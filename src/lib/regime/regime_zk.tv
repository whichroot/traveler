// ===== COMPOSITION: commit + Fiat-Shamir freeze + per-segment FRI =====

// FRI parameters for an order-1 (piecewise-linear) segment certificate.
// degree=1, log_blowup=2 -> log_n=3, n=8, n_rounds=3.  Uniform across segments.
//   FRI_DEG=1  FRI_LB=2  FRI_NQ=2  FRI_MAXR=3  FRI_MAXD=3  FRI_SHIFT=7

// Merkle-commit the data: each data point is a leaf (value in slot 0, zero pad).
// n_leaves must be a power of two. Writes the root (4 field elems) to data_root.
fn commit_data(
    f: Field, data: *i64, n_leaves: i32,
    leaves: *i64, tree: *i64, data_root: *i64,
    rc_init: *i64, rc_term: *i64, rc_int: *i64, diag: *i64
) {
    for i in 0..n_leaves {
        leaves[i * 4] = data[i];
        leaves[i * 4 + 1] = 0;
        leaves[i * 4 + 2] = 0;
        leaves[i * 4 + 3] = 0;
    }
    merkle_build_dyn(f, leaves, n_leaves, tree, rc_init, rc_term, rc_int, diag);
    for j in 0..4 { data_root[j] = tree[4 + j]; }
}

// Fiat-Shamir FREEZE: absorb data_root (4) + flattened descriptor (nseg*3),
// squeeze a 4-elem fingerprint binding the pair BEFORE any FRI challenge.
fn make_fingerprint(
    f: Field, data_root: *i64, cert: *i64, nseg: i32, fp: *i64,
    rc_init: *i64, rc_term: *i64, rc_int: *i64, diag: *i64
) {
    let ts: *i64 = alloc(8);
    let ts_pos: *i32 = alloc(1);
    transcript_init_dyn(f, ts);
    ts_pos[0] = 0;
    transcript_absorb_dyn(f, ts, ts_pos, data_root, 4, rc_init, rc_term, rc_int, diag);
    transcript_absorb_dyn(f, ts, ts_pos, cert, nseg * 3, rc_init, rc_term, rc_int, diag);
    transcript_squeeze_dyn(f, ts, ts_pos, fp, 4, rc_init, rc_term, rc_int, diag);
    free(ts);
    free(ts_pos);
}

// Per-segment FRI low-degree proofs.  For segment k the Newton coefficients
// [c0, c1] = [data[start], forward_diff(data[start..start+2])] describe a
// degree-1 polynomial; fri_prove binds it cryptographically.  Proof data for
// every segment is stored into the flat per-segment arrays (indexed by k).
fn prove_segments(
    f: Field, data: *i64, cert: *i64, nseg: i32,
    seg_roots: *i64, seg_chal: *i64, seg_final: *i64,
    seg_qval: *i64, seg_qpath: *i64, seg_qidx: *i32, seg_nr: *i32,
    rc_init: *i64, rc_term: *i64, rc_int: *i64, diag: *i64
) {
    let coeffs: *i64 = alloc(2);
    let work: *i64 = alloc(4);
    for k in 0..nseg {
        let start: i32 = cert[k * 3] as i32;
        coeffs[0] = data[start];
        fdiff_dyn(f, data, start, 2, 1, work);
        coeffs[1] = work[0];

        let roots: *i64 = &seg_roots[k * 12];          // FRI_MAXR*4
        let chal: *i64 = &seg_chal[k * 3];             // FRI_MAXR
        let final_poly: *i64 = &seg_final[k];          // 1
        let qval: *i64 = &seg_qval[k * 12];            // FRI_NQ*FRI_MAXR*2
        let qpath: *i64 = &seg_qpath[k * 72];          // FRI_NQ*FRI_MAXR*FRI_MAXD*4
        let qidx: *i32 = &seg_qidx[k * 2];             // FRI_NQ

        let nr: i32 = fri_prove_dyn(
            f, coeffs, 1, 2, 7, 2,
            roots, chal, final_poly, qval, qpath, qidx,
            rc_init, rc_term, rc_int, diag);
        seg_nr[k] = nr;
    }
    free(coeffs);
    free(work);
}

// Verify all per-segment FRI proofs.  Returns 1 iff every segment verifies.
fn verify_segments(
    f: Field, cert: *i64, nseg: i32,
    seg_roots: *i64, seg_chal: *i64, seg_final: *i64,
    seg_qval: *i64, seg_qpath: *i64, seg_qidx: *i32, seg_nr: *i32,
    rc_init: *i64, rc_term: *i64, rc_int: *i64, diag: *i64
) -> i32 {
    var ok: i32 = 1;
    for k in 0..nseg {
        let roots: *i64 = &seg_roots[k * 12];
        let chal: *i64 = &seg_chal[k * 3];
        let final_poly: *i64 = &seg_final[k];
        let qval: *i64 = &seg_qval[k * 12];
        let qpath: *i64 = &seg_qpath[k * 72];
        let qidx: *i32 = &seg_qidx[k * 2];
        let nr: i32 = seg_nr[k];

        let v: i32 = fri_verify_dyn(
            f, 1, 2, 7, 2, nr,
            roots, chal, final_poly, qval, qpath, qidx,
            rc_init, rc_term, rc_int, diag);
        if v != 1 { ok = 0; }
    }
    return ok;
}

// Full verification: replay all four layers over the (possibly tampered) data,
// certificate, fingerprint, and FRI proofs.  Returns 1 iff all pass.
fn regime_zk_verify(
    f: Field, data: *i64, n: i32, n_leaves: i32, cert: *i64, nseg: i32,
    committed_root: *i64, committed_fp: *i64,
    seg_roots: *i64, seg_chal: *i64, seg_final: *i64,
    seg_qval: *i64, seg_qpath: *i64, seg_qidx: *i32, seg_nr: *i32,
    leaves: *i64, tree: *i64, work: *i64,
    rc_init: *i64, rc_term: *i64, rc_int: *i64, diag: *i64
) -> i32 {
    // (a) recompute data_root, check == committed root.
    let root2: *i64 = alloc(4);
    commit_data(f, data, n_leaves, leaves, tree, root2, rc_init, rc_term, rc_int, diag);
    var root_ok: i32 = 1;
    for j in 0..4 {
        if root2[j] != committed_root[j] { root_ok = 0; }
    }
    free(root2);
    if root_ok == 0 { return 0; }

    // (b) recompute the binding fingerprint, check == committed fingerprint.
    let fp2: *i64 = alloc(4);
    make_fingerprint(f, committed_root, cert, nseg, fp2, rc_init, rc_term, rc_int, diag);
    var fp_ok: i32 = 1;
    for j in 0..4 {
        if fp2[j] != committed_fp[j] { fp_ok = 0; }
    }
    free(fp2);
    if fp_ok == 0 { return 0; }

    // (c) algebraic certificate: fit + forced boundary + exact partition.
    if regime_verify_dyn(f, data, n, cert, nseg, work) != 1 { return 0; }

    // (d) per-segment FRI low-degree proofs.
    if verify_segments(f, cert, nseg, seg_roots, seg_chal, seg_final,
        seg_qval, seg_qpath, seg_qidx, seg_nr,
        rc_init, rc_term, rc_int, diag) != 1 { return 0; }

    return 1;
}

// ===== EXPORTED ENTRY POINT: the domain-agnostic ZK regime proof =====

// run_zk_domain proves+verifies a canonical order-1 segmentation of data[0..n)
// (n_leaves a power of two >= n; padding beyond n is committed, not segmented),
// then runs the three soundness tampers. Caller passes the prime as plain i64
// (the carrier is built internally via field(p)). Results in out[0..5]:
//   out[0] = nseg          (number of canonical segments)
//   out[1] = honest verify (1)
//   out[2] = data tamper   (0)
//   out[3] = descriptor tamper (0)
//   out[4] = FRI tamper    (0)

#[export]
fn run_zk_domain(p: i64, data: *i64, n: i32, n_leaves: i32, out: *i64) {
    let f: Field = field(p);

    let rc_init: *i64 = alloc(32);
    let rc_term: *i64 = alloc(32);
    let rc_int: *i64 = alloc(22);
    let diag: *i64 = alloc(8);
    fill_rc(rc_init, rc_term, rc_int);
    poseidon2_diag_dyn(f, diag);

    let cert: *i64 = alloc(n * 3);
    let work: *i64 = alloc(n);
    let leaves: *i64 = alloc(n_leaves * 4);
    let tree: *i64 = alloc(n_leaves * 8);
    let data_root: *i64 = alloc(4);
    let fp: *i64 = alloc(4);

    // Per-segment FRI proof storage (upper-bounded by n segments).
    let seg_roots: *i64 = alloc(n * 12);
    let seg_chal: *i64 = alloc(n * 3);
    let seg_final: *i64 = alloc(n);
    let seg_qval: *i64 = alloc(n * 12);
    let seg_qpath: *i64 = alloc(n * 72);
    let seg_qidx: *i32 = alloc(n * 2);
    let seg_nr: *i32 = alloc(n);

    // ---- PROVE ----
    // 1. commit the data (all n_leaves leaves).
    commit_data(f, data, n_leaves, leaves, tree, data_root, rc_init, rc_term, rc_int, diag);
    // 2. canonical order-1 segmentation over [0, n).
    let nseg: i32 = regime_prove_dyn(f, data, n, 1, cert, work);
    out[0] = nseg as i64;
    // 3. Fiat-Shamir freeze: bind data_root + descriptor.
    make_fingerprint(f, data_root, cert, nseg, fp, rc_init, rc_term, rc_int, diag);
    // 4. per-segment FRI low-degree proofs.
    prove_segments(f, data, cert, nseg,
        seg_roots, seg_chal, seg_final, seg_qval, seg_qpath, seg_qidx, seg_nr,
        rc_init, rc_term, rc_int, diag);

    // ---- VERIFY (honest) -> 1 ----
    out[1] = regime_zk_verify(
        f, data, n, n_leaves, cert, nseg, data_root, fp,
        seg_roots, seg_chal, seg_final, seg_qval, seg_qpath, seg_qidx, seg_nr,
        leaves, tree, work, rc_init, rc_term, rc_int, diag) as i64;

    // ---- SOUNDNESS 1: tamper the DATA -> root mismatch -> 0 ----
    let ti: i32 = n / 2;
    let saved: i64 = data[ti];
    data[ti] = data[ti] + 1;
    out[2] = regime_zk_verify(
        f, data, n, n_leaves, cert, nseg, data_root, fp,
        seg_roots, seg_chal, seg_final, seg_qval, seg_qpath, seg_qidx, seg_nr,
        leaves, tree, work, rc_init, rc_term, rc_int, diag) as i64;
    data[ti] = saved;

    // ---- SOUNDNESS 2: tamper the DESCRIPTOR -> fingerprint mismatch -> 0 ----
    // Extend the first segment by one sample past its forced boundary (requires
    // at least two segments; every real domain here has nseg >= 2).
    if nseg >= 2 {
        let len0: i64 = cert[1];
        let s1: i64 = cert[3];
        let l1: i64 = cert[4];
        cert[1] = len0 + 1;
        cert[3] = s1 + 1;
        cert[4] = l1 - 1;
        out[3] = regime_zk_verify(
            f, data, n, n_leaves, cert, nseg, data_root, fp,
            seg_roots, seg_chal, seg_final, seg_qval, seg_qpath, seg_qidx, seg_nr,
            leaves, tree, work, rc_init, rc_term, rc_int, diag) as i64;
        cert[1] = len0;
        cert[3] = s1;
        cert[4] = l1;
    } else {
        out[3] = 0;
    }

    // ---- SOUNDNESS 3: tamper a FRI PROOF -> fri_verify fails -> 0 ----
    seg_final[0] = seg_final[0] + 1;
    out[4] = regime_zk_verify(
        f, data, n, n_leaves, cert, nseg, data_root, fp,
        seg_roots, seg_chal, seg_final, seg_qval, seg_qpath, seg_qidx, seg_nr,
        leaves, tree, work, rc_init, rc_term, rc_int, diag) as i64;
    seg_final[0] = seg_final[0] - 1;

    free(rc_init); free(rc_term); free(rc_int); free(diag);
    free(cert); free(work); free(leaves); free(tree);
    free(data_root); free(fp);
    free(seg_roots); free(seg_chal); free(seg_final);
    free(seg_qval); free(seg_qpath); free(seg_qidx); free(seg_nr);
}
