// SPDX-License-Identifier: Apache-2.0
// Author: Matt Flores
// sqrt.tv — squares, both citizens: exact integer sqrt / perfect-square
// detection (magnitude side) and Tonelli-Shanks root extraction over F_p
// (field side). Detection = Euler criterion; extraction = sqrt_mod; check =
// one multiplication (the minimal compute+certificate pair). Odd primes
// p < 2^31 (i64 products safe). sq_-prefixed helpers avoid curve.tv name
// collisions under Model A import merge. tvc_self-only import.
// @internal-design: nt (squares section)

// ===== integer side =====

// floor(sqrt(n)) for n >= 0; -1 sentinel for n < 0. Binary search, no
// division; hi = floor(sqrt(2^63-1)) so mid*mid never wraps for ANY i64 n.
fn isqrt64(n: i64) -> i64 {
    if n < 0 { return 0 - 1; }
    var lo: i64 = 0;
    var hi: i64 = 3037000499;
    if n < hi { hi = n; }
    while lo < hi {
        let mid: i64 = (lo + hi + 1) / 2;
        if mid * mid <= n { lo = mid; }
        else { hi = mid - 1; }
    }
    return lo;
}

// 1 iff n is a perfect square. Certificate either way: r = isqrt64(n) gives
// r*r == n (witness) or r*r < n < (r+1)*(r+1) (bracketing refusal).
fn is_square64(n: i64) -> i64 {
    if n < 0 { return 0; }
    let r: i64 = isqrt64(n);
    if r * r == n { return 1; }
    return 0;
}

// ===== F_p side (p an odd prime < 2^31 — the caller's contract) =====

fn sq_modpow(b: i64, e: i64, p: i64) -> i64 {
    var r: i64 = 1;
    var bb: i64 = ((b % p) + p) % p;
    var ee: i64 = e;
    while ee > 0 {
        if ee % 2 == 1 { r = r * bb % p; }
        bb = bb * bb % p;
        ee = ee / 2;
    }
    return r;
}

// Euler criterion: 1 = QR, -1 = non-residue, 0 for a == 0. (Detection.)
fn sq_legendre(a: i64, p: i64) -> i64 {
    let aa: i64 = ((a % p) + p) % p;
    if aa == 0 { return 0; }
    let c: i64 = sq_modpow(aa, (p - 1) / 2, p);
    if c == 1 { return 1; }
    return 0 - 1;
}

// Tonelli-Shanks: r with r*r == a (mod p), normalized to min(r, p-r); -1 for
// a non-residue (one-sided refusal, Euler-checked before extraction); 0 for
// a == 0. One code path: p == 3 (mod 4) degenerates at S = 1 (loop skipped).
fn sqrt_mod(a: i64, p: i64) -> i64 {
    if p == 2 { return ((a % 2) + 2) % 2; }
    let aa: i64 = ((a % p) + p) % p;
    if aa == 0 { return 0; }
    if sq_legendre(aa, p) != 1 { return 0 - 1; }
    // p - 1 = q * 2^s, q odd
    var q: i64 = p - 1;
    var s: i64 = 0;
    while q % 2 == 0 { q = q / 2; s = s + 1; }
    // z = smallest non-residue (deterministic -> deterministic root)
    var z: i64 = 2;
    while sq_legendre(z, p) != 0 - 1 { z = z + 1; }
    var m: i64 = s;
    var c: i64 = sq_modpow(z, q, p);
    var t: i64 = sq_modpow(aa, q, p);
    var r: i64 = sq_modpow(aa, (q + 1) / 2, p);
    while t != 1 {
        // least i in (0, m) with t^(2^i) == 1
        var i: i64 = 0;
        var t2: i64 = t;
        while t2 != 1 { t2 = t2 * t2 % p; i = i + 1; }
        var b: i64 = c;
        var j: i64 = 0;
        while j < m - i - 1 { b = b * b % p; j = j + 1; }
        m = i;
        c = b * b % p;
        t = t * c % p;
        r = r * b % p;
    }
    if p - r < r { return p - r; }
    return r;
}
