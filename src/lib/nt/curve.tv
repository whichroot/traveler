// curve.tv — FORWARD nt kernel: exact point counts N_n for y^2 = x^3 + ax + b
// over F_p / F_{p^2} / F_{p^3}, QR/Legendre machinery, trace a_p. tvc_self-only.
// @internal-design: nt

// ===== F_p scalar machinery =====

fn mod_pos(x: i32, p: i32) -> i32 {
    let r: i32 = x % p;
    if r < 0 { return r + p; }
    return r;
}

fn modpow(base: i32, e: i32, p: i32) -> i32 {
    var r: i32 = 1;
    var b: i32 = mod_pos(base, p);
    var ee: i32 = e;
    while ee > 0 {
        if (ee % 2) == 1 { r = (r * b) % p; }
        b = (b * b) % p;
        ee = ee / 2;
    }
    return r;
}

fn legendre(z: i32, p: i32) -> i32 {
    let zz: i32 = mod_pos(z, p);
    if zz == 0 { return 0; }
    let c: i32 = modpow(zz, (p - 1) / 2, p);
    if c == 1 { return 1; }
    return 0 - 1;
}

fn smallest_nonresidue(p: i32) -> i32 {
    var nr: i32 = 2;
    while nr < p {
        if legendre(nr, p) == 0 - 1 { return nr; }
        nr = nr + 1;
    }
    return 0;
}

fn is_prime(n: i32) -> i32 {
    if n < 2 { return 0; }
    var d: i32 = 2;
    while d * d <= n {
        if n % d == 0 { return 0; }
        d = d + 1;
    }
    return 1;
}

// round(num / den), den > 0, num signed. The declared-scale membrane crossing.
fn rnd_div(num: i64, den: i64) -> i64 {
    if num >= 0 { return (num + den / 2) / den; }
    return 0 - ((0 - num + den / 2) / den);
}

// ===== a_p via the quadratic-residue table =====

fn build_qr(p: i32, sq: *i32) {
    var i: i32 = 0;
    while i < p { sq[i] = 0; i = i + 1; }
    var y: i32 = 0;
    while y < p { sq[(y * y) % p] = 1; y = y + 1; }
}

// a_p for y^2 = x^3 + x + 1:  a_p = - sum_x chi(x^3 + x + 1).
#[export]
fn ap_curve(p: i32, sq: *i32) -> i32 {
    var s: i32 = 0;
    var x: i32 = 0;
    while x < p {
        let x3: i32 = (((x * x) % p) * x) % p;
        let fx: i32 = (((x3 + x + 1) % p) + p) % p;
        if fx != 0 {
            if sq[fx] == 1 { s = s + 1; }
            else { s = s - 1; }
        }
        x = x + 1;
    }
    return 0 - s;
}

// ===== N_1 = #E(F_p) via the character sum =====

// N_1 = #E(F_p) = p + 1 + sum_x chi(x^3 + a x + b)
#[export]
fn count_fp(p: i32, a: i32, b: i32) -> i32 {
    var s: i32 = 0;
    var x: i32 = 0;
    while x < p {
        let x2: i32 = (x * x) % p;
        let x3: i32 = (x2 * x) % p;
        let fx: i32 = mod_pos(x3 + a * x + b, p);
        s = s + legendre(fx, p);
        x = x + 1;
    }
    return p + 1 + s;
}

// ===== N_2 = #E(F_{p^2}),  F_{p^2} = F_p[i]/(i^2 = nr) =====

fn gf2re(a0: i32, a1: i32, b0: i32, b1: i32, p: i32, nr: i32) -> i32 {
    return (a0 * b0 % p + (a1 * b1 % p) * nr % p) % p;
}
fn gf2im(a0: i32, a1: i32, b0: i32, b1: i32, p: i32) -> i32 {
    return (a0 * b1 % p + a1 * b0 % p) % p;
}

// N_2 = #E(F_{p^2}) via a square-set over F_{p^2}
#[export]
fn count_fp2(p: i32, a: i32, b: i32) -> i32 {
    let nr: i32 = smallest_nonresidue(p);
    let n: i32 = p * p;
    let sq: *i32 = alloc(n);
    var i: i32 = 0;
    while i < n { sq[i] = 0; i = i + 1; }
    var u: i32 = 0;
    while u < p {
        var v: i32 = 0;
        while v < p {
            let s0: i32 = gf2re(u, v, u, v, p, nr);
            let s1: i32 = gf2im(u, v, u, v, p);
            sq[s0 * p + s1] = 1;
            v = v + 1;
        }
        u = u + 1;
    }
    var total: i32 = 0;
    var uu: i32 = 0;
    while uu < p {
        var vv: i32 = 0;
        while vv < p {
            let x2r: i32 = gf2re(uu, vv, uu, vv, p, nr);
            let x2i: i32 = gf2im(uu, vv, uu, vv, p);
            let x3r: i32 = gf2re(x2r, x2i, uu, vv, p, nr);
            let x3i: i32 = gf2im(x2r, x2i, uu, vv, p);
            // f = x^3 + a*x + b   (a,b in F_p act on the (re,im) pair)
            let f0: i32 = mod_pos(x3r + a * uu + b, p);
            let f1: i32 = mod_pos(x3i + a * vv, p);
            if f0 != 0 || f1 != 0 {
                if sq[f0 * p + f1] == 1 { total = total + 1; }
                else { total = total - 1; }
            }
            vv = vv + 1;
        }
        uu = uu + 1;
    }
    free(sq);
    return n + 1 + total;
}

// ===== N_3 = #E(F_{p^3}),  F_{p^3} = F_p[t]/(t^3 + m1 t + m0) =====

fn gf3mul(a0: i32, a1: i32, a2: i32, b0: i32, b1: i32, b2: i32,
    p: i32, m1: i32, m0: i32, out: *i32) {
    let c0: i32 = a0 * b0;
    let c1: i32 = a0 * b1 + a1 * b0;
    let c2: i32 = a0 * b2 + a1 * b1 + a2 * b0;
    let c3: i32 = a1 * b2 + a2 * b1;
    let c4: i32 = a2 * b2;
    out[0] = mod_pos(c0 - m0 * c3, p);
    out[1] = mod_pos(c1 - m1 * c3 - m0 * c4, p);
    out[2] = mod_pos(c2 - m1 * c4, p);
}

// N_3 = #E(F_{p^3})
#[export]
fn count_fp3(p: i32, a: i32, b: i32) -> i32 {
    // irreducible depressed cubic t^3 + m1 t + m0 (no root in F_p)
    var m1: i32 = 0;
    var m0: i32 = 0;
    var found: i32 = 0;
    var mm1: i32 = 0;
    while mm1 < p {
        var mm0: i32 = 0;
        while mm0 < p {
            if found == 0 {
                var hasroot: i32 = 0;
                var t: i32 = 0;
                while t < p {
                    let t3: i32 = ((t * t % p) * t) % p;
                    if mod_pos(t3 + mm1 * t + mm0, p) == 0 { hasroot = 1; }
                    t = t + 1;
                }
                if hasroot == 0 { m1 = mm1; m0 = mm0; found = 1; }
            }
            mm0 = mm0 + 1;
        }
        mm1 = mm1 + 1;
    }
    let pp: i32 = p * p;
    let n: i32 = pp * p;
    let sq: *i32 = alloc(n);
    var i: i32 = 0;
    while i < n { sq[i] = 0; i = i + 1; }
    let tmp: *i32 = alloc(3);
    let x2: *i32 = alloc(3);
    let x3: *i32 = alloc(3);
    var a0: i32 = 0;
    while a0 < p {
        var a1: i32 = 0;
        while a1 < p {
            var a2: i32 = 0;
            while a2 < p {
                gf3mul(a0, a1, a2, a0, a1, a2, p, m1, m0, tmp);
                sq[tmp[0] * pp + tmp[1] * p + tmp[2]] = 1;
                a2 = a2 + 1;
            }
            a1 = a1 + 1;
        }
        a0 = a0 + 1;
    }
    var total: i32 = 0;
    var b0: i32 = 0;
    while b0 < p {
        var b1: i32 = 0;
        while b1 < p {
            var b2: i32 = 0;
            while b2 < p {
                gf3mul(b0, b1, b2, b0, b1, b2, p, m1, m0, x2);
                gf3mul(x2[0], x2[1], x2[2], b0, b1, b2, p, m1, m0, x3);
                // f = x^3 + a*x + b
                let f0: i32 = mod_pos(x3[0] + a * b0 + b, p);
                let f1: i32 = mod_pos(x3[1] + a * b1, p);
                let f2: i32 = mod_pos(x3[2] + a * b2, p);
                if f0 != 0 || f1 != 0 || f2 != 0 {
                    if sq[f0 * pp + f1 * p + f2] == 1 { total = total + 1; }
                    else { total = total - 1; }
                }
                b2 = b2 + 1;
            }
            b1 = b1 + 1;
        }
        b0 = b0 + 1;
    }
    free(sq);
    free(tmp);
    free(x2);
    free(x3);
    return n + 1 + total;
}
