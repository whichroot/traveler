// linalg.tv — carrier-generic dense linear algebra over a field F: rref/rank/
// nullspace/matvec/det/solve on caller-owned row-major *F. tvc_self-only.
// @internal-design: nt

// Field inverse witness: base^(|F|-2) by square-and-multiply (`*`-only, so it
// compiles over BinField, which has no div in codegen). qm2 = |F|-2.
fn la_fpow<F: Field>(base: F, e: i64) -> F {
    var r: F = 1 as F;
    var b: F = base;
    var ee: i64 = e;
    while ee > 0 {
        if (ee % 2) == 1 { r = r * b; }
        b = b * b;
        ee = ee / 2;
    }
    return r;
}

// In-place RREF of A (rows x cols, row-major). pivcol (caller-owned, size cols)
// gets 1 at pivot columns, 0 elsewhere. Returns the rank. qm2 = |F| - 2.
fn la_rref<F: Field>(A: *F, rows: i32, cols: i32, qm2: i64, pivcol: *i32) -> i32 {
    var c: i32 = 0;
    while c < cols { pivcol[c] = 0; c = c + 1; }

    var pr: i32 = 0;                // current pivot row
    var pc: i32 = 0;               // current pivot column
    while pr < rows && pc < cols {
        // find a nonzero entry in column pc at or below pr
        var piv: i32 = 0 - 1;
        var r: i32 = pr;
        while r < rows {
            if A[r * cols + pc] == (0 as F) { r = r + 1; }
            else { piv = r; break; }
        }
        if piv == 0 - 1 {
            pc = pc + 1;               // free column, advance
        } else {
            // swap rows piv <-> pr
            if piv != pr {
                var k: i32 = 0;
                while k < cols {
                    let t: F = A[pr * cols + k];
                    A[pr * cols + k] = A[piv * cols + k];
                    A[piv * cols + k] = t;
                    k = k + 1;
                }
            }
            // normalize the pivot row to a leading 1
            let inv: F = la_fpow(A[pr * cols + pc], qm2);
            var k2: i32 = 0;
            while k2 < cols { A[pr * cols + k2] = A[pr * cols + k2] * inv; k2 = k2 + 1; }
            // eliminate the pivot column from every other row (subtracting a zero
            // multiple is harmless, so no per-row zero-test is needed)
            var r2: i32 = 0;
            while r2 < rows {
                if r2 != pr {
                    let f: F = A[r2 * cols + pc];
                    var k3: i32 = 0;
                    while k3 < cols {
                        A[r2 * cols + k3] = A[r2 * cols + k3] - f * A[pr * cols + k3];
                        k3 = k3 + 1;
                    }
                }
                r2 = r2 + 1;
            }
            pivcol[pc] = 1;
            pr = pr + 1;
            pc = pc + 1;
        }
    }
    return pr;
}

// Non-destructive rank (works on a copy).
fn la_rank<F: Field>(A: *F, rows: i32, cols: i32, qm2: i64) -> i32 {
    let W: *F = alloc(rows * cols);
    var i: i32 = 0;
    while i < rows * cols { W[i] = A[i]; i = i + 1; }
    let pivcol: *i32 = alloc(cols);
    let r: i32 = la_rref(W, rows, cols, qm2, pivcol);
    free(W);
    free(pivcol);
    return r;
}

// Right null space {x : A x = 0}: basis vectors written as the ROWS of out
// (caller-owned, cols*cols; nullity <= cols). Returns the nullity. A untouched.
fn la_nullspace<F: Field>(A: *F, rows: i32, cols: i32, qm2: i64, out: *F) -> i32 {
    let W: *F = alloc(rows * cols);
    var i: i32 = 0;
    while i < rows * cols { W[i] = A[i]; i = i + 1; }
    let pivcol: *i32 = alloc(cols);
    let rank: i32 = la_rref(W, rows, cols, qm2, pivcol);

    // pivot columns in increasing order
    let pcols: *i32 = alloc(cols);
    var np: i32 = 0;
    var c: i32 = 0;
    while c < cols {
        if pivcol[c] == 1 { pcols[np] = c; np = np + 1; }
        c = c + 1;
    }

    // one basis vector per free column
    var d: i32 = 0;
    c = 0;
    while c < cols {
        if pivcol[c] == 0 {
            var k: i32 = 0;
            while k < cols { out[d * cols + k] = 0 as F; k = k + 1; }
            out[d * cols + c] = 1 as F;
            var ip: i32 = 0;
            while ip < rank {
                // x[pivot_col_of_row ip] = -W[ip][c]
                out[d * cols + pcols[ip]] = (0 as F) - W[ip * cols + c];
                ip = ip + 1;
            }
            d = d + 1;
        }
        c = c + 1;
    }

    free(W);
    free(pivcol);
    free(pcols);
    return d;
}

// y = A x  (rows x cols times cols-vector). For the gate's A·v == 0 check.
fn la_matvec<F: Field>(A: *F, rows: i32, cols: i32, x: *F, y: *F) {
    var i: i32 = 0;
    while i < rows {
        var acc: F = 0 as F;
        var j: i32 = 0;
        while j < cols { acc = acc + A[i * cols + j] * x[j]; j = j + 1; }
        y[i] = acc;
        i = i + 1;
    }
}

// Determinant of a square n x n matrix by forward elimination (det = ±∏ pivots).
// Non-destructive. Returns 0 as F for a singular matrix. qm2 = |F| - 2.
fn la_det<F: Field>(Ain: *F, n: i32, qm2: i64) -> F {
    let A: *F = alloc(n * n);
    var i: i32 = 0;
    while i < n * n { A[i] = Ain[i]; i = i + 1; }
    var det: F = 1 as F;
    var col: i32 = 0;
    while col < n {
        // pivot at or below the diagonal in this column
        var piv: i32 = 0 - 1;
        var r: i32 = col;
        while r < n {
            if A[r * n + col] == (0 as F) { r = r + 1; }
            else { piv = r; break; }
        }
        if piv == 0 - 1 { det = 0 as F; col = n; }        // singular: bail
        else {
            if piv != col {
                var k: i32 = 0;
                while k < n {
                    let t: F = A[col * n + k];
                    A[col * n + k] = A[piv * n + k];
                    A[piv * n + k] = t;
                    k = k + 1;
                }
                det = (0 as F) - det;                      // row swap flips sign
            }
            let p: F = A[col * n + col];
            det = det * p;
            let inv: F = la_fpow(p, qm2);
            var r2: i32 = col + 1;
            while r2 < n {
                let f: F = A[r2 * n + col] * inv;
                var k2: i32 = col;
                while k2 < n {
                    A[r2 * n + k2] = A[r2 * n + k2] - f * A[col * n + k2];
                    k2 = k2 + 1;
                }
                r2 = r2 + 1;
            }
            col = col + 1;
        }
    }
    free(A);
    return det;
}

// Solve the square system A x = b (n x n). Writes x into out; returns 1 on a
// unique solution, 0 if A is singular. Augment [A|b], rref, read the last column.
fn la_solve<F: Field>(A: *F, n: i32, b: *F, out: *F, qm2: i64) -> i32 {
    let w: i32 = n + 1;
    let aug: *F = alloc(n * w);
    var i: i32 = 0;
    while i < n {
        var j: i32 = 0;
        while j < n { aug[i * w + j] = A[i * n + j]; j = j + 1; }
        aug[i * w + n] = b[i];
        i = i + 1;
    }
    let pivcol: *i32 = alloc(w);
    let rank: i32 = la_rref(aug, n, w, qm2, pivcol);
    var ok: i32 = 0;
    if rank == n {
        // full rank on the n coefficient columns => RREF is identity there,
        // and the augmented column holds the solution row-for-row.
        var r: i32 = 0;
        while r < n { out[r] = aug[r * w + n]; r = r + 1; }
        ok = 1;
    }
    free(aug);
    free(pivcol);
    return ok;
}
