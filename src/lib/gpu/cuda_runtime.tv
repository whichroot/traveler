// Traveler-owned CUDA module runtime. The driver owns device mechanisms;
// Traveler owns context, module, allocation, launch, synchronization, and
// failure state.

import "cuda_ffi.tv";

var g_cuda_error: i32 = 0;
var g_cuda_status: i32 = 0;
var g_cuda_dispatch_count: i32 = 0;

struct CudaRuntime {
    context: *u8,
    device: i32,
    module: *u8,
    function: *u8,
    input: *u8,
    input2: *u8,
    output: *u8,
    input_capacity: usize,
    output_capacity: usize,
    caps: **u8,
    cap_count: i32,
}

fn cuda_record_error(boundary: i32, status: i32) {
    g_cuda_error = boundary;
    g_cuda_status = status;
}

fn cuda_runtime_close(runtime: *CudaRuntime) {
    if runtime == null { return; }
    if runtime.caps != null {
        var ci: i32 = 0;
        while ci < runtime.cap_count {
            if runtime.caps[ci] != null { cuMemFree_v2(runtime.caps[ci]); }
            ci = ci + 1;
        }
        free(runtime.caps as *u8);
    }
    if runtime.output != null { cuMemFree_v2(runtime.output); }
    if runtime.input2 != null { cuMemFree_v2(runtime.input2); }
    if runtime.input != null { cuMemFree_v2(runtime.input); }
    if runtime.module != null { cuModuleUnload(runtime.module); }
    if runtime.context != null { cuDevicePrimaryCtxRelease(runtime.device); }
    free(runtime);
}

fn cuda_runtime_open(module_path: *u8, kernel_name: *u8,
                     input_capacity: usize,
                     output_capacity: usize) -> *CudaRuntime {
    g_cuda_error = 0;
    g_cuda_status = 0;
    if module_path == null || kernel_name == null
        || input_capacity == 0 || output_capacity == 0 {
        cuda_record_error(1, 0 - 1);
        return null;
    }

    let runtime: *CudaRuntime = alloc(1);
    runtime.context = null;
    runtime.device = 0;
    runtime.module = null;
    runtime.function = null;
    runtime.input = null;
    runtime.input2 = null;
    runtime.output = null;
    runtime.input_capacity = input_capacity;
    runtime.output_capacity = output_capacity;
    runtime.caps = null;
    runtime.cap_count = 0;

    var status: i32 = cuInit(0);
    if status != 0 {
        cuda_record_error(2, status);
        cuda_runtime_close(runtime);
        return null;
    }
    // Open runtimes share the device primary context: every module, buffer,
    // and launch is then valid no matter which open most recently ran.
    let device_slot: *i32 = alloc(1);
    status = cuDeviceGet(device_slot, 0);
    if status == 0 { runtime.device = device_slot[0]; }
    free(device_slot);
    if status == 0 {
        let context_slot: **u8 = alloc(1);
        context_slot[0] = null;
        status = cuDevicePrimaryCtxRetain(context_slot, runtime.device);
        if status == 0 { runtime.context = context_slot[0]; }
        free(context_slot as *u8);
    }
    if status == 0 { status = cuCtxSetCurrent(runtime.context); }
    if status != 0 || runtime.context == null {
        cuda_record_error(3, status);
        cuda_runtime_close(runtime);
        return null;
    }

    let module_slot: **u8 = alloc(1);
    module_slot[0] = null;
    status = cuModuleLoad(module_slot, module_path);
    if status != 0 || module_slot[0] == null {
        cuda_record_error(4, status);
        free(module_slot as *u8);
        cuda_runtime_close(runtime);
        return null;
    }
    runtime.module = module_slot[0];
    free(module_slot as *u8);

    let function_slot: **u8 = alloc(1);
    function_slot[0] = null;
    status = cuModuleGetFunction(function_slot, runtime.module, kernel_name);
    if status != 0 || function_slot[0] == null {
        cuda_record_error(5, status);
        free(function_slot as *u8);
        cuda_runtime_close(runtime);
        return null;
    }
    runtime.function = function_slot[0];
    free(function_slot as *u8);

    let input_slot: **u8 = alloc(1);
    input_slot[0] = null;
    status = cuMemAlloc_v2(input_slot, input_capacity);
    if status != 0 || input_slot[0] == null {
        cuda_record_error(6, status);
        free(input_slot as *u8);
        cuda_runtime_close(runtime);
        return null;
    }
    runtime.input = input_slot[0];
    free(input_slot as *u8);

    let output_slot: **u8 = alloc(1);
    output_slot[0] = null;
    status = cuMemAlloc_v2(output_slot, output_capacity);
    if status != 0 || output_slot[0] == null {
        cuda_record_error(7, status);
        free(output_slot as *u8);
        cuda_runtime_close(runtime);
        return null;
    }
    runtime.output = output_slot[0];
    free(output_slot as *u8);
    return runtime;
}

// Launches the Stage-0 one-input/one-output pfor ABI:
//   kernel(input, output, lo, hi)
fn cuda_runtime_launch_map_1d(runtime: *CudaRuntime,
                              input: *u8, input_bytes: usize,
                              output: *u8, output_bytes: usize,
                              lo: i32, hi: i32) -> i32 {
    g_cuda_error = 0;
    g_cuda_status = 0;
    if runtime == null || input == null || output == null || lo < 0 || hi <= lo
        || input_bytes == 0 || output_bytes == 0
        || input_bytes > runtime.input_capacity
        || output_bytes > runtime.output_capacity {
        cuda_record_error(8, 0 - 1);
        return 0;
    }

    var status: i32 = cuMemcpyHtoD_v2(runtime.input, input, input_bytes);
    if status != 0 {
        cuda_record_error(9, status);
        return 0;
    }

    var device_input: *u8 = runtime.input;
    var device_output: *u8 = runtime.output;
    var kernel_lo: i32 = lo;
    var kernel_hi: i32 = hi;
    let args: **u8 = alloc(4);
    args[0] = (&device_input) as *u8;
    args[1] = (&device_output) as *u8;
    args[2] = (&kernel_lo) as *u8;
    args[3] = (&kernel_hi) as *u8;
    let groups: u32 = (((hi - lo) + 255) / 256) as u32;
    status = cuLaunchKernel(runtime.function,
                            groups, 1, 1, 256, 1, 1,
                            0, null, args, null);
    free(args as *u8);
    if status != 0 {
        cuda_record_error(10, status);
        return 0;
    }
    status = cuCtxSynchronize();
    if status != 0 {
        cuda_record_error(11, status);
        return 0;
    }
    status = cuMemcpyDtoH_v2(output, runtime.output, output_bytes);
    if status != 0 {
        cuda_record_error(12, status);
        return 0;
    }
    g_cuda_dispatch_count = g_cuda_dispatch_count + 1;
    return 1;
}

fn cuda_dispatches() -> i32 { return g_cuda_dispatch_count; }

fn cuda_runtime_launch_dot_k8_repeated(runtime: *CudaRuntime,
                                       input0: *u8, input0_bytes: usize,
                                       input1: *u8, input1_bytes: usize,
                                       output: *u8, output_bytes: usize,
                                       lo: i32, hi: i32,
                                       repetitions: i32) -> i32 {
    g_cuda_error = 0;
    g_cuda_status = 0;
    if runtime == null || input0 == null || input1 == null || output == null
        || input0_bytes == 0 || input1_bytes == 0 || output_bytes == 0
        || input0_bytes > runtime.input_capacity
        || input1_bytes > runtime.input_capacity
        || output_bytes > runtime.output_capacity || lo < 0 || hi <= lo
        || repetitions <= 0 {
        cuda_record_error(20, 0 - 1);
        return 0;
    }
    if runtime.input2 == null {
        let input2_slot: **u8 = alloc(1);
        input2_slot[0] = null;
        let allocation_status: i32 = cuMemAlloc_v2(
            input2_slot, runtime.input_capacity);
        if allocation_status != 0 || input2_slot[0] == null {
            free(input2_slot as *u8);
            cuda_record_error(21, allocation_status);
            return 0;
        }
        runtime.input2 = input2_slot[0];
        free(input2_slot as *u8);
    }
    var status: i32 = cuMemcpyHtoD_v2(runtime.input, input0, input0_bytes);
    if status == 0 {
        status = cuMemcpyHtoD_v2(runtime.input2, input1, input1_bytes);
    }
    if status != 0 { cuda_record_error(22, status); return 0; }

    var device_input0: *u8 = runtime.input;
    var device_input1: *u8 = runtime.input2;
    var device_output: *u8 = runtime.output;
    var kernel_lo: i32 = lo;
    var kernel_hi: i32 = hi;
    let args: **u8 = alloc(5);
    args[0] = (&device_input0) as *u8;
    args[1] = (&device_input1) as *u8;
    args[2] = (&device_output) as *u8;
    args[3] = (&kernel_lo) as *u8;
    args[4] = (&kernel_hi) as *u8;
    var repetition: i32 = 0;
    while repetition < repetitions && status == 0 {
        status = cuLaunchKernel(runtime.function,
                                (((hi - lo) + 255) / 256) as u32,
                                1, 1, 256, 1, 1, 0, null, args, null);
        repetition = repetition + 1;
    }
    free(args as *u8);
    if status != 0 { cuda_record_error(23, status); return 0; }
    status = cuCtxSynchronize();
    if status != 0 { cuda_record_error(24, status); return 0; }
    status = cuMemcpyDtoH_v2(output, runtime.output, output_bytes);
    if status != 0 { cuda_record_error(25, status); return 0; }
    g_cuda_dispatch_count = g_cuda_dispatch_count + repetitions;
    return 1;
}

// Launches the proved private K=8 projection ABI:
//   kernel(input0, input1, output, lo, hi)
fn cuda_runtime_launch_dot_k8(runtime: *CudaRuntime,
                              input0: *u8, input0_bytes: usize,
                              input1: *u8, input1_bytes: usize,
                              output: *u8, output_bytes: usize,
                              lo: i32, hi: i32) -> i32 {
    return cuda_runtime_launch_dot_k8_repeated(
        runtime, input0, input0_bytes, input1, input1_bytes,
        output, output_bytes, lo, hi, 1);
}

// Publishes once, queues all repetitions on the default stream, then performs
// one synchronization and one output transfer.
fn cuda_runtime_launch_dot_k8_batch(runtime: *CudaRuntime,
                                    input0: *u8, input0_bytes: usize,
                                    input1: *u8, input1_bytes: usize,
                                    output: *u8, output_bytes: usize,
                                    lo: i32, hi: i32,
                                    repetitions: i32) -> i32 {
    return cuda_runtime_launch_dot_k8_repeated(
        runtime, input0, input0_bytes, input1, input1_bytes,
        output, output_bytes, lo, hi, repetitions);
}

// Launches the compiler's general device ABI, bounded by MAX_PFOR_CAP:
//   kernel(cap0, ..., capN-1, lo, hi)  with 2 <= N <= 32.
// Host slots 0..N-2 upload as inputs; slot N-1 downloads as the output.
// The caller orders host slots to the device walk order of the emitted
// kernel signature; every capture must be a pointer.
fn cuda_runtime_launch_caps(runtime: *CudaRuntime,
                            host: **u8, bytes: *usize, ncaps: i32,
                            lo: i32, hi: i32) -> i32 {
    g_cuda_error = 0;
    g_cuda_status = 0;
    if runtime == null || host == null || bytes == null
        || ncaps < 2 || ncaps > 32 || lo < 0 || hi <= lo {
        cuda_record_error(30, 0 - 1);
        return 0;
    }
    var i: i32 = 0;
    while i < ncaps {
        if host[i] == null || bytes[i] == 0
            || bytes[i] > runtime.input_capacity
            || (i == ncaps - 1 && bytes[i] > runtime.output_capacity) {
            cuda_record_error(30, 0 - 1);
            return 0;
        }
        i = i + 1;
    }

    // The device capture array persists across same-shape launches; a shape
    // change frees every slot and reallocates.
    if runtime.cap_count != ncaps {
        if runtime.caps != null {
            i = 0;
            while i < runtime.cap_count {
                if runtime.caps[i] != null { cuMemFree_v2(runtime.caps[i]); }
                i = i + 1;
            }
            free(runtime.caps as *u8);
            runtime.caps = null;
            runtime.cap_count = 0;
        }
        let slots: **u8 = alloc(ncaps);
        i = 0;
        while i < ncaps { slots[i] = null; i = i + 1; }
        i = 0;
        var allocation_status: i32 = 0;
        while i < ncaps && allocation_status == 0 {
            let slot: **u8 = alloc(1);
            slot[0] = null;
            var capacity: usize = runtime.input_capacity;
            if i == ncaps - 1 { capacity = runtime.output_capacity; }
            allocation_status = cuMemAlloc_v2(slot, capacity);
            if allocation_status == 0 && slot[0] != null {
                slots[i] = slot[0];
            } else {
                if allocation_status == 0 { allocation_status = 0 - 1; }
            }
            free(slot as *u8);
            i = i + 1;
        }
        if allocation_status != 0 {
            var j: i32 = 0;
            while j < ncaps {
                if slots[j] != null { cuMemFree_v2(slots[j]); }
                j = j + 1;
            }
            free(slots as *u8);
            cuda_record_error(31, allocation_status);
            return 0;
        }
        runtime.caps = slots;
        runtime.cap_count = ncaps;
    }

    var status: i32 = 0;
    i = 0;
    while i < ncaps - 1 && status == 0 {
        status = cuMemcpyHtoD_v2(runtime.caps[i], host[i], bytes[i]);
        i = i + 1;
    }
    if status != 0 { cuda_record_error(32, status); return 0; }

    // kernel_params is an array of addresses: args[i] points at the storage
    // that holds parameter i's value.
    let params: **u8 = alloc(ncaps);
    i = 0;
    while i < ncaps {
        params[i] = runtime.caps[i];
        i = i + 1;
    }
    var kernel_lo: i32 = lo;
    var kernel_hi: i32 = hi;
    let args: **u8 = alloc(ncaps + 2);
    i = 0;
    while i < ncaps {
        args[i] = (&params[i]) as *u8;
        i = i + 1;
    }
    args[ncaps] = (&kernel_lo) as *u8;
    args[ncaps + 1] = (&kernel_hi) as *u8;
    let groups: u32 = (((hi - lo) + 255) / 256) as u32;
    status = cuLaunchKernel(runtime.function,
                            groups, 1, 1, 256, 1, 1,
                            0, null, args, null);
    free(args as *u8);
    free(params as *u8);
    if status != 0 { cuda_record_error(33, status); return 0; }
    status = cuCtxSynchronize();
    if status != 0 { cuda_record_error(34, status); return 0; }
    status = cuMemcpyDtoH_v2(host[ncaps - 1], runtime.caps[ncaps - 1],
                             bytes[ncaps - 1]);
    if status != 0 { cuda_record_error(35, status); return 0; }
    g_cuda_dispatch_count = g_cuda_dispatch_count + 1;
    return 1;
}
