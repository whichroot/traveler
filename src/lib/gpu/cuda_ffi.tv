// SPDX-License-Identifier: Apache-2.0
// Public CUDA driver ABI floor for Traveler-owned NVIDIA device submission.
// Linux only. cuModuleLoad JIT-compiles PTX for the local GPU; no ptxas.

extern "C" fn cuInit(flags: u32) -> i32;
extern "C" fn cuDeviceGet(device_out: *i32, ordinal: i32) -> i32;
extern "C" fn cuDevicePrimaryCtxRetain(context_out: **u8, device: i32) -> i32;
extern "C" fn cuDevicePrimaryCtxRelease(device: i32) -> i32;
extern "C" fn cuCtxSetCurrent(context: *u8) -> i32;
extern "C" fn cuModuleLoad(module_out: **u8, path: *u8) -> i32;
extern "C" fn cuModuleGetFunction(function_out: **u8, module: *u8,
                                  name: *u8) -> i32;
extern "C" fn cuModuleUnload(module: *u8) -> i32;
extern "C" fn cuMemAlloc_v2(pointer_out: **u8, size: usize) -> i32;
extern "C" fn cuMemFree_v2(pointer: *u8) -> i32;
extern "C" fn cuMemcpyHtoD_v2(destination: *u8, source: *u8,
                              size: usize) -> i32;
extern "C" fn cuMemcpyDtoH_v2(destination: *u8, source: *u8,
                              size: usize) -> i32;
extern "C" fn cuLaunchKernel(function: *u8,
                             grid_x: u32, grid_y: u32, grid_z: u32,
                             block_x: u32, block_y: u32, block_z: u32,
                             shared_bytes: u32, stream: *u8,
                             kernel_params: **u8, extra: **u8) -> i32;
extern "C" fn cuCtxSynchronize() -> i32;
extern "C" fn cuCtxGetCurrent(context_out: **u8) -> i32;
extern "C" fn cuDeviceGetAttribute(value_out: *i32, attribute: i32, device: i32) -> i32;
extern "C" fn cuModuleLoadDataEx(module_out: **u8, image: *u8, count: u32,
                                 options: *i32, values: **u8) -> i32;
extern "C" fn cuFuncGetAttribute(value_out: *i32, attribute: i32, function: *u8) -> i32;

// Registered host memory: a device reads the pinned host pages directly.
// flags=2 is CU_MEMHOSTREGISTER_DEVICEMAP, the cuMemHostGetDevicePointer form.
// The driver refuses file-backed mappings; stage through cuMemHostAlloc.
extern "C" fn cuMemHostRegister_v2(pointer: *u8, size: usize,
                                   flags: u32) -> i32;
extern "C" fn cuMemHostGetDevicePointer(device_out: **u8, host: *u8,
                                        flags: u32) -> i32;
extern "C" fn cuMemHostUnregister(pointer: *u8) -> i32;

// Driver-allocated pinned host memory. flags=2 is CU_MEMHOSTALLOC_DEVICEMAP;
// under UVA the host pointer is device-accessible as-is.
extern "C" fn cuMemHostAlloc(pointer_out: **u8, size: usize,
                             flags: u32) -> i32;
extern "C" fn cuMemFreeHost(pointer: *u8) -> i32;
