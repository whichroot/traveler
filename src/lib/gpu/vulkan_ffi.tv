// SPDX-License-Identifier: Apache-2.0
// Public Vulkan 1.0 C ABI used by Traveler's compute runtime.

let VK_SUCCESS: i32 = 0;
let VK_STRUCTURE_TYPE_APPLICATION_INFO: i32 = 0;
let VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO: i32 = 1;
let VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO: i32 = 2;
let VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO: i32 = 3;
let VK_STRUCTURE_TYPE_SUBMIT_INFO: i32 = 4;
let VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO: i32 = 5;
let VK_STRUCTURE_TYPE_FENCE_CREATE_INFO: i32 = 8;
let VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO: i32 = 12;
let VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO: i32 = 16;
let VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO: i32 = 18;
let VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO: i32 = 29;
let VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO: i32 = 30;
let VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO: i32 = 32;
let VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO: i32 = 33;
let VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO: i32 = 34;
let VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET: i32 = 35;
let VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO: i32 = 39;
let VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO: i32 = 40;
let VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO: i32 = 42;
let VK_STRUCTURE_TYPE_MEMORY_BARRIER: i32 = 46;

let VK_QUEUE_COMPUTE_BIT: u32 = 2;
let VK_BUFFER_USAGE_STORAGE_BUFFER_BIT: u32 = 0x20;
let VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT: u32 = 1;
let VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT: u32 = 2;
let VK_MEMORY_PROPERTY_HOST_COHERENT_BIT: u32 = 4;
let VK_MEMORY_PROPERTY_HOST_CACHED_BIT: u32 = 8;
let VK_SHADER_STAGE_COMPUTE_BIT: u32 = 0x20;
let VK_DESCRIPTOR_TYPE_STORAGE_BUFFER: i32 = 7;
let VK_PIPELINE_BIND_POINT_COMPUTE: i32 = 1;
let VK_SHARING_MODE_EXCLUSIVE: i32 = 0;
let VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT: u32 = 2;
let VK_COMMAND_BUFFER_LEVEL_PRIMARY: i32 = 0;
let VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT: u32 = 1;
let VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT: u32 = 0x800;
let VK_ACCESS_SHADER_WRITE_BIT: u32 = 0x40;

struct VkApplicationInfo {
    sType: i32,
    pNext: *u8,
    pApplicationName: *u8,
    applicationVersion: u32,
    pEngineName: *u8,
    engineVersion: u32,
    apiVersion: u32,
}

struct VkInstanceCreateInfo {
    sType: i32,
    pNext: *u8,
    flags: u32,
    pApplicationInfo: *VkApplicationInfo,
    enabledLayerCount: u32,
    ppEnabledLayerNames: **u8,
    enabledExtensionCount: u32,
    ppEnabledExtensionNames: **u8,
}

struct VkDeviceQueueCreateInfo {
    sType: i32,
    pNext: *u8,
    flags: u32,
    queueFamilyIndex: u32,
    queueCount: u32,
    pQueuePriorities: *u32,
}

struct VkDeviceCreateInfo {
    sType: i32,
    pNext: *u8,
    flags: u32,
    queueCreateInfoCount: u32,
    pQueueCreateInfos: *VkDeviceQueueCreateInfo,
    enabledLayerCount: u32,
    ppEnabledLayerNames: **u8,
    enabledExtensionCount: u32,
    ppEnabledExtensionNames: **u8,
    pEnabledFeatures: *u8,
}

struct VkBufferCreateInfo {
    sType: i32,
    pNext: *u8,
    flags: u32,
    size: u64,
    usage: u32,
    sharingMode: i32,
    queueFamilyIndexCount: u32,
    pQueueFamilyIndices: *u32,
}

struct VkMemoryAllocateInfo {
    sType: i32,
    pNext: *u8,
    allocationSize: u64,
    memoryTypeIndex: u32,
}

struct VkShaderModuleCreateInfo {
    sType: i32,
    pNext: *u8,
    flags: u32,
    codeSize: usize,
    pCode: *u32,
}

struct VkDescriptorSetLayoutBinding {
    binding: u32,
    descriptorType: i32,
    descriptorCount: u32,
    stageFlags: u32,
    pImmutableSamplers: **u8,
}

struct VkDescriptorSetLayoutCreateInfo {
    sType: i32,
    pNext: *u8,
    flags: u32,
    bindingCount: u32,
    pBindings: *VkDescriptorSetLayoutBinding,
}

struct VkPushConstantRange {
    stageFlags: u32,
    offset: u32,
    size: u32,
}

struct VkPipelineLayoutCreateInfo {
    sType: i32,
    pNext: *u8,
    flags: u32,
    setLayoutCount: u32,
    pSetLayouts: **u8,
    pushConstantRangeCount: u32,
    pPushConstantRanges: *VkPushConstantRange,
}

struct VkPipelineShaderStageCreateInfo {
    sType: i32,
    pNext: *u8,
    flags: u32,
    stage: u32,
    module: *u8,
    pName: *u8,
    pSpecializationInfo: *u8,
}

struct VkComputePipelineCreateInfo {
    sType: i32,
    pNext: *u8,
    flags: u32,
    stagePadding: u32,
    stageSType: i32,
    stagePNext: *u8,
    stageFlags: u32,
    stageStage: u32,
    stageModule: *u8,
    stagePName: *u8,
    stagePSpecializationInfo: *u8,
    layout: *u8,
    basePipelineHandle: *u8,
    basePipelineIndex: i32,
}

struct VkDescriptorPoolSize {
    descriptorType: i32,
    descriptorCount: u32,
}

struct VkDescriptorPoolCreateInfo {
    sType: i32,
    pNext: *u8,
    flags: u32,
    maxSets: u32,
    poolSizeCount: u32,
    pPoolSizes: *VkDescriptorPoolSize,
}

struct VkDescriptorSetAllocateInfo {
    sType: i32,
    pNext: *u8,
    descriptorPool: *u8,
    descriptorSetCount: u32,
    pSetLayouts: **u8,
}

struct VkDescriptorBufferInfo {
    buffer: *u8,
    offset: u64,
    range: u64,
}

struct VkWriteDescriptorSet {
    sType: i32,
    pNext: *u8,
    dstSet: *u8,
    dstBinding: u32,
    dstArrayElement: u32,
    descriptorCount: u32,
    descriptorType: i32,
    pImageInfo: *u8,
    pBufferInfo: *VkDescriptorBufferInfo,
    pTexelBufferView: *u8,
}

struct VkCommandPoolCreateInfo {
    sType: i32,
    pNext: *u8,
    flags: u32,
    queueFamilyIndex: u32,
}

struct VkCommandBufferAllocateInfo {
    sType: i32,
    pNext: *u8,
    commandPool: *u8,
    level: i32,
    commandBufferCount: u32,
}

struct VkCommandBufferBeginInfo {
    sType: i32,
    pNext: *u8,
    flags: u32,
    pInheritanceInfo: *u8,
}

struct VkSubmitInfo {
    sType: i32,
    pNext: *u8,
    waitSemaphoreCount: u32,
    pWaitSemaphores: **u8,
    pWaitDstStageMask: *u32,
    commandBufferCount: u32,
    pCommandBuffers: **u8,
    signalSemaphoreCount: u32,
    pSignalSemaphores: **u8,
}

struct VkFenceCreateInfo {
    sType: i32,
    pNext: *u8,
    flags: u32,
}

struct VkMemoryBarrier {
    sType: i32,
    pNext: *u8,
    srcAccessMask: u32,
    dstAccessMask: u32,
}

extern "C" fn vkCreateInstance(info: *VkInstanceCreateInfo, allocator: *u8,
                                instance: **u8) -> i32;
extern "C" fn vkDestroyInstance(instance: *u8, allocator: *u8);
extern "C" fn vkEnumeratePhysicalDevices(instance: *u8, count: *u32,
                                           devices: **u8) -> i32;
extern "C" fn vkGetPhysicalDeviceProperties(device: *u8, properties: *u8);
extern "C" fn vkGetPhysicalDeviceFeatures(device: *u8, features: *u8);
extern "C" fn vkGetPhysicalDeviceQueueFamilyProperties(device: *u8,
                                                         count: *u32,
                                                         properties: *u8);
extern "C" fn vkGetPhysicalDeviceMemoryProperties(device: *u8,
                                                    properties: *u8);
extern "C" fn vkCreateDevice(physical: *u8, info: *VkDeviceCreateInfo,
                              allocator: *u8, device: **u8) -> i32;
extern "C" fn vkDestroyDevice(device: *u8, allocator: *u8);
extern "C" fn vkGetDeviceQueue(device: *u8, family: u32, index: u32,
                                queue: **u8);
extern "C" fn vkDeviceWaitIdle(device: *u8) -> i32;

extern "C" fn vkCreateBuffer(device: *u8, info: *VkBufferCreateInfo,
                              allocator: *u8, buffer: **u8) -> i32;
extern "C" fn vkDestroyBuffer(device: *u8, buffer: *u8, allocator: *u8);
extern "C" fn vkGetBufferMemoryRequirements(device: *u8, buffer: *u8,
                                              requirements: *u8);
extern "C" fn vkAllocateMemory(device: *u8, info: *VkMemoryAllocateInfo,
                                allocator: *u8, memory: **u8) -> i32;
extern "C" fn vkFreeMemory(device: *u8, memory: *u8, allocator: *u8);
extern "C" fn vkBindBufferMemory(device: *u8, buffer: *u8, memory: *u8,
                                  offset: u64) -> i32;
extern "C" fn vkMapMemory(device: *u8, memory: *u8, offset: u64, size: u64,
                           flags: u32, data: **u8) -> i32;
extern "C" fn vkUnmapMemory(device: *u8, memory: *u8);

extern "C" fn vkCreateShaderModule(device: *u8,
                                    info: *VkShaderModuleCreateInfo,
                                    allocator: *u8, module: **u8) -> i32;
extern "C" fn vkDestroyShaderModule(device: *u8, module: *u8,
                                     allocator: *u8);
extern "C" fn vkCreateDescriptorSetLayout(device: *u8,
                                           info: *VkDescriptorSetLayoutCreateInfo,
                                           allocator: *u8, layout: **u8) -> i32;
extern "C" fn vkDestroyDescriptorSetLayout(device: *u8, layout: *u8,
                                            allocator: *u8);
extern "C" fn vkCreatePipelineLayout(device: *u8,
                                      info: *VkPipelineLayoutCreateInfo,
                                      allocator: *u8, layout: **u8) -> i32;
extern "C" fn vkDestroyPipelineLayout(device: *u8, layout: *u8,
                                       allocator: *u8);
extern "C" fn vkCreateComputePipelines(device: *u8, cache: *u8, count: u32,
                                        infos: *VkComputePipelineCreateInfo,
                                        allocator: *u8, pipelines: **u8) -> i32;
extern "C" fn vkDestroyPipeline(device: *u8, pipeline: *u8, allocator: *u8);

extern "C" fn vkCreateDescriptorPool(device: *u8,
                                      info: *VkDescriptorPoolCreateInfo,
                                      allocator: *u8, pool: **u8) -> i32;
extern "C" fn vkDestroyDescriptorPool(device: *u8, pool: *u8, allocator: *u8);
extern "C" fn vkAllocateDescriptorSets(device: *u8,
                                        info: *VkDescriptorSetAllocateInfo,
                                        sets: **u8) -> i32;
extern "C" fn vkUpdateDescriptorSets(device: *u8, write_count: u32,
                                      writes: *VkWriteDescriptorSet,
                                      copy_count: u32, copies: *u8);

extern "C" fn vkCreateCommandPool(device: *u8,
                                   info: *VkCommandPoolCreateInfo,
                                   allocator: *u8, pool: **u8) -> i32;
extern "C" fn vkDestroyCommandPool(device: *u8, pool: *u8, allocator: *u8);
extern "C" fn vkAllocateCommandBuffers(device: *u8,
                                        info: *VkCommandBufferAllocateInfo,
                                        buffers: **u8) -> i32;
extern "C" fn vkResetCommandBuffer(command: *u8, flags: u32) -> i32;
extern "C" fn vkBeginCommandBuffer(command: *u8,
                                    info: *VkCommandBufferBeginInfo) -> i32;
extern "C" fn vkEndCommandBuffer(command: *u8) -> i32;
extern "C" fn vkCmdBindPipeline(command: *u8, bind_point: i32,
                                 pipeline: *u8);
extern "C" fn vkCmdBindDescriptorSets(command: *u8, bind_point: i32,
                                       layout: *u8, first_set: u32,
                                       set_count: u32, sets: **u8,
                                       dynamic_offset_count: u32,
                                       dynamic_offsets: *u32);
extern "C" fn vkCmdPushConstants(command: *u8, layout: *u8,
                                  stage_flags: u32, offset: u32, size: u32,
                                  values: *u8);
extern "C" fn vkCmdDispatch(command: *u8, x: u32, y: u32, z: u32);
extern "C" fn vkCmdPipelineBarrier(command: *u8,
                                     source_stage_mask: u32,
                                     destination_stage_mask: u32,
                                     dependency_flags: u32,
                                     memory_barrier_count: u32,
                                     memory_barriers: *VkMemoryBarrier,
                                     buffer_memory_barrier_count: u32,
                                     buffer_memory_barriers: *u8,
                                     image_memory_barrier_count: u32,
                                     image_memory_barriers: *u8);
extern "C" fn vkQueueSubmit(queue: *u8, submit_count: u32,
                             submits: *VkSubmitInfo, fence: *u8) -> i32;

extern "C" fn vkCreateFence(device: *u8, info: *VkFenceCreateInfo,
                             allocator: *u8, fence: **u8) -> i32;
extern "C" fn vkDestroyFence(device: *u8, fence: *u8, allocator: *u8);
extern "C" fn vkResetFences(device: *u8, count: u32, fences: **u8) -> i32;
extern "C" fn vkWaitForFences(device: *u8, count: u32, fences: **u8,
                               wait_all: u32, timeout: u64) -> i32;
