// ===== ROUND CONSTANTS (Goldilocks, Plonky3) =====

#[export]
fn fill_rc(rc_init: *i64, rc_term: *i64, rc_int: *i64) {
    rc_init[0]  = 0xdd5743e7f2a5a5d9; rc_init[1]  = 0xcb3a864e58ada44b;
    rc_init[2]  = 0xffa2449ed32f8cdc; rc_init[3]  = 0x42025f65d6bd13ee;
    rc_init[4]  = 0x7889175e25506323; rc_init[5]  = 0x34b98bb03d24b737;
    rc_init[6]  = 0xbdcc535ecc4faa2a; rc_init[7]  = 0x5b20ad869fc0d033;
    rc_init[8]  = 0xf1dda5b9259dfcb4; rc_init[9]  = 0x27515210be112d59;
    rc_init[10] = 0x4227d1718c766c3f; rc_init[11] = 0x26d333161a5bd794;
    rc_init[12] = 0x49b938957bf4b026; rc_init[13] = 0x4a56b5938b213669;
    rc_init[14] = 0x1120426b48c8353d; rc_init[15] = 0x6b323c3f10a56cad;
    rc_init[16] = 0xce57d6245ddca6b2; rc_init[17] = 0xb1fc8d402bba1eb1;
    rc_init[18] = 0xb5c5096ca959bd04; rc_init[19] = 0x6db55cd306d31f7f;
    rc_init[20] = 0xc49d293a81cb9641; rc_init[21] = 0x1ce55a4fe979719f;
    rc_init[22] = 0xa92e60a9d178a4d1; rc_init[23] = 0x002cc64973bcfd8c;
