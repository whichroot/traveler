// plonk_dyn.tv — dynamic-field PLONK: the full stack (coset NTT + Poseidon2 +
// Merkle + transcript + FRI + PLONK) generic <F: Field>, instantiated <dyn>
// over a runtime prime via field(p). tvc_self-only.
// @internal-design: crypto (incl. the raw-literal bug class)

// ===== GENERIC NTT (forward + coset forward; uses carrier roots) =====

fn bit_rev(x: i32, bits: i32) -> i32 {
    var r: i32 = 0;
    var v: i32 = x;
    for i in 0..bits {
        r = (r << 1) | (v & 1);
        v = v >> 1;
    }
    return r;
}

fn bit_reverse_swap<F: Field>(data: *F, log_n: i32) {
    let n: i32 = 1 << log_n;
    for i in 0..n {
        let j: i32 = bit_rev(i, log_n);
        if i < j {
            let tmp: F = data[i];
            data[i] = data[j];
            data[j] = tmp;
        }
    }
}

fn ntt_forward<F: Field>(data: *F, log_n: i32) {
    let n: i32 = 1 << log_n;
    bit_reverse_swap(data, log_n);
    for s in 0..log_n {
        let m: i32 = 1 << (s + 1);
        let half: i32 = m / 2;
        let omega_m: F = __ntt_root(s);
        var k: i32 = 0;
        while k < n {
            var w: F = 1;
            for j in 0..half {
                let u: F = data[k + j];
                let v: F = w * data[k + j + half];
                data[k + j] = u + v;
                data[k + j + half] = u - v;
                w = w * omega_m;
            }
            k = k + m;
        }
    }
}

fn ntt_coset_forward<F: Field>(data: *F, log_n: i32, shift: F) {
    let n: i32 = 1 << log_n;
    let sp: *F = alloc(n);
    sp[0] = 1;
    for i in 1..n {
        sp[i] = sp[i - 1] * shift;
    }
    for i in 0..n {
        data[i] = data[i] * sp[i];
    }
    free(sp);
    ntt_forward(data, log_n);
}

fn ntt_inverse<F: Field>(data: *F, log_n: i32) {
    let n: i32 = 1 << log_n;
    bit_reverse_swap(data, log_n);
    for s in 0..log_n {
        let m: i32 = 1 << (s + 1);
        let half: i32 = m / 2;
        let omega_m: F = __ntt_inv_root(s);
        var k: i32 = 0;
        while k < n {
            var w: F = 1;
            for j in 0..half {
                let u: F = data[k + j];
                let v: F = w * data[k + j + half];
                data[k + j] = u + v;
                data[k + j + half] = u - v;
                w = w * omega_m;
            }
            k = k + m;
        }
    }
    let scale: F = __ntt_n_inv(log_n - 1);
    for i in 0..n {
        data[i] = data[i] * scale;
    }
}

fn ntt_coset_inverse<F: Field>(data: *F, log_n: i32, shift: F) {
    ntt_inverse(data, log_n);
    let shift_inv: F = 1 / shift;
    let n: i32 = 1 << log_n;
    let sp: *F = alloc(n);
    sp[0] = 1;
    for i in 1..n {
        sp[i] = sp[i - 1] * shift_inv;
    }
    for i in 0..n {
        data[i] = data[i] * sp[i];
    }
    free(sp);
}

// ===== GENERIC POSEIDON2 (permutation + compression + field-term diag) =====

fn sbox7<F: Field>(x: F) -> F {
    let x2: F = x * x;
    let x4: F = x2 * x2;
    let x7: F = x4 * x2 * x;
    return x7;
}

fn mds_mat4<F: Field>(s: *F) {
    let s0: F = s[0]; let s1: F = s[1]; let s2: F = s[2]; let s3: F = s[3];
    let t01: F  = s0 + s1;
    let t23: F  = s2 + s3;
    let t0123: F = t01 + t23;
    let t01123: F = t0123 + s1;
    let t01233: F = t0123 + s3;
    s[0] = t01123 + t01;
    s[1] = t01123 + s2 + s2;
    s[2] = t01233 + t23;
    s[3] = t01233 + s0 + s0;
}

fn mds_external_8<F: Field>(state: *F) {
    mds_mat4(state);
    let hi: *F = &state[4];
    mds_mat4(hi);
    let sum0: F = state[0] + state[4];
    let sum1: F = state[1] + state[5];
    let sum2: F = state[2] + state[6];
    let sum3: F = state[3] + state[7];
    state[0] = state[0] + sum0;
    state[1] = state[1] + sum1;
    state[2] = state[2] + sum2;
    state[3] = state[3] + sum3;
    state[4] = state[4] + sum0;
    state[5] = state[5] + sum1;
    state[6] = state[6] + sum2;
    state[7] = state[7] + sum3;
}

fn mds_internal_8<F: Field>(state: *F, diag: *F) {
    var sum: F = state[0];
    for i in 1..8 {
        sum = sum + state[i];
    }
    for i in 0..8 {
        state[i] = state[i] * diag[i] + sum;
    }
}

fn poseidon2_permute_8<F: Field>(
    state: *F, rc_init: *F, rc_term: *F, rc_int: *F, diag: *F
) {
    mds_external_8(state);
    for r in 0..4 {
        let base: i32 = r * 8;
        for i in 0..8 { state[i] = state[i] + rc_init[base + i]; }
        for i in 0..8 { state[i] = sbox7(state[i]); }
        mds_external_8(state);
    }
    for r in 0..22 {
        state[0] = state[0] + rc_int[r];
        state[0] = sbox7(state[0]);
        mds_internal_8(state, diag);
    }
    for r in 0..4 {
        let base: i32 = r * 8;
        for i in 0..8 { state[i] = state[i] + rc_term[base + i]; }
        for i in 0..8 { state[i] = sbox7(state[i]); }
        mds_external_8(state);
    }
}

fn poseidon2_compress<F: Field>(
    left: *F, right: *F, out: *F,
    rc_init: *F, rc_term: *F, rc_int: *F, diag: *F
) {
    let state: *F = alloc(8);
    for i in 0..4 { state[i] = left[i]; }
    for i in 0..4 { state[4 + i] = right[i]; }
    poseidon2_permute_8(state, rc_init, rc_term, rc_int, diag);
    for i in 0..4 { out[i] = state[i]; }
    free(state);
}

fn poseidon2_diag<F: Field>(diag: *F) {
    let zero: F = 0;
    let one: F = 1;
    let two: F = 2;
    let three: F = 3;
    let four: F = 4;
    let half: F = one / two;
    diag[0] = zero - two;
    diag[1] = one;
    diag[2] = two;
    diag[3] = half;
    diag[4] = three;
    diag[5] = zero - half;
    diag[6] = zero - three;
    diag[7] = zero - four;
}

// ===== GENERIC MERKLE =====

fn merkle_build<F: Field>(
    leaves: *F, n_leaves: i32, tree: *F,
    rc_init: *F, rc_term: *F, rc_int: *F, diag: *F
) {
    for i in 0..n_leaves {
        let src: i32 = i * 4;
        let dst: i32 = (n_leaves + i) * 4;
        for j in 0..4 { tree[dst + j] = leaves[src + j]; }
    }
    var k: i32 = n_leaves - 1;
    while k >= 1 {
        let left: *F = &tree[(2 * k) * 4];
        let right: *F = &tree[(2 * k + 1) * 4];
        let out: *F = &tree[k * 4];
        poseidon2_compress(left, right, out, rc_init, rc_term, rc_int, diag);
        k = k - 1;
    }
}

fn merkle_open<F: Field>(tree: *F, n_leaves: i32, idx: i32, path: *F) -> i32 {
    var pos: i32 = n_leaves + idx;
    var depth: i32 = 0;
    while pos > 1 {
        let sibling: i32 = pos ^ 1;
        let src: i32 = sibling * 4;
        let dst: i32 = depth * 4;
        for j in 0..4 { path[dst + j] = tree[src + j]; }
        pos = pos / 2;
        depth = depth + 1;
    }
    return depth;
}

fn merkle_verify<F: Field>(
    root: *F, leaf: *F, idx: i32, n_leaves: i32,
    path: *F, path_len: i32,
    rc_init: *F, rc_term: *F, rc_int: *F, diag: *F
) -> i32 {
    let current: *F = alloc(4);
    let tmp: *F = alloc(4);
    for j in 0..4 { current[j] = leaf[j]; }
    var pos: i32 = n_leaves + idx;
    for d in 0..path_len {
        let sib: *F = &path[d * 4];
        if (pos & 1) == 0 {
            poseidon2_compress(current, sib, tmp, rc_init, rc_term, rc_int, diag);
        } else {
            poseidon2_compress(sib, current, tmp, rc_init, rc_term, rc_int, diag);
        }
        for j in 0..4 { current[j] = tmp[j]; }
        pos = pos / 2;
    }
    var ok: i32 = 1;
    for j in 0..4 {
        if current[j] != root[j] { ok = 0; }
    }
    free(current);
    free(tmp);
    return ok;
}

// ===== GENERIC FRI: transcript, hashing, fold, twiddle, prove, verify =====

fn transcript_init<F: Field>(state: *F) {
    for i in 0..8 { state[i] = 0; }
}

fn transcript_absorb<F: Field>(
    state: *F, absorb_pos: *i32, input: *F, n: i32,
    rc_init: *F, rc_term: *F, rc_int: *F, diag: *F
) {
    for i in 0..n {
        let pos: i32 = absorb_pos[0];
        state[pos] = state[pos] + input[i];
        absorb_pos[0] = pos + 1;
        if absorb_pos[0] == 4 {
            poseidon2_permute_8(state, rc_init, rc_term, rc_int, diag);
            absorb_pos[0] = 0;
        }
    }
}

fn transcript_squeeze<F: Field>(
    state: *F, absorb_pos: *i32, out: *F, n: i32,
    rc_init: *F, rc_term: *F, rc_int: *F, diag: *F
) {
    if absorb_pos[0] != 0 {
        poseidon2_permute_8(state, rc_init, rc_term, rc_int, diag);
        absorb_pos[0] = 0;
    }
    var squeeze_pos: i32 = 0;
    for i in 0..n {
        if squeeze_pos == 4 {
            poseidon2_permute_8(state, rc_init, rc_term, rc_int, diag);
            squeeze_pos = 0;
        }
        out[i] = state[squeeze_pos];
        squeeze_pos = squeeze_pos + 1;
    }
}

fn fri_hash_pair<F: Field>(
    v_left: F, v_right: F, out: *F,
    rc_init: *F, rc_term: *F, rc_int: *F, diag: *F
) {
    let state: *F = alloc(8);
    state[0] = v_left;
    state[1] = v_right;
    for i in 2..8 { state[i] = 0; }
    poseidon2_permute_8(state, rc_init, rc_term, rc_int, diag);
    for i in 0..4 { out[i] = state[i]; }
    free(state);
}

fn fri_hash_layer<F: Field>(
    evals: *F, n: i32, digests: *F,
    rc_init: *F, rc_term: *F, rc_int: *F, diag: *F
) {
    let half: i32 = n / 2;
    for i in 0..half {
        let out: *F = &digests[i * 4];
        fri_hash_pair(evals[i], evals[i + half], out,
            rc_init, rc_term, rc_int, diag);
    }
}

fn fri_fold_layer<F: Field>(
    evals: *F, log_n: i32, beta: F, shift: F, folded: *F
) {
    let n: i32 = 1 << log_n;
    let half: i32 = n / 2;
    let inv2: F = 1 / 2;
    let inv_tw: *F = alloc(half);
    let inv_shift: F = 1 / shift;
    let inv_omega: F = __ntt_inv_root(log_n - 1);
    inv_tw[0] = inv_shift;
    for i in 1..half {
        inv_tw[i] = inv_tw[i - 1] * inv_omega;
    }
    for i in 0..half {
        let sum: F = evals[i] + evals[i + half];
        let diff: F = evals[i] - evals[i + half];
        folded[i] = (sum + beta * diff * inv_tw[i]) * inv2;
    }
    free(inv_tw);
}

fn fri_twiddle<F: Field>(pair_idx: i32, log_n: i32, shift: F) -> F {
    let omega: F = __ntt_root(log_n - 1);
    var w: F = 1;
    var base: F = omega;
    var exp: i32 = pair_idx;
    while exp > 0 {
        if (exp & 1) == 1 {
            w = w * base;
        }
        base = base * base;
        exp = exp >> 1;
    }
    return shift * w;
}

fn fri_prove<F: Field>(
    coeffs: *F, degree: i32, log_blowup: i32, shift: F, num_queries: i32,
    roots: *F, challenges: *F, final_poly: *F,
    query_values: *F, query_paths: *F, query_indices: *i32,
    rc_init: *F, rc_term: *F, rc_int: *F, diag: *F
) -> i32 {
    var log_n: i32 = 0;
    var tmp: i32 = degree;
    while tmp > 0 {
        log_n = log_n + 1;
        tmp = tmp >> 1;
    }
    log_n = log_n + log_blowup;
    let n: i32 = 1 << log_n;
    let max_total: i32 = 2 * n;
    let all_evals: *F = alloc(max_total);

    for i in 0..(degree + 1) { all_evals[i] = coeffs[i]; }
    for i in (degree + 1)..n { all_evals[i] = 0; }
    ntt_coset_forward(all_evals, log_n, shift);

    let ts: *F = alloc(8);
    let ts_pos: *i32 = alloc(1);
    transcript_init(ts);
    ts_pos[0] = 0;

    let max_depth: i32 = log_n;
    var cur_off: i32 = 0;
    var cur_log: i32 = log_n;
    var n_rounds: i32 = 0;
    var cur_shift: F = shift;

    let digests: *F = alloc((n / 2) * 4);
    let tree: *F = alloc(n * 4);

    while (1 << cur_log) > 1 {
        let cur_n: i32 = 1 << cur_log;
        let n_leaves: i32 = cur_n / 2;
        let cur_evals: *F = &all_evals[cur_off];

        fri_hash_layer(cur_evals, cur_n, digests, rc_init, rc_term, rc_int, diag);
        merkle_build(digests, n_leaves, tree, rc_init, rc_term, rc_int, diag);
        let root: *F = &tree[4];
        for j in 0..4 { roots[n_rounds * 4 + j] = root[j]; }

        transcript_absorb(ts, ts_pos, root, 4, rc_init, rc_term, rc_int, diag);

        let challenge: *F = alloc(1);
        transcript_squeeze(ts, ts_pos, challenge, 1, rc_init, rc_term, rc_int, diag);
        challenges[n_rounds] = challenge[0];

        if (1 << (cur_log - 1)) > 1 {
            let next_off: i32 = cur_off + cur_n;
            let next_evals: *F = &all_evals[next_off];
            fri_fold_layer(cur_evals, cur_log, challenge[0], cur_shift, next_evals);
            cur_off = next_off;
        } else {
            let next: *F = alloc(1);
            fri_fold_layer(cur_evals, cur_log, challenge[0], cur_shift, next);
            final_poly[0] = next[0];
            free(next);
        }

        free(challenge);
        cur_shift = cur_shift * cur_shift;
        cur_log = cur_log - 1;
        n_rounds = n_rounds + 1;
    }

    let q_raw: *F = alloc(num_queries);
    transcript_squeeze(ts, ts_pos, q_raw, num_queries, rc_init, rc_term, rc_int, diag);
    for q in 0..num_queries {
        let idx: i32 = q_raw[q] as i32;
        let mask: i32 = (1 << log_n) - 1;
        query_indices[q] = idx & mask;
    }
    free(q_raw);

    var rnd_off: i32 = 0;
    var rnd_log: i32 = log_n;
    for r in 0..n_rounds {
        let rnd_n: i32 = 1 << rnd_log;
        let rnd_leaves: i32 = rnd_n / 2;
        let rnd_evals: *F = &all_evals[rnd_off];

        fri_hash_layer(rnd_evals, rnd_n, digests, rc_init, rc_term, rc_int, diag);
        merkle_build(digests, rnd_leaves, tree, rc_init, rc_term, rc_int, diag);

        for q in 0..num_queries {
            let qi: i32 = query_indices[q];
            let rnd_half: i32 = rnd_n / 2;
            let pair_idx: i32 = qi & (rnd_half - 1);

            let v_off: i32 = (q * n_rounds + r) * 2;
            query_values[v_off] = rnd_evals[pair_idx];
            query_values[v_off + 1] = rnd_evals[pair_idx + rnd_half];

            let path_off: i32 = (q * n_rounds + r) * max_depth * 4;
            let path_buf: *F = &query_paths[path_off];
            merkle_open(tree, rnd_leaves, pair_idx, path_buf);
        }

        rnd_off = rnd_off + rnd_n;
        rnd_log = rnd_log - 1;
    }

    free(all_evals);
    free(digests);
    free(tree);
    free(ts);
    free(ts_pos);
    return n_rounds;
}

fn fri_verify<F: Field>(
    degree: i32, log_blowup: i32, shift: F, num_queries: i32, n_rounds: i32,
    roots: *F, challenges: *F, final_poly: *F,
    query_values: *F, query_paths: *F, query_indices: *i32,
    rc_init: *F, rc_term: *F, rc_int: *F, diag: *F
) -> i32 {
    var log_n: i32 = 0;
    var tmp: i32 = degree;
    while tmp > 0 {
        log_n = log_n + 1;
        tmp = tmp >> 1;
    }
    log_n = log_n + log_blowup;
    let max_depth: i32 = log_n;

    let ts: *F = alloc(8);
    let ts_pos: *i32 = alloc(1);
    transcript_init(ts);
    ts_pos[0] = 0;

    let challenge_check: *F = alloc(1);
    for r in 0..n_rounds {
        let root: *F = &roots[r * 4];
        transcript_absorb(ts, ts_pos, root, 4, rc_init, rc_term, rc_int, diag);
        transcript_squeeze(ts, ts_pos, challenge_check, 1, rc_init, rc_term, rc_int, diag);
        if challenge_check[0] != challenges[r] {
            free(ts); free(ts_pos); free(challenge_check);
            return 0;
        }
    }

    let q_raw: *F = alloc(num_queries);
    transcript_squeeze(ts, ts_pos, q_raw, num_queries, rc_init, rc_term, rc_int, diag);
    let mask: i32 = (1 << log_n) - 1;
    for q in 0..num_queries {
        let expected_idx: i32 = (q_raw[q] as i32) & mask;
        if expected_idx != query_indices[q] {
            free(ts); free(ts_pos); free(challenge_check);
            free(q_raw);
            return 0;
        }
    }
    free(q_raw);
    free(challenge_check);
    free(ts);
    free(ts_pos);

    let inv2: F = 1 / 2;
    let leaf_digest: *F = alloc(4);

    for q in 0..num_queries {
        let qi: i32 = query_indices[q];
        var cur_shift: F = shift;
        var cur_log: i32 = log_n;

        for r in 0..n_rounds {
            let cur_half: i32 = (1 << cur_log) / 2;
            let pair_idx: i32 = qi & (cur_half - 1);
            let v_off: i32 = (q * n_rounds + r) * 2;
            let v_left: F = query_values[v_off];
            let v_right: F = query_values[v_off + 1];

            fri_hash_pair(v_left, v_right, leaf_digest, rc_init, rc_term, rc_int, diag);

            let rnd_n: i32 = 1 << cur_log;
            let rnd_leaves: i32 = rnd_n / 2;
            let path_off: i32 = (q * n_rounds + r) * max_depth * 4;
            let path_buf: *F = &query_paths[path_off];
            let root: *F = &roots[r * 4];

            var path_len: i32 = 0;
            var pl_tmp: i32 = rnd_leaves;
            while pl_tmp > 1 {
                path_len = path_len + 1;
                pl_tmp = pl_tmp / 2;
            }

            let mk_ok: i32 = merkle_verify(
                root, leaf_digest, pair_idx, rnd_leaves,
                path_buf, path_len, rc_init, rc_term, rc_int, diag);
            if mk_ok != 1 {
                free(leaf_digest);
                return 0;
            }

            let tw: F = fri_twiddle(pair_idx, cur_log, cur_shift);
            let inv_tw: F = 1 / tw;
            let beta: F = challenges[r];

            let sum: F = v_left + v_right;
            let diff: F = v_left - v_right;
            let expected: F = (sum + beta * diff * inv_tw) * inv2;

            if r < n_rounds - 1 {
                let next_half: i32 = cur_half / 2;
                let next_v_off: i32 = (q * n_rounds + (r + 1)) * 2;
                let actual_left: F = query_values[next_v_off];
                let actual_right: F = query_values[next_v_off + 1];
                if pair_idx < next_half {
                    if expected != actual_left {
                        free(leaf_digest);
                        return 0;
                    }
                } else {
                    if expected != actual_right {
                        free(leaf_digest);
                        return 0;
                    }
                }
            } else {
                if expected != final_poly[0] {
                    free(leaf_digest);
                    return 0;
                }
            }

            cur_shift = cur_shift * cur_shift;
            cur_log = cur_log - 1;
        }
    }

    free(leaf_digest);
    return 1;
}

// ===== GENERIC PLONK (carrier-derived omega/cosets) =====

fn fmul<F: Field>(a: F, b: F) -> F { return a * b; }
fn fadd<F: Field>(a: F, b: F) -> F { return a + b; }
fn fsub<F: Field>(a: F, b: F) -> F { return a - b; }

fn poly_eval<F: Field>(coeffs: *F, degree: i32, x: F) -> F {
    var result: F = coeffs[degree];
    var i: i32 = degree - 1;
    while i >= 0 {
        result = result * x + coeffs[i];
        i = i - 1;
    }
    return result;
}

// Primitive 2^log_n-th root of unity from the carrier root chain:
// __ntt_root(log_n - 1) (__ntt_root(s) has order 2^(s+1)); log_n == 0 -> 1.
fn plonk_omega<F: Field>(log_n: i32) -> F {
    if log_n == 0 { return 1; }
    return __ntt_root(log_n - 1);
}

fn pow_field<F: Field>(base: F, exp: i32) -> F {
    var result: F = 1;
    var b: F = base;
    var e: i32 = exp;
    while e > 0 {
        if (e & 1) == 1 {
            result = result * b;
        }
        b = b * b;
        e = e >> 1;
    }
    return result;
}

fn plonk_hash<F: Field>(
    data: *F, n: i32,
    rc_init: *F, rc_term: *F, rc_int: *F, diag: *F
) -> F {
    let h_st: *F = alloc(8);
    let h_pos: *i32 = alloc(1);
    transcript_init(h_st);
    h_pos[0] = 0;
    transcript_absorb(h_st, h_pos, data, n, rc_init, rc_term, rc_int, diag);
    let h_out: *F = alloc(1);
    transcript_squeeze(h_st, h_pos, h_out, 1, rc_init, rc_term, rc_int, diag);
    let result: F = h_out[0];
    free(h_st); free(h_pos); free(h_out);
    return result;
}

fn plonk_circuit_commit<F: Field>(
    n: i32,
    q_L: *F, q_R: *F, q_O: *F, q_M: *F, q_C: *F,
    sigma_a: *F, sigma_b: *F, sigma_c: *F,
    rc_init: *F, rc_term: *F, rc_int: *F, diag: *F
) -> F {
    let h_st: *F = alloc(8);
    let h_pos: *i32 = alloc(1);
    transcript_init(h_st);
    h_pos[0] = 0;
    transcript_absorb(h_st, h_pos, q_L, n, rc_init, rc_term, rc_int, diag);
    transcript_absorb(h_st, h_pos, q_R, n, rc_init, rc_term, rc_int, diag);
    transcript_absorb(h_st, h_pos, q_O, n, rc_init, rc_term, rc_int, diag);
    transcript_absorb(h_st, h_pos, q_M, n, rc_init, rc_term, rc_int, diag);
    transcript_absorb(h_st, h_pos, q_C, n, rc_init, rc_term, rc_int, diag);
    transcript_absorb(h_st, h_pos, sigma_a, n, rc_init, rc_term, rc_int, diag);
    transcript_absorb(h_st, h_pos, sigma_b, n, rc_init, rc_term, rc_int, diag);
    transcript_absorb(h_st, h_pos, sigma_c, n, rc_init, rc_term, rc_int, diag);
    let h_out: *F = alloc(1);
    transcript_squeeze(h_st, h_pos, h_out, 1, rc_init, rc_term, rc_int, diag);
    let result: F = h_out[0];
    free(h_st); free(h_pos); free(h_out);
    return result;
}

fn plonk_derive_challenges<F: Field>(
    circuit_commit: F, w_commit: F, z_commit: F,
    fri_root: *F, out_ch: *F,
    rc_init: *F, rc_term: *F, rc_int: *F, diag: *F
) {
    let ts: *F = alloc(8);
    let tp: *i32 = alloc(1);
    transcript_init(ts);
    tp[0] = 0;
    let cc_buf: *F = alloc(1);
    cc_buf[0] = circuit_commit;
    transcript_absorb(ts, tp, cc_buf, 1, rc_init, rc_term, rc_int, diag);
    cc_buf[0] = w_commit;
    transcript_absorb(ts, tp, cc_buf, 1, rc_init, rc_term, rc_int, diag);
    let bg: *F = alloc(2);
    transcript_squeeze(ts, tp, bg, 2, rc_init, rc_term, rc_int, diag);
    out_ch[0] = bg[0];
    out_ch[1] = bg[1];
    cc_buf[0] = z_commit;
    transcript_absorb(ts, tp, cc_buf, 1, rc_init, rc_term, rc_int, diag);
    transcript_squeeze(ts, tp, bg, 1, rc_init, rc_term, rc_int, diag);
    out_ch[2] = bg[0];
    transcript_absorb(ts, tp, fri_root, 4, rc_init, rc_term, rc_int, diag);
    transcript_squeeze(ts, tp, bg, 1, rc_init, rc_term, rc_int, diag);
    out_ch[3] = bg[0];
    free(ts); free(tp); free(cc_buf); free(bg);
}

fn copy_n<F: Field>(dst: *F, src: *F, n: i32) {
    for i in 0..n { dst[i] = src[i]; }
}

fn pad_to<F: Field>(dst: *F, src: *F, n_src: i32, n_dst: i32) {
    for i in 0..n_src { dst[i] = src[i]; }
    for i in n_src..n_dst { dst[i] = 0; }
}

fn plonk_interpolate<F: Field>(values: *F, log_n: i32) {
    ntt_inverse(values, log_n);
}

fn plonk_prove<F: Field>(
    n_gates: i32, log_n: i32,
    q_L: *F, q_R: *F, q_O: *F, q_M: *F, q_C: *F,
    wa: *F, wb: *F, wc: *F,
    sigma_a: *F, sigma_b: *F, sigma_c: *F,
    eval_out: *F,
    fri_roots: *F, fri_challenges: *F, fri_final_poly: *F,
    fri_query_values: *F, fri_query_paths: *F,
    fri_query_indices: *i32, fri_n_rounds: *i32,
    num_queries: i32,
    rc_init: *F, rc_term: *F, rc_int: *F, diag: *F
) -> i32 {
    let n: i32 = 1 << log_n;
    let n4: i32 = n * 4;
    let log_n4: i32 = log_n + 2;
    let coset_shift: F = 7;
    let k1: F = 13;
    let k2: F = 17;

    let omega: F = plonk_omega(log_n);
    let omega_pow: *F = alloc(n);
    omega_pow[0] = 1;
    for i in 1..n { omega_pow[i] = omega_pow[i - 1] * omega; }

    let cc: F = plonk_circuit_commit(n,
        q_L, q_R, q_O, q_M, q_C, sigma_a, sigma_b, sigma_c,
        rc_init, rc_term, rc_int, diag);

    let wh_st: *F = alloc(8);
    let wh_pos: *i32 = alloc(1);
    transcript_init(wh_st);
    wh_pos[0] = 0;
    transcript_absorb(wh_st, wh_pos, wa, n, rc_init, rc_term, rc_int, diag);
    transcript_absorb(wh_st, wh_pos, wb, n, rc_init, rc_term, rc_int, diag);
    transcript_absorb(wh_st, wh_pos, wc, n, rc_init, rc_term, rc_int, diag);
    let wh_out: *F = alloc(1);
    transcript_squeeze(wh_st, wh_pos, wh_out, 1, rc_init, rc_term, rc_int, diag);
    let w_commit: F = wh_out[0];
    free(wh_st); free(wh_pos); free(wh_out);
    eval_out[0] = w_commit;

    let ts: *F = alloc(8);
    let tp: *i32 = alloc(1);
    transcript_init(ts);
    tp[0] = 0;
    let tmp1: *F = alloc(1);
    tmp1[0] = cc;
    transcript_absorb(ts, tp, tmp1, 1, rc_init, rc_term, rc_int, diag);
    tmp1[0] = w_commit;
    transcript_absorb(ts, tp, tmp1, 1, rc_init, rc_term, rc_int, diag);
    let bg: *F = alloc(2);
    transcript_squeeze(ts, tp, bg, 2, rc_init, rc_term, rc_int, diag);
    let beta: F = bg[0];
    let gamma: F = bg[1];

    let z_vals: *F = alloc(n);
    z_vals[0] = 1;
    for i in 0..(n - 1) {
        let f_i: F = (wa[i] + beta * omega_pow[i] + gamma)
        * (wb[i] + beta * k1 * omega_pow[i] + gamma)
        * (wc[i] + beta * k2 * omega_pow[i] + gamma);
        let g_i: F = (wa[i] + beta * sigma_a[i] + gamma)
        * (wb[i] + beta * sigma_b[i] + gamma)
        * (wc[i] + beta * sigma_c[i] + gamma);
        z_vals[i + 1] = z_vals[i] * f_i / g_i;
    }

    let z_commit: F = plonk_hash(z_vals, n, rc_init, rc_term, rc_int, diag);
    eval_out[1] = z_commit;

    tmp1[0] = z_commit;
    transcript_absorb(ts, tp, tmp1, 1, rc_init, rc_term, rc_int, diag);
    transcript_squeeze(ts, tp, tmp1, 1, rc_init, rc_term, rc_int, diag);
    let alpha: F = tmp1[0];

    let a_co: *F = alloc(n); copy_n(a_co, wa, n);
    let b_co: *F = alloc(n); copy_n(b_co, wb, n);
    let c_co: *F = alloc(n); copy_n(c_co, wc, n);
    let qL_co: *F = alloc(n); copy_n(qL_co, q_L, n);
    let qR_co: *F = alloc(n); copy_n(qR_co, q_R, n);
    let qO_co: *F = alloc(n); copy_n(qO_co, q_O, n);
    let qM_co: *F = alloc(n); copy_n(qM_co, q_M, n);
    let qC_co: *F = alloc(n); copy_n(qC_co, q_C, n);
    let sa_co: *F = alloc(n); copy_n(sa_co, sigma_a, n);
    let sb_co: *F = alloc(n); copy_n(sb_co, sigma_b, n);
    let sc_co: *F = alloc(n); copy_n(sc_co, sigma_c, n);
    let z_co: *F = alloc(n); copy_n(z_co, z_vals, n);

    plonk_interpolate(a_co, log_n);
    plonk_interpolate(b_co, log_n);
    plonk_interpolate(c_co, log_n);
    plonk_interpolate(qL_co, log_n);
    plonk_interpolate(qR_co, log_n);
    plonk_interpolate(qO_co, log_n);
    plonk_interpolate(qM_co, log_n);
    plonk_interpolate(qC_co, log_n);
    plonk_interpolate(sa_co, log_n);
    plonk_interpolate(sb_co, log_n);
    plonk_interpolate(sc_co, log_n);
    plonk_interpolate(z_co, log_n);

    let a_ext: *F = alloc(n4); pad_to(a_ext, a_co, n, n4);
    let b_ext: *F = alloc(n4); pad_to(b_ext, b_co, n, n4);
    let c_ext: *F = alloc(n4); pad_to(c_ext, c_co, n, n4);
    let qL_ext: *F = alloc(n4); pad_to(qL_ext, qL_co, n, n4);
    let qR_ext: *F = alloc(n4); pad_to(qR_ext, qR_co, n, n4);
    let qO_ext: *F = alloc(n4); pad_to(qO_ext, qO_co, n, n4);
    let qM_ext: *F = alloc(n4); pad_to(qM_ext, qM_co, n, n4);
    let qC_ext: *F = alloc(n4); pad_to(qC_ext, qC_co, n, n4);
    let sa_ext: *F = alloc(n4); pad_to(sa_ext, sa_co, n, n4);
    let sb_ext: *F = alloc(n4); pad_to(sb_ext, sb_co, n, n4);
    let sc_ext: *F = alloc(n4); pad_to(sc_ext, sc_co, n, n4);
    let z_ext: *F = alloc(n4); pad_to(z_ext, z_co, n, n4);

    ntt_coset_forward(a_ext, log_n4, coset_shift);
    ntt_coset_forward(b_ext, log_n4, coset_shift);
    ntt_coset_forward(c_ext, log_n4, coset_shift);
    ntt_coset_forward(qL_ext, log_n4, coset_shift);
    ntt_coset_forward(qR_ext, log_n4, coset_shift);
    ntt_coset_forward(qO_ext, log_n4, coset_shift);
    ntt_coset_forward(qM_ext, log_n4, coset_shift);
    ntt_coset_forward(qC_ext, log_n4, coset_shift);
    ntt_coset_forward(sa_ext, log_n4, coset_shift);
    ntt_coset_forward(sb_ext, log_n4, coset_shift);
    ntt_coset_forward(sc_ext, log_n4, coset_shift);
    ntt_coset_forward(z_ext, log_n4, coset_shift);

    let zs_ext: *F = alloc(n4);
    var om: F = 1;
    for k in 0..n {
        zs_ext[k] = z_co[k] * om;
        om = om * omega;
    }
    for k in n..n4 { zs_ext[k] = 0; }
    ntt_coset_forward(zs_ext, log_n4, coset_shift);

    let l1_ext: *F = alloc(n4);
    var n_field: F = 1;
    for i in 1..n { n_field = n_field + 1; }
    let n_inv: F = 1 / n_field;
    for k in 0..n { l1_ext[k] = n_inv; }
    for k in n..n4 { l1_ext[k] = 0; }
    ntt_coset_forward(l1_ext, log_n4, coset_shift);

    let omega4n: F = plonk_omega(log_n4);
    let pts: *F = alloc(n4);
    var cp: F = coset_shift;
    for j in 0..n4 {
        pts[j] = cp;
        cp = cp * omega4n;
    }

    let zh_ext: *F = alloc(n4);
    for i in 0..n4 { zh_ext[i] = 0; }
    let zero_f: F = 0;
    let one_f: F = 1;
    zh_ext[0] = zero_f - one_f;
    zh_ext[n] = 1;
    ntt_coset_forward(zh_ext, log_n4, coset_shift);

    let t_ext: *F = alloc(n4);
    for j in 0..n4 {
        let gate: F = qL_ext[j] * a_ext[j]
        + qR_ext[j] * b_ext[j]
        + qO_ext[j] * c_ext[j]
        + qM_ext[j] * a_ext[j] * b_ext[j]
        + qC_ext[j];
        let f_j: F = (a_ext[j] + beta * pts[j] + gamma)
        * (b_ext[j] + beta * k1 * pts[j] + gamma)
        * (c_ext[j] + beta * k2 * pts[j] + gamma);
        let g_j: F = (a_ext[j] + beta * sa_ext[j] + gamma)
        * (b_ext[j] + beta * sb_ext[j] + gamma)
        * (c_ext[j] + beta * sc_ext[j] + gamma);
        let perm: F = zs_ext[j] * g_j - z_ext[j] * f_j;
        let bnd: F = l1_ext[j] * (z_ext[j] - 1);
        t_ext[j] = (gate + alpha * perm + alpha * alpha * bnd) / zh_ext[j];
    }

    ntt_coset_inverse(t_ext, log_n4, coset_shift);

    free(a_ext); free(b_ext); free(c_ext);
    free(qL_ext); free(qR_ext); free(qO_ext);
    free(qM_ext); free(qC_ext);
    free(sa_ext); free(sb_ext); free(sc_ext);
    free(z_ext); free(zs_ext); free(l1_ext);
    free(pts); free(zh_ext);

    let t_degree: i32 = 3 * n - 4;
    fri_n_rounds[0] = fri_prove(
        t_ext, t_degree, 1, coset_shift, num_queries,
        fri_roots, fri_challenges, fri_final_poly,
        fri_query_values, fri_query_paths, fri_query_indices,
        rc_init, rc_term, rc_int, diag);

    let fri_root0: *F = &fri_roots[0];
    transcript_absorb(ts, tp, fri_root0, 4, rc_init, rc_term, rc_int, diag);
    transcript_squeeze(ts, tp, tmp1, 1, rc_init, rc_term, rc_int, diag);
    let zeta: F = tmp1[0];

    free(ts); free(tp); free(tmp1); free(bg);

    eval_out[2] = poly_eval(a_co, n - 1, zeta);
    eval_out[3] = poly_eval(b_co, n - 1, zeta);
    eval_out[4] = poly_eval(c_co, n - 1, zeta);
    eval_out[5] = poly_eval(qL_co, n - 1, zeta);
    eval_out[6] = poly_eval(qR_co, n - 1, zeta);
    eval_out[7] = poly_eval(qO_co, n - 1, zeta);
    eval_out[8] = poly_eval(qM_co, n - 1, zeta);
    eval_out[9] = poly_eval(qC_co, n - 1, zeta);
    eval_out[10] = poly_eval(z_co, n - 1, zeta);
    eval_out[11] = poly_eval(z_co, n - 1, omega * zeta);
    eval_out[12] = poly_eval(sa_co, n - 1, zeta);
    eval_out[13] = poly_eval(sb_co, n - 1, zeta);
    eval_out[14] = poly_eval(sc_co, n - 1, zeta);
    eval_out[15] = poly_eval(t_ext, t_degree, zeta);

    free(omega_pow); free(z_vals);
    free(a_co); free(b_co); free(c_co);
    free(qL_co); free(qR_co); free(qO_co);
    free(qM_co); free(qC_co);
    free(sa_co); free(sb_co); free(sc_co);
    free(z_co); free(t_ext);

    return 1;
}

fn plonk_verify<F: Field>(
    n_gates: i32, log_n: i32,
    q_L: *F, q_R: *F, q_O: *F, q_M: *F, q_C: *F,
    sigma_a: *F, sigma_b: *F, sigma_c: *F,
    eval_out: *F,
    fri_n_rounds: i32,
    fri_roots: *F, fri_challenges: *F, fri_final_poly: *F,
    fri_query_values: *F, fri_query_paths: *F,
    fri_query_indices: *i32, num_queries: i32,
    rc_init: *F, rc_term: *F, rc_int: *F, diag: *F
) -> i32 {
    let n: i32 = 1 << log_n;
    let coset_shift: F = 7;
    let k1: F = 13;
    let k2: F = 17;

    let cc: F = plonk_circuit_commit(n,
        q_L, q_R, q_O, q_M, q_C, sigma_a, sigma_b, sigma_c,
        rc_init, rc_term, rc_int, diag);

    let w_commit: F = eval_out[0];
    let z_commit: F = eval_out[1];

    let ch: *F = alloc(4);
    plonk_derive_challenges(cc, w_commit, z_commit, &fri_roots[0], ch,
        rc_init, rc_term, rc_int, diag);
    let beta: F = ch[0];
    let gamma: F = ch[1];
    let alpha: F = ch[2];
    let zeta: F = ch[3];
    free(ch);

    let a_z: F = eval_out[2];
    let b_z: F = eval_out[3];
    let c_z: F = eval_out[4];
    let qL_z: F = eval_out[5];
    let qR_z: F = eval_out[6];
    let qO_z: F = eval_out[7];
    let qM_z: F = eval_out[8];
    let qC_z: F = eval_out[9];
    let z_z: F = eval_out[10];
    let z_wz: F = eval_out[11];
    let sa_z: F = eval_out[12];
    let sb_z: F = eval_out[13];
    let sc_z: F = eval_out[14];
    let t_z: F = eval_out[15];

    let gate: F = qL_z * a_z + qR_z * b_z + qO_z * c_z
    + qM_z * a_z * b_z + qC_z;

    let f_z: F = (a_z + beta * zeta + gamma)
    * (b_z + beta * k1 * zeta + gamma)
    * (c_z + beta * k2 * zeta + gamma);
    let g_z: F = (a_z + beta * sa_z + gamma)
    * (b_z + beta * sb_z + gamma)
    * (c_z + beta * sc_z + gamma);
    let perm: F = z_wz * g_z - z_z * f_z;

    let zeta_n: F = pow_field(zeta, n);
    var n_field: F = 1;
    for i in 1..n { n_field = n_field + 1; }
    let l1_z: F = (zeta_n - 1) / (n_field * (zeta - 1));
    let bnd: F = l1_z * (z_z - 1);

    let lhs: F = gate + alpha * perm + alpha * alpha * bnd;
    let zh_z: F = zeta_n - 1;
    let rhs: F = t_z * zh_z;

    if lhs != rhs {
        return 2;
    }

    let t_degree: i32 = 3 * n - 4;
    let fri_ok: i32 = fri_verify(
        t_degree, 1, coset_shift, num_queries, fri_n_rounds,
        fri_roots, fri_challenges, fri_final_poly,
        fri_query_values, fri_query_paths, fri_query_indices,
        rc_init, rc_term, rc_int, diag);
    if fri_ok != 1 {
        return 3;
    }

    return 1;
}

