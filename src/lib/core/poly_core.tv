// poly_core.tv — libc-free four-operation polynomial kernel: forward_sum /
// forward_diff / regime_detect / eval_at. Caller-owned buffers; p=0 = raw mode.
// @internal-design: core

// ===== INTERNAL HELPERS (not exported, internal linkage) =====

// Modular addition. When p > 0, result is in [0, p-1].
// When p = 0, plain integer addition.
fn mod_add(a: i32, b: i32, p: i32) -> i32 {
    if p > 0 {
        let sum: i64 = (a as i64) + (b as i64);
        return (sum % (p as i64)) as i32;
    }
    return a + b;
}

// Modular subtraction. When p > 0, result is in [0, p-1].
// When p = 0, plain integer subtraction.
fn mod_sub(a: i32, b: i32, p: i32) -> i32 {
    if p > 0 {
        let diff: i64 = (a as i64) - (b as i64) + (p as i64);
        return (diff % (p as i64)) as i32;
    }
    return a - b;
}

// Modular multiplication. When p > 0, result is in [0, p-1].
// When p = 0, plain integer multiplication.
fn mod_mul(a: i32, b: i32, p: i32) -> i32 {
    if p > 0 {
        let prod: i64 = (a as i64) * (b as i64);
        return (prod % (p as i64)) as i32;
    }
    return a * b;
}

// ===== DERIVED FIELD OPERATIONS (theorems of the axioms) =====

// Signed interpretation: maps field element to balanced range.
// Values > p/2 are negative. When p = 0, identity.
fn signed_val(x: i32, p: i32) -> i32 {
    if p > 0 {
        let half: i32 = (p - 1) / 2;
        if x > half { return x - p; }
    }
    return x;
}

// Absolute value.
fn abs_val(x: i32) -> i32 {
    if x < 0 { return 0 - x; }
    return x;
}

// Modular exponentiation by repeated squaring. Requires p > 0.
// Complexity: O(log e) multiplications.
fn mod_pow(base: i32, exp: i32, p: i32) -> i32 {
    var result: i32 = 1;
    var b: i32 = mod_mul(base, 1, p);
    var e: i32 = exp;
    while e > 0 {
        if (e & 1) == 1 {
            result = mod_mul(result, b, p);
        }
        b = mod_mul(b, b, p);
        e = e >> 1;
    }
    return result;
}

// Modular multiplicative inverse via Fermat's little theorem: a^(p-2).
// Requires p > 0 and a != 0.
fn mod_inv(a: i32, p: i32) -> i32 {
    return mod_pow(a, p - 2, p);
}

// ===== FORWARD SUMMATION (decode) =====

// Evaluate a Newton-basis polynomial (coeffs[0..order]) at n consecutive
// points into out[0..n-1], via the register reg[0..order] (caller scratch).
#[export]
fn forward_sum(coeffs: *i32, order: i32, out: *i32, n: i32, p: i32, reg: *i32) {
    // Initialize register from Newton coefficients
    var k: i32 = 0;
    while k <= order {
        reg[k] = coeffs[k];
        k = k + 1;
    }

    // Evaluate at n consecutive points
    var i: i32 = 0;
    while i < n {
        out[i] = reg[0];
        // Advance register: reg[k] += reg[k+1] for k = 0..order-1
        var j: i32 = 0;
        while j < order {
            reg[j] = mod_add(reg[j], reg[j + 1], p);
            j = j + 1;
        }
        i = i + 1;
    }
}

// ===== FORWARD DIFFERENCES (analyze) =====

// Compute Newton forward differences of data[0..n-1] into coeffs, up to
// max_order, using work[0..n-1] as scratch. Returns the detected order.
#[export]
fn forward_diff(data: *i32, n: i32, coeffs: *i32, max_order: i32, p: i32, work: *i32) -> i32 {
    // Copy data to work buffer
    var i: i32 = 0;
    while i < n {
        work[i] = data[i];
        i = i + 1;
    }

    // Level by level: work[0..n-d-1] becomes the d-th differences;
    // coeffs[d] = work[0] before differencing at level d.
    var d: i32 = 0;
    var remaining: i32 = n;
    while d <= max_order && remaining > 0 {
        coeffs[d] = work[0];

        // Check if all values at this level are zero (for d > 0)
        if d > 0 {
            var all_zero: i32 = 1;
            var ci: i32 = 0;
            while ci < remaining {
                if work[ci] != 0 {
                    all_zero = 0;
                }
                ci = ci + 1;
            }
            if all_zero == 1 {
                return d;
            }
        }

        // Compute next level of differences: work[i] = work[i+1] - work[i]
        var j: i32 = 0;
        while j < remaining - 1 {
            work[j] = mod_sub(work[j + 1], work[j], p);
            j = j + 1;
        }
        remaining = remaining - 1;
        d = d + 1;
    }

    return max_order;
}

// ===== REGIME DETECTION (segment) =====

// Walk data[0..n-1] with an order-`order` difference register (reg, caller
// scratch); return the first index whose residual exceeds threshold, else n.
#[export]
fn regime_detect(data: *i32, n: i32, order: i32, threshold: i32, p: i32, reg: *i32) -> i32 {
    // Need at least order+1 samples to initialize the register
    if n <= order { return n; }

    // Initialize register via forward differencing on the first order+1
    // samples, in-place (the register doubles as the work buffer).
    var k: i32 = 0;
    while k <= order {
        reg[k] = data[k];
        k = k + 1;
    }
    // Forward difference in-place: after level d, reg[d] has the d-th
    // forward difference of the initial sequence.
    var d: i32 = 0;
    while d < order {
        var j: i32 = order;
        while j > d {
            reg[j] = mod_sub(reg[j], reg[j - 1], p);
            j = j - 1;
        }
        d = d + 1;
    }

    // Advance register from point 0 (post-differencing) to point `order`, so
    // the first advance in the scan loop predicts point order+1.
    var adv: i32 = 0;
    while adv < order {
        var j: i32 = 0;
        while j < order {
            reg[j] = mod_add(reg[j], reg[j + 1], p);
            j = j + 1;
        }
        adv = adv + 1;
    }

    // Now scan: for each sample after the initial window, predict via
    // register advance and compare to actual.
    var i: i32 = order + 1;
    while i < n {
        // Advance register (predict next value)
        var j: i32 = 0;
        while j < order {
            reg[j] = mod_add(reg[j], reg[j + 1], p);
            j = j + 1;
        }
        // reg[0] is the predicted value
        let predicted: i32 = reg[0];
        let actual: i32 = data[i];
        let residual: i32 = mod_sub(actual, predicted, p);
        let abs_res: i32 = abs_val(signed_val(residual, p));
        if abs_res > threshold {
            return i;
        }
        // Update register: correct reg[0] to the actual value
        reg[0] = actual;
        i = i + 1;
    }

    return n;
}

// ===== ARBITRARY-POINT EVALUATION (query) =====

// Evaluate a Newton-basis polynomial (coeffs[0..order]) at an arbitrary field
// point x. Requires p > 0: Horner on the binomial basis divides by k+1.
#[export]
fn eval_at(coeffs: *i32, order: i32, x: i32, p: i32) -> i32 {
    if order < 0 { return 0; }
    var result: i32 = coeffs[order];
    var k: i32 = order - 1;
    while k >= 0 {
        let xmk: i32 = mod_sub(x, k, p);
        let inv_kp1: i32 = mod_inv(k + 1, p);
        let factor: i32 = mod_mul(xmk, inv_kp1, p);
        result = mod_add(coeffs[k], mod_mul(result, factor, p), p);
        k = k - 1;
    }
    return result;
}
