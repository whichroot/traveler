// string.tv — owned, length-carrying byte string Str (realloc-doubling).
// NUL is a normal data byte, never a terminator. tvc_self ONLY.
// @internal-design: collections

struct Str {
    data: *u8,
    len: i32,
    cap: i32,
}

fn str_new() -> Str {
    let buf: *u8 = alloc(8);
    return Str { data: buf, len: 0, cap: 8 };
}

fn str_push(s: *Str, c: u8) {
    if s.len == s.cap {
        s.cap = s.cap * 2;
        s.data = realloc(s.data, s.cap);
    }
    s.data[s.len] = c;
    s.len = s.len + 1;
}

// Append every byte of `b` onto `a` (length-based; copies b.len bytes,
// NUL-safe).
fn str_concat(a: *Str, b: *Str) {
    var i: i32 = 0;
    while i < b.len {
        str_push(a, b.data[i]);
        i = i + 1;
    }
}

fn str_len(s: *Str) -> i32 {
    return s.len;
}

fn str_byte(s: *Str, i: i32) -> u8 {
    return s.data[i];
}

// Length-first byte comparison. Returns 1 if equal, 0 otherwise. A NUL byte
// in the middle is compared like any other byte.
fn str_eq(a: *Str, b: *Str) -> i32 {
    if a.len != b.len {
        return 0;
    }
    var i: i32 = 0;
    while i < a.len {
        if a.data[i] != b.data[i] {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

fn str_free(s: *Str) {
    free(s.data);
}
