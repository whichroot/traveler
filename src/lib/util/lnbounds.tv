// lnbounds.tv — directed (rigorous) rational bounds on ln, fixed point at internal
// scale SI = 2^30, via ln(x) = 2*atanh(y), y = (x-1)/(x+1), atanh = sum y^(2j+1)/(2j+1).
// Caller passes V = round(v*SI), v >= 1; results at the same scale SI.
// @internal-design: mobius-inclusion (rigor lemma, tail, i64 safety)

// ceil(a/b) for a>=0, b>0.
fn ceil_div(a: i64, b: i64) -> i64 {
    return (a + b - 1) / b;
}

// LOWER bound on atanh(Y/SI), for 0 <= Y <= SI/3. Truncate + round every op down.
fn atanh_lo(Y: i64) -> i64 {
    let SI: i64 = 1073741824;          // 2^30
    var acc: i64 = Y;               // j=0 term: y
    let ysq: i64 = (Y * Y) / SI;        // floor -> underestimate of y^2
    var power: i64 = Y;             // running y^(2j+1)
    var j: i64 = 1;
    while j <= 12 {
        power = (power * ysq) / SI;      // floor -> underestimate of y^(2j+1)
        acc = acc + power / (2 * j + 1); // floor
        j = j + 1;
    }
    return acc;
}

// UPPER bound on atanh(Y/SI), for 0 <= Y <= SI/3. Round every op up, add a tail.
// After the loop `power` overestimates y^25 (j=12); the dropped tail satisfies
//   sum_{j>=13} y^(2j+1)/(2j+1) < (y^27/27) * 1/(1 - y^2) <= (y^27/27) * 9/8,
// using y^2 <= 1/9. We form y^27 = power*ysq and bound the tail upward.
fn atanh_hi(Y: i64) -> i64 {
    let SI: i64 = 1073741824;
    var acc: i64 = Y;
    let ysq: i64 = ceil_div(Y * Y, SI);        // overestimate of y^2
    var power: i64 = Y;
    var j: i64 = 1;
    while j <= 12 {
        power = ceil_div(power * ysq, SI);      // overestimate of y^(2j+1)
        acc = acc + ceil_div(power, 2 * j + 1); // overestimate
        j = j + 1;
    }
    let p27: i64 = ceil_div(power * ysq, SI);   // overestimate of y^27
    let tail: i64 = ceil_div(ceil_div(p27, 27) * 9, 8);
    return acc + tail;
}

// ln 2 = 2*atanh(1/3), computed directly (base constant for the reduction).
#[export]
fn ln2_lo() -> i64 {
    let SI: i64 = 1073741824;
    return 2 * atanh_lo(SI / 3);               // floor(SI/3) underestimates 1/3
}
#[export]
fn ln2_hi() -> i64 {
    let SI: i64 = 1073741824;
    return 2 * atanh_hi(ceil_div(SI, 3));      // ceil overestimates 1/3
}

// LOWER bound on ln(V/SI), V >= SI. Reduce v = 2^a * m with m in [1,2), floor
// everything so both a*ln2 and ln(m) are underestimated.
#[export]
fn ln_lo(V: i64) -> i64 {
    let SI: i64 = 1073741824;
    var a: i64 = 0;
    var pw: i64 = 1;
    while V / pw >= 2 * SI { pw = pw * 2; a = a + 1; }
    let M: i64 = V / pw;                        // floor -> m underestimate, [SI,2SI)
    let Y: i64 = ((M - SI) * SI) / (M + SI);    // floor -> y underestimate
    return a * ln2_lo() + 2 * atanh_lo(Y);
}

// UPPER bound on ln(V/SI), V >= SI. Same reduction, ceil everything.
#[export]
fn ln_hi(V: i64) -> i64 {
    let SI: i64 = 1073741824;
    var a: i64 = 0;
    var pw: i64 = 1;
    while V / pw >= 2 * SI { pw = pw * 2; a = a + 1; }
    let M: i64 = ceil_div(V, pw);               // ceil -> m overestimate, (SI,2SI]
    let Y: i64 = ceil_div((M - SI) * SI, M + SI); // ceil -> y overestimate
    return a * ln2_hi() + 2 * atanh_hi(Y);
}
