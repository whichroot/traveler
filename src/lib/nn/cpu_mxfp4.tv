import "cpu_q32.tv";

fn cpu_e2m1(code: i32) -> i32 {
    let v: i32 = code & 7; var magnitude: i32 = v;
    if v >= 4 { magnitude = (2+(v & 1)) << ((v >> 1)-1); }
    if (code & 8) != 0 { magnitude = 0-magnitude; }
    return magnitude;
}

// Planes occupy m*3*k bytes; k is a positive multiple of 64.
fn cpu_mxfp4_planes(mant: *i32, planes: *u8, m: i64, k: i64) {
    var t: i64 = 0;
    while t < m {
        var c: i64 = 0;
        while c < k {
            var j: i64 = 0;
            while j < 64 {
                let pos: i64 = (j % 2)*32+(j/32)*16+(j % 32)/2;
                let u: u32 = (mant[t*k+c+j]+262144) as u32;
                planes[t*3*k+c+pos] = u as u8;
                planes[(t*3+1)*k+c+pos] = (u >> 8) as u8;
                planes[(t*3+2)*k+c+pos] = (u >> 16) as u8;
                j = j+1;
            }
            c = c+64;
        }
        t = t+1;
    }
}

// Scratch: e[k/32], weights[k]. Planes are prepared once for each token block.
fn cpu_mxfp4_rows(planes: *u8, exponent: *i64, packed: *u8, scale: *u8, y: *i64,
                  m: i64, n: i64, k: i64, r0: i64, r1: i64, e: *i64, weights: *i8) {
    let groups: i64 = k/32;
    var lut: [u8;64] = 0; var indices: [u8;64] = 0; var ones: [u8;64] = 0;
    var zero: [i32;16] = 0;
    var p0: [i32;16] = 0; var p1: [i32;16] = 0; var p2: [i32;16] = 0; var pw: [i32;16] = 0;
    var i: i64 = 0;
    while i < 64 { lut[i] = cpu_e2m1((i % 16) as i32) as u8; ones[i] = 1; i = i+1; }
    var row: i64 = r0;
    while row < r1 {
        var q: i64 = 0;
        while q < k/64 {
            i = 0;
            while i < 32 {
                let byte: u8 = packed[row*(k/2)+q*32+i];
                indices[i] = byte & 15; indices[32+i] = byte >> 4; i = i+1;
            }
            cpu_shuffle8_512((&weights[q*64]) as *u8,&lut[0],&indices[0]);
            q = q+1;
        }
        var t: i64 = 0;
        while t < m {
            var emin: i64 = 1000; var g: i64 = 0;
            while g < groups {
                e[g] = exponent[t*groups+g]+(scale[row*groups+g] as i64)-128;
                if e[g] < emin { emin = e[g]; } g = g+1;
            }
            var acc: i64 = 0; q = 0;
            while q < k/64 {
                let w: *i8 = &weights[q*64];
                cpu_dpbusd_512(&p0[0],&zero[0],&planes[t*3*k+q*64],w);
                cpu_dpbusd_512(&p1[0],&zero[0],&planes[(t*3+1)*k+q*64],w);
                cpu_dpbusd_512(&p2[0],&zero[0],&planes[(t*3+2)*k+q*64],w);
                cpu_dpbusd_512(&pw[0],&zero[0],&ones[0],w);
                i = 0;
                while i < 16 {
                    let v: i32 = p0[i]+(p1[i] << 8)+(p2[i] << 16)-(pw[i] << 18);
                    acc = acc+((v as i64) << (e[2*q+((i/4) & 1)]-emin)); i = i+1;
                }
                q = q+1;
            }
            if emin+32 >= 0 { y[t*n+row] = acc << (emin+32); }
            else { y[t*n+row] = cpu_q_rne(acc as i128,0-emin-32); }
            t = t+1;
        }
        row = row+1;
    }
}
