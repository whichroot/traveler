define internal i32 @__get_num_cores() {
entry:
  %c = load i32, ptr @__pfor_cores
  %hit = icmp sgt i32 %c, 0
  br i1 %hit, label %ret_c, label %read
ret_c:
  ret i32 %c
read:
  %env = call ptr @getenv(ptr @.__tv_threads)
  %has = icmp ne ptr %env, null
  br i1 %has, label %parse, label %detect
parse:
  %n = call i32 @atoi(ptr %env)
  %ok = icmp sgt i32 %n, 0
  br i1 %ok, label %save, label %detect
detect:
  %sc = call i64 @sysconf(i32 58)
  %sc_ok = icmp sgt i64 %sc, 0
  br i1 %sc_ok, label %ret_sc, label %fb
ret_sc:
  %nc = trunc i64 %sc to i32
  br label %save
fb:
  br label %save
save:
  %v = phi i32 [%n, %parse], [%nc, %ret_sc], [8, %fb]
  store i32 %v, ptr @__pfor_cores
  ret i32 %v
}

define internal void @__pfor_pool_init_once() {
entry:
  %mrc = call i32 @pthread_mutex_init(ptr @__pfor_mu, ptr null)
  %grc = call i32 @pthread_cond_init(ptr @__pfor_cv_go, ptr null)
  %drc = call i32 @pthread_cond_init(ptr @__pfor_cv_done, ptr null)
  %e1 = or i32 %mrc, %grc
  %e2 = or i32 %e1, %drc
  %bad0 = icmp ne i32 %e2, 0
  br i1 %bad0, label %fail, label %cores
cores:
  %c = call i32 @__get_num_cores()
  %cap = icmp slt i32 %c, 32
  %p = select i1 %cap, i32 %c, i32 32
  store i32 %p, ptr @__pfor_pool_n
  %attr = alloca [8 x i64]
  %arc = call i32 @pthread_attr_init(ptr %attr)
  %abad = icmp ne i32 %arc, 0
  br i1 %abad, label %fail, label %ssz
ssz:
  %src = call i32 @pthread_attr_setstacksize(ptr %attr, i64 8388608)
  %sbad = icmp ne i32 %src, 0
  br i1 %sbad, label %fail, label %spawn
spawn:
  %i = phi i32 [0, %ssz], [%inxt, %spawn_cont]
  %done = icmp sge i32 %i, %p
  br i1 %done, label %fin, label %mk
mk:
  %i64v = sext i32 %i to i64
  %ip = getelementptr i32, ptr @__pfor_widx, i64 %i64v
  store i32 %i, ptr %ip
  %tp = getelementptr i64, ptr @__pfor_tids, i64 %i64v
  %crc = call i32 @pthread_create(ptr %tp, ptr %attr, ptr @__pfor_worker, ptr %ip)
  %cok = icmp eq i32 %crc, 0
  br i1 %cok, label %spawn_cont, label %fail
spawn_cont:
  %inxt = add i32 %i, 1
  br label %spawn
fin:
  %drc2 = call i32 @pthread_attr_destroy(ptr %attr)
  store i32 1, ptr @__pfor_pool_state
  ret void
fail:
  store i32 2, ptr @__pfor_pool_state
  ret void
}

define internal ptr @__pfor_worker(ptr %idxp) {
entry:
  %idx = load i32, ptr %idxp
  %idx64p = sext i32 %idx to i64
  br label %loop
loop:
  %last = phi i64 [0, %entry], [%gw, %ackd], [%gw, %retry]
  br label %spin
spin:
  %sp = phi i32 [0, %loop], [%spn, %spin_chk]
  %g = load atomic i64, ptr @__pfor_gen acquire, align 8
  %new = icmp ne i64 %g, %last
  %odd = and i64 %g, 1
  %even = icmp eq i64 %odd, 0
  %ready = and i1 %new, %even
  br i1 %ready, label %got, label %spin_more
spin_more:
  %spn = add i32 %sp, 1
  %yq = and i32 %spn, 8191
  %yz = icmp eq i32 %yq, 0
  br i1 %yz, label %spin_yield, label %spin_chk
spin_yield:
  %yrc = call i32 @sched_yield()
  br label %spin_chk
spin_chk:
  %exp = icmp slt i32 %spn, 262144
  br i1 %exp, label %spin, label %park
park:
  %lrc = call i32 @pthread_mutex_lock(ptr @__pfor_mu)
  %wsp = getelementptr i32, ptr @__pfor_wstate, i64 %idx64p
  store i32 1, ptr %wsp
  br label %park_chk
park_chk:
  %g2 = load atomic i64, ptr @__pfor_gen acquire, align 8
  %new2 = icmp ne i64 %g2, %last
  %odd2 = and i64 %g2, 1
  %even2 = icmp eq i64 %odd2, 0
  %ready2 = and i1 %new2, %even2
  br i1 %ready2, label %unpark, label %park_wait
park_wait:
  %wrc = call i32 @pthread_cond_wait(ptr @__pfor_cv_go, ptr @__pfor_mu)
  br label %park_chk
unpark:
  store i32 0, ptr %wsp
  %urc = call i32 @pthread_mutex_unlock(ptr @__pfor_mu)
  br label %got2
got:
  br label %got2
got2:
  %gw = phi i64 [%g, %got], [%g2, %unpark]
  %fn = load atomic ptr, ptr @__pfor_job_fn monotonic, align 8
  %ctx = load atomic ptr, ptr @__pfor_job_ctx monotonic, align 8
  %lo = load atomic i64, ptr @__pfor_job_lo monotonic, align 8
  %hi = load atomic i64, ptr @__pfor_job_hi monotonic, align 8
  %nthr = load atomic i32, ptr @__pfor_job_nthr monotonic, align 4
  %wide = load atomic i32, ptr @__pfor_job_wide monotonic, align 4
  fence acquire
  %gv = load atomic i64, ptr @__pfor_gen monotonic, align 8
  %stable = icmp eq i64 %gv, %gw
  br i1 %stable, label %steady, label %retry
retry:
  br label %loop
steady:
  %ge1 = icmp sgt i32 %idx, 0
  %lt = icmp slt i32 %idx, %nthr
  %part = and i1 %ge1, %lt
  br i1 %part, label %work, label %ackd
work:
  %rng = sub i64 %hi, %lo
  %nthr64 = sext i32 %nthr to i64
  %chunk = sdiv i64 %rng, %nthr64
  %idx64 = sext i32 %idx to i64
  %off = mul i64 %idx64, %chunk
  %start = add i64 %lo, %off
  %i1 = add i32 %idx, 1
  %is_last = icmp eq i32 %i1, %nthr
  %tent = add i64 %start, %chunk
  %end = select i1 %is_last, i64 %hi, i64 %tent
  %isw = icmp ne i32 %wide, 0
  br i1 %isw, label %call64, label %call32
call32:
  %s32 = trunc i64 %start to i32
  %e32 = trunc i64 %end to i32
  call void %fn(ptr %ctx, i32 %s32, i32 %e32)
  br label %ack
call64:
  call void %fn(ptr %ctx, i64 %start, i64 %end)
  br label %ack
ack:
  %olda = atomicrmw add ptr @__pfor_ack, i32 1 acq_rel, align 4
  %lastw = sub i32 %nthr, 2
  %islast = icmp eq i32 %olda, %lastw
  br i1 %islast, label %sig, label %ackd
sig:
  %lrc2 = call i32 @pthread_mutex_lock(ptr @__pfor_mu)
  %dw = load i32, ptr @__pfor_dwait
  %dwset = icmp ne i32 %dw, 0
  br i1 %dwset, label %dosig, label %sig_done
dosig:
  %src2 = call i32 @pthread_cond_signal(ptr @__pfor_cv_done)
  br label %sig_done
sig_done:
  %urc2 = call i32 @pthread_mutex_unlock(ptr @__pfor_mu)
  br label %ackd
ackd:
  br label %loop
}

define internal void @__pfor_dispatch(ptr %fn, ptr %ctx, i64 %lo, i64 %hi, i32 %nthr, i32 %wide) {
entry:
  %lrc = call i32 @pthread_mutex_lock(ptr @__pfor_mu)
  %bz = load atomic i32, ptr @__pfor_busy monotonic, align 4
  %free = icmp eq i32 %bz, 0
  br i1 %free, label %take, label %busy_serial
busy_serial:
  %urc0 = call i32 @pthread_mutex_unlock(ptr @__pfor_mu)
  %bsw = icmp ne i32 %wide, 0
  br i1 %bsw, label %bs64, label %bs32
bs32:
  %bl32 = trunc i64 %lo to i32
  %bh32 = trunc i64 %hi to i32
  call void %fn(ptr %ctx, i32 %bl32, i32 %bh32)
  ret void
bs64:
  call void %fn(ptr %ctx, i64 %lo, i64 %hi)
  ret void
take:
  store atomic i32 1, ptr @__pfor_busy monotonic, align 4
  %g = load atomic i64, ptr @__pfor_gen monotonic, align 8
  %writing = add i64 %g, 1
  store atomic i64 %writing, ptr @__pfor_gen monotonic, align 8
  fence release
  store atomic ptr %fn, ptr @__pfor_job_fn monotonic, align 8
  store atomic ptr %ctx, ptr @__pfor_job_ctx monotonic, align 8
  store atomic i64 %lo, ptr @__pfor_job_lo monotonic, align 8
  store atomic i64 %hi, ptr @__pfor_job_hi monotonic, align 8
  store atomic i32 %nthr, ptr @__pfor_job_nthr monotonic, align 4
  store atomic i32 %wide, ptr @__pfor_job_wide monotonic, align 4
  store atomic i32 0, ptr @__pfor_ack monotonic, align 4
  %g1 = add i64 %g, 2
  store atomic i64 %g1, ptr @__pfor_gen release, align 8
  br label %scan
scan:
  %si = phi i32 [1, %take], [%sin, %scan_cont]
  %sdone = icmp sge i32 %si, %nthr
  br i1 %sdone, label %go, label %scan_one
scan_one:
  %si64 = sext i32 %si to i64
  %sip = getelementptr i32, ptr @__pfor_wstate, i64 %si64
  %ws = load i32, ptr %sip
  %isparked = icmp eq i32 %ws, 1
  br i1 %isparked, label %wake, label %scan_cont
scan_cont:
  %sin = add i32 %si, 1
  br label %scan
wake:
  %brc = call i32 @pthread_cond_broadcast(ptr @__pfor_cv_go)
  br label %go
go:
  %urc = call i32 @pthread_mutex_unlock(ptr @__pfor_mu)
  br label %slice0
slice0:
  %rng0 = sub i64 %hi, %lo
  %n64 = sext i32 %nthr to i64
  %chunk0 = sdiv i64 %rng0, %n64
  %end0 = add i64 %lo, %chunk0
  %isw0 = icmp ne i32 %wide, 0
  br i1 %isw0, label %d64, label %d32
d32:
  %dl = trunc i64 %lo to i32
  %de = trunc i64 %end0 to i32
  call void %fn(ptr %ctx, i32 %dl, i32 %de)
  br label %spin
d64:
  call void %fn(ptr %ctx, i64 %lo, i64 %end0)
  br label %spin
spin:
  %sp = phi i32 [0, %d32], [0, %d64], [%spn, %spin_chk]
  %a = load atomic i32, ptr @__pfor_ack acquire, align 4
  %tgt = sub i32 %nthr, 1
  %all = icmp sge i32 %a, %tgt
  br i1 %all, label %fin, label %spin_more
spin_more:
  %spn = add i32 %sp, 1
  %yq = and i32 %spn, 1023
  %yz = icmp eq i32 %yq, 0
  br i1 %yz, label %spin_yield, label %spin_chk
spin_yield:
  %yrc = call i32 @sched_yield()
  br label %spin_chk
spin_chk:
  %exp = icmp slt i32 %spn, 4096
  br i1 %exp, label %spin, label %park
park:
  %lrc2 = call i32 @pthread_mutex_lock(ptr @__pfor_mu)
  store i32 1, ptr @__pfor_dwait
  br label %park_chk
park_chk:
  %a2 = load atomic i32, ptr @__pfor_ack acquire, align 4
  %tgt2 = sub i32 %nthr, 1
  %all2 = icmp sge i32 %a2, %tgt2
  br i1 %all2, label %unpark, label %park_wait
park_wait:
  %wrc = call i32 @pthread_cond_wait(ptr @__pfor_cv_done, ptr @__pfor_mu)
  br label %park_chk
unpark:
  store i32 0, ptr @__pfor_dwait
  %urc2 = call i32 @pthread_mutex_unlock(ptr @__pfor_mu)
  br label %fin
fin:
