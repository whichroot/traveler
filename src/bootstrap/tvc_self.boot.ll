}

define internal void @__parallel_for(ptr %fn, ptr %ctx, i32 %lo, i32 %hi) {
entry:
  %rng = sub i32 %hi, %lo
  %big = icmp sgt i32 %rng, 512
  br i1 %big, label %par_check, label %serial
par_check:
  %cores = call i32 @__get_num_cores()
  %multi = icmp sgt i32 %cores, 1
  br i1 %multi, label %pool_check, label %serial
pool_check:
  %st = load i32, ptr @__pfor_pool_state
  %un = icmp eq i32 %st, 0
  br i1 %un, label %doinit, label %st_chk
doinit:
  %orc = call i32 @pthread_once(ptr @__pfor_once, ptr @__pfor_pool_init_once)
  br label %st_chk
st_chk:
  %st2 = load i32, ptr @__pfor_pool_state
  %rdy = icmp eq i32 %st2, 1
  br i1 %rdy, label %setup, label %serial
setup:
  %max_t = sdiv i32 %rng, 64
  %t1 = icmp slt i32 %cores, %max_t
  %t2 = select i1 %t1, i32 %cores, i32 %max_t
  %t3 = icmp slt i32 %t2, 32
  %t4 = select i1 %t3, i32 %t2, i32 32
  %nt = icmp sgt i32 %t4, 1
  %nthr = select i1 %nt, i32 %t4, i32 1
  %one = icmp eq i32 %nthr, 1
  br i1 %one, label %serial, label %go
go:
  %lo64 = sext i32 %lo to i64
  %hi64 = sext i32 %hi to i64
  call void @__pfor_dispatch(ptr %fn, ptr %ctx, i64 %lo64, i64 %hi64, i32 %nthr, i32 0)
  ret void
serial:
  call void %fn(ptr %ctx, i32 %lo, i32 %hi)
  ret void
}


