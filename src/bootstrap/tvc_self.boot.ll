define internal i64 @field_dyn_add(i64 %a, i64 %b, ptr %f) alwaysinline {
  %pp = getelementptr %__Field, ptr %f, i32 0, i32 0
  %p = load i64, ptr %pp
  %aw = zext i64 %a to i128
  %bw = zext i64 %b to i128
  %pw = zext i64 %p to i128
  %sum = add i128 %aw, %bw
  %ge = icmp uge i128 %sum, %pw
  %sub = sub i128 %sum, %pw
  %res = select i1 %ge, i128 %sub, i128 %sum
  %out = trunc i128 %res to i64
  ret i64 %out
}

define internal i64 @field_dyn_sub(i64 %a, i64 %b, ptr %f) alwaysinline {
  %pp = getelementptr %__Field, ptr %f, i32 0, i32 0
  %p = load i64, ptr %pp
  %aw = zext i64 %a to i128
  %bw = zext i64 %b to i128
  %pw = zext i64 %p to i128
  %d = add i128 %aw, %pw
  %d2 = sub i128 %d, %bw
  %ge = icmp uge i128 %d2, %pw
  %sub = sub i128 %d2, %pw
  %res = select i1 %ge, i128 %sub, i128 %d2
  %out = trunc i128 %res to i64
  ret i64 %out
}

define internal i64 @field_dyn_mul(i64 %a, i64 %b, ptr %f) alwaysinline {
  %pp = getelementptr %__Field, ptr %f, i32 0, i32 0
  %p = load i64, ptr %pp
  %narrow = icmp ule i64 %p, 4294967296
  br i1 %narrow, label %fast, label %wide
fast:
  %prod64 = mul i64 %a, %b
  %rfast = urem i64 %prod64, %p
  ret i64 %rfast
wide:
  %mlop = getelementptr %__Field, ptr %f, i32 0, i32 4
  %mlo = load i64, ptr %mlop
  %mhip = getelementptr %__Field, ptr %f, i32 0, i32 5
  %mhi = load i64, ptr %mhip
  %aw = zext i64 %a to i128
  %bw = zext i64 %b to i128
  %prod = mul i128 %aw, %bw
  %mlo128 = zext i64 %mlo to i128
  %mhi128 = zext i64 %mhi to i128
  %msh = shl i128 %mhi128, 64
  %m = or i128 %msh, %mlo128
