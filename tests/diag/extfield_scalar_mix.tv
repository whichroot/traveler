// Negative: a raw scalar VARIABLE combined with an ExtField. A literal lifts to
// the reduced (v,0) pair on either side (operand symmetry, Part 1), but a value
// declared `i32` stays an integer — mixing it with an extension element needs an
// explicit `n as E`. An aggregate {iN,iN} can't be compared/combined with a
// scalar, so this must be diagnosed, not emit invalid IR (extractvalue on a
// scalar). @internal-note: plan-extfield-operand-symmetry (Part 2).
field F251 = Field<251>;
extfield E = ExtField<Field<251>, 2>;

fn main() {
    let x: E = 10;
    let n: i32 = 5;
    let c: i32 = (x == n) as i32;
    print(c);
}
