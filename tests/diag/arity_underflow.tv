// arity_underflow.tv — #26 negative gate. A direct call with FEWER arguments
// than the callee's parameter count is refused. Before #26 both compilers
// accepted this and the missing argument read uninitialized memory at runtime
// (garbage / segfault). The refusal is the boundary.
fn takes6(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32) -> i32 {
    return a + b + c + d + e + f;
}
fn main() {
    let r: i32 = takes6(1, 2, 3, 4, 5);   // 5 args, 6 params: refused
    print(r);
}
