// arity_fnptr.tv — #26 negative gate. An indirect call through a function
// pointer must match the signature's arity. The fn-pointer path had the same
// unchecked-arity gap as direct calls; #26 closes it (the count is known
// statically from the fn(...)->R type).
fn add2(a: i32, b: i32) -> i32 { return a + b; }
fn main() {
    let fp: fn(i32, i32) -> i32 = &add2;
    let r: i32 = fp(1);          // 1 arg, 2 params: refused
    print(r);
}
