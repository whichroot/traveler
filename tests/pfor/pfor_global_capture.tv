// #53: pfor dispatch ctx-fill must load GLOBAL captures via @name (is_alloca==2).
// Pre-fix the fill stored the sym's stale reg (always %t0) as the SSA value:
// computed bound -> %t0 i32 -> llc reject; param bound -> %t0 ptr-typed by luck
// -> llc-accepted SIGSEGV. Three bound shapes over a global *i64 + a global
// scalar capture; all three loops must DISPATCH and run bit-identically at any
// thread count. Analysis: @internal-note: known-issues #53.
let G1: i32 = 8;
let G2: i32 = 16;
var g_arr: *i64 = null;
var g_bias: i64 = 3;

fn zero_param(n: i32) { for i in 0..n { g_arr[i] = 0; } }
fn fill_computed() { let m: i32 = G1 * G2; for i in 0..m { g_arr[i] = (i as i64) * 2 + g_bias; } }
fn triple_literal() { for i in 0..128 { g_arr[i] = g_arr[i] * 3 + 1; } }

fn main() {
    g_arr = alloc(8 * 128);
    var i: i32 = 0; while i < 128 { g_arr[i] = 7; i = i + 1; }
    zero_param(128);
    print(g_arr[0]); print(g_arr[127]);
    fill_computed();
    triple_literal();
    var s: i64 = 0; i = 0; while i < 128 { s = s + g_arr[i]; i = i + 1; }
    print(s);
}
