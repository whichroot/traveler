// Integer division remains admitted in dispatched bodies; zero aborts explicitly.
// The harness compares stdout and status with one and 32 threads.
fn main() -> i32 {
    let n: i32 = 4096;
    let a: *i64 = alloc(n);
    let b: *i64 = alloc(n);
    let q: *i64 = alloc(n);

    var w: i32 = 0;
    while w < n {
        a[w] = (w as i64) * 1000003;
        b[w] = ((w as i64) % 97) + 1;   // nonzero...
        w = w + 1;
    }
    b[2077] = 0;                         // ...except one poison lane

    print(7777);                         // Abort can discard buffered output.

    for i in 0..n {
        q[i] = a[i] / b[i];
    }

    var s: i64 = 0;
    w = 0;
    while w < n {
        s = s + q[w];
        w = w + 1;
    }
    print(s);                            // Unreachable after the zero divisor.
    return 0;
}
