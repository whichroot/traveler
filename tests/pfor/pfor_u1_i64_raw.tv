// pfor_u1_i64_raw.tv — via-negativa for U1, the primitive-capture dispatch
// lift (@internal-note: plan-exact-arithmetic-arc, Stage D): the RAW hazard,
// i64 flavor.
// U1 lifted the TYPE gate, not the independence proof: out[i] = out[i+1] + a[i]
// still reads a cell that a DIFFERENT iteration writes — refused (`raw`),
// exactly as the Field<> original (pfor_race_raw.tv). The i64 demonstrators
// prove default-deny carried over to the lifted type set unchanged.
//
// MUST NOT PARALLELIZE. Expected workers: 0 (stage1).
// Serial ground truth: out[i] = (i+1) + 1 = i+2; sum out[0..8) = 44.
fn main() -> i32 {
    let n: i32 = 8192;
    let a: *i64 = alloc(n);
    let out: *i64 = alloc(n + 1);

    var w: i32 = 0;
    while w < n {
        a[w] = 1;
        w = w + 1;
    }
    w = 0;
    while w < n + 1 {
        out[w] = w as i64;
        w = w + 1;
    }

    // RACE: reads out[i+1], a cell written by iteration i+1.
    for i in 0..n {
        out[i] = out[i + 1] + a[i];
    }

    var s: i64 = 0;
    w = 0;
    while w < 8 {
        s = s + out[w];
        w = w + 1;
    }
    print(s);
    return 0;
}
