// pfor_self_affine_point_wrap.tv - a constant read can lie inside a wrapped
// stride-1 write footprint despite ordinary integer interval order.

field F = Field<2013265921>;
var never: i32 = 0;

fn main() -> i32 {
    let out: *F = alloc(1);
    if never == 1 {
        for i in 0..50000 {
            out[i + 2147483647] = out[0 - 2147483647];
        }
    }
    print(7);
    return 0;
}
