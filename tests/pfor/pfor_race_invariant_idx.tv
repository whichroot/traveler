// pfor_race_invariant_idx.tv — HOLE 2: loop-invariant write index
//
// out[j] = out[j] + slow(a[i]) where j is a captured scalar that never
// varies with the loop.  Same single-cell reduction race as hole 1, but
// the index is an identifier instead of a literal — exercises the
// AST_IDENT capture path in pfor_walk_expr.
//
// MUST NOT PARALLELIZE.  Expected workers: 0.  Expected output: 50000.

field F = Field<2013265921>;

fn slow(x: F) -> F {
    var a: F = x;
    var k: i32 = 0;
    while k < 2000 {
        a = a + 0;
        k = k + 1;
    }
    return a;
}

fn main() -> i32 {
    let n: i32 = 50000;
    let j: i32 = 5;
    let a: *F = alloc(n);
    let out: *F = alloc(16);

    var w: i32 = 0;
    while w < n {
        a[w] = 1;
        w = w + 1;
    }
    w = 0;
    while w < 16 {
        out[w] = 0;
        w = w + 1;
    }

    // RACE: write index j is loop-invariant — every iteration hits out[5]
    for i in 0..n {
        out[j] = out[j] + slow(a[i]);
    }

    print(out[5]);
    return 0;
}
