// pfor_boundary_values.tv — A4: field arithmetic at modulus edges
//  through parallel workers (SIMD + pthread interaction)
//
// Seeds arrays with boundary values (p-1, 0, 1, p/2) and runs
// per-element doubling, squaring, and negation in parallel loops over
// three field widths.  Any wraparound error in the vectorized +
// parallel path shifts the checksums.
//
// Per-field expected (n=4096, pattern repeats every 4 elements
// [p-1, 0, 1, h] where h=(p-1)/2):
//   double: (2p-2)%p=p-2, 0, 2, p-1        sum_4 = 2p-1 ≡ p-1 (mod p)
//   square: 1, 0, 1, h^2%p
//   neg:    1, 0, p-1, p-h
//
// Checksums = 1024 * (per-4 sums) mod p, printed per field, 3 lines
// per field, 9 lines total.  Expected workers: 9.
//
// Field<251>:        h=125, h2=h*h%251=62
// Field<65521>:      h=32760, h2=h*h%65521=49141
// Field<2013265921>: h=1006632960, h2=h*h%p
//
// Expected output (computed by the serial baseline at first run):
//   see expected/pfor_boundary_values.txt

field F8 = Field<251>;
field F16 = Field<65521>;
field F31 = Field<2013265921>;

fn main() -> i32 {
    let n: i32 = 4096;

    // ---- Field<251> ----
    let a8: *F8 = alloc(n);
    let d8: *F8 = alloc(n);
    let q8: *F8 = alloc(n);
    let g8: *F8 = alloc(n);
    var w: i32 = 0;
    while w < n {
        let m: i32 = w % 4;
        if m == 0 { a8[w] = 250; }
        else if m == 1 { a8[w] = 0; }
        else if m == 2 { a8[w] = 1; }
        else { a8[w] = 125; }
        w = w + 1;
    }
    for i in 0..4096 {
        d8[i] = a8[i] + a8[i];
    }
    for i in 0..4096 {
        q8[i] = a8[i] * a8[i];
    }
    for i in 0..4096 {
        g8[i] = 0 - a8[i];
    }
    var s1: F8 = 0;
    var s2: F8 = 0;
    var s3: F8 = 0;
    w = 0;
    while w < n {
        s1 = s1 + d8[w];
        s2 = s2 + q8[w];
        s3 = s3 + g8[w];
        w = w + 1;
    }
    print(s1); print(s2); print(s3);

    // ---- Field<65521> ----
    let a16: *F16 = alloc(n);
    let d16: *F16 = alloc(n);
    let q16: *F16 = alloc(n);
    let g16: *F16 = alloc(n);
    w = 0;
    while w < n {
        let m: i32 = w % 4;
        if m == 0 { a16[w] = 65520; }
        else if m == 1 { a16[w] = 0; }
        else if m == 2 { a16[w] = 1; }
        else { a16[w] = 32760; }
        w = w + 1;
    }
    for i in 0..4096 {
        d16[i] = a16[i] + a16[i];
    }
    for i in 0..4096 {
        q16[i] = a16[i] * a16[i];
    }
    for i in 0..4096 {
        g16[i] = 0 - a16[i];
    }
    var t1: F16 = 0;
    var t2: F16 = 0;
    var t3: F16 = 0;
    w = 0;
    while w < n {
        t1 = t1 + d16[w];
        t2 = t2 + q16[w];
        t3 = t3 + g16[w];
        w = w + 1;
    }
    print(t1); print(t2); print(t3);

    // ---- Field<2013265921> ----
    let a31: *F31 = alloc(n);
    let d31: *F31 = alloc(n);
    let q31: *F31 = alloc(n);
    let g31: *F31 = alloc(n);
    w = 0;
    while w < n {
        let m: i32 = w % 4;
        if m == 0 { a31[w] = 2013265920; }
        else if m == 1 { a31[w] = 0; }
        else if m == 2 { a31[w] = 1; }
        else { a31[w] = 1006632960; }
        w = w + 1;
    }
    for i in 0..4096 {
        d31[i] = a31[i] + a31[i];
    }
    for i in 0..4096 {
        q31[i] = a31[i] * a31[i];
    }
    for i in 0..4096 {
        g31[i] = 0 - a31[i];
    }
    var u1: F31 = 0;
    var u2: F31 = 0;
    var u3: F31 = 0;
    w = 0;
    while w < n {
        u1 = u1 + d31[w];
        u2 = u2 + q31[w];
        u3 = u3 + g31[w];
        w = w + 1;
    }
    print(u1); print(u2); print(u3);

    return 0;
}
