// gpu_rowbatch_dot.tv — row-batched blocked dot: 3 reduction rows, 8
// wave accumulators per row (24 > the old 16 cap), 3 stride-1 stores
// separated by the trip count. Pins the row-batch capacity raises.
// @internal-design: plane-k8-boundary.

fn main() -> i32 {
    let x: *i32 = alloc(4 * 2 * 32);
    let out: *i64 = alloc(12);
    for i in 0..4 {
        var acc: i64 = 0;
        var acc_r1: i64 = 0;
        var acc_r2: i64 = 0;
        for b in 0..2 {
            var a0: i32 = 0;
            var a1: i32 = 0;
            var a2: i32 = 0;
            var a3: i32 = 0;
            var a4: i32 = 0;
            var a5: i32 = 0;
            var a6: i32 = 0;
            var a7: i32 = 0;
            var b0: i32 = 0;
            var b1: i32 = 0;
            var b2: i32 = 0;
            var b3: i32 = 0;
            var b4: i32 = 0;
            var b5: i32 = 0;
            var b6: i32 = 0;
            var b7: i32 = 0;
            var c0: i32 = 0;
            var c1: i32 = 0;
            var c2: i32 = 0;
            var c3: i32 = 0;
            var c4: i32 = 0;
            var c5: i32 = 0;
            var c6: i32 = 0;
            var c7: i32 = 0;
            for lane in 0..32 {
                a0 = a0 + x[(i * 2 + b) * 32 + lane] + lane;
                a1 = a1 + x[(i * 2 + b) * 32 + lane] + lane + 1;
                a2 = a2 + x[(i * 2 + b) * 32 + lane] + lane + 2;
                a3 = a3 + x[(i * 2 + b) * 32 + lane] + lane + 3;
                a4 = a4 + x[(i * 2 + b) * 32 + lane] + lane + 4;
                a5 = a5 + x[(i * 2 + b) * 32 + lane] + lane + 5;
                a6 = a6 + x[(i * 2 + b) * 32 + lane] + lane + 6;
                a7 = a7 + x[(i * 2 + b) * 32 + lane] + lane + 7;
                b0 = b0 + x[(i * 2 + b) * 32 + lane] + lane + 8;
                b1 = b1 + x[(i * 2 + b) * 32 + lane] + lane + 9;
                b2 = b2 + x[(i * 2 + b) * 32 + lane] + lane + 10;
                b3 = b3 + x[(i * 2 + b) * 32 + lane] + lane + 11;
                b4 = b4 + x[(i * 2 + b) * 32 + lane] + lane + 12;
                b5 = b5 + x[(i * 2 + b) * 32 + lane] + lane + 13;
                b6 = b6 + x[(i * 2 + b) * 32 + lane] + lane + 14;
                b7 = b7 + x[(i * 2 + b) * 32 + lane] + lane + 15;
                c0 = c0 + x[(i * 2 + b) * 32 + lane] + lane + 16;
                c1 = c1 + x[(i * 2 + b) * 32 + lane] + lane + 17;
                c2 = c2 + x[(i * 2 + b) * 32 + lane] + lane + 18;
                c3 = c3 + x[(i * 2 + b) * 32 + lane] + lane + 19;
                c4 = c4 + x[(i * 2 + b) * 32 + lane] + lane + 20;
                c5 = c5 + x[(i * 2 + b) * 32 + lane] + lane + 21;
                c6 = c6 + x[(i * 2 + b) * 32 + lane] + lane + 22;
                c7 = c7 + x[(i * 2 + b) * 32 + lane] + lane + 23;
            }
            acc = acc + (a0 as i64) + (a1 as i64) + (a2 as i64)
                + (a3 as i64) + (a4 as i64) + (a5 as i64) + (a6 as i64)
                + (a7 as i64);
            acc_r1 = acc_r1 + (b0 as i64) + (b1 as i64) + (b2 as i64)
                + (b3 as i64) + (b4 as i64) + (b5 as i64) + (b6 as i64)
                + (b7 as i64);
            acc_r2 = acc_r2 + (c0 as i64) + (c1 as i64) + (c2 as i64)
                + (c3 as i64) + (c4 as i64) + (c5 as i64) + (c6 as i64)
                + (c7 as i64);
        }
        out[i] = acc;
        out[4 + i] = acc_r1;
        out[8 + i] = acc_r2;
    }
    free(out); free(x);
    return 0;
}
