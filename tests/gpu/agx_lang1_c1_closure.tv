// LANG1-C1: a local block closure owns scalar local control and one capture.

field AgxLang1C1ClosureF = Field<2013265921>;

fn agx_lang1_c1_closure_init(left: *AgxLang1C1ClosureF,
                             right: *AgxLang1C1ClosureF, n: i32) {
    let prime: u64 = 2013265921;
    var state: u64 = 0x6a09e667f3bcc909;
    var i: i32 = 0;
    while i < n {
        state = state * (6364136223846793005 as u64)
            + (1442695040888963407 as u64);
        left[i] = (state % prime) as AgxLang1C1ClosureF;
        state = state * (6364136223846793005 as u64)
            + (1442695040888963407 as u64);
        right[i] = (state % prime) as AgxLang1C1ClosureF;
        i = i + 1;
    }
}

fn agx_lang1_c1_closure(left: *AgxLang1C1ClosureF,
                        right: *AgxLang1C1ClosureF,
                        output: *AgxLang1C1ClosureF) {
    for i in 0..768 {
        let captured: AgxLang1C1ClosureF = right[i];
        let choose = |value: AgxLang1C1ClosureF| -> AgxLang1C1ClosureF {
            let candidate: AgxLang1C1ClosureF = value;
            if candidate < captured { return captured; }
            else { return candidate; }
        };
        output[i] = choose(left[i]);
    }
}
