// SPDX-License-Identifier: Apache-2.0
// Executes the packed two-input AGX-3 exhibit through the Traveler runtime.
import "../../src/lib/gpu/agx_runtime.tv";

fn main(argc: i32, argv: **u8) -> i32 {
    if argc != 3 { return 2; }
    let n: i32 = 768;
    let prime: u64 = 2013265921;
    let left: *u32 = alloc(n);
    let right: *u32 = alloc(n);
    let output: *u32 = alloc(n);
    var state: u64 = 0xa54ff53a5f1d36f1;
    var i: i32 = 0;
    while i < n {
        state = state * (6364136223846793005 as u64)
            + (1442695040888963407 as u64);
        left[i] = (state % prime) as u32;
        state = state * (6364136223846793005 as u64)
            + (1442695040888963407 as u64);
        right[i] = (state % prime) as u32;
        i = i + 1;
    }
    left[0] = 0; right[0] = (prime - 1) as u32;
    left[1] = 1; right[1] = (prime - 1) as u32;
    left[2] = (prime - 1) as u32; right[2] = (prime - 1) as u32;

    let ran: i32 = agx_run_binary_words(argv[1], argv[2], left, right,
                                         n, output);
    var exact: i32 = ran;
    i = 0;
    while i < n && exact != 0 {
        let want: u64 = ((left[i] as u64) * (right[i] as u64)) % prime;
        if output[i] as u64 != want {
            print(i); print(output[i] as u64); print(want);
            exact = 0;
        }
        i = i + 1;
    }
    print(exact);
    if exact == 0 { print(g_agx_error); }
    free(output); free(right); free(left);
    if exact == 0 { return 1; }
    return 0;
}
