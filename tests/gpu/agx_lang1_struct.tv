// LANG1-H1: a private flat struct scalarizes before AGX CFG/RA.

field AgxLang1F = Field<2013265921>;

struct AgxLang1Score {
    value: i32,
    threshold: i32,
}

fn agx_lang1_init(left: *AgxLang1F, right: *AgxLang1F, n: i32) {
    let prime: u64 = 2013265921;
    var state: u64 = 0x6a09e667f3bcc909;
    var i: i32 = 0;
    while i < n {
        state = state * (6364136223846793005 as u64)
            + (1442695040888963407 as u64);
        left[i] = (state % prime) as AgxLang1F;
        state = state * (6364136223846793005 as u64)
            + (1442695040888963407 as u64);
        right[i] = (state % prime) as AgxLang1F;
        i = i + 1;
    }
    left[0] = 0; right[0] = 0;
    left[1] = 3; right[1] = 5;
    left[2] = 7; right[2] = 11;
    left[3] = 19; right[3] = 2;
}

fn agx_lang1_struct(left: *AgxLang1F, right: *AgxLang1F,
                    output: *AgxLang1F) {
    for j in 0..768 {
        let a: AgxLang1F = left[j];
        let b: AgxLang1F = right[j];
        var score: AgxLang1Score = AgxLang1Score { value: 1, threshold: 2 };
        if a < b {
            score.value = score.value + 3;
        } else {
            score.value = score.value + 1;
        }
        var chosen: AgxLang1F = a;
        if score.value > score.threshold { chosen = b; }
        output[j] = chosen;
    }
}
