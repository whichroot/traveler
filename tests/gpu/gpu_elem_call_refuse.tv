// Integer power remains outside the typed scalar device profile.

fn dnq32r(x: i64) -> i64 {
    return x ** 3;
}

fn main() -> i32 {
    let input: *i64 = alloc(2048);
    let output: *i64 = alloc(2048);
    for i in 0..2048 {
        output[i] = dnq32r(input[i]);
    }
    free(output); free(input);
    return 0;
}
