// Wide-element device class: *i128 / *i256 captures admit wide device loads
// (16B/32B per thread — the Blackwell fabric lever). AGX fails closed: its
// 32-bit encoder skips the workers by name.

fn main() -> i32 {
    let w: *i128 = alloc(2048);
    let out: *i128 = alloc(2048);
    for i in 0..2048 {
        out[i] = w[i] * 3 + 1;
    }
    free(out); free(w);
    let w2: *i256 = alloc(2048);
    let out2: *i256 = alloc(2048);
    for j in 0..2048 {
        out2[j] = w2[j] + 7;
    }
    free(out2); free(w2);
    return 0;
}
