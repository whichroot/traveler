// gpu_prefetch_dot.tv — carried-fetch prefetch, device structure: pre is
// phi-carried, its reassign guarded. @internal-design: stage1-dot.

fn main() -> i32 {
    let w: *i64 = alloc(257);
    let x: *i64 = alloc(256);
    let out: *i64 = alloc(64);
    for i in 0..64 {
        var pre: i64 = w[i * 4];
        var acc: i64 = 0;
        for b in 0..4 {
            acc = acc + pre * x[i * 4 + b];
            pre = w[i * 4 + b + 1];
        }
        out[i] = acc;
    }
    free(out); free(x); free(w);
    return 0;
}
