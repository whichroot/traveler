import "../../src/lib/gpu/thread.tv";

fn gpu_bounded_load_u64(buffer: *u64, count: u64, index: u64) -> u64 {
    if index < count { return buffer[index]; } else { return 0; }
}

fn numeric_projection_step(column: u64, columns: u64, weight: u64, input: u64, accumulator: u64, fused: u64) -> u64 {
    if column < columns {
        if fused == 1 { return ieee64_fma(weight, input, accumulator); }
        else { return ieee64_add(ieee64_mul(weight, input), accumulator); }
    } else { return accumulator; }
}

fn numeric_projection_output(index: u64, cells: u64, value: u64) -> u64 {
    if index < cells { return value; } else { return 0; }
}

#[kernel]
fn numeric_projection(thread: GpuThread, weights: *u64, weights_count: u64,
                      input: *u64, input_count: u64, output: *u64,
                      rows: u64, tokens: u64, columns: u64, bias: u64, fused: u64) {
    let index: u64 = gpu_global_index(thread);
    let row: u64 = index % rows;
    let token: u64 = index / rows;
    let w0: u64 = gpu_bounded_load_u64(weights, weights_count, row * 8);
    let x0: u64 = gpu_bounded_load_u64(input, input_count, token * 8);
    let s0: u64 = numeric_projection_step(0, columns, w0, x0, bias, fused);
    let w1: u64 = gpu_bounded_load_u64(weights, weights_count, row * 8 + 1);
    let x1: u64 = gpu_bounded_load_u64(input, input_count, token * 8 + 1);
    let s1: u64 = numeric_projection_step(1, columns, w1, x1, s0, fused);
    let w2: u64 = gpu_bounded_load_u64(weights, weights_count, row * 8 + 2);
    let x2: u64 = gpu_bounded_load_u64(input, input_count, token * 8 + 2);
    let s2: u64 = numeric_projection_step(2, columns, w2, x2, s1, fused);
    let w3: u64 = gpu_bounded_load_u64(weights, weights_count, row * 8 + 3);
    let x3: u64 = gpu_bounded_load_u64(input, input_count, token * 8 + 3);
    let s3: u64 = numeric_projection_step(3, columns, w3, x3, s2, fused);
    let w4: u64 = gpu_bounded_load_u64(weights, weights_count, row * 8 + 4);
    let x4: u64 = gpu_bounded_load_u64(input, input_count, token * 8 + 4);
    let s4: u64 = numeric_projection_step(4, columns, w4, x4, s3, fused);
    let w5: u64 = gpu_bounded_load_u64(weights, weights_count, row * 8 + 5);
    let x5: u64 = gpu_bounded_load_u64(input, input_count, token * 8 + 5);
    let s5: u64 = numeric_projection_step(5, columns, w5, x5, s4, fused);
    let w6: u64 = gpu_bounded_load_u64(weights, weights_count, row * 8 + 6);
    let x6: u64 = gpu_bounded_load_u64(input, input_count, token * 8 + 6);
    let s6: u64 = numeric_projection_step(6, columns, w6, x6, s5, fused);
    let w7: u64 = gpu_bounded_load_u64(weights, weights_count, row * 8 + 7);
    let x7: u64 = gpu_bounded_load_u64(input, input_count, token * 8 + 7);
    let s7: u64 = numeric_projection_step(7, columns, w7, x7, s6, fused);
    output[index] = numeric_projection_output(index, rows * tokens, s7);
}

fn numeric_projection_valid(rows: u64, tokens: u64, columns: u64,
                            weights_count: u64, input_count: u64, fused: u64) -> bool {
    if rows == 0 || tokens == 0 || columns == 0 || columns > 8 || fused > 1 { return false; }
    if rows > 288230376151711743 || tokens > 288230376151711743 { return false; }
    if weights_count != rows * 8 || input_count != tokens * 8 { return false; }
    if rows > 9223372036854775807 / tokens { return false; }
    return true;
}
