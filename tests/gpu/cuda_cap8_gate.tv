// SPDX-License-Identifier: Apache-2.0
// Multi-capture launch gate: one Traveler source supplies the CPU oracle and
// an eight-capture NVPTX worker (kernel(cap0..cap7, lo, hi)). Distinct plane
// weights make any capture-order mistake visible in the byte compare. The
// executable links no project C or CUDA source.

import "../../src/lib/gpu/cuda_runtime.tv";

fn main(argc: i32, argv: **u8) -> i32 {
    if argc != 2 { return 2; }
    let n: i32 = 4096;
    let bytes: usize = (n as usize) * 4;
    let q0: *i32 = alloc(n);
    let q1: *i32 = alloc(n);
    let q2: *i32 = alloc(n);
    let q3: *i32 = alloc(n);
    let x: *i32 = alloc(n);
    let scales: *i32 = alloc(n);
    let mins: *i32 = alloc(n);
    let expected: *i32 = alloc(n);
    let output: *i32 = alloc(n);
    var i: i32 = 0;
    while i < n {
        q0[i] = i * 2654435761;
        q1[i] = i * 2246822519 + 3;
        q2[i] = i * 3266489917 + 5;
        q3[i] = i * 668265263 + 11;
        x[i] = i * 40503 + 7;
        scales[i] = i * 286293 + 1;
        mins[i] = i * 101 + 13;
        expected[i] = 0;
        output[i] = 0;
        i = i + 1;
    }

    for j in 0..4096 {
        expected[j] = udot4(q0[j], x[j] ^ 0x80808080, 0)
            + 2 * udot4(q1[j], x[j] ^ 0x80808080, 0)
            + 3 * udot4(q2[j], x[j] ^ 0x80808080, 0)
            + 5 * udot4(q3[j], scales[j], 0)
            + mins[j];
    }

    let runtime: *CudaRuntime = cuda_runtime_open(
        argv[1], "__pfor_gpu_worker_0", bytes, bytes);
    if runtime == null {
        print(g_cuda_error);
        print(g_cuda_status);
        return 1;
    }
    // Device walk order for the worker body: q0, x, q1, q2, q3, scales,
    // mins, out. Host slots must match the emitted kernel signature.
    let host: **u8 = alloc(8);
    host[0] = q0 as *u8;
    host[1] = x as *u8;
    host[2] = q1 as *u8;
    host[3] = q2 as *u8;
    host[4] = q3 as *u8;
    host[5] = scales as *u8;
    host[6] = mins as *u8;
    host[7] = output as *u8;
    let nbytes: *usize = alloc(8);
    i = 0;
    while i < 8 {
        nbytes[i] = bytes;
        i = i + 1;
    }
    let ran: i32 = cuda_runtime_launch_caps(runtime, host, nbytes, 8, 0, n);
    cuda_runtime_close(runtime);
    if ran == 0 || cuda_dispatches() != 1 {
        print(g_cuda_error);
        print(g_cuda_status);
        return 1;
    }

    i = 0;
    while i < n {
        if output[i] != expected[i] {
            print(100 + i);
            print(output[i] as i64);
            print(expected[i] as i64);
            return 1;
        }
        i = i + 1;
    }
    print(1);
    return 0;
}
