// LANG1-H4: a statically resolved trait operator inlines before scalarization.

field AgxLang1OperatorF = Field<2013265921>;

struct AgxLang1OperatorBox {
    value: AgxLang1OperatorF,
}

trait Add {
    fn add(self, other: AgxLang1OperatorBox) -> AgxLang1OperatorF;
}

impl Add for AgxLang1OperatorBox {
    fn add(self, other: AgxLang1OperatorBox) -> AgxLang1OperatorF {
        return other.value;
    }
}

fn agx_lang1_operator_init(left: *AgxLang1OperatorF,
                           right: *AgxLang1OperatorF, n: i32) {
    let prime: u64 = 2013265921;
    var state: u64 = 0x6a09e667f3bcc909;
    var i: i32 = 0;
    while i < n {
        state = state * (6364136223846793005 as u64)
            + (1442695040888963407 as u64);
        left[i] = (state % prime) as AgxLang1OperatorF;
        state = state * (6364136223846793005 as u64)
            + (1442695040888963407 as u64);
        right[i] = (state % prime) as AgxLang1OperatorF;
        i = i + 1;
    }
}

fn agx_lang1_operator(left: *AgxLang1OperatorF,
                      right: *AgxLang1OperatorF,
                      output: *AgxLang1OperatorF) {
    for j in 0..768 {
        let a: AgxLang1OperatorBox = AgxLang1OperatorBox { value: left[j] };
        let b: AgxLang1OperatorBox = AgxLang1OperatorBox { value: right[j] };
        let via_trait: AgxLang1OperatorF =
            Add__AgxLang1OperatorBox__add(&a, b);
        let via_operator: AgxLang1OperatorF = a + b;
        var chosen: AgxLang1OperatorF = via_trait;
        if via_trait == via_operator { chosen = via_operator; }
        output[j] = chosen;
    }
}
