// gpu_wavepipe_dot.tv — emitter software pipelining: the two wave loads
// become loop-carried phis (prologue + guarded reload at the body head).
// Exactly 4 i64 loads remain: 2 prologue, 2 reload. @internal-design: stage1-dot.

fn main() -> i32 {
    let w: *i64 = alloc(4 * 4 * 32);
    let x: *i64 = alloc(4 * 4 * 32);
    let out: *i64 = alloc(4);
    for i in 0..4 {
        var acc: i64 = 0;
        for b in 0..4 {
            var p: i32 = 0;
            for lane in 0..32 {
                p = p + ((w[(i * 4 + b) * 32 + lane]
                          * x[(i * 4 + b) * 32 + lane]) as i32);
            }
            acc = acc + (p as i64);
        }
        out[i] = acc;
    }
    free(out); free(x); free(w);
    return 0;
}
