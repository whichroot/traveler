// LANG1-H3: a bounded private fixed array scalarizes at constant indices.

field AgxLang1ArrayF = Field<2013265921>;

fn agx_lang1_array_init(left: *AgxLang1ArrayF, right: *AgxLang1ArrayF,
                        n: i32) {
    let prime: u64 = 2013265921;
    var state: u64 = 0x6a09e667f3bcc909;
    var i: i32 = 0;
    while i < n {
        state = state * (6364136223846793005 as u64)
            + (1442695040888963407 as u64);
        left[i] = (state % prime) as AgxLang1ArrayF;
        state = state * (6364136223846793005 as u64)
            + (1442695040888963407 as u64);
        right[i] = (state % prime) as AgxLang1ArrayF;
        i = i + 1;
    }
    left[0] = 0; right[0] = 13;
    left[1] = 3; right[1] = 5;
    left[2] = 7; right[2] = 11;
    left[3] = 19; right[3] = 2;
}

fn agx_lang1_array(left: *AgxLang1ArrayF, right: *AgxLang1ArrayF,
                   output: *AgxLang1ArrayF) {
    for j in 0..768 {
        let a: AgxLang1ArrayF = left[j];
        let b: AgxLang1ArrayF = right[j];
        var score: [i32; 4] = 0;
        score[0] = 1;
        score[1] = 2;
        score[2] = score[0] + score[1];
        var chosen: AgxLang1ArrayF = a;
        if a < b && score[2] == 3 { chosen = b; }
        output[j] = chosen;
    }
}
