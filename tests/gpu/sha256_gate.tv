import "../../src/lib/crypto/sha256.tv";
import "../../src/lib/fs/fs.tv";

fn main(argc: i32, argv: **u8) -> i32 {
    if argc != 2 { return 1; }
    match fs_read_to_string(argv[1]) {
        Result::Err(e) => { return 1; },
        Result::Ok(input) => {
            var data: Str = input;
            let digest: *u8 = alloc(32);
            sha256(data.data, data.len as usize, digest);
            var i: i32 = 0;
            while i < 32 { print(digest[i] as i32); i = i + 1; }
            free(digest); str_free(&data);
            return 0;
        },
    }
    return 1;
}
