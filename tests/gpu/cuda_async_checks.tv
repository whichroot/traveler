import "cuda_resident_checks.tv";
import "../../src/lib/gpu/cuda_async.tv";

fn async_pipeline(path: *u8, expected_sm: u64) {
    let d: u64 = resident_need(cuda_device_open(0));
    if expected_sm != 0 && resident_need(cuda_device_sm(d)) != expected_sm { exit(15); }
    let m: u64 = resident_need(cuda_module_load(d, path));
    let root: u64 = resident_need(cuda_kernel_get_owner(m, "async_root"));
    let left: u64 = resident_need(cuda_kernel_get_owner(m, "async_left"));
    let right: u64 = resident_need(cuda_kernel_get_owner(m, "async_right"));
    let join: u64 = resident_need(cuda_kernel_get_owner(m, "async_join"));
    let independent: u64 = resident_need(cuda_kernel_get_owner(m, "async_independent"));
    let streams: *u64 = alloc(4); let events: *u64 = alloc(4); let buffers: *u64 = alloc(5);
    let views: *CudaArgument = alloc(5); let host: *u64 = alloc(288);
    for i in 0..4 {
        streams[i] = resident_need(cuda_stream_create(d)); events[i] = resident_need(cuda_event_create(d));
    }
    for i in 0..5 {
        buffers[i] = resident_need(cuda_buffer_alloc(d, 288*8));
        views[i] = resident_typed_view(buffers[i], 0, 288*8, 0-64);
    }
    let geometry: CudaGeometry = CudaGeometry { grid_x: 9, grid_y: 1, grid_z: 1, block_x: 32, block_y: 1, block_z: 1, shared_bytes: 0 };
    let args: *CudaArgument = alloc(3);
    resident_refused(cuda_event_query(events[0])); resident_refused(cuda_event_sync(events[0]));
    resident_refused(cuda_stream_wait_event(streams[1], events[0]));
    resident_refused(cuda_stream_query(d)); resident_refused(cuda_device_close(d));
    let other: u64 = resident_need(cuda_device_open(0));
    let foreign: u64 = resident_need(cuda_stream_create(other));
    args[0] = views[0]; args[1] = views[1];
    resident_refused(cuda_launch_async(independent, streams[0], 0-1, 288, args, 2));
    resident_refused(cuda_launch_async(root, streams[0], 0, 288, args, 2));
    resident_refused(cuda_launch_grid_async(root, foreign, geometry, args, 2));
    resident_refused(cuda_event_record(events[0], foreign));
    resident_refused(cuda_stream_wait_event(foreign, events[0]));
    resident_need(cuda_stream_close(foreign)); resident_need(cuda_device_close(other));
    for round in 0..8 {
        for i in 0..288 { host[i] = (i+round*7) as u64; }
        resident_need(cuda_upload(views[0], host as *u8, 288*8));
        resident_need(cuda_event_record(events[3], streams[0]));
        args[0] = views[0]; args[1] = views[1];
        resident_refused(cuda_launch_grid_async(root, 0, geometry, args, 2));
        if round % 2 == 0 { resident_need(cuda_launch_grid_async(root, streams[0], geometry, args, 2)); }
        else { resident_need(cuda_launch_async(independent, streams[0], 0, 288, args, 2)); }
        resident_need(cuda_event_record(events[0], streams[0]));
        resident_need(cuda_event_sync(events[3]));
        resident_refused(cuda_buffer_close(buffers[0]));
        resident_refused(cuda_upload(views[0], host as *u8, 288*8));
        resident_refused(cuda_launch_grid_sync(root, geometry, args, 2));
        resident_refused(cuda_event_record(events[0], streams[0]));
        resident_refused(cuda_event_close(events[0]));
        resident_need(cuda_stream_wait_event(streams[1], events[0]));
        resident_need(cuda_stream_wait_event(streams[2], events[0]));
        args[0] = views[1]; args[1] = views[2];
        resident_need(cuda_launch_grid_async(left, streams[1], geometry, args, 2));
        resident_need(cuda_event_record(events[1], streams[1]));
        args[1] = views[3];
        resident_need(cuda_launch_grid_async(right, streams[2], geometry, args, 2));
        resident_need(cuda_event_record(events[2], streams[2]));
        resident_need(cuda_stream_wait_event(streams[3], events[1]));
        resident_need(cuda_stream_wait_event(streams[3], events[2]));
        args[0] = views[2]; args[1] = views[3]; args[2] = views[4];
        resident_need(cuda_launch_grid_async(join, streams[3], geometry, args, 3));
        resident_refused(cuda_module_close(m)); resident_refused(cuda_buffer_close(buffers[4]));
        resident_refused(cuda_download(host as *u8, views[4], 288*8));
        if resident_need(cuda_stream_query(streams[3])) > 1 || resident_need(cuda_event_query(events[2])) > 1 { exit(11); }
        resident_need(cuda_stream_sync(streams[3]));
        resident_need(cuda_download(host as *u8, views[4], 288*8));
        for i in 0..288 { if host[i] != ((i+round*7)*4+8) as u64 { exit(12); } }
        if resident_need(cuda_event_query(events[0])) != 1 { exit(13); }
        resident_need(cuda_event_sync(events[1]));
        for i in 0..3 { if resident_need(cuda_stream_query(streams[i])) != 1 { exit(14); } }
    }
    for i in 0..4 { resident_need(cuda_stream_close(streams[i])); }
    for i in 0..4 {
        resident_need(cuda_event_sync(events[i])); resident_need(cuda_event_close(events[i]));
        resident_refused(cuda_event_query(events[i])); resident_refused(cuda_stream_sync(streams[i]));
    }
    let replacement: u64 = resident_need(cuda_stream_create(d));
    resident_refused(cuda_stream_sync(streams[0])); resident_need(cuda_stream_close(replacement));
    for i in 0..5 { resident_need(cuda_buffer_close(buffers[i])); }
    resident_need(cuda_module_close(m)); resident_need(cuda_device_close(d));
    free(streams); free(events); free(buffers); free(views); free(host); free(args);
    puts("async fork/join PASS");
}
