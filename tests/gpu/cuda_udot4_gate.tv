// SPDX-License-Identifier: Apache-2.0
// dp4a lowering gate: one Traveler source supplies the CPU oracle (udot4
// byte expansion) and the NVPTX device kernel (dp4a.u32.u32 inline asm).
// The executable links no project C or CUDA source.

import "../../src/lib/gpu/cuda_runtime.tv";

fn main(argc: i32, argv: **u8) -> i32 {
    if argc != 2 { return 2; }
    let n: i32 = 4096;
    let bytes: usize = (n as usize) * 4;
    let q: *i32 = alloc(n);
    let x: *i32 = alloc(n);
    let expected: *i32 = alloc(n);
    let output: *i32 = alloc(n);
    var i: i32 = 0;
    while i < n {
        q[i] = i * 2654435761;
        x[i] = i * 40503 + 7;
        expected[i] = 0;
        output[i] = 0;
        i = i + 1;
    }

    for j in 0..4096 {
        expected[j] = udot4(q[j], x[j] ^ 0x80808080, 0)
            + udot4(q[j], 0x01010101, 0);
    }

    let runtime: *CudaRuntime = cuda_runtime_open(
        argv[1], "__pfor_gpu_worker_0", bytes, bytes);
    if runtime == null {
        print(g_cuda_error);
        print(g_cuda_status);
        free(output); free(expected); free(x); free(q);
        return 1;
    }
    let ran: i32 = cuda_runtime_launch_dot_k8(
        runtime, q as *u8, bytes, x as *u8, bytes,
        output as *u8, bytes, 0, n);
    cuda_runtime_close(runtime);
    if ran == 0 || cuda_dispatches() != 1 {
        print(g_cuda_error);
        print(g_cuda_status);
        free(output); free(expected); free(x); free(q);
        return 1;
    }

    i = 0;
    while i < n {
        if output[i] != expected[i] {
            print(100 + i);
            print(output[i] as i64);
            print(expected[i] as i64);
            free(output); free(expected); free(x); free(q);
            return 1;
        }
        i = i + 1;
    }
    free(output); free(expected); free(x); free(q);
    print(1);
    return 0;
}
