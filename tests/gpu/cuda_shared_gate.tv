import "cuda_resident_checks.tv";
extern "C" fn strtoull(text: *u8, end: **u8, base: i32) -> u64;

fn shared_input(path: *u8) -> Str {
    match fs_read_to_string(path) {
        Result::Ok(value) => { return value; },
        Result::Err(error) => { exit(1); },
    }
    exit(1); return str_new();
}

fn main(argc: i32, argv: **u8) -> i32 {
    if argc != 12 { return 1; }
    var data: Str = shared_input(argv[3]);
    let geometry: CudaGeometry = CudaGeometry {
        grid_x: strtoull(argv[5], null, 10), grid_y: strtoull(argv[6], null, 10), grid_z: strtoull(argv[7], null, 10),
        block_x: strtoull(argv[8], null, 10), block_y: strtoull(argv[9], null, 10), block_z: strtoull(argv[10], null, 10),
        shared_bytes: 0 };
    let device: u64 = resident_need(cuda_device_open(0));
    let module: u64 = resident_need(cuda_module_load(device, argv[1]));
    let kernel: u64 = resident_need(cuda_kernel_get_owner(module, argv[2]));
    let input: u64 = resident_need(cuda_buffer_alloc(device, data.len as u64 + 16));
    let output: u64 = resident_need(cuda_buffer_alloc(device, data.len as u64 + 16));
    let vi: CudaArgument = resident_typed_view(input, 16, data.len as u64, 0 - 64);
    let vo: CudaArgument = resident_typed_view(output, 16, data.len as u64, 0 - 64);
    let args: *CudaArgument = alloc(3);
    resident_bind(kernel, args, "input", vi); resident_bind(kernel, args, "output", vo);
    resident_bind(kernel, args, "limit", cuda_arg_u64(strtoull(argv[11], null, 10)));
    resident_need(cuda_upload(vi, data.data, data.len as u64));
    resident_need(cuda_upload(vo, data.data, data.len as u64));
    resident_need(cuda_launch_grid_sync(kernel, geometry, args, 3));
    resident_need(cuda_launch_grid_sync(kernel, geometry, args, 3));
    resident_need(cuda_download(data.data, vo, data.len as u64));
    let file: *u8 = fopen(argv[4], "wb");
    if file == null { return 1; }
    let written: i64 = fwrite(data.data, 1, data.len as i64, file);
    if fclose(file) != 0 || written != data.len as i64 { return 1; }
    resident_need(cuda_buffer_close(input)); resident_need(cuda_buffer_close(output));
    resident_need(cuda_module_close(module)); resident_need(cuda_device_close(device));
    free(args); str_free(&data);
    return 0;
}
