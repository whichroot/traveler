// LANG1-H4: pure direct and monomorphized generic calls inline into EIR.

field AgxLang1CallF = Field<2013265921>;

fn agx_lang1_call_init(left: *AgxLang1CallF, right: *AgxLang1CallF,
                       n: i32) {
    let prime: u64 = 2013265921;
    var state: u64 = 0x6a09e667f3bcc909;
    var i: i32 = 0;
    while i < n {
        state = state * (6364136223846793005 as u64)
            + (1442695040888963407 as u64);
        left[i] = (state % prime) as AgxLang1CallF;
        state = state * (6364136223846793005 as u64)
            + (1442695040888963407 as u64);
        right[i] = (state % prime) as AgxLang1CallF;
        i = i + 1;
    }
    left[0] = 0; right[0] = 13;
    left[1] = 3; right[1] = 5;
    left[2] = 7; right[2] = 11;
    left[3] = 19; right[3] = 2;
}

fn agx_lang1_less(a: AgxLang1CallF, b: AgxLang1CallF) -> i1 {
    return a < b;
}

fn agx_lang1_identity<T>(value: T) -> T {
    return value;
}

fn agx_lang1_call(left: *AgxLang1CallF, right: *AgxLang1CallF,
                  output: *AgxLang1CallF) {
    for j in 0..768 {
        var chosen: AgxLang1CallF = left[j];
        if agx_lang1_less(left[j], right[j]) {
            chosen = agx_lang1_identity(right[j]);
        }
        output[j] = chosen;
    }
}
