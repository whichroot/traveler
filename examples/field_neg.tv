// field_neg.tv — unary negation on field elements is the ADDITIVE INVERSE
// (field_sub(0, x)), never a two's-complement wrap. Regression gate: the raw
// `sub iN 0, x` used to leave the canonical residue class, so -100 over
// Field<251> printed 156 and a + (-a) printed 5 (not 0). tvc_self-only — the
// frozen C seed keeps the wrap semantics.
field F = Field<251>;
binfield G = BinField<8, 0x11B>;

fn main() {
    // Prime field: -a == p - a; a + (-a) == 0; -0 == 0
    let a: F = 100;
    let na: F = -a;
    print(na);        // 151  (251 - 100)
    print(a + na);    // 0
    let z: F = 0;
    print(-z);        // 0
    let b: F = 250;   // == -1
    print(-b);        // 1

    // Binary field GF(2^8): sub == add == XOR, so -x == x.
    let g: G = 0x53;
    let ng: G = -g;
    print(ng);        // 83   (0x53)
    print(g + ng);    // 0
}
