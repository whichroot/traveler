fn fill_reftable(ref: *i64, w: *i64) {
    w[0] = 6; w[1] = 7; w[2] = 8; w[3] = 9; w[4] = 5; w[5] = 5; w[6] = 4;
    w[7] = 5; w[8] = 31; w[9] = 43; w[10] = 63; w[11] = 44; w[12] = 79;
    ref[0]=11; ref[1]=10; ref[2]=8; ref[3]=8; ref[4]=16; ref[5]=14; ref[6]=17;
    ref[7]=14; ref[8]=1; ref[9]=2; ref[10]=1; ref[11]=2; ref[12]=0;
    ref[13]=12; ref[14]=11; ref[15]=4; ref[16]=4; ref[17]=12; ref[18]=10;
    ref[19]=13; ref[20]=11; ref[21]=0; ref[22]=2; ref[23]=0; ref[24]=2; ref[25]=0;
    ref[26]=13; ref[27]=12; ref[28]=16; ref[29]=15; ref[30]=23; ref[31]=19;
    ref[32]=24; ref[33]=20; ref[34]=2; ref[35]=2; ref[36]=0; ref[37]=2; ref[38]=0-2;
    ref[39]=14; ref[40]=13; ref[41]=19; ref[42]=17; ref[43]=25; ref[44]=21;
    ref[45]=26; ref[46]=21; ref[47]=8; ref[48]=2; ref[49]=3; ref[50]=0-2; ref[51]=0-1;
    ref[52]=19; ref[53]=16; ref[54]=11; ref[55]=10; ref[56]=22; ref[57]=18;
    ref[58]=23; ref[59]=19; ref[60]=0; ref[61]=0; ref[62]=0; ref[63]=2; ref[64]=0-2;
    ref[65]=12; ref[66]=11; ref[67]=18; ref[68]=16; ref[69]=23; ref[70]=19;
    ref[71]=23; ref[72]=20; ref[73]=2; ref[74]=1; ref[75]=1; ref[76]=0; ref[77]=0;
    ref[78]=15; ref[79]=13; ref[80]=10; ref[81]=9; ref[82]=20; ref[83]=16;
    ref[84]=20; ref[85]=17; ref[86]=0-2; ref[87]=1; ref[88]=0; ref[89]=2; ref[90]=1;
    ref[91]=14; ref[92]=13; ref[93]=10; ref[94]=9; ref[95]=18; ref[96]=16;
    ref[97]=19; ref[98]=16; ref[99]=3; ref[100]=2; ref[101]=1; ref[102]=0; ref[103]=0;
    ref[104]=13; ref[105]=12; ref[106]=10; ref[107]=9; ref[108]=18; ref[109]=15;
    ref[110]=19; ref[111]=16; ref[112]=0-1; ref[113]=2; ref[114]=0; ref[115]=2; ref[116]=0;
    ref[117]=14; ref[118]=12; ref[119]=9; ref[120]=8; ref[121]=17; ref[122]=14;
    ref[123]=18; ref[124]=15; ref[125]=1; ref[126]=2; ref[127]=0; ref[128]=0; ref[129]=1;
}

// expected oracle feature vector for test image 0 (label 7)
fn fill_expected(e: *i64) {
    e[0]=18; e[1]=14; e[2]=10; e[3]=9; e[4]=22; e[5]=17; e[6]=23; e[7]=19;
    e[8]=2; e[9]=3; e[10]=1; e[11]=3; e[12]=0-1;
}

fn classify_image(p: i64, ref: *i64, w: *i64, fv: *i64, dists: *i64) -> i32 {
    let f: Field = field(p);
    let cap: i32 = 4096;
    let img: *u8 = alloc(784);
    let cx: *i64 = alloc(cap);
    let cy: *i64 = alloc(cap);
    let vbuf: *i64 = alloc(cap);
    let t: *i64 = alloc(cap);
    let cert: *i64 = alloc(cap * 3);
    let work: *i64 = alloc(cap);
    fill_image(img);
    let n: i32 = trace_contour(img, 64, cx, cy, cap);
    gc_features(f, cx, cy, n, vbuf, t, cert, work, fv);
    let bc: i32 = gc_classify(fv, ref, w, dists);
    free(img); free(cx); free(cy); free(vbuf); free(t); free(cert); free(work);
    return bc;
}

fn main() -> i32 {
    let gold: i64 = 18446744069414584321;
    let baby: i64 = 2013265921;
    let nbits: i32 = 20;

    let ref: *i64 = alloc(130);
    let w: *i64 = alloc(13);
    fill_reftable(ref, w);
    let expected: *i64 = alloc(13);
    fill_expected(expected);

    let fv: *i64 = alloc(13);
    let dists: *i64 = alloc(10);
    let bc: i32 = classify_image(gold, ref, w, fv, dists);

    wr(2, "feature vector: ");
    var j: i32 = 0;
    while j < 13 { wr_int(2, fv[j]); wr(2, " "); j = j + 1; }
    wr(2, "\nweighted distances: ");
    j = 0;
    while j < 10 { wr_int(2, dists[j]); wr(2, " "); j = j + 1; }
    wr(2, "\nargmin class: "); wr_int(2, bc as i64); wr(2, "\n");

    // ---- Test 1: feature vector matches oracle ----
    var t1: i32 = 1;
    j = 0;
    while j < 13 { if fv[j] != expected[j] { t1 = 0; } j = j + 1; }

    // ---- Test 2: decision = class 7 ----
    var t2: i32 = 0;
    if bc == 7 { t2 = 1; }

    // ---- Test 3: winner distance is strict minimum ----
    var t3: i32 = 1;
    j = 0;
    while j < 10 {
        if j != bc { if dists[j] <= dists[bc] { t3 = 0; } }
        j = j + 1;
    }

    // ---- Test 4: argmin dominance certificate verifies (honest claim = bc) ----
    let t4: i32 = gc_certify_argmin(gold, dists, bc, nbits);

    // ---- Test 5: tampered decision (claim 3) is rejected ----
    let t5: i32 = gc_certify_argmin(gold, dists, 3, nbits);

    // ---- Test 6: field-invariant classification over BabyBear ----
    let fv_b: *i64 = alloc(13);
    let dists_b: *i64 = alloc(10);
    let bc_b: i32 = classify_image(baby, ref, w, fv_b, dists_b);
    var t6: i32 = 0;
    if bc_b == bc { t6 = 1; }

    print(t1);
    print(t2);
    print(t3);
    print(t4);
    print(t5);
    print(t6);

    return 0;
}
