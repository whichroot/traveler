// Author: Matt Flores
// genus_classify_test.tv — hermetic validation of the verifiable genus
// classifier (Phase 2): embedded MNIST image 0 (label 7), full ZK argmin chain.
// @internal-design: genus (genus_classifier section)
//
// Tests (each 1 = pass):
//   1. feature vector reproduces the oracle EXACTLY (13 ints)               -> 1
//   2. nearest-signature decision = class 7 (the true label, correct here)  -> 1
//   3. winner's weighted distance is the minimum (margin > 0)               -> 1
//   4. argmin DOMINANCE certificate VERIFIES (9 leq proofs all accept)      -> 1
//   5. a TAMPERED decision (claim class 3) is REJECTED by the certificate   -> 0
//   6. field-invariant: same classification over BabyBear                   -> 1
//
// Expected output: 1 1 1 1 0 1
//
// Link: plonk_dyn.o + regime_fri.o + zk_range.o + genus_classifier.o +
//       genus_classify_test.o (tvc_self-only).

extern "C" fn write(fd: i32, buf: *u8, n: usize) -> i64;
extern "C" fn strlen(s: *u8) -> usize;
extern "C" fn gc_features(
    f: Field, cx: *i64, cy: *i64, n: i32,
    vbuf: *i64, t: *i64, cert: *i64, work: *i64, out: *i64) -> i32;
extern "C" fn gc_classify(fv: *i64, ref_tbl: *i64, w: *i64, dists: *i64) -> i32;
extern "C" fn gc_certify_argmin(p: i64, dists: *i64, claim: i32, nbits: i32) -> i32;

fn wr(fd: i32, s: *u8) { let len: usize = strlen(s); write(fd, s, len); }
fn wr_int(fd: i32, n: i64) {
    if n < 0 { write(fd, "-", 1); wr_int(fd, 0 - n); return; }
    if n >= 10 { wr_int(fd, n / 10); }
    var d: [u8; 1] = 0;
    d[0] = ((n % 10) + 48) as u8;
    write(fd, &d[0], 1);
}

fn is_ink(img: *u8, x: i32, y: i32, thr: i32) -> i32 {
    if x < 0 { return 0; }
    if y < 0 { return 0; }
    if x > 27 { return 0; }
    if y > 27 { return 0; }
    if (img[y * 28 + x] as i32) > thr { return 1; }
    return 0;
}
fn trace_contour(img: *u8, thr: i32, cx: *i64, cy: *i64, max_len: i32) -> i32 {
    var dx: [i32; 8] = 0;
    var dy: [i32; 8] = 0;
    dx[0]=1;  dy[0]=0;
    dx[1]=1;  dy[1]=1;
    dx[2]=0;  dy[2]=1;
    dx[3]=0-1; dy[3]=1;
    dx[4]=0-1; dy[4]=0;
    dx[5]=0-1; dy[5]=0-1;
    dx[6]=0;  dy[6]=0-1;
    dx[7]=1;  dy[7]=0-1;
    var sx: i32 = 0-1;
    var sy: i32 = 0-1;
    var yy: i32 = 0;
    while yy < 28 {
        var xx: i32 = 0;
        while xx < 28 {
            if is_ink(img, xx, yy, thr) == 1 { sx = xx; sy = yy; xx = 28; yy = 28; }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    if sx < 0 { return 0; }
    cx[0] = sx as i64; cy[0] = sy as i64;
    var clen: i32 = 1;
    var curx: i32 = sx;
    var cury: i32 = sy;
    var b: i32 = 4;
    var steps: i32 = 0;
    while steps < max_len {
        var found: i32 = 0 - 1;
        var k: i32 = 0;
        while k < 8 {
            let dd: i32 = (b + 1 + k) % 8;
            let nx: i32 = curx + dx[dd];
            let ny: i32 = cury + dy[dd];
            if is_ink(img, nx, ny, thr) == 1 { found = dd; k = 8; }
            k = k + 1;
        }
        if found < 0 { return clen; }
        let nxp: i32 = curx + dx[found];
        let nyp: i32 = cury + dy[found];
        if nxp == sx { if nyp == sy { return clen; } }
        if clen < max_len {
            cx[clen] = nxp as i64; cy[clen] = nyp as i64; clen = clen + 1;
        } else { return clen; }
        curx = nxp; cury = nyp;
        b = (found + 4) % 8;
        steps = steps + 1;
    }
    return clen;
}

// Embed MNIST test image 0 (true label 7): 116 nonzero pixels.
