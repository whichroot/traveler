// method_basics.tv — Method syntax: reg.advance() desugars to advance(&reg)
//
// Level 4 of Section 17: algebraic method resolution.
// Operations follow from the type's algebraic structure.
//
// Expected output: 10 14 20 28 38 50

type F = Field<251>;

fn main() {
    var reg: Register<F, 2> = register(10, 4, 2);

    let v0: F = reg.advance();
    let v1: F = reg.advance();
    let v2: F = reg.advance();
    let v3: F = reg.advance();
    let v4: F = reg.advance();
    let v5: F = reg.advance();

    print(v0);
    print(v1);
    print(v2);
    print(v3);
    print(v4);
    print(v5);
}
