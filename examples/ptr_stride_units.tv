// ptr_stride_units.tv — pointer indexing is element-scaled, not
// byte-scaled. @internal-note: known-issues #7d.
//
// Expected output: 4 3 7

fn main() {
    // 512 bytes = 128 words through the *u32 view.
    let bytes: *u8 = alloc(512);
    let words: *u32 = bytes as *u32;

    var i: i32 = 0;
    while i < 128 { words[i] = 0; i = i + 1; }

    // Grid B: the byte formula v*32 on a *u32 — a 4x stride.
    var v: i32 = 0;
    while v < 4 { words[v * 32] = 222; v = v + 1; }

    // Grid A: the correct word stride, 32 / 4 = 8. Overwrites B at word 0.
    v = 0;
    while v < 4 { words[v * 8] = 111; v = v + 1; }

    var ca: i32 = 0;
    var cb: i32 = 0;
    var cnz: i32 = 0;
    i = 0;
    while i < 128 {
        if words[i] == 111 { ca = ca + 1; }
        if words[i] == 222 { cb = cb + 1; }
        if words[i] != 0 { cnz = cnz + 1; }
        i = i + 1;
    }
    print(ca);   // 4: words 0, 8, 16, 24
    print(cb);   // 3: words 32, 64, 96 (word 0 was overwritten)
    print(cnz);  // 7: the grids do not share any other cell
}
