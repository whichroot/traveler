// Author: Matt Flores
// mds_check_test.tv — the B-MDS gate: the repo diagonal is MDS-valid over
// Goldilocks, INVALID over BabyBear; mds_generate_diag grain-repairs it.
// @internal-design: crypto
//
// Output (expected): 1 0 1 1 1
//   1  repo diagonal valid over Goldilocks            (transported param works HERE)
//   0  repo diagonal INVALID over BabyBear            (the finding: not generic)
//   1  generated BabyBear diagonal valid              (generator repairs genericity)
//   1  official Plonky3 BabyBear w16 diagonal valid   (soundness: check not vacuous; width-16)
//   1  generated diagonal != repo diagonal            (genuinely different parameter)
//
// 2-file link: mds_check.o + grain_lfsr.o.

extern "C" fn grain_init(state: *i64, n: i32, t: i32, rf: i32, rp: i32);
extern "C" fn grain_random_field_elem(f: Field, state: *i64, n: i32) -> i64;
extern "C" fn mds_check_diag_dyn(f: Field, pp: i64, v: *i64, t: i32) -> i32;
extern "C" fn mds_generate_diag(f: Field, pp: i64, n: i32, t: i32, gstate: *i64, out: *i64) -> i32;

// The repo internal-matrix diagonal v[i] = base[i] + 1, base = [-2,1,2,1/2,3,-1/2,-3,-4].
fn repo_diag(p: i64, half: i64, v: *i64) {
    v[0] = p - 1;        // -2 + 1 = -1
    v[1] = 2;            //  1 + 1
    v[2] = 3;            //  2 + 1
    v[3] = half + 1;     // 1/2 + 1
    v[4] = 4;            //  3 + 1
    v[5] = p - half + 1; // -1/2 + 1
    v[6] = p - 2;        // -3 + 1
    v[7] = p - 3;        // -4 + 1
}

fn main() -> i32 {
    // ---- 1. repo diagonal over Goldilocks: VALID ----
    let fg: Field = field(18446744069414584321);
    let pg: i64 = 18446744069414584321;
    let vg: *i64 = alloc(8);
    repo_diag(pg, 9223372034707292161, vg);       // inv(2) = (p+1)/2
    print(mds_check_diag_dyn(fg, pg, vg, 8));      // expect 1

    // ---- 2. repo diagonal over BabyBear: INVALID (the finding) ----
    let fb: Field = field(2013265921);
    let pb: i64 = 2013265921;
    let vb: *i64 = alloc(8);
    repo_diag(pb, 1006632961, vb);                 // inv(2) = (p+1)/2
    print(mds_check_diag_dyn(fb, pb, vb, 8));      // expect 0

    // ---- 3. generate a valid BabyBear diagonal: REPAIR ----
    let gstate: *i64 = alloc(80);
    grain_init(gstate, 31, 8, 8, 22);
    for i in 0..86 { grain_random_field_elem(fb, gstate, 31); }  // skip constant draws
    let gen: *i64 = alloc(8);
    mds_generate_diag(fb, pb, 31, 8, gstate, gen);
    print(mds_check_diag_dyn(fb, pb, gen, 8));     // expect 1

    // ---- 4. official Plonky3 BabyBear width-16 diagonal: VALID (soundness) ----
    let v16: *i64 = alloc(16);
    v16[0]=2013265919; v16[1]=1; v16[2]=2; v16[3]=1006632961;
    v16[4]=3; v16[5]=4; v16[6]=1006632960; v16[7]=2013265918;
    v16[8]=2013265917; v16[9]=2005401601; v16[10]=1509949441; v16[11]=1761607681;
    v16[12]=2013265906; v16[13]=7864320; v16[14]=125829120; v16[15]=15;
    print(mds_check_diag_dyn(fb, pb, v16, 16));    // expect 1

    // ---- 5. generated diagonal is genuinely different from the repo one ----
    var differ: i32 = 0;
    for i in 0..8 {
        if gen[i] != vb[i] { differ = 1; }
    }
    print(differ);                                  // expect 1

    return 0;
}
