// SPDX-License-Identifier: Apache-2.0
// Author: Matt Flores
// mnist_topology.tv — MNIST topological classification via enclosed area
//
// Applies the even-odd boundary intersection rule (validated in
// regime_intersect_test.tv) to MNIST: enclosed area = cells where both row
// and column boundary crossing counts are odd (hole area, not perimeter).
// @internal-design: genus (topology/enclosed-area hypothesis)
//
// Uses p=0 (raw integer mode) and order=1 (edge detection).
// Links with poly_core.tv (two-file link).
// Usage: ./mnist_topology <data_directory>

extern "C" fn open(path: *u8, flags: i32, mode: i32) -> i32;
extern "C" fn close(fd: i32) -> i32;
extern "C" fn write(fd: i32, buf: *u8, n: usize) -> i64;
extern "C" fn strlen(s: *u8) -> usize;
extern "C" fn exit(code: i32);

fn wr(fd: i32, s: *u8) {
    let len: usize = strlen(s);
    write(fd, s, len);
}

fn wr_int(fd: i32, n: i64) {
    if n < 0 {
        write(fd, "-", 1);
        wr_int(fd, 0 - n);
        return;
    }
    if n >= 10 {
        wr_int(fd, n / 10);
    }
    var d: [u8; 1] = 0;
    d[0] = ((n % 10) + 48) as u8;
    write(fd, &d[0], 1);
}

fn wr_int_pad(fd: i32, n: i64, w: i32) {
    var tmp: i64 = n;
    if tmp < 0 { tmp = 0 - tmp; }
    var digits: i32 = 1;
    while tmp >= 10 { tmp = tmp / 10; digits = digits + 1; }
    if n < 0 { digits = digits + 1; }
    var pad: i32 = w - digits;
    while pad > 0 { write(fd, " ", 1); pad = pad - 1; }
    wr_int(fd, n);
}

fn path_build(dst: *u8, dir: *u8, file: *u8) {
    var i: i32 = 0;
    while dir[i] != 0 { dst[i] = dir[i]; i = i + 1; }
    dst[i] = 47; i = i + 1;
    var j: i32 = 0;
    while file[j] != 0 { dst[i] = file[j]; i = i + 1; j = j + 1; }
    dst[i] = 0;
}

fn read_be_i32(buf: *u8, off: i32) -> i32 {
    return (buf[off] as i32) * 16777216
    + (buf[off + 1] as i32) * 65536
    + (buf[off + 2] as i32) * 256
    + (buf[off + 3] as i32);
}

extern "C" fn regime_detect(data: *i32, n: i32, order: i32, threshold: i32, p: i32, reg: *i32) -> i32;

// Collect all boundary positions in a 1D signal.
// Writes positions to out[0..return-1]. Returns count.
// max_out caps storage to prevent overflow.
fn collect_boundaries(data: *i32, n: i32, order: i32, threshold: i32, p: i32,
    reg: *i32, out: *i32, max_out: i32) -> i32 {
    var count: i32 = 0;
    var offset: i32 = 0;
    while n - offset > order + 1 {
        if count >= max_out { break; }
        let rem: i32 = n - offset;
        let b: i32 = regime_detect(&data[offset], rem, order, threshold, p, reg);
        if b >= rem { break; }
        out[count] = offset + b;
        count = count + 1;
        offset = offset + b;
    }
    return count;
}

// Compute enclosed area for one 28x28 image at a given threshold.
// img points to 784 u8 pixels (row-major).
//
// Buffers required (caller-owned):
//   row_buf:    [i32; 28]   — pixel conversion
//   col_buf:    [i32; 28]   — column extraction
//   reg:        [i32; 2]    — regime_detect register (order 1)
//   row_bounds: [i32; 392]  — 28 rows × 14 max boundaries
//   row_bcnt:   [i32; 28]   — boundary count per row
//   col_bounds: [i32; 392]  — 28 cols × 14 max boundaries
//   col_bcnt:   [i32; 28]   — boundary count per col
fn compute_image_enclosed(img: *u8, threshold: i32,
    row_buf: *i32, col_buf: *i32, reg: *i32,
    row_bounds: *i32, row_bcnt: *i32,
    col_bounds: *i32, col_bcnt: *i32) -> i32 {
    // Collect row boundaries
    var r: i32 = 0;
    while r < 28 {
        var c: i32 = 0;
        while c < 28 {
            row_buf[c] = img[r * 28 + c] as i32;
            c = c + 1;
        }
        let cnt: i32 = collect_boundaries(row_buf, 28, 1, threshold, 0, reg,
            &row_bounds[r * 14], 14);
        row_bcnt[r] = cnt;
        r = r + 1;
    }

    // Collect column boundaries
    var c: i32 = 0;
    while c < 28 {
        var r2: i32 = 0;
        while r2 < 28 {
            col_buf[r2] = img[r2 * 28 + c] as i32;
            r2 = r2 + 1;
        }
        let cnt: i32 = collect_boundaries(col_buf, 28, 1, threshold, 0, reg,
            &col_bounds[c * 14], 14);
        col_bcnt[c] = cnt;
        c = c + 1;
    }

    // Even-odd rule: count cells where both parities are odd
    var enclosed: i32 = 0;
    r = 0;
    while r < 28 {
        c = 0;
        while c < 28 {
            // Row boundaries at positions <= c
            var left: i32 = 0;
            var i: i32 = 0;
            while i < row_bcnt[r] {
                if row_bounds[r * 14 + i] <= c {
                    left = left + 1;
                }
                i = i + 1;
            }
            // Col boundaries at positions <= r
            var above: i32 = 0;
            i = 0;
            while i < col_bcnt[c] {
                if col_bounds[c * 14 + i] <= r {
                    above = above + 1;
                }
                i = i + 1;
            }
            if left % 2 == 1 {
                if above % 2 == 1 {
                    enclosed = enclosed + 1;
                }
            }
            c = c + 1;
        }
        r = r + 1;
    }
    return enclosed;
}

fn main(argc: i32, argv: **u8) {
    if argc < 2 {
        wr(2, "usage: mnist_topology <data_directory>\n");
        exit(1);
    }

    let dir: *u8 = argv[1];
    var path_buf: [u8; 512] = 0;

    // --- Load test set ---
    wr(2, "Loading test images...\n");
    let test_img: *u8 = alloc(7840016);
    path_build(&path_buf[0], dir, "t10k-images-idx3-ubyte");
    var fd: i32 = open(&path_buf[0], 0, 0);
    if fd < 0 { wr(2, "error: cannot open test images\n"); exit(1); }
    read_bytes(fd, test_img, 7840016);
    close(fd);

    let test_lbl: *u8 = alloc(10008);
    path_build(&path_buf[0], dir, "t10k-labels-idx1-ubyte");
    fd = open(&path_buf[0], 0, 0);
    if fd < 0 { wr(2, "error: cannot open test labels\n"); exit(1); }
    read_bytes(fd, test_lbl, 10008);
    close(fd);

    let n_test: i32 = read_be_i32(test_img, 4);
    wr(2, "  images: ");
    wr_int(2, n_test as i64);
    wr(2, "\n");

    // --- Thresholds ---
    var thresholds: [i32; 5] = 0;
    thresholds[0] = 5;
    thresholds[1] = 20;
    thresholds[2] = 50;
    thresholds[3] = 100;
    thresholds[4] = 150;

    // --- Accumulators: 10 classes × 5 thresholds ---
    var totals: [i32; 50] = 0;
    var counts: [i32; 10] = 0;

    // Shared buffers
    var row_buf: [i32; 28] = 0;
    var col_buf: [i32; 28] = 0;
    var reg: [i32; 2] = 0;
    var row_bounds: [i32; 392] = 0;
    var row_bcnt: [i32; 28] = 0;
    var col_bounds: [i32; 392] = 0;
    var col_bcnt: [i32; 28] = 0;

    // --- Process all test images ---
    wr(2, "Computing enclosed area...\n");
    var i: i32 = 0;
    while i < n_test {
        let label: i32 = test_lbl[8 + i] as i32;
        counts[label] = counts[label] + 1;

        let img: *u8 = &test_img[16 + i * 784];

        var ti: i32 = 0;
        while ti < 5 {
            let enc: i32 = compute_image_enclosed(img, thresholds[ti],
                &row_buf[0], &col_buf[0], &reg[0],
                &row_bounds[0], &row_bcnt[0],
                &col_bounds[0], &col_bcnt[0]);
            totals[label * 5 + ti] = totals[label * 5 + ti] + enc;
            ti = ti + 1;
        }

        if (i + 1) % 2000 == 0 {
            wr(2, "  ");
            wr_int(2, (i + 1) as i64);
            wr(2, " / ");
            wr_int(2, n_test as i64);
            wr(2, "\n");
        }

        i = i + 1;
    }

    // --- Report enclosed area profiles ---
    wr(1, "=== MNIST Enclosed Area (even-odd, order=1, p=0) ===\n");
    wr(1, "class    n     t=5   t=20   t=50  t=100  t=150\n");

    var cls: i32 = 0;
    while cls < 10 {
        wr(1, "    ");
        wr_int(1, cls as i64);
        wr_int_pad(1, counts[cls] as i64, 5);

        var ti: i32 = 0;
        while ti < 5 {
            let mean: i32 = totals[cls * 5 + ti] / counts[cls];
            wr_int_pad(1, mean as i64, 7);
            ti = ti + 1;
        }
        wr(1, "\n");

        cls = cls + 1;
    }

    // --- Summary ---
    wr(1, "  all");
    wr_int_pad(1, n_test as i64, 5);
    var ti: i32 = 0;
    while ti < 5 {
        var sum: i32 = 0;
        var cls2: i32 = 0;
        while cls2 < 10 {
            sum = sum + totals[cls2 * 5 + ti];
            cls2 = cls2 + 1;
        }
        let mean: i32 = sum / n_test;
        wr_int_pad(1, mean as i64, 7);
        ti = ti + 1;
    }
    wr(1, "\n");

    free(test_img);
    free(test_lbl);
}
