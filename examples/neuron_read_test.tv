// SPDX-License-Identifier: Apache-2.0
// Author: Matt Flores
// neuron_read_test.tv — PROBE P1 (hermetic): read a trained neuron's ridge
// response with the exact regime segmenter; ReLU kink recovered, tanh shatters.
// @internal-design: regime (neuron read; memo-2026-06-16 §7)
//
// Embeds the oracle's (neuron_read_oracle.py) exact integer activations: one
// ReLU ridge (kink on sample 8) and one smooth tanh ridge.
//
// Tests (each 1 = pass):
//   1. ReLU ridge reads as EXACTLY 2 segments (nseg=2)                       -> 1
//   2. the boundary RECOVERS the kink (boundary index == 9 == kink_sample+1)  -> 1
//   3. ReLU read is field-invariant (Goldilocks == BabyBear, both nseg=2)     -> 1
//   4. smooth tanh ridge SHATTERS under the exact deg-2 segmenter (nseg >= 8)  -> 1
//   5. smooth tanh ridge CONVERGES under the threshold deg-2 segmenter (nseg==1)-> 1
//
// Expected output: 1 1 1 1 1
//
// Two-file link: regime_fri.o + neuron_read_test.o (tvc_self-only).

extern "C" fn write(fd: i32, buf: *u8, n: usize) -> i64;
extern "C" fn strlen(s: *u8) -> usize;
extern "C" fn regime_prove_dyn(
    f: Field, data: *i64, n: i32, deg: i32, cert: *i64, work: *i64) -> i32;

fn wr(fd: i32, s: *u8) { let len: usize = strlen(s); write(fd, s, len); }
fn wr_int(fd: i32, n: i64) {
    if n < 0 { write(fd, "-", 1); wr_int(fd, 0 - n); return; }
    if n >= 10 { wr_int(fd, n / 10); }
    var d: [u8; 1] = 0;
    d[0] = ((n % 10) + 48) as u8;
    write(fd, &d[0], 1);
}
fn iabs(x: i64) -> i64 { if x < 0 { return 0 - x; } return x; }

// ReLU ridge: relu((t-8)*4942), N=40 (kink exactly on sample 8). From the oracle.
fn fill_relu(a: *i64) {
    var i: i32 = 0;
    while i < 40 { a[i] = 0; i = i + 1; }
    // flat 0 for t=0..8, then linear slope 4942 from t=9.
    let slope: i64 = 4942;
    var t: i32 = 9;
    while t < 40 {
        a[t] = ((t - 8) as i64) * slope;
        t = t + 1;
    }
}

// Smooth tanh ridge, N=40, Q=100000. Exact integer samples from the oracle.
fn fill_smooth(a: *i64) {
    a[0]=0-2772; a[1]=22318; a[2]=44763; a[3]=62701; a[4]=75788; a[5]=84714;
    a[6]=90527; a[7]=94199; a[8]=96474; a[9]=97866; a[10]=98713; a[11]=99224;
    a[12]=99533; a[13]=99719; a[14]=99831; a[15]=99899; a[16]=99939; a[17]=99963;
    a[18]=99978; a[19]=99987; a[20]=99992; a[21]=99995; a[22]=99997; a[23]=99998;
    a[24]=99999; a[25]=99999; a[26]=100000; a[27]=100000; a[28]=100000; a[29]=100000;
    a[30]=100000; a[31]=100000; a[32]=100000; a[33]=100000; a[34]=100000; a[35]=100000;
    a[36]=100000; a[37]=100000; a[38]=100000; a[39]=100000;
}

// Exact deg-1 segmentation that ALSO returns the first boundary index.
// Mirrors regime_prove but records where segment 2 starts.
fn regime_first_boundary(f: Field, data: *i64, n: i32, deg: i32,
    cert: *i64, work: *i64) -> i32 {
    let nseg: i32 = regime_prove_dyn(f, data, n, deg, cert, work);
    if nseg < 2 { return 0 - 1; }
    // cert[3*1 + 0] = start index of segment 1 (the first interior boundary).
    return cert[3] as i32;
}

// Threshold (tolerant) deg-d segmentation: a window fits if the (d+1)-th forward
// difference is <= tol in absolute value everywhere (integer magnitudes).
fn seg_fits_tol(data: *i64, a: i32, len: i32, deg: i32, tol: i64, work: *i64) -> i32 {
    if len <= deg + 1 { return 1; }
    var i: i32 = 0;
    while i < len { work[i] = data[a + i]; i = i + 1; }
    var rem: i32 = len;
    var level: i32 = 0;
    while level < (deg + 1) {
        var j: i32 = 0;
        while j < (rem - 1) { work[j] = work[j + 1] - work[j]; j = j + 1; }
        rem = rem - 1;
        level = level + 1;
    }
    var ok: i32 = 1;
    i = 0;
    while i < rem { if iabs(work[i]) > tol { ok = 0; } i = i + 1; }
    return ok;
}
fn regime_prove_tol(data: *i64, n: i32, deg: i32, tol: i64, work: *i64) -> i32 {
    var nseg: i32 = 0;
    var start: i32 = 0;
    while start < n {
        var len: i32 = deg + 1;
        if start + len > n { len = n - start; }
        while (start + len) < n {
            if seg_fits_tol(data, start, len + 1, deg, tol, work) == 0 { break; }
            len = len + 1;
        }
        nseg = nseg + 1;
        start = start + len;
    }
    return nseg;
}

fn main() -> i32 {
    let gold: Field = field(18446744069414584321);
    let baby: Field = field(2013265921);

    let cap: i32 = 64;
    let relu: *i64 = alloc(cap);
    let smooth: *i64 = alloc(cap);
    let cert: *i64 = alloc(cap * 3);
    let work: *i64 = alloc(cap);
    fill_relu(relu);
    fill_smooth(smooth);

    // ReLU exact read over Goldilocks
    let relu_nseg: i32 = regime_prove_dyn(gold, relu, 40, 1, cert, work);
    let relu_bnd: i32 = regime_first_boundary(gold, relu, 40, 1, cert, work);
    // ReLU over BabyBear (field-invariance)
    let relu_nseg_b: i32 = regime_prove_dyn(baby, relu, 40, 1, cert, work);

    // smooth exact deg-2 (shatter) over Goldilocks
    let smooth_exact: i32 = regime_prove_dyn(gold, smooth, 40, 2, cert, work);
    // smooth threshold deg-2 (converge), tol = 200000
    let smooth_thr: i32 = regime_prove_tol(smooth, 40, 2, 200000, work);

    wr(2, "ReLU: nseg="); wr_int(2, relu_nseg as i64);
    wr(2, " boundary="); wr_int(2, relu_bnd as i64);
    wr(2, " (Baby nseg="); wr_int(2, relu_nseg_b as i64); wr(2, ")\n");
    wr(2, "smooth: exact nseg(d2)="); wr_int(2, smooth_exact as i64);
    wr(2, " threshold nseg(d2)="); wr_int(2, smooth_thr as i64); wr(2, "\n");

    // ---- Test 1: ReLU reads as exactly 2 segments ----
    var t1: i32 = 0;
    if relu_nseg == 2 { t1 = 1; }

    // ---- Test 2: boundary recovers the kink (== 9 == kink_sample 8 + 1) ----
    var t2: i32 = 0;
    if relu_bnd == 9 { t2 = 1; }

    // ---- Test 3: field-invariant (Gold == Baby, both 2) ----
    var t3: i32 = 0;
    if relu_nseg == relu_nseg_b { if relu_nseg == 2 { t3 = 1; } }

    // ---- Test 4: smooth shatters under exact segmenter (nseg >= 8) ----
    var t4: i32 = 0;
    if smooth_exact >= 8 { t4 = 1; }

    // ---- Test 5: smooth converges under threshold segmenter (nseg == 1) ----
    var t5: i32 = 0;
    if smooth_thr == 1 { t5 = 1; }

    print(t1);
    print(t2);
    print(t3);
    print(t4);
    print(t5);

    return 0;
}
