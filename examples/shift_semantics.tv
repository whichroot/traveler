// shift_semantics.tv — pins right-shift semantics per operand type.
//
// >> on a signed type is ARITHMETIC (sign bit replicates).
// >> on an unsigned type is LOGICAL (zero fill).
//
// Why this gate exists: hash functions (splitmix64, xorshift) are written
// against bit patterns. Run one in i64 and the sign-extending shift smears
// the top bit through every xor, silently destroying avalanche. The splitmix64
// known-answer vectors below only pass when every step is a logical shift.
// (Found the hard way in the plane repo's K5 kernel: Traveler >> on i64 is
// arithmetic, so splitmix64 must run in u64.)

fn sm64(seed: u64) -> u64 {
    var z: u64 = seed + 11400714819323198485; // 0x9E3779B97F4A7C15
    z = (z ^ (z >> 30)) * 13787848793156543929; // 0xBF58476D1CE4E5B9
    z = (z ^ (z >> 27)) * 10723151780598845931; // 0x94D049BB133111EB
    return z ^ (z >> 31);
}

fn main() {
    // Arithmetic on i64: the sign bit replicates.
    let neg: i64 = 0 - 8;
    print(neg >> 1);          // -4, not 9223372036854775804
    let mone: i64 = 0 - 1;
    print(mone >> 63);        // -1: all-sign fill

    // Logical on u64: zero fill.
    let top: u64 = 9223372036854775808; // 2^63
    print(top >> 1);          // 4611686018427387904
    let ones: u64 = 18446744073709551615;
    print(ones >> 4);         // 1152921504606846975

    // splitmix64 known-answer vectors (u64 logical shifts).
    print(sm64(0));           // 16294208416658607535
    print(sm64(1));           // 10451216379200822465
    print(sm64(42));          // 13679457532755275413
}
