// SPDX-License-Identifier: Apache-2.0
// Author: Matt Flores
// #55 gate: the exact-2^63 literal (the INT64_MIN bit pattern) and INT64_MIN
// printing. Pre-fix, tvc_self's wr_int/fmt_i64 negate-overflow recursed
// forever on INT64_MIN (`0 - n` wraps MIN to itself) — the compiler
// SEGFAULTED mid-emission on any program containing the literal 2^63.
// Fixed with the fmt.tv/ev_put_i64 magnitude pattern: `0 - (n as u64)`.
// Dual-parity: the seed's C printf path never had the bug (emits the
// unsigned spelling; same bit pattern).
// @internal-note: known-issues #55

fn main() -> i32 {
    // the #55 crash shape: exact 2^63 as a literal, u64 and i64 contexts
    var n: u64 = 9223372036854775808;
    print(n as i64);                    // -9223372036854775808
    var m: i64 = 9223372036854775808;
    print(m);                           // -9223372036854775808
    // runtime-constructed INT64_MIN + MIN-adjacent arithmetic
    var x: i64 = (0 - 9223372036854775807) - 1;
    print(x);                           // -9223372036854775808
    print(x + 1);                       // -9223372036854775807
    // u64 max as a literal (as i64 = -1)
    var big: u64 = 18446744073709551615;
    print(big as i64);                  // -1
    // u64 compare across the sign line
    var five: u64 = 5;
    if five < 9223372036854775808 { print(1); }
    return 0;
}
