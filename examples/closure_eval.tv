// Author: Matt Flores
// closure_eval.tv — E2e closure coverage: the capture-kind matrix (field, mixed
// narrow widths, closure-capturing-closure, void body, global, in-loop, bool).
// @internal-design: examples (closure_eval).
//
// Expected output: 49 4000060207 42 100 1001 60 6

type F = Field<251>;

let GBIAS: i32 = 1000;

fn helper(v: i32) -> i32 { return v + 3; }

fn main() {
    // Field-element capture (1-byte width store/reload).
    let fe: F = 200;
    let addf = |x: F| x + fe;
    print(addf(100));            // (200+100) mod 251 = 49

    // Narrow-width captures: u8 + u16 + i64 mixed env offsets.
    let b8: u8 = 200;
    let h16: u16 = 60000;
    let w64: i64 = 4000000000;
    let mix = |k: i64| (b8 as i64) + (h16 as i64) + w64 + k;
    print(mix(7));               // 200+60000+4000000000+7 = 4000060207

    // Closure capturing a CLOSURE (env-ptr capture, nested direct call).
    let inc = |x: i32| x + 1;
    let twice = |x: i32| inc(inc(x));
    print(twice(40));            // 42

    // Void expression body (effect-only), calling a global fn.
    let shout = |x: i32| print(helper(x));
    shout(97);                   // 100

    // Global capture (value snapshot; globals ARE sym_find-visible).
    let biased = |x: i32| x + GBIAS;
    print(biased(1));            // 1001

    // Closure literal inside a loop: env rebuilt per iteration.
    var acc: i32 = 0;
    for i in 0..5 {
        let addi = |x: i32| x + i;
        acc = acc + addi(10);
    }
    print(acc);                  // sum(10+i) = 50+10 = 60

    // Bool capture (1-byte env slot), used as a value.
    let flag: bool = true;
    let pick = |x: i32| x + (flag as i32);
    print(pick(5));              // 6
}
