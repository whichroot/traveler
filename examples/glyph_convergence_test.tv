// Author: Matt Flores
// glyph_convergence_test.tv — vector digit glyphs rendered at increasing
// resolution: the nseg(d) fingerprint converges to a property of the SHAPE.
// @internal-design: genus (glyph convergence — the bridge)
//
// Three glyphs span the spectrum:
//   "1" = filled vertical bar (rectangle): contour is PIECEWISE LINEAR with a
//         fixed edge count -> exact nseg CONVERGES TO A CONSTANT (resolution-
//         independent: the polygon edge count). Finite == continuous, exactly.
//   "7" = horizontal bar + 45-degree diagonal (polygon): same, converges to its
//         edge count (tiny corner jitter as the diagonal resolves).
//   "0" = circular annulus (transcendental loop): exact nseg SHATTERS (grows with
//         r), threshold nseg CONVERGES (fraction -> 0). The circle contrast, now
//         in a glyph.
//
// Field-invariance (Goldilocks / BabyBear / 65537) checked on the exact path.
// Coordinates tiny (<= r <= 96) so no field wraps; Boundary Invariance Theorem.
//
// Cross-checked by @internal-oracle: glyph_convergence. Self-validating:
// prints the per-resolution fingerprint table to STDERR (the science) and asserts
// the convergence LAW to STDOUT as pass flags:
//   1. glyph "1" exact x nseg(d1) is CONSTANT across all r (== its edge count)  -> 1
//   2. glyph "7" exact x nseg(d1) is BOUNDED across r (converges, small jitter)  -> 1
//   3. glyph "0" exact x nseg(d2) SHATTERS (top > bottom of the ladder)          -> 1
//   4. glyph "0" threshold nseg/len fraction is NON-INCREASING (converge)        -> 1
//   5. all exact measurements field-invariant (3 primes identical)               -> 1
//
// Expected output: 1 1 1 1 1
//
// Multi-file link: regime_fri.o + poly_core.o + glyph_convergence_test.o.

extern "C" fn write(fd: i32, buf: *u8, n: usize) -> i64;
extern "C" fn strlen(s: *u8) -> usize;

extern "C" fn regime_prove_dyn(
    f: Field, data: *i64, n: i32, deg: i32, cert: *i64, work: *i64) -> i32;
extern "C" fn regime_detect(
    data: *i32, n: i32, order: i32, threshold: i32, p: i32, reg: *i32) -> i32;

fn wr(fd: i32, s: *u8) { let len: usize = strlen(s); write(fd, s, len); }
fn wr_int(fd: i32, n: i64) {
    if n < 0 { write(fd, "-", 1); wr_int(fd, 0 - n); return; }
    if n >= 10 { wr_int(fd, n / 10); }
    var d: [u8; 1] = 0;
    d[0] = ((n % 10) + 48) as u8;
    write(fd, &d[0], 1);
}
fn wr_pad(fd: i32, n: i64, w: i32) {
    var tmp: i64 = n; if tmp < 0 { tmp = 0 - tmp; }
    var digits: i32 = 1;
    while tmp >= 10 { tmp = tmp / 10; digits = digits + 1; }
    if n < 0 { digits = digits + 1; }
    var pad: i32 = w - digits;
    while pad > 0 { write(fd, " ", 1); pad = pad - 1; }
    wr_int(fd, n);
}

fn iabs(x: i32) -> i32 { if x < 0 { return 0 - x; } return x; }
fn imax(a: i32, b: i32) -> i32 { if a > b { return a; } return b; }

// ---------- glyph ink membership (matches the oracle bit-for-bit) ----------
// glyph "1": filled vertical bar (rectangle).
fn ink_one(x: i32, y: i32, r: i32) -> i32 {
    let hw: i32 = imax(1, r / 12);
    let m: i32 = r / 6;
    let cx: i32 = r / 2;
    if iabs(x - cx) <= hw {
        if y >= m { if y <= (r - 1 - m) { return 1; } }
    }
    return 0;
}
// glyph "7": top horizontal bar + 45-degree diagonal.
fn ink_seven(x: i32, y: i32, r: i32) -> i32 {
    let hw: i32 = imax(1, r / 12);
    let m: i32 = r / 6;
    if y >= m { if y <= (m + 2 * hw) { if x >= m { if x <= (r - 1 - m) { return 1; } } } }
    let x1: i32 = r - 1 - m;
    let y1: i32 = m;
    let x2: i32 = m;
    let y2: i32 = r - 1 - m;
    let dx: i32 = x2 - x1;
    let dy: i32 = y2 - y1;
    let px: i32 = x - x1;
    let py: i32 = y - y1;
    let cross: i32 = dy * px - dx * py;
    let denom: i32 = dx * dx + dy * dy;
    let dot: i32 = dx * px + dy * py;
    if dot >= 0 { if dot <= denom {
            if cross * cross <= hw * hw * denom { return 1; }
        } }
    return 0;
}
// glyph "0": circular annulus.
fn ink_zero(x: i32, y: i32, r: i32) -> i32 {
    let hw: i32 = imax(1, r / 12);
    let m: i32 = r / 6;
    let cx: i32 = r / 2;
    let cy: i32 = r / 2;
    let rout: i32 = r / 2 - m;
    var rin: i32 = rout - (2 * hw + 1);
    if rin < 1 { rin = 1; }
    let d2: i32 = (x - cx) * (x - cx) + (y - cy) * (y - cy);
    if d2 >= rin * rin { if d2 <= rout * rout { return 1; } }
    return 0;
}

// dispatch ink by glyph id (0="1", 1="7", 2="0") with bounds guard.
fn ink(gid: i32, x: i32, y: i32, r: i32) -> i32 {
    if x < 0 { return 0; }
    if y < 0 { return 0; }
    if x > (r - 1) { return 0; }
    if y > (r - 1) { return 0; }
    if gid == 0 { return ink_one(x, y, r); }
    if gid == 1 { return ink_seven(x, y, r); }
    return ink_zero(x, y, r);
}

// ---------- Moore contour trace into cx[], cy[]; returns length ----------
fn trace_contour(gid: i32, r: i32, cx: *i64, cy: *i64, max_len: i32) -> i32 {
    var dx: [i32; 8] = 0;
    var dy: [i32; 8] = 0;
    dx[0]=1;  dy[0]=0;
    dx[1]=1;  dy[1]=1;
    dx[2]=0;  dy[2]=1;
    dx[3]=0-1; dy[3]=1;
    dx[4]=0-1; dy[4]=0;
    dx[5]=0-1; dy[5]=0-1;
    dx[6]=0;  dy[6]=0-1;
    dx[7]=1;  dy[7]=0-1;

    var sx: i32 = 0-1;
    var sy: i32 = 0-1;
    var yy: i32 = 0;
    while yy < r {
        var xx: i32 = 0;
        while xx < r {
            if ink(gid, xx, yy, r) == 1 { sx = xx; sy = yy; xx = r; yy = r; }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    if sx < 0 { return 0; }

    cx[0] = sx as i64; cy[0] = sy as i64;
    var clen: i32 = 1;
    var curx: i32 = sx;
    var cury: i32 = sy;
    var b: i32 = 4;
    var steps: i32 = 0;
    while steps < max_len {
        var found: i32 = 0 - 1;
        var k: i32 = 0;
        while k < 8 {
            let dd: i32 = (b + 1 + k) % 8;
            let nx: i32 = curx + dx[dd];
            let ny: i32 = cury + dy[dd];
            if ink(gid, nx, ny, r) == 1 { found = dd; k = 8; }
            k = k + 1;
        }
        if found < 0 { return clen; }
        let nxp: i32 = curx + dx[found];
        let nyp: i32 = cury + dy[found];
        if nxp == sx { if nyp == sy { return clen; } }
        if clen < max_len {
            cx[clen] = nxp as i64;
            cy[clen] = nyp as i64;
            clen = clen + 1;
        } else { return clen; }
        curx = nxp; cury = nyp;
        b = (found + 4) % 8;
        steps = steps + 1;
    }
    return clen;
}

// threshold-segmenter segment count (raw integer p=0).
fn threshold_nseg(data: *i32, n: i32, order: i32, eps: i32, reg: *i32) -> i32 {
    var count: i32 = 0;
    var offset: i32 = 0;
    while (n - offset) > (order + 1) {
        let rem: i32 = n - offset;
        let b: i32 = regime_detect(&data[offset], rem, order, eps, 0, reg);
        if b >= rem { break; }
        count = count + 1;
        offset = offset + b;
    }
    return count + 1;
}

fn main() -> i32 {
    let gold: Field = field(18446744069414584321);
    let baby: Field = field(2013265921);
    let small: Field = field(65537);
    let eps: i32 = 1;

    let cap: i32 = 1024;
    let cx: *i64 = alloc(cap);
    let cy: *i64 = alloc(cap);
    let ibuf: *i32 = alloc(cap);
    let cert: *i64 = alloc(cap * 3);
    let work: *i64 = alloc(cap);
    let reg: *i32 = alloc(8);

    var res: [i32; 5] = 0;
    res[0]=24; res[1]=32; res[2]=48; res[3]=64; res[4]=96;

    // per-glyph tracked ladders for the law
    var field_ok: i32 = 1;
    // glyph "1" exact x nseg(d1) ladder
    var one_x_d1: [i32; 5] = 0;
    // glyph "7" exact x nseg(d1) ladder
    var seven_x_d1: [i32; 5] = 0;
    // glyph "0" exact x nseg(d2) + threshold x(d2) + len ladders
    var zero_x_d2: [i32; 5] = 0;
    var zero_th_d2: [i32; 5] = 0;
    var zero_len: [i32; 5] = 0;

    wr(2, "=== Font-Glyph Convergence (Traveler) ===\n");
    wr(2, "glyph  r   len  exX(d1,d2)  exY(d1,d2)  thrX(d2) thrY(d2) fieldOK\n");

    var g: i32 = 0;
    while g < 3 {
        var k: i32 = 0;
        while k < 5 {
            let r: i32 = res[k];
            let n: i32 = trace_contour(g, r, cx, cy, cap);

            // exact nseg on x(t) at d1,d2 over 3 fields
            let xg1: i32 = regime_prove_dyn(gold,  cx, n, 1, cert, work);
            let xb1: i32 = regime_prove_dyn(baby,  cx, n, 1, cert, work);
            let xs1: i32 = regime_prove_dyn(small, cx, n, 1, cert, work);
            if xg1 != xb1 { field_ok = 0; }
            if xg1 != xs1 { field_ok = 0; }
            let xg2: i32 = regime_prove_dyn(gold,  cx, n, 2, cert, work);
            let xb2: i32 = regime_prove_dyn(baby,  cx, n, 2, cert, work);
            let xs2: i32 = regime_prove_dyn(small, cx, n, 2, cert, work);
            if xg2 != xb2 { field_ok = 0; }
            if xg2 != xs2 { field_ok = 0; }

            // exact nseg on y(t) at d1,d2 over 3 fields
            let yg1: i32 = regime_prove_dyn(gold,  cy, n, 1, cert, work);
            let yb1: i32 = regime_prove_dyn(baby,  cy, n, 1, cert, work);
            let ys1: i32 = regime_prove_dyn(small, cy, n, 1, cert, work);
            if yg1 != yb1 { field_ok = 0; }
            if yg1 != ys1 { field_ok = 0; }
            let yg2: i32 = regime_prove_dyn(gold,  cy, n, 2, cert, work);
            let yb2: i32 = regime_prove_dyn(baby,  cy, n, 2, cert, work);
            let ys2: i32 = regime_prove_dyn(small, cy, n, 2, cert, work);
            if yg2 != yb2 { field_ok = 0; }
            if yg2 != ys2 { field_ok = 0; }

            // threshold on x(t), y(t) at d2 (raw integer)
            var t: i32 = 0;
            while t < n { ibuf[t] = cx[t] as i32; t = t + 1; }
            let txd2: i32 = threshold_nseg(ibuf, n, 2, eps, reg);
            t = 0;
            while t < n { ibuf[t] = cy[t] as i32; t = t + 1; }
            let tyd2: i32 = threshold_nseg(ibuf, n, 2, eps, reg);

            if g == 0 { one_x_d1[k] = xg1; }
            if g == 1 { seven_x_d1[k] = xg1; }
            if g == 2 { zero_x_d2[k] = xg2; zero_th_d2[k] = txd2; zero_len[k] = n; }

            // contrast row
            if g == 0 { wr(2, "  1  "); }
            if g == 1 { wr(2, "  7  "); }
            if g == 2 { wr(2, "  0  "); }
            wr_pad(2, r as i64, 4);
            wr_pad(2, n as i64, 5);
            wr_pad(2, xg1 as i64, 5); wr_pad(2, xg2 as i64, 4);
            wr_pad(2, yg1 as i64, 6); wr_pad(2, yg2 as i64, 4);
            wr_pad(2, txd2 as i64, 9); wr_pad(2, tyd2 as i64, 8);
            wr_pad(2, field_ok as i64, 8);
            wr(2, "\n");
            k = k + 1;
        }
        g = g + 1;
    }

    // ---- Test 1: glyph "1" exact x nseg(d1) CONSTANT across all r ----
    var t1: i32 = 1;
    var k2: i32 = 1;
    while k2 < 5 {
        if one_x_d1[k2] != one_x_d1[0] { t1 = 0; }
        k2 = k2 + 1;
    }

    // ---- Test 2: glyph "7" exact x nseg(d1) BOUNDED (max-min <= 3) ----
    var lo: i32 = seven_x_d1[0];
    var hi: i32 = seven_x_d1[0];
    k2 = 1;
    while k2 < 5 {
        if seven_x_d1[k2] < lo { lo = seven_x_d1[k2]; }
        if seven_x_d1[k2] > hi { hi = seven_x_d1[k2]; }
        k2 = k2 + 1;
    }
    var t2: i32 = 0;
    if (hi - lo) <= 3 { t2 = 1; }

    // ---- Test 3: glyph "0" exact x nseg(d2) SHATTERS (top > bottom) ----
    var t3: i32 = 0;
    if zero_x_d2[4] > zero_x_d2[0] { t3 = 1; }

    // ---- Test 4: glyph "0" threshold nseg/len NON-INCREASING (converge) ----
    var t4: i32 = 1;
    k2 = 1;
    while k2 < 5 {
        let lhs: i64 = (zero_th_d2[k2] as i64) * (zero_len[k2 - 1] as i64);
        let rhs: i64 = (zero_th_d2[k2 - 1] as i64) * (zero_len[k2] as i64);
        if lhs > rhs { t4 = 0; }
        k2 = k2 + 1;
    }

    print(t1);        // 1
    print(t2);        // 1
    print(t3);        // 1
    print(t4);        // 1
    print(field_ok);  // 1

    return 0;
}
