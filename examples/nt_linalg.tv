// nt_linalg.tv — known-answer gate for src/lib/nt/linalg.tv: rank/nullity/nullspace
// (A·v == 0 verified) over Field<7> AND BinField<8,0x11B>. tvc_self-only (import).
// @internal-design: nt

import "../src/lib/nt/linalg.tv";

type P = Field<7>;
type G = BinField<8, 0x11B>;

fn main() {
    // ---- Field<7>: a 2x3 of rank 2, nullity 1 ----
    // [1 2 3]
    // [4 5 6]
    let A: *P = alloc(6);
    A[0] = 1; A[1] = 2; A[2] = 3;
    A[3] = 4; A[4] = 5; A[5] = 6;

    let rk: i32 = la_rank(A, 2, 3, 5);          // qm2 = 7 - 2 = 5
    print(rk);                                      // 2

    let ns: *P = alloc(9);                          // cols*cols = 3*3
    let dim: i32 = la_nullspace(A, 2, 3, 5, ns);
    print(dim);                                     // 1

    // verify A · v == 0 for each of the `dim` basis vectors (rows of ns)
    let y: *P = alloc(2);
    var allzero: i32 = 1;
    var b: i32 = 0;
    while b < dim {
        la_matvec(A, 2, 3, &ns[b * 3], y);
        if (y[0] as i32) != 0 { allzero = 0; }
        if (y[1] as i32) != 0 { allzero = 0; }
        b = b + 1;
    }
    print(allzero);                                 // 1
    // the basis vector itself (RREF of [1 2 3; 4 5 6] over F_7 -> v = [1,5,1])
    print(ns[0] as i32);                            // 1
    print(ns[1] as i32);                            // 5
    print(ns[2] as i32);                            // 1

    // full-rank control: 3x3 identity over F_7 -> rank 3, nullity 0
    let I: *P = alloc(9);
    var i: i32 = 0;
    while i < 9 { I[i] = 0; i = i + 1; }
    I[0] = 1; I[4] = 1; I[8] = 1;
    print(la_rank(I, 3, 3, 5));                  // 3

    // ---- BinField<8>: a 2x2 singular matrix, rank 1, nullity 1 ----
    // [1 1]
    // [1 1]   (over char 2, the kernel is spanned by [1,1])
    let B: *G = alloc(4);
    B[0] = 1; B[1] = 1;
    B[2] = 1; B[3] = 1;
    print(la_rank(B, 2, 2, 254));                // qm2 = 256 - 2 = 254 ; rank 1

    let nb: *G = alloc(4);                          // cols*cols = 2*2
    let dimb: i32 = la_nullspace(B, 2, 2, 254, nb);
    print(dimb);                                    // 1
    let yb: *G = alloc(2);
    la_matvec(B, 2, 2, &nb[0], yb);
    var okb: i32 = 1;
    if (yb[0] as i32) != 0 { okb = 0; }
    if (yb[1] as i32) != 0 { okb = 0; }
    print(okb);                                     // 1
    print(nb[0] as i32);                            // 1
    print(nb[1] as i32);                            // 1
}
