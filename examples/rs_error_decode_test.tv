// rs_error_decode_test.tv — RS ERROR decode over GF(2^8) at UNKNOWN positions:
// syndromes -> bm<GF> -> Chien -> Forney, cross-gated vs erasure-reduction.
// @internal-design: ecc
// Per case prints: nu, then the nu recovered error values (each == the injected
// corruption), then agree (both routes identical) and ok; a refused case prints -1.

import "../src/lib/ecc/rs_errdec.tv";   // rs_decode_errors + rs_decode_erasure_at;
// transitively: GF, rs_encode, rs_decode (reed_solomon.tv), bm<F> (nt/linrec.tv)

// Encode `data`, corrupt at nerr positions, decode both ways, print the case stream.
fn run_case(data: *GF, k: i32, n: i32, epos: *i32, eadd: *GF, nerr: i32) {
    let code: *GF = alloc(n);
    rs_encode(data, k, code, n);
    let recv: *GF = alloc(n);
    var i: i32 = 0;
    while i < n { recv[i] = code[i]; i = i + 1; }
    var e: i32 = 0;
    while e < nerr {
        let p: i32 = epos[e];
        recv[p] = recv[p] + eadd[e];        // inject error (XOR in char 2)
        e = e + 1;
    }

    let dataF: *GF = alloc(k);
    let errpos: *i32 = alloc(n);
    let errval: *GF = alloc(n);
    let nu: i32 = rs_decode_errors(recv, n, k, dataF, errpos, errval);
    if nu < 0 {
        print(0 - 1);                       // REFUSED
    } else {
        print(nu);
        var l: i32 = 0;
        while l < nu {
            print(errval[l] as i32);        // recovered error value (== injected)
            l = l + 1;
        }
        // cross-gate: independent erasure-reduction route on the located positions
        let dataE: *GF = alloc(k);
        let rc: i32 = rs_decode_erasure_at(recv, n, k, errpos, nu, dataE);
        var agree: i32 = 1;
        if rc != 0 { agree = 0; }
        var c: i32 = 0;
        while c < k {
            if dataF[c] != dataE[c] { agree = 0; }
            c = c + 1;
        }
        var ok: i32 = 1;
        c = 0;
        while c < k {
            if dataF[c] != data[c] { ok = 0; }
            c = c + 1;
        }
        print(agree);
        print(ok);
        free(dataE);
    }
    free(code);
    free(recv);
    free(dataF);
    free(errpos);
    free(errval);
}

fn main() -> i32 {
    // ---- RS(12,5): t = 3 --------------------------------------------------
    let d125: *GF = alloc(5);
    d125[0] = 0x12; d125[1] = 0x34; d125[2] = 0x56; d125[3] = 0x78; d125[4] = 0x9A;

    // 0 errors
    let ep0: *i32 = alloc(1);
    let ea0: *GF = alloc(1);
    run_case(d125, 5, 12, ep0, ea0, 0);

    // 1 error @3
    let ep1: *i32 = alloc(1);
    let ea1: *GF = alloc(1);
    ep1[0] = 3; ea1[0] = 0x1F;
    run_case(d125, 5, 12, ep1, ea1, 1);

    // 2 errors @2 @7
    let ep2: *i32 = alloc(2);
    let ea2: *GF = alloc(2);
    ep2[0] = 2; ep2[1] = 7; ea2[0] = 0x1F; ea2[1] = 0x2A;
    run_case(d125, 5, 12, ep2, ea2, 2);

    // 3 errors @1 @5 @10 (= t, the correction ceiling)
    let ep3: *i32 = alloc(3);
    let ea3: *GF = alloc(3);
    ep3[0] = 1; ep3[1] = 5; ep3[2] = 10; ea3[0] = 0x05; ea3[1] = 0x8C; ea3[2] = 0x33;
    run_case(d125, 5, 12, ep3, ea3, 3);

    // 4 errors -> deterministic refusal (d = 8 > 2t+1)
    let ep4: *i32 = alloc(4);
    let ea4: *GF = alloc(4);
    ep4[0] = 0; ep4[1] = 4; ep4[2] = 8; ep4[3] = 11;
    ea4[0] = 0x11; ea4[1] = 0x22; ea4[2] = 0x44; ea4[3] = 0x88;
    run_case(d125, 5, 12, ep4, ea4, 4);

    // ---- RS(8,4): DE AD BE EF, 2 errors @2 @5 (= t) -----------------------
    let d84: *GF = alloc(4);
    d84[0] = 0xDE; d84[1] = 0xAD; d84[2] = 0xBE; d84[3] = 0xEF;
    let ep5: *i32 = alloc(2);
    let ea5: *GF = alloc(2);
    ep5[0] = 2; ep5[1] = 5; ea5[0] = 0x1F; ea5[1] = 0x2A;
    run_case(d84, 4, 8, ep5, ea5, 2);

    return 0;
}
