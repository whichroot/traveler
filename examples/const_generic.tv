// const_generic.tv — const generic params: <const N> substituted into [T; N]
// (B-paramtypes Slice 3). tvc_self-only, gated in tests/dynfield/run.sh.
// @internal-design: examples (const_generic).
//
// Expected output:
//   3
//   100
//   200
//   3
//   40
//   9

struct Buf<T, const N> {
    data: [T; N],
    len: i32,
}

// Function over a concrete instance (the const lives in the explicit type).
fn buf_len(b: *Buf<i32, 4>) -> i32 {
    return b.len;
}

fn main() -> i32 {
    // 1. const N=4 substituted into [i32; 4]; field access + alloc sizing.
    let b: *Buf<i32, 4> = alloc(1);
    b.len = 3;
    b.data[0] = 100;
    b.data[1] = 200;
    print(b.len);            // 3
    print(b.data[0]);        // 100
    print(b.data[1]);        // 200
    print(buf_len(b));       // 3

    // 2. distinct instances: const value differs, type differs.
    let big: *Buf<i32, 8> = alloc(1);
    let small: *Buf<u8, 4> = alloc(1);
    big.data[7] = 40;        // valid index only in the N=8 layout
    small.data[3] = 9;
    print(big.data[7]);      // 40
    print(small.data[3] as i32); // 9

    free(b);
    free(big);
    free(small);
    return 0;
}
