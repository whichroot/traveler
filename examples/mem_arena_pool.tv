// M3 gate: lib/mem arena + pool.
//
// The point is the INVALIDATION story. (1) Arena chunk-chain growth: a
// pointer issued from a full chunk stays valid after a later alloc links a
// fresh chunk — where a realloc-growing buffer would have moved. (2) Pool
// handles: a handle stays valid across a forced realloc (the backing store
// moves, the index doesn't) — the raw-pointer analogue of the same access
// WOULD dangle. Both are asserted by value, not by luck.

import "../src/lib/mem/arena.tv";
import "../src/lib/mem/pool.tv";

fn main() {
    // ---- Arena: issued pointers survive chunk-chain growth ----
    var a: Arena<i64> = arena_new(4);   // tiny default chunk forces growth
    let p1: *i64 = arena_alloc(&a, 3);  // fills most of chunk 1
    p1[0] = 100; p1[1] = 101; p1[2] = 102;
    // This alloc overflows chunk 1 -> links chunk 2 (chunk 1 NOT moved).
    let p2: *i64 = arena_alloc(&a, 8);
    p2[0] = 200;
    // p1 (into chunk 1) must still read its values.
    print(p1[0] + p1[1] + p1[2]);   // 303
    print(p2[0]);                   // 200

    // reset rewinds; the chain is reused.
    arena_reset(&a);
    let p3: *i64 = arena_alloc(&a, 2);
    p3[0] = 7; p3[1] = 8;
    print(p3[0] + p3[1]);           // 15
    arena_free(&a);

    // ---- Pool: handles survive a forced realloc ----
    var pool: Pool<i64> = pool_new();   // cap 4
    let h0: i32 = pool_push(&pool, 11);
    let h1: i32 = pool_push(&pool, 22);
    let h2: i32 = pool_push(&pool, 33);
    let h3: i32 = pool_push(&pool, 44);
    // The 5th push doubles cap 4 -> 8 and REALLOCS the backing store.
    let h4: i32 = pool_push(&pool, 55);
    // Read back through the HANDLES (re-fetched after the grow). A raw pointer
    // taken before the 5th push would dangle here; the handles do not.
    var s: i64 = 0;
    s = s + pool_get(&pool, h0)[0];
    s = s + pool_get(&pool, h1)[0];
    s = s + pool_get(&pool, h2)[0];
    s = s + pool_get(&pool, h3)[0];
    s = s + pool_get(&pool, h4)[0];
    print(s);                       // 165
    print(pool_len(&pool));         // 5
    pool_set(&pool, h2, 1000);
    print(pool_get(&pool, h2)[0]);  // 1000
    pool_free(&pool);
}
