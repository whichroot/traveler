// genus_global_certify.tv — Thread 1B: GLOBAL MDL-optimality certificate
// (Bellman DOMINANCE + ACHIEVING, each inequality a ZK leq). Closes spec 17.11.4.
// @internal-design: genus (global MDL-optimality certificate)
//
// @internal-oracle: genus_global (DP cost[n] == brute-force
// optimum on every corpus shape; every dominance inequality holds).
//
// Corpus (small, buffer-safe — each leq is its own padded_n<=32 proof):
//   const+lin     (n=6) -> [0,1]    cost 3, 18 dominance leqs
//   lin+quad      (n=6) -> [1,2]    cost 5, 18 dominance leqs
//   const+lin+quad(n=9) -> [0,1,2]  cost 6, 30 dominance leqs
//
// Per shape the driver prints:  nseg  cost[n]  ndom  all_dominance_verified(1)
//                               achieving_ok(1)  tamper_rejected(1)
// Expected output:
//   2 3 18 1 1 1
//   2 5 18 1 1 1
//   3 6 30 1 1 1
//
// Link: plonk_dyn.o + regime_fri.o + genus_adaptive.o + zk_range.o
//       + genus_global_certify.o

extern "C" fn fill_rc(rc_init: *i64, rc_term: *i64, rc_int: *i64);
extern "C" fn poseidon2_diag_dyn(f: Field, diag: *i64);

// adaptive DP segmenter (Z.3a) — reused verbatim
extern "C" fn genus_mdl_segment(
    f: Field, data: *i64, n: i32, d_max: i32, cert: *i64, work: *i64) -> i32;

// FIT machinery (regime_fri.tv) — binds c(s,e) to the data
extern "C" fn seg_fits_dyn(
    f: Field, data: *i64, a: i32, len: i32, deg: i32, work: *i64) -> i32;

// range/comparison gadget (Thread 1A) — the ordering primitive
extern "C" fn rc_range_gates(nbits: i32) -> i32;
extern "C" fn rc_range_pow2(x: i32) -> i32;
extern "C" fn rc_range_ilog2(n: i32) -> i32;
extern "C" fn rc_range_build(
    f: Field, x: i64, nbits: i32, padded_n: i32, log_n: i32,
    q_L: *i64, q_R: *i64, q_O: *i64, q_M: *i64, q_C: *i64,
    wa: *i64, wb: *i64, wc: *i64,
    sigma_a: *i64, sigma_b: *i64, sigma_c: *i64);

extern "C" fn plonk_prove_dyn(
    f: Field, n_gates: i32, log_n: i32,
    q_L: *i64, q_R: *i64, q_O: *i64, q_M: *i64, q_C: *i64,
    wa: *i64, wb: *i64, wc: *i64,
    sigma_a: *i64, sigma_b: *i64, sigma_c: *i64,
    eval_out: *i64,
    fri_roots: *i64, fri_challenges: *i64, fri_final_poly: *i64,
    fri_query_values: *i64, fri_query_paths: *i64,
    fri_query_indices: *i32, fri_n_rounds: *i32,
    num_queries: i32,
    rc_init: *i64, rc_term: *i64, rc_int: *i64, diag: *i64) -> i32;
extern "C" fn plonk_verify_dyn(
    f: Field, n_gates: i32, log_n: i32,
    q_L: *i64, q_R: *i64, q_O: *i64, q_M: *i64, q_C: *i64,
    sigma_a: *i64, sigma_b: *i64, sigma_c: *i64,
    eval_out: *i64,
    fri_n_rounds: i32,
    fri_roots: *i64, fri_challenges: *i64, fri_final_poly: *i64,
    fri_query_values: *i64, fri_query_paths: *i64,
    fri_query_indices: *i32, num_queries: i32,
    rc_init: *i64, rc_term: *i64, rc_int: *i64, diag: *i64) -> i32;

// ---- minimal degree that EXACTLY fits [a,a+len), or -1 (mirror of ga_mindeg) ----
// Binds the cost term c(s,e)=mindeg+1 to the data via seg_fits (the (d+1)-th
// forward difference vanishes). Returns -1 for infeasible spans.
fn gg_mindeg(f: Field, data: *i64, a: i32, len: i32, d_max: i32, work: *i64) -> i32 {
    var dlim: i32 = d_max;
    if len - 1 < dlim { dlim = len - 1; }
    for d in 0..(dlim + 1) {
        if seg_fits_dyn(f, data, a, len, d, work) == 1 { return d; }
    }
    return 0 - 1;
}

// Prove (via ZK leq) that lhs <= rhs, both small non-negative. Returns the dyn
// PLONK verify code (1 = verified). nbits sized to hold rhs.
fn prove_leq(f: Field, lhs: i64, rhs: i64, nbits: i32,
    rc_init: *i64, rc_term: *i64, rc_int: *i64, diag: *i64) -> i32 {
    if lhs > rhs { return 0; }          // out of range: no honest proof
    let diff: i64 = rhs - lhs;
    let n_real: i32 = rc_range_gates(nbits);
    let padded_n: i32 = rc_range_pow2(n_real);
    let log_n: i32 = rc_range_ilog2(padded_n);
    let q_L: *i64 = alloc(padded_n); let q_R: *i64 = alloc(padded_n);
    let q_O: *i64 = alloc(padded_n); let q_M: *i64 = alloc(padded_n);
    let q_C: *i64 = alloc(padded_n);
    let wa: *i64 = alloc(padded_n); let wb: *i64 = alloc(padded_n);
    let wc: *i64 = alloc(padded_n);
    let sa: *i64 = alloc(padded_n); let sb: *i64 = alloc(padded_n);
    let sc: *i64 = alloc(padded_n);
    rc_range_build(f, diff, nbits, padded_n, log_n,
        q_L, q_R, q_O, q_M, q_C, wa, wb, wc, sa, sb, sc);

    let num_queries: i32 = 3;
    let eval_out: *i64 = alloc(16);
    let fri_roots: *i64 = alloc(128);
    let fri_challenges: *i64 = alloc(32);
    let fri_final_poly: *i64 = alloc(4);
    let fri_query_values: *i64 = alloc(512);
    let fri_query_paths: *i64 = alloc(4096);
    let fri_query_indices: *i32 = alloc(16);
    let fri_n_rounds: *i32 = alloc(1);
    plonk_prove_dyn(f, padded_n, log_n, q_L, q_R, q_O, q_M, q_C,
        wa, wb, wc, sa, sb, sc,
        eval_out, fri_roots, fri_challenges, fri_final_poly,
        fri_query_values, fri_query_paths, fri_query_indices,
        fri_n_rounds, num_queries, rc_init, rc_term, rc_int, diag);
    let v: i32 = plonk_verify_dyn(f, padded_n, log_n,
        q_L, q_R, q_O, q_M, q_C, sa, sb, sc,
        eval_out, fri_n_rounds[0],
        fri_roots, fri_challenges, fri_final_poly,
        fri_query_values, fri_query_paths, fri_query_indices,
        num_queries, rc_init, rc_term, rc_int, diag);

    free(q_L); free(q_R); free(q_O); free(q_M); free(q_C);
    free(wa); free(wb); free(wc); free(sa); free(sb); free(sc);
    free(eval_out); free(fri_roots); free(fri_challenges); free(fri_final_poly);
    free(fri_query_values); free(fri_query_paths); free(fri_query_indices);
    free(fri_n_rounds);
    return v;
}

// Recompute the DP cost table natively (same recurrence as genus_mdl_segment).
fn gg_costtable(f: Field, data: *i64, n: i32, d_max: i32,
    cost: *i32, par: *i32, pdeg: *i32, work: *i64) {
    let big: i32 = 1000000;
    cost[0] = 0;
    for e in 1..(n + 1) { cost[e] = big; par[e] = 0; pdeg[e] = 0; }
    for e in 1..(n + 1) {
        for s in 0..e {
            let len: i32 = e - s;
            let md: i32 = gg_mindeg(f, data, s, len, d_max, work);
            if md >= 0 {
                if cost[s] < big {
                    let c: i32 = cost[s] + (md + 1);
                    if c < cost[e] {
                        cost[e] = c; par[e] = s; pdeg[e] = md;
                    }
                }
            }
        }
    }
}

// The global-optimality certificate for one shape.
fn certify(f: Field, data: *i64, n: i32, d_max: i32, nbits: i32,
    rc_init: *i64, rc_term: *i64, rc_int: *i64, diag: *i64) {
    let cert: *i64 = alloc(n * 3);
    let work: *i64 = alloc(n);
    let nseg: i32 = genus_mdl_segment(f, data, n, d_max, cert, work);
    print(nseg);

    let cost: *i32 = alloc(n + 1);
    let par: *i32 = alloc(n + 1);
    let pdeg: *i32 = alloc(n + 1);
    gg_costtable(f, data, n, d_max, cost, par, pdeg, work);
    print(cost[n]);

    // count dominance pairs, prove each via ZK leq
    let big: i32 = 1000000;
    var ndom: i32 = 0;
    var all_ok: i32 = 1;
    for e in 1..(n + 1) {
        for s in 0..e {
            let len: i32 = e - s;
            let md: i32 = gg_mindeg(f, data, s, len, d_max, work);
            if md >= 0 {
                if cost[s] < big {
                    // DOMINANCE: cost[e] <= cost[s] + (md+1)
                    let rhs: i32 = cost[s] + (md + 1);
                    ndom = ndom + 1;
                    let v: i32 = prove_leq(f, cost[e] as i64, rhs as i64, nbits,
                        rc_init, rc_term, rc_int, diag);
                    if v != 1 { all_ok = 0; }
                }
            }
        }
    }
    print(ndom);
    print(all_ok);

    // ACHIEVING: cost[e] == cost[par[e]] + (pdeg[e]+1) for every e
    var ach_ok: i32 = 1;
    for e in 1..(n + 1) {
        let rhs: i32 = cost[par[e]] + (pdeg[e] + 1);
        if cost[e] != rhs { ach_ok = 0; }
    }
    print(ach_ok);

    // TAMPER: prove cost[n] <= (cost[par[n]]+c) - 1 — false (equality was
    // tight), so leq returns 0. Direction rationale: @internal-design: genus.
    let rhs_true: i32 = cost[par[n]] + (pdeg[n] + 1);
    let forged: i32 = rhs_true - 1;
    let vt: i32 = prove_leq(f, cost[n] as i64, forged as i64, nbits,
        rc_init, rc_term, rc_int, diag);
    // vt must NOT be 1 (the forged tighter bound is unprovable)
    let tamper_rejected: i32 = 1;
    if vt == 1 { print(0); } else { print(tamper_rejected); }

    free(cert); free(work); free(cost); free(par); free(pdeg);
}

fn run(p: i64) {
    let f: Field = field(p);
    let rc_init: *i64 = alloc(32);
    let rc_term: *i64 = alloc(32);
    let rc_int: *i64 = alloc(22);
    let diag: *i64 = alloc(8);
    fill_rc(rc_init, rc_term, rc_int);
    poseidon2_diag_dyn(f, diag);

    let d_max: i32 = 3;
    let nbits: i32 = 6;     // costs <= 9, diffs <= ~12; 6 bits (0..63) ample

    // const+lin (n=6) -> [0,1], cost 3
    let d1: *i64 = alloc(6);
    d1[0]=5; d1[1]=5; d1[2]=5; d1[3]=10; d1[4]=13; d1[5]=16;
    certify(f, d1, 6, d_max, nbits, rc_init, rc_term, rc_int, diag);

    // lin+quad (n=6) -> [1,2], cost 5
    let d2: *i64 = alloc(6);
    d2[0]=0; d2[1]=2; d2[2]=4; d2[3]=7; d2[4]=13; d2[5]=22;
    certify(f, d2, 6, d_max, nbits, rc_init, rc_term, rc_int, diag);

    // const+lin+quad (n=9) -> [0,1,2], cost 6
    let d3: *i64 = alloc(9);
    d3[0]=3; d3[1]=3; d3[2]=3; d3[3]=10; d3[4]=13; d3[5]=16; d3[6]=20; d3[7]=27; d3[8]=38;
    certify(f, d3, 9, d_max, nbits, rc_init, rc_term, rc_int, diag);

    free(d1); free(d2); free(d3);
    free(rc_init); free(rc_term); free(rc_int); free(diag);
}

fn main() -> i32 {
    run(18446744069414584321);   // Goldilocks
    return 0;
}
