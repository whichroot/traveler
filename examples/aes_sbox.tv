    r[176]=0xe7;r[177]=0xc8;r[178]=0x37;r[179]=0x6d;r[180]=0x8d;r[181]=0xd5;r[182]=0x4e;r[183]=0xa9;
    r[184]=0x6c;r[185]=0x56;r[186]=0xf4;r[187]=0xea;r[188]=0x65;r[189]=0x7a;r[190]=0xae;r[191]=0x08;
    // Row 0xc_
    r[192]=0xba;r[193]=0x78;r[194]=0x25;r[195]=0x2e;r[196]=0x1c;r[197]=0xa6;r[198]=0xb4;r[199]=0xc6;
    r[200]=0xe8;r[201]=0xdd;r[202]=0x74;r[203]=0x1f;r[204]=0x4b;r[205]=0xbd;r[206]=0x8b;r[207]=0x8a;
    // Row 0xd_
    r[208]=0x70;r[209]=0x3e;r[210]=0xb5;r[211]=0x66;r[212]=0x48;r[213]=0x03;r[214]=0xf6;r[215]=0x0e;
    r[216]=0x61;r[217]=0x35;r[218]=0x57;r[219]=0xb9;r[220]=0x86;r[221]=0xc1;r[222]=0x1d;r[223]=0x9e;
    // Row 0xe_
    r[224]=0xe1;r[225]=0xf8;r[226]=0x98;r[227]=0x11;r[228]=0x69;r[229]=0xd9;r[230]=0x8e;r[231]=0x94;
    r[232]=0x9b;r[233]=0x1e;r[234]=0x87;r[235]=0xe9;r[236]=0xce;r[237]=0x55;r[238]=0x28;r[239]=0xdf;
    // Row 0xf_
    r[240]=0x8c;r[241]=0xa1;r[242]=0x89;r[243]=0x0d;r[244]=0xbf;r[245]=0xe6;r[246]=0x42;r[247]=0x68;
    r[248]=0x41;r[249]=0x99;r[250]=0x2d;r[251]=0x0f;r[252]=0xb0;r[253]=0x54;r[254]=0xbb;r[255]=0x16;
}

fn main() {
    // ============================================================
    //  S-BOX VERIFICATION: 256 entries vs FIPS 197
    // ============================================================
    var expected: [i32; 256] = 0;
    init_fips197(&expected[0]);

    var correct: i32 = 0;
    var x: i32 = 0;
    while x < 256 {
        let computed: i32 = aes_sbox(x);
        if computed == expected[x] {
            correct = correct + 1;
        }
        x = x + 1;
    }

    wr(1, "AES S-box: ");
    wr_int(1, correct as i64);
    wr(1, "/256 correct\n");

    // ============================================================
    //  BINFIELD CROSS-CHECK: compiler log/exp tables vs integer gf_inv (8 inputs)
    // ============================================================
    var bf_ok: i32 = 0;

    // inv(0x53) = 0xCA = 202
    let g1: G = 0x53;
    let v1: G = 1 / g1;
    print(v1);  // 202
    if gf_inv(0x53) == 202 { bf_ok = bf_ok + 1; }

    // inv(0x01) = 0x01 = 1
    let g2: G = 0x01;
    let v2: G = 1 / g2;
    print(v2);  // 1
    if gf_inv(0x01) == 1 { bf_ok = bf_ok + 1; }

    // inv(0x02) = 0x8D = 141 (generator inverse)
    let g3: G = 0x02;
    let v3: G = 1 / g3;
    print(v3);  // 141
    if gf_inv(0x02) == 141 { bf_ok = bf_ok + 1; }

    // inv(0x03) = 0xF6 = 246 (generator used for log table)
    let g4: G = 0x03;
    let v4: G = 1 / g4;
    print(v4);  // 246
    if gf_inv(0x03) == 246 { bf_ok = bf_ok + 1; }

    // inv(0x57) * 0x83 = 1 (AES test vector pair)
    let g5: G = 0x57;
    let v5: G = 1 / g5;
    print(v5);
    let g5_ref: i32 = gf_inv(0x57);
    wr(1, "gf_inv(0x57)="); wr_int(1, g5_ref as i64); wr(1, "\n");
    if gf_mul(0x57, g5_ref) == 1 { bf_ok = bf_ok + 1; }

    // inv(0xFF) = known value
    let g6: G = 0xff;
    let v6: G = 1 / g6;
    print(v6);
    let g6_ref: i32 = gf_inv(0xff);
    wr(1, "gf_inv(0xFF)="); wr_int(1, g6_ref as i64); wr(1, "\n");
    if gf_mul(0xff, g6_ref) == 1 { bf_ok = bf_ok + 1; }

    // inv(0x80) = known value
    let g7: G = 0x80;
    let v7: G = 1 / g7;
    print(v7);
    let g7_ref: i32 = gf_inv(0x80);
    if gf_mul(0x80, g7_ref) == 1 { bf_ok = bf_ok + 1; }

    // inv(0xFE) = known value (S[0xFE] = 0xBB verifiable)
    let g8: G = 0xfe;
    let v8: G = 1 / g8;
    print(v8);
    let g8_ref: i32 = gf_inv(0xfe);
    if gf_mul(0xfe, g8_ref) == 1 { bf_ok = bf_ok + 1; }

    wr(1, "BinField cross-check: ");
    wr_int(1, bf_ok as i64);
    wr(1, "/8 correct\n");
}
