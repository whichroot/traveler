// SPDX-License-Identifier: Apache-2.0
// Author: Matt Flores
// regime_invariance_test.tv — Boundary Invariance Theorem: sharpness demonstrators
//
// Exercises the theorem's failure mode and its corollaries from
// spec/language-spec.md Section 17.3.1. Case values below are the oracle data.
// @internal-design: regime
//
// Four test cases:
//
//   Case 1 (aliased boundary): constant-zero signal, jump to 251 at
//     index 15. Integer residual r = 251 exactly. Prime 251 aliases
//     the residual to 0 (misses the boundary); primes 65521 and 65537
//     see |r| = 251 > 0 and report the boundary. Demonstrates the
//     theorem's one-sided failure mode: p | r => miss.
//
//   Case 2 (double-blind alias): jump to 16445771 = 251 * 65521 at
//     index 15. Both primes alias to 0; integer mode and p=65537
//     catch it. Pins Corollary 2: pq | r => both miss.
//
//   Case 3 (soundness / no false positives): constant-zero signal,
//     bump to 5 at index 15, threshold=10. Residual 5 < 10 in all
//     modes: no boundary reported anywhere. One-sided error confirmed:
//     no field can report a boundary that integer mode doesn't.
//
//   Case 4 (CRT verifier as composition): the existing 5 signal classes
//     from regime_topology_test.tv, verified by two-prime comparison.
//     Agreement = certified correct; disagreement = detected alias.
//     Applied to case 1's signal with p1=251, p2=65521: disagreement
//     detected (251 reports n, 65521 reports 15).
//
// Links with poly_core.tv (two-file link).
//
// Expected output: see tests/expected/regime_invariance_test.txt

extern "C" fn write(fd: i32, buf: *u8, n: usize) -> i64;
extern "C" fn strlen(s: *u8) -> usize;

fn wr(fd: i32, s: *u8) {
    let n: usize = strlen(s);
    write(fd, s, n);
}

fn wr_int(fd: i32, n: i64) {
    if n < 0 {
        write(fd, "-", 1);
        wr_int(fd, 0 - n);
        return;
    }
    if n >= 10 {
        wr_int(fd, n / 10);
    }
    var d: u8 = (n % 10) as u8 + 48;
    write(fd, &d, 1);
}

extern "C" fn regime_detect(data: *i32, n: i32, order: i32, threshold: i32, p: i32, reg: *i32) -> i32;
extern "C" fn forward_sum(coeffs: *i32, order: i32, out: *i32, n: i32, p: i32, reg: *i32);

fn assert_eq(label: *u8, got: i32, want: i32, pass_count: *i32, total: *i32) {
    total[0] = total[0] + 1;
    if got == want {
        pass_count[0] = pass_count[0] + 1;
    } else {
        wr(2, "FAIL: ");
        wr(2, label);
        wr(2, " got=");
        wr_int(2, got as i64);
        wr(2, " want=");
        wr_int(2, want as i64);
        wr(2, "\n");
    }
}

// CRT verifier: two regime_detect calls, compare results.
// Returns 1 if boundaries agree (certified), 0 if they disagree (alias detected).
fn regime_detect_verified(data: *i32, n: i32, order: i32, threshold: i32,
    p1: i32, p2: i32, reg: *i32) -> i32 {
    let b1: i32 = regime_detect(data, n, order, threshold, p1, reg);
    let b2: i32 = regime_detect(data, n, order, threshold, p2, reg);
    if b1 == b2 { return 1; }
    return 0;
}

fn main() {
    let pass: *i32 = alloc(1);
    let total: *i32 = alloc(1);
    pass[0] = 0;
    total[0] = 0;
    let reg: *i32 = alloc(16);

    // ============================================================
    //  Case 1: aliased boundary (p | r)
    //
    //  Signal: [0, 0, ..., 0, 251, 0, 0, ...]
    //  20 samples, constant zero except data[15] = 251.
    //  Order 1, threshold 0.
    //
    //  Integer residual at index 15: |251 - 0| = 251.
    //  p=251:   251 mod 251 = 0 => miss (returns 20)
    //  p=65521: 251 mod 65521 = 251 => boundary at 15
    //  p=65537: 251 mod 65537 = 251 => boundary at 15
    // ============================================================
    let n1: i32 = 20;
    let data1: *i32 = alloc(n1);
    var i: i32 = 0;
    while i < n1 { data1[i] = 0; i = i + 1; }
    data1[15] = 251;

    // Integer mode (p=0): boundary at 15
    let b1_int: i32 = regime_detect(data1, n1, 1, 0, 0, reg);
    assert_eq("case1 p=0", b1_int, 15, pass, total);

    // p=251: residual aliases to 0 => misses the boundary
    let b1_251: i32 = regime_detect(data1, n1, 1, 0, 251, reg);
    assert_eq("case1 p=251 (miss)", b1_251, n1, pass, total);

    // p=65521: sees residual 251 => boundary at 15
    let b1_65521: i32 = regime_detect(data1, n1, 1, 0, 65521, reg);
    assert_eq("case1 p=65521", b1_65521, 15, pass, total);

    // p=65537: sees residual 251 => boundary at 15
    let b1_65537: i32 = regime_detect(data1, n1, 1, 0, 65537, reg);
    assert_eq("case1 p=65537", b1_65537, 15, pass, total);

    // ============================================================
    //  Case 2: double-blind alias (pq | r)
    //
    //  Signal: [0, 0, ..., 0, 16445771, 0, 0, ...]
    //  r = 251 * 65521 = 16445771. Both small primes alias to 0.
    //
    //  p=0:     boundary at 15 (integer mode)
    //  p=251:   16445771 mod 251 = 0 => miss
    //  p=65521: 16445771 mod 65521 = 0 => miss
    //  p=65537: 16445771 mod 65537 = 61521 != 0 => boundary at 15
    // ============================================================
    let data2: *i32 = alloc(n1);
    i = 0;
    while i < n1 { data2[i] = 0; i = i + 1; }
    data2[15] = 16445771;

    let b2_int: i32 = regime_detect(data2, n1, 1, 0, 0, reg);
    assert_eq("case2 p=0", b2_int, 15, pass, total);

    let b2_251: i32 = regime_detect(data2, n1, 1, 0, 251, reg);
    assert_eq("case2 p=251 (miss)", b2_251, n1, pass, total);

    let b2_65521: i32 = regime_detect(data2, n1, 1, 0, 65521, reg);
    assert_eq("case2 p=65521 (miss)", b2_65521, n1, pass, total);

    let b2_65537: i32 = regime_detect(data2, n1, 1, 0, 65537, reg);
    assert_eq("case2 p=65537", b2_65537, 15, pass, total);

    // ============================================================
    //  Case 3: soundness / no false positives
    //
    //  Signal: [0, 0, ..., 0, 5, 0, 0, ...]
    //  Order 1, threshold 10. Residual 5 < 10 in all modes.
    //  No boundary should be reported in any field.
    // ============================================================
    let data3: *i32 = alloc(n1);
    i = 0;
    while i < n1 { data3[i] = 0; i = i + 1; }
    data3[15] = 5;

    let b3_int: i32 = regime_detect(data3, n1, 1, 10, 0, reg);
    assert_eq("case3 p=0 (no bnd)", b3_int, n1, pass, total);

    let b3_251: i32 = regime_detect(data3, n1, 1, 10, 251, reg);
    assert_eq("case3 p=251 (no bnd)", b3_251, n1, pass, total);

    let b3_65521: i32 = regime_detect(data3, n1, 1, 10, 65521, reg);
    assert_eq("case3 p=65521 (no bnd)", b3_65521, n1, pass, total);

    let b3_65537: i32 = regime_detect(data3, n1, 1, 10, 65537, reg);
    assert_eq("case3 p=65537 (no bnd)", b3_65537, n1, pass, total);

    // ============================================================
    //  Case 4: CRT verifier as composition
    //
    //  4a: case 1's signal with p1=251, p2=65521.
    //      251 returns 20 (miss), 65521 returns 15 => DISAGREE (0).
    //      This is alias detection — the verifier catches the miss.
    //
    //  4b: case 1's signal with p1=65521, p2=65537.
    //      Both return 15 => AGREE (1). Certified correct.
    //
    //  4c: simply-connected signal (pure degree-2, no boundary).
    //      All primes agree at n => AGREE (1).
    //
    //  4d: spliced-linear signal, boundary at 10.
    //      p1=251, p2=65521 => both report 10 => AGREE (1).
    //      (residual is small; no aliasing possible.)
    // ============================================================

    // 4a: CRT catches alias
    let v4a: i32 = regime_detect_verified(data1, n1, 1, 0, 251, 65521, reg);
    assert_eq("case4a CRT disagree", v4a, 0, pass, total);

    // 4b: CRT certifies
    let v4b: i32 = regime_detect_verified(data1, n1, 1, 0, 65521, 65537, reg);
    assert_eq("case4b CRT agree", v4b, 1, pass, total);

    // 4c: simply connected — generate degree-2 polynomial
    let n4: i32 = 20;
    let coeffs4c: *i32 = alloc(3);
    coeffs4c[0] = 10;
    coeffs4c[1] = 3;
    coeffs4c[2] = 1;
    let data4c: *i32 = alloc(n4);
    forward_sum(coeffs4c, 2, data4c, n4, 0, reg);
    let v4c: i32 = regime_detect_verified(data4c, n4, 2, 0, 251, 65521, reg);
    assert_eq("case4c CRT simply-connected", v4c, 1, pass, total);

    // 4d: spliced linear, boundary at 10
    // data = [0, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 53, 56, 59, ...]
    // First segment: slope 5. Second segment: slope 3, starting at 50.
    // At index 10: linear predict from slope 5 => 50, but actual = 50 (continuous).
    // At index 11: predict = 55, actual = 53. residual = |53-55| = 2.
    // With threshold=0: boundary at 11 (first nonzero residual).
    let data4d: *i32 = alloc(n4);
    i = 0;
    while i < 10 { data4d[i] = i * 5; i = i + 1; }       // slope 5
    i = 10;
    while i < n4 { data4d[i] = 50 + (i - 10) * 3; i = i + 1; }  // slope 3
    let v4d: i32 = regime_detect_verified(data4d, n4, 1, 0, 251, 65521, reg);
    assert_eq("case4d CRT spliced-linear", v4d, 1, pass, total);

    // ============================================================
    //  Summary
    // ============================================================
    wr_int(1, total[0] as i64);
    wr(1, " tests, ");
    wr_int(1, pass[0] as i64);
    wr(1, " passed\n");
}
