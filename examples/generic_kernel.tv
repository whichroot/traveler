// SPDX-License-Identifier: Apache-2.0
// Author: Matt Flores
// generic_kernel.tv — generic monomorphization stress: pointer params (*F),
// loops in generic bodies, generic-calls-generic, two field types via one source.
//
// Expected output:
//   73
//   73
//   10
//   3
//   1
//   10
//   3
//   1

type F251 = Field<251>;
type F65521 = Field<65521>;

// Generic add — building block called by forward_sum
fn generic_add<F: Field>(a: F, b: F) -> F {
    return a + b;
}

// Generic sub — building block called by forward_diff
fn generic_sub<F: Field>(a: F, b: F) -> F {
    return a - b;
}

// Generic forward_sum — Newton coeffs evaluated at consecutive points by
// register advancement; calls generic_add (generic calling generic).
fn generic_forward_sum<F: Field>(coeffs: *F, order: i32, out: *F, n: i32) {
    // Initialize register (up to order 8)
    var r0: F = coeffs[0];
    var r1: F = coeffs[1];
    var r2: F = coeffs[2];

    for step in 0..n {
        out[step] = r0;
        if order >= 1 {
            r0 = generic_add(r0, r1);
        }
        if order >= 2 {
            r1 = generic_add(r1, r2);
        }
    }
}

// Generic forward_diff — recover Newton coefficients from data;
// calls generic_sub internally (generic calling generic).
fn generic_forward_diff<F: Field>(data: *F, n: i32, coeffs: *F) {
    // Copy data to work array
    var w0: F = data[0];
    var w1: F = data[1];
    var w2: F = data[2];

    // Level 0: coeffs[0] = data[0]
    coeffs[0] = w0;
    // Difference
    w0 = generic_sub(w1, w0);
    w1 = generic_sub(w2, w1);

    // Level 1: coeffs[1] = diff[0]
    coeffs[1] = w0;
    // Second difference
    w0 = generic_sub(w1, w0);

    // Level 2: coeffs[2] = diff2[0]
    coeffs[2] = w0;
}

fn main() {
    // === Test 1: forward_sum over Field<251> ===
    // Newton coefficients [10, 3, 1] -> f(x) = 10 + 3*C(x,1) + 1*C(x,2)
    // f(9) = 10 + 3*9 + 1*36 = 73
    var c251: [F251; 3] = 0;
    c251[0] = 10;
    c251[1] = 3;
    c251[2] = 1;
    var out251: [F251; 10] = 0;
    generic_forward_sum(&c251[0], 2, &out251[0], 10);
    print(out251[9]);

    // === Test 2: Same computation over Field<65521> ===
    var c65521: [F65521; 3] = 0;
    c65521[0] = 10;
    c65521[1] = 3;
    c65521[2] = 1;
    var out65521: [F65521; 10] = 0;
    generic_forward_sum(&c65521[0], 2, &out65521[0], 10);
    print(out65521[9]);

    // === Test 3: forward_diff round-trip over Field<251> ===
    var rec251: [F251; 3] = 0;
    generic_forward_diff(&out251[0], 3, &rec251[0]);
    print(rec251[0]);
    print(rec251[1]);
    print(rec251[2]);

    // === Test 4: forward_diff round-trip over Field<65521> ===
    var rec65521: [F65521; 3] = 0;
    generic_forward_diff(&out65521[0], 3, &rec65521[0]);
    print(rec65521[0]);
    print(rec65521[1]);
    print(rec65521[2]);
}
