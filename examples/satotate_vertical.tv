// satotate_vertical.tv — Sato-Tate, the VERTICAL axis: fix p, range over ALL
// curves y^2 = x^3 + ax + b mod p (Birch); population stats of the observable a_p.
// Companion: weil_zeta family; @internal-design: observability + @internal-design: examples (satotate_vertical).
//
// In-field (exact): N, integer moments M_k, histogram; ODD moments EXACTLY 0
// (quadratic-twist pairing). Leaves-field (S=1e6): even moments -> Catalan 1, 2, 5.
//
// Per prime p, printed in order:
//   p, N, M1, M2, M3, M4, M5, M6, nm2, nm4, nm6, B, then the 2B+1 histogram counts
//   h[-B..B] (B = floor(2 sqrt p), the Hasse bound).
// @internal-oracle: satotate_vertical (bit-for-bit).

fn isqrt(n: i64) -> i64 {
    if n < 0 { return 0; }
    var r: i64 = 0;
    while (r + 1) * (r + 1) <= n { r = r + 1; }
    return r;
}

// sq[t] = 1 iff t is a nonzero square mod p (the quadratic-residue table).
fn build_qr(p: i32, sq: *i32) {
    var i: i32 = 0;
    while i < p { sq[i] = 0; i = i + 1; }
    var y: i32 = 0;
    while y < p { sq[(y * y) % p] = 1; y = y + 1; }
}

// chi(t) in {0, +1, -1}: the quadratic character (Legendre symbol) via the table.
fn chi(t: i32, sq: *i32, p: i32) -> i32 {
    let tt: i32 = ((t % p) + p) % p;
    if tt == 0 { return 0; }
    if sq[tt] == 1 { return 1; }
    return -1;
}

// a_p = -sum_x chi(x^3 + a x + b)   (so #E(F_p) = p + 1 - a_p).
fn ap_of(a: i32, b: i32, sq: *i32, p: i32) -> i32 {
    var s: i32 = 0;
    var x: i32 = 0;
    while x < p {
        let x3: i32 = (((x * x) % p) * x) % p;
        let axb: i32 = (((a * x) % p) + b) % p;
        let fx: i32 = (((x3 + axb) % p) + p) % p;
        s = s + chi(fx, sq, p);
        x = x + 1;
    }
    return -s;
}

fn rnd_div(num: i64, den: i64) -> i64 {
    return (num + den / 2) / den;
}

// Observe a_p over ALL curves mod p; print the exact aggregate + the membrane.
fn run_prime(p: i32) {
    let sq: *i32 = alloc(p);
    build_qr(p, sq);

    let B: i32 = isqrt(4 * (p as i64)) as i32;     // floor(2 sqrt p)
    let nbins: i32 = 2 * B + 1;
    let hist: *i32 = alloc(nbins);
    var i: i32 = 0;
    while i < nbins { hist[i] = 0; i = i + 1; }

    var N: i64 = 0;
    var m1: i64 = 0;
    var m2: i64 = 0;
    var m3: i64 = 0;
    var m4: i64 = 0;
    var m5: i64 = 0;
    var m6: i64 = 0;

    var a: i32 = 0;
    while a < p {
        var b: i32 = 0;
        while b < p {
            let a3: i32 = (((a * a) % p) * a) % p;
            let disc: i32 = (((4 * a3) % p) + ((27 * ((b * b) % p)) % p)) % p;
            if disc != 0 {                          // skip singular curves
                N = N + 1;
                let ap: i32 = ap_of(a, b, sq, p);
                hist[ap + B] = hist[ap + B] + 1;
                let v: i64 = ap as i64;
                let v2: i64 = v * v;
                let v3: i64 = v2 * v;
                let v4: i64 = v3 * v;
                let v5: i64 = v4 * v;
                let v6: i64 = v5 * v;
                m1 = m1 + v;
                m2 = m2 + v2;
                m3 = m3 + v3;
                m4 = m4 + v4;
                m5 = m5 + v5;
                m6 = m6 + v6;
            }
            b = b + 1;
        }
        a = a + 1;
    }

    let pl: i64 = p as i64;
    let p2: i64 = pl * pl;
    let p3: i64 = p2 * pl;
    let s: i64 = 1000000;                            // declared leaves-field scale
    let nm2: i64 = rnd_div(s * m2, N * pl);          // -> S*C1 = 1000000
    let nm4: i64 = rnd_div(s * m4, N * p2);          // -> S*C2 = 2000000
    let nm6: i64 = rnd_div(s * m6, N * p3);          // -> S*C3 = 5000000

    print(p);
    print(N);
    print(m1); print(m2); print(m3); print(m4); print(m5); print(m6);
    print(nm2); print(nm4); print(nm6);
    print(B);
    var k: i32 = 0;
    while k < nbins { print(hist[k]); k = k + 1; }

    free(hist);
    free(sq);
}

fn main() -> i32 {
    run_prime(11);
    run_prime(31);
    run_prime(101);
    return 0;
}
