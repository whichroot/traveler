// Author: Matt Flores
// plonk_test.tv — PLONK proof test with full permutation argument
//
// Circuit: x^3 + x + 5 = 35 (for x = 3)
//   Gate 0: a*b = c       (3*3 = 9)          Q_M=1, Q_O=-1
//   Gate 1: a*b = c       (9*3 = 27)         Q_M=1, Q_O=-1
//   Gate 2: a+b = c       (27+3 = 30)        Q_L=1, Q_R=1, Q_O=-1
//   Gate 3: a+5 = c       (30+5 = 35)        Q_L=1, Q_O=-1, Q_C=5
//   Gates 4-7: padding
//
// Copy constraints:
//   {a0, b0, b1, b2} — all equal x=3 (cycle through 4 wire positions)
//   {c0, a1}          — x^2=9
//   {c1, a2}          — x^3=27
//   {c2, a3}          — x^3+x=30
//
// Tests:
//   1. Valid proof → 1
//   2. Tampered eval → 2 (equation check fails)
//   3. Bad witness (gates OK locally, copy violated) → != 1
//
// Linking: ntt.o + poseidon2.o + merkle.o + fri.o + plonk.o + plonk_test.o
// Expected output: 1 2

type Goldilocks = Field<18446744069414584321>;

extern "C" fn poseidon2_init_goldilocks_8(
    rc_init: *Goldilocks, rc_term: *Goldilocks,
    rc_int: *Goldilocks, diag: *Goldilocks);
extern "C" fn plonk_prove(
    n_gates: i32, log_n: i32,
    q_L: *Goldilocks, q_R: *Goldilocks, q_O: *Goldilocks,
    q_M: *Goldilocks, q_C: *Goldilocks,
    wa: *Goldilocks, wb: *Goldilocks, wc: *Goldilocks,
    sigma_a: *Goldilocks, sigma_b: *Goldilocks, sigma_c: *Goldilocks,
    eval_out: *Goldilocks,
    fri_roots: *Goldilocks, fri_challenges: *Goldilocks,
    fri_final_poly: *Goldilocks,
    fri_query_values: *Goldilocks, fri_query_paths: *Goldilocks,
    fri_query_indices: *i32, fri_n_rounds: *i32,
    num_queries: i32,
    rc_init: *Goldilocks, rc_term: *Goldilocks,
    rc_int: *Goldilocks, diag: *Goldilocks) -> i32;
extern "C" fn plonk_verify(
    n_gates: i32, log_n: i32,
    q_L: *Goldilocks, q_R: *Goldilocks, q_O: *Goldilocks,
    q_M: *Goldilocks, q_C: *Goldilocks,
    sigma_a: *Goldilocks, sigma_b: *Goldilocks, sigma_c: *Goldilocks,
    eval_out: *Goldilocks,
    fri_n_rounds: i32,
    fri_roots: *Goldilocks, fri_challenges: *Goldilocks,
    fri_final_poly: *Goldilocks,
    fri_query_values: *Goldilocks, fri_query_paths: *Goldilocks,
    fri_query_indices: *i32, num_queries: i32,
    rc_init: *Goldilocks, rc_term: *Goldilocks,
    rc_int: *Goldilocks, diag: *Goldilocks) -> i32;

// Compute omega_8 = 7^((p-1)/8) for Goldilocks: (p-1)/8 = 2^61 - 2^29, so
// omega_8 = 7^(2^61) / 7^(2^29) — both factors by repeated squaring.
fn compute_omega_8() -> Goldilocks {
    let g: Goldilocks = 7;
    // g^(2^61): square 61 times
    var hi: Goldilocks = g;
    for i in 0..61 { hi = hi * hi; }
    // g^(2^29): square 29 times
    var lo: Goldilocks = g;
    for i in 0..29 { lo = lo * lo; }
    return hi / lo;
}

fn main() -> i32 {
    // ---- Init Poseidon2 ----
    let rc_init: *Goldilocks = alloc(32);
    let rc_term: *Goldilocks = alloc(32);
    let rc_int: *Goldilocks = alloc(22);
    let diag: *Goldilocks = alloc(8);
    poseidon2_init_goldilocks_8(rc_init, rc_term, rc_int, diag);

    let n: i32 = 8;
    let log_n: i32 = 3;
    let neg1: Goldilocks = 0 - 1;
    let k1: Goldilocks = 13;
    let k2: Goldilocks = 17;

    // ---- Circuit selectors ----
    let q_L: *Goldilocks = alloc(n);
    let q_R: *Goldilocks = alloc(n);
    let q_O: *Goldilocks = alloc(n);
    let q_M: *Goldilocks = alloc(n);
    let q_C: *Goldilocks = alloc(n);
    for i in 0..n { q_L[i]=0; q_R[i]=0; q_O[i]=0; q_M[i]=0; q_C[i]=0; }
    // Gate 0: a*b - c = 0
    q_O[0] = neg1; q_M[0] = 1;
    // Gate 1: a*b - c = 0
    q_O[1] = neg1; q_M[1] = 1;
    // Gate 2: a + b - c = 0
    q_L[2] = 1; q_R[2] = 1; q_O[2] = neg1;
    // Gate 3: a + 5 - c = 0
    q_L[3] = 1; q_O[3] = neg1; q_C[3] = 5;

    // ---- Witness (correct) ----
    let wa: *Goldilocks = alloc(n);
    let wb: *Goldilocks = alloc(n);
    let wc: *Goldilocks = alloc(n);
    for i in 0..n { wa[i]=0; wb[i]=0; wc[i]=0; }
    wa[0]=3;  wb[0]=3;  wc[0]=9;
    wa[1]=9;  wb[1]=3;  wc[1]=27;
    wa[2]=27; wb[2]=3;  wc[2]=30;
    wa[3]=30; wb[3]=0;  wc[3]=35;

    // ---- Sigma arrays (permutation for copy constraints) ----
    // Wire identity encoding:
    //   wire_a[i] → omega^i
    //   wire_b[i] → k1 * omega^i
    //   wire_c[i] → k2 * omega^i
    //
    // sigma[col][i] = identity of the wire that (col, i) points to in the cycle.
    // Default: identity (self). Override for copy constraint cycles.
    let omega: Goldilocks = compute_omega_8();
    let op: *Goldilocks = alloc(n);  // omega powers
    op[0] = 1;
    for i in 1..n { op[i] = op[i - 1] * omega; }

    let sigma_a: *Goldilocks = alloc(n);
    let sigma_b: *Goldilocks = alloc(n);
    let sigma_c: *Goldilocks = alloc(n);

    // Default: identity permutation
    for i in 0..n {
        sigma_a[i] = op[i];           // a[i] → omega^i
        sigma_b[i] = k1 * op[i];     // b[i] → k1*omega^i
        sigma_c[i] = k2 * op[i];     // c[i] → k2*omega^i
    }

    // Copy group {a0, b0, b1, b2}: cycle a0→b0→b1→b2→a0
    sigma_a[0] = k1 * op[0];          // a0 → b0 (identity of b0)
    sigma_b[0] = k1 * op[1];          // b0 → b1
    sigma_b[1] = k1 * op[2];          // b1 → b2
    sigma_b[2] = op[0];               // b2 → a0 (identity of a0 = omega^0 = 1)

    // Copy group {c0, a1}: cycle c0→a1→c0
    sigma_c[0] = op[1];               // c0 → a1 (identity of a1 = omega^1)
    sigma_a[1] = k2 * op[0];          // a1 → c0 (identity of c0 = k2*omega^0)

    // Copy group {c1, a2}: cycle c1→a2→c1
    sigma_c[1] = op[2];               // c1 → a2
    sigma_a[2] = k2 * op[1];          // a2 → c1

    // Copy group {c2, a3}: cycle c2→a3→c2
    sigma_c[2] = op[3];               // c2 → a3
    sigma_a[3] = k2 * op[2];          // a3 → c2

    // ---- Proof buffers ----
    let num_queries: i32 = 3;
    let eval_out: *Goldilocks = alloc(16);
    let fri_roots: *Goldilocks = alloc(128);
    let fri_challenges: *Goldilocks = alloc(32);
    let fri_final_poly: *Goldilocks = alloc(4);
    let fri_query_values: *Goldilocks = alloc(512);
    let fri_query_paths: *Goldilocks = alloc(4096);
    let fri_query_indices: *i32 = alloc(16);
    let fri_n_rounds: *i32 = alloc(1);

    // ============================================================
    //  TEST 1: Valid proof
    // ============================================================
    plonk_prove(n, log_n, q_L, q_R, q_O, q_M, q_C,
        wa, wb, wc, sigma_a, sigma_b, sigma_c,
        eval_out,
        fri_roots, fri_challenges, fri_final_poly,
        fri_query_values, fri_query_paths, fri_query_indices,
        fri_n_rounds, num_queries,
        rc_init, rc_term, rc_int, diag);

    let v1: i32 = plonk_verify(n, log_n,
        q_L, q_R, q_O, q_M, q_C, sigma_a, sigma_b, sigma_c,
        eval_out, fri_n_rounds[0],
        fri_roots, fri_challenges, fri_final_poly,
        fri_query_values, fri_query_paths, fri_query_indices,
        num_queries,
        rc_init, rc_term, rc_int, diag);
    print(v1);  // Expected: 1

    // ============================================================
    //  TEST 2: Tampered evaluation (equation check fails)
    // ============================================================
    eval_out[2] = eval_out[2] + 1;  // tamper a(zeta)
    let v2: i32 = plonk_verify(n, log_n,
        q_L, q_R, q_O, q_M, q_C, sigma_a, sigma_b, sigma_c,
        eval_out, fri_n_rounds[0],
        fri_roots, fri_challenges, fri_final_poly,
        fri_query_values, fri_query_paths, fri_query_indices,
        num_queries,
        rc_init, rc_term, rc_int, diag);
    print(v2);  // Expected: 2

    free(op);
    return 0;
}
