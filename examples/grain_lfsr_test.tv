// SPDX-License-Identifier: Apache-2.0
// Author: Matt Flores
// grain_lfsr_test.tv — runtime Grain-LFSR reproduces the Plonky3 round constants
// bit-for-bit over Goldilocks (rejection never fires) and BabyBear (it fires).
// @internal-design: crypto
//
// Output (expected): 1 1 1 1
//   1  Goldilocks rc_init[0]  == 0xdd5743e7f2a5a5d9 (first external constant)
//   1  Goldilocks rc_int[0]   == 0x488897d85ff51f56 (first internal; tests the
//                                init/internal/final raw-stream ORDER)
//   1  BabyBear  rc_init[0]   == 0x69cbb6af (rejection path exercised, n=31)
//   1  BabyBear  rc_int[0]    == 0x5a8053c0 (internal after rejection draws)

extern "C" fn grain_generate(f: Field, n: i32, t: i32, rf: i32, rp: i32,
    out: *i64, count: i32);

fn check(got: i64, want: i64) -> i32 {
    if got == want { return 1; }
    return 0;
}

fn main() -> i32 {
    // ---- Goldilocks width-8: RF=8, RP=22, n=64 ----
    // Raw stream = [ext_init, internal, ext_final]; ext_init holds (RF/2)*t = 32
    // constants (external layer runs R_f = RF/2 rounds), so internal[0] = raw[32].
    let fg: Field = field(18446744069414584321);
    let gcount: i32 = 8 * 8 + 22;        // RF*t + RP = 86 total raw constants
    let gout: *i64 = alloc(gcount);
    grain_generate(fg, 64, 8, 8, 22, gout, gcount);
    // ext_init[0] is raw[0]; internal[0] is raw[(RF/2)*t] = raw[32]
    print(check(gout[0], 0xdd5743e7f2a5a5d9));
    print(check(gout[32], 0x488897d85ff51f56));
    free(gout);

    // ---- BabyBear width-16: RF=8, RP=13, n=31 ----
    // ext_init = (RF/2)*t = 4*16 = 64; internal[0] is raw[64].
    let fb: Field = field(2013265921);
    let bcount: i32 = 8 * 16 + 13;       // RF*t + RP = 141
    let bout: *i64 = alloc(bcount);
    grain_generate(fb, 31, 16, 8, 13, bout, bcount);
    // ext_init[0] is raw[0]; internal[0] is raw[(RF/2)*t] = raw[64]
    print(check(bout[0], 0x69cbb6af));
    print(check(bout[64], 0x5a8053c0));
    free(bout);

    return 0;
}
