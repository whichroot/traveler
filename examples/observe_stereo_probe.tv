// SPDX-License-Identifier: Apache-2.0
// Author: Matt Flores
// observe_stereo_probe.tv — the honest stereo pair, measured exactly: runs the
// FOLD (w1024 fx<=4|lpc<=8 coef17) on mid + side-full, prints exact bits.
// @internal-design: observability (stereo-pair refutation)
//
// Link: observe_stereo_probe.o + learn.o
// Usage: observe_stereo_probe <file.wav>

extern "C" fn open(path: *u8, flags: i32, mode: i32) -> i32;
extern "C" fn read(fd: i32, buf: *u8, n: usize) -> i64;
extern "C" fn close(fd: i32) -> i32;
extern "C" fn write(fd: i32, buf: *u8, n: usize) -> i64;
extern "C" fn strlen(s: *u8) -> usize;
extern "C" fn exit(code: i32);

extern "C" fn codec_windowed_bits(x: *i32, n: i32, p: i32, window: i32, max_fixed_order: i32, fixed_hdr_bits: i32, max_lpc_order: i32, coef_bits: i32, out: *i64) -> i64;

let OSP_P16: i32 = 65537;    // 16-bit channels (mid, L, R): offset +32768/+2^15
let OSP_P17: i32 = 131071;   // 17-bit side-full: 2^17 - 1 (Mersenne), offset +65535

fn wr(fd: i32, s: *u8) {
    let n: usize = strlen(s);
    write(fd, s, n);
}

fn wr_int(fd: i32, n: i64) {
    if n < 0 {
        write(fd, "-", 1);
        wr_int(fd, 0 - n);
        return;
    }
    if n >= 10 { wr_int(fd, n / 10); }
    var d: [u8; 1] = 0;
    d[0] = ((n % 10) + 48) as u8;
    write(fd, &d[0], 1);
}

fn read_bytes_all(fd: i32, buf: *u8, cap: i64) -> i64 {
    var total: i64 = 0;
    while total < cap {
        let got: i64 = read(fd, (buf as i64 + total) as *u8, (cap - total) as usize);
        if got <= 0 { return total; }
        total = total + got;
    }
    return total;
}

fn read_le_u16(buf: *u8, pos: i32) -> i32 {
    return buf[pos] as i32 + (buf[pos + 1] as i32) * 256;
}
fn read_le_u32(buf: *u8, pos: i32) -> i32 {
    return buf[pos] as i32 + (buf[pos + 1] as i32) * 256
    + (buf[pos + 2] as i32) * 65536 + (buf[pos + 3] as i32) * 16777216;
}
fn read_s16(buf: *u8, off: i32) -> i32 {
    var val: i32 = buf[off] as i32 + (buf[off + 1] as i32) * 256;
    if val >= 32768 { val = val - 65536; }
    return val;
}
fn find_data_chunk(buf: *u8, file_size: i32, data_size_out: *i32) -> i32 {
    var pos: i32 = 12;
    while pos < file_size - 8 {
        let c0: i32 = buf[pos] as i32;
        let c1: i32 = buf[pos + 1] as i32;
        let c2: i32 = buf[pos + 2] as i32;
        let c3: i32 = buf[pos + 3] as i32;
        let sz: i32 = read_le_u32(buf, pos + 4);
        if c0 == 100 && c1 == 97 && c2 == 116 && c3 == 97 {
            data_size_out[0] = sz;
            return pos + 8;
        }
        pos = pos + 8 + sz + (sz % 2);
    }
    return 0;
}

fn run_fold(label: *u8, x: *i32, n: i32, p: i32) -> i64 {
    let out: *i64 = alloc(2);
    let bits: i64 = codec_windowed_bits(x, n, p, 1024, 4, 8, 8, 17, out);
    wr(2, label);
    wr_int(2, bits / 8);
    wr(2, " bytes   mode split: fixed=");
    wr_int(2, out[0]);
    wr(2, " lpc=");
    wr_int(2, out[1]);
    wr(2, "\n");
    free(out);
    return bits;
}

fn main(argc: i32, argv: **u8) -> i32 {
    if argc < 2 {
        wr(2, "usage: observe_stereo_probe <file.wav>\n");
        exit(1);
    }
    let path: *u8 = argv[1];

    let fd: i32 = open(path, 0, 0);
    if fd < 0 { wr(2, "error: cannot open file\n"); exit(1); }
    let buf: *u8 = alloc(134217728);
    let file_size: i64 = read_bytes_all(fd, buf, 134217728);
    close(fd);

    let num_channels: i32 = read_le_u16(buf, 22);
    let bits_ps: i32 = read_le_u16(buf, 34);
    if bits_ps != 16 { wr(2, "error: only 16-bit PCM supported\n"); exit(1); }
    if num_channels != 2 { wr(2, "error: stereo probe needs 2 channels\n"); exit(1); }

    var data_size_arr: [i32; 1] = 0;
    let data_offset: i32 = find_data_chunk(buf, file_size as i32, &data_size_arr[0]);
    let data_size: i32 = data_size_arr[0];
    if data_offset == 0 { wr(2, "error: no data chunk\n"); exit(1); }
    let n: i32 = data_size / 4;

    wr(2, "FILE "); wr(2, path); wr(2, "  frames="); wr_int(2, n as i64); wr(2, "\n");

    // the honest invertible pair: mid=(l+r)>>1 (arith shift = floor), side=l-r
    // full. l = mid + ((side + (side & 1)) >> 1), r = l - side.
    let midF: *i32 = alloc(n);    // + 32768 -> [0, 65536) in Field<65537>
    let sideF: *i32 = alloc(n);   // + 65535 -> [0, 131070] in Field<131071>
    var i: i32 = 0;
    while i < n {
        let base: i32 = data_offset + i * 4;
        let l: i32 = read_s16(buf, base);
        let r: i32 = read_s16(buf, base + 2);
        midF[i] = ((l + r) >> 1) + 32768;
        sideF[i] = (l - r) + 65535;
        i = i + 1;
    }
    free(buf);

    let mid_bits: i64 = run_fold("  mid  (l+r)>>1  fold w1024: ", midF, n, OSP_P16);
    let side_bits: i64 = run_fold("  side l-r FULL  fold w1024: ", sideF, n, OSP_P17);

    wr(2, "  HONEST mid+side total: ");
    wr_int(2, (mid_bits + side_bits) / 8);
    wr(2, " bytes\n");

    free(sideF); free(midF);
    print(n as i64);
    return 0;
}
