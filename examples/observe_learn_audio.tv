// SPDX-License-Identifier: Apache-2.0
// Author: Matt Flores
// observe_learn_audio.tv — observe-learn audio analysis driver: per-channel
// ladder (trace/momentum/Rice/multiorder/LPC/fold) + side channel + stereo fold.
// @internal-design: observability (observe-learn audio examples)
//
// Stereo pair: mid=(l+r)>>1 (16-bit), side=l-r FULL (17-bit, parity in LSB);
// side runs over p=131071 (Mersenne 2^17-1) at offset +65535.
//
// Link: observe_learn_audio.o + learn.o + residual_cascade.o + piecewise_codec.o + ntt.o
// Usage: observe_learn_audio <file.wav>

extern "C" fn open(path: *u8, flags: i32, mode: i32) -> i32;
extern "C" fn close(fd: i32) -> i32;
extern "C" fn write(fd: i32, buf: *u8, n: usize) -> i64;
extern "C" fn strlen(s: *u8) -> usize;
extern "C" fn exit(code: i32);

extern "C" fn pc_project_to_field(signed_samples: *i16, n: i32, field_samples: *i32) -> i32;
extern "C" fn register_trace(input: *i32, n: i32, residual_out: *i32, momentum_out: *i32) -> i32;
extern "C" fn learn_momentum_bits(residual: *i32, momentum: *i32, n: i32, p: i32, out: *i64);
extern "C" fn learn_windowed_bits(residual: *i32, n: i32, p: i32, window: i32, hdr_bits: i32) -> i64;
extern "C" fn learn_window_momentum_bits(residual: *i32, momentum: *i32, n: i32, p: i32, window: i32, hdr_bits: i32) -> i64;
extern "C" fn multiorder_windowed_bits(x: *i32, n: i32, p: i32, window: i32, max_order: i32, hdr_bits: i32) -> i64;
extern "C" fn lpc_windowed_bits(x: *i32, n: i32, p: i32, window: i32, max_order: i32, coef_bits: i32) -> i64;
extern "C" fn codec_windowed_bits(x: *i32, n: i32, p: i32, window: i32, max_fixed_order: i32, fixed_hdr_bits: i32, max_lpc_order: i32, coef_bits: i32, out: *i64) -> i64;
extern "C" fn codec_stereo_windowed_bits(lf: *i32, rf: *i32, mf: *i32, sf: *i32, n: i32, p_ch: i32, p_side: i32, window: i32, max_fixed_order: i32, fixed_hdr_bits: i32, max_lpc_order: i32, coef_bits: i32, out: *i64) -> i64;

let OLA_P: i32 = 65537;
let OLA_P17: i32 = 131071;   // side-full field: Mersenne 2^17 - 1, offset +65535

// ============================================================
//  OUTPUT
// ============================================================

fn wr(fd: i32, s: *u8) {
    let n: usize = strlen(s);
    write(fd, s, n);
}

fn wr_int(fd: i32, n: i64) {
    if n < 0 {
        write(fd, "-", 1);
        wr_int(fd, 0 - n);
        return;
    }
    if n >= 10 { wr_int(fd, n / 10); }
    var d: [u8; 1] = 0;
    d[0] = ((n % 10) + 48) as u8;
    write(fd, &d[0], 1);
}

// bits total -> "<bytes> bytes (<milli-bits/sample> mbps)"
fn report_bits(label: *u8, bits: i64, n: i64) {
    wr(2, label);
    wr_int(2, bits / 8);
    wr(2, " bytes  (");
    wr_int(2, bits * 1000 / (n + 1));
    wr(2, " mbps)\n");
}

// ============================================================
//  WAV
// ============================================================

fn read_le_u16(buf: *u8, pos: i32) -> i32 {
    return buf[pos] as i32 + (buf[pos + 1] as i32) * 256;
}
fn read_le_u32(buf: *u8, pos: i32) -> i32 {
    return buf[pos] as i32 + (buf[pos + 1] as i32) * 256
    + (buf[pos + 2] as i32) * 65536 + (buf[pos + 3] as i32) * 16777216;
}
fn read_s16(buf: *u8, off: i32) -> i32 {
    var val: i32 = buf[off] as i32 + (buf[off + 1] as i32) * 256;
    if val >= 32768 { val = val - 65536; }
    return val;
}
fn find_data_chunk(buf: *u8, file_size: i32, data_size_out: *i32) -> i32 {
    var pos: i32 = 12;
    while pos < file_size - 8 {
        let c0: i32 = buf[pos] as i32;
        let c1: i32 = buf[pos + 1] as i32;
        let c2: i32 = buf[pos + 2] as i32;
        let c3: i32 = buf[pos + 3] as i32;
        let sz: i32 = read_le_u32(buf, pos + 4);
        if c0 == 100 && c1 == 97 && c2 == 116 && c3 == 97 {
            data_size_out[0] = sz;
            return pos + 8;
        }
        pos = pos + 8 + sz + (sz % 2);
    }
    return 0;
}

// ============================================================
//  ONE FRAMING
// ============================================================

fn analyze(label: *u8, ch: *i16, n: i32) {
    let field_samples: *i32 = alloc(n);
    pc_project_to_field(ch, n, field_samples);

    let residual: *i32 = alloc(n);
    let momentum: *i32 = alloc(n);
    register_trace(field_samples, n, residual, momentum);

    let out: *i64 = alloc(5);
    learn_momentum_bits(residual, momentum, n, OLA_P, out);

    let marginal: i64 = out[0];
    let conditional: i64 = out[1];
    let floor_bits: i64 = out[2];
    let best_k: i64 = out[3];
    let ns: i64 = out[4];

    wr(2, "== "); wr(2, label); wr(2, " ==\n");
    wr(2, "  marginal (k="); wr_int(2, best_k); wr(2, ")  ");
    report_bits("", marginal, ns);
    report_bits("  conditional (learned) ", conditional, ns);
    report_bits("  floor (per-sample opt) ", floor_bits, ns);

    let saved: i64 = marginal - conditional;
    wr(2, "  learned saving: ");
    wr_int(2, saved / 8); wr(2, " bytes  (");
    if marginal > 0 { wr_int(2, saved * 100 / marginal); } else { wr(2, "0"); }
    wr(2, "% of marginal)  gap-to-floor: ");
    wr_int(2, (conditional - floor_bits) / 8); wr(2, " bytes\n");

    // multi-scale middle: per-window adaptive k (the FLAC-like scheme)
    let w4096: i64 = learn_windowed_bits(residual, n, OLA_P, 4096, 5);
    let w1024: i64 = learn_windowed_bits(residual, n, OLA_P, 1024, 5);
    let w256:  i64 = learn_windowed_bits(residual, n, OLA_P, 256, 5);
    let wm1024: i64 = learn_window_momentum_bits(residual, momentum, n, OLA_P, 1024, 5);
    report_bits("  window-4096 adaptive   ", w4096, ns);
    report_bits("  window-1024 adaptive   ", w1024, ns);
    report_bits("  window-256  adaptive   ", w256, ns);
    report_bits("  window-1024 +momentum  ", wm1024, ns);

    // multi-order predictor (Δ^0..Δ^4), best order+k per window — the gap-to-floor lever
    let mo1024: i64 = multiorder_windowed_bits(field_samples, n, OLA_P, 1024, 4, 8);
    let mo512:  i64 = multiorder_windowed_bits(field_samples, n, OLA_P, 512, 4, 8);
    report_bits("  MULTIORDER w1024 (0..4) ", mo1024, ns);
    report_bits("  MULTIORDER w512  (0..4) ", mo512, ns);

    // exact-integer LPC (FLAC-style) — the gap-to-floor lever for dense/tonal
    // residual. Order ladder 8/16; dropped w4096-o32 rung: @internal-design: observability.
    let lpc1024_8:  i64 = lpc_windowed_bits(field_samples, n, OLA_P, 1024, 8, 17);
    let lpc4096_16: i64 = lpc_windowed_bits(field_samples, n, OLA_P, 4096, 16, 17);
    report_bits("  LPC w1024 order<=8      ", lpc1024_8, ns);
    report_bits("  LPC w4096 order<=16     ", lpc4096_16, ns);

    // THE FOLD — one emitter, per-window fixed-vs-LPC decision (+1 mode bit
    // per window); can beat both single modes by mixing within the track.
    let cout: *i64 = alloc(2);
    let fold1024: i64 = codec_windowed_bits(field_samples, n, OLA_P, 1024, 4, 8, 8, 17, cout);
    report_bits("  CODEC-FOLD w1024 (fx4|lpc8) ", fold1024, ns);
    wr(2, "    mode split: fixed="); wr_int(2, cout[0]);
    wr(2, " lpc="); wr_int(2, cout[1]); wr(2, "\n");
    let fold4096: i64 = codec_windowed_bits(field_samples, n, OLA_P, 4096, 4, 8, 16, 17, cout);
    report_bits("  CODEC-FOLD w4096 (fx4|lpc16)", fold4096, ns);
    wr(2, "    mode split: fixed="); wr_int(2, cout[0]);
    wr(2, " lpc="); wr_int(2, cout[1]); wr(2, "\n");
    free(cout);

    free(out);
    free(momentum);
    free(residual);
    free(field_samples);
}

// The honest side channel (l-r FULL, 17-bit) — p-parametric lines only;
// the Field<65537>-coupled trace/momentum path stays on the 16-bit channels.
fn analyze_side(sideF: *i32, n: i32) {
    let ns: i64 = n as i64;
    wr(2, "== side (l-r FULL, p=131071) ==\n");
    let mo1024: i64 = multiorder_windowed_bits(sideF, n, OLA_P17, 1024, 4, 8);
    report_bits("  MULTIORDER w1024 (0..4) ", mo1024, ns);
    let lpc1024_8: i64 = lpc_windowed_bits(sideF, n, OLA_P17, 1024, 8, 17);
    report_bits("  LPC w1024 order<=8      ", lpc1024_8, ns);
    let cout: *i64 = alloc(2);
    let fold1024: i64 = codec_windowed_bits(sideF, n, OLA_P17, 1024, 4, 8, 8, 17, cout);
    report_bits("  CODEC-FOLD w1024 (fx4|lpc8) ", fold1024, ns);
    wr(2, "    mode split: fixed="); wr_int(2, cout[0]);
    wr(2, " lpc="); wr_int(2, cout[1]); wr(2, "\n");
    free(cout);
}

// ============================================================
//  MAIN
// ============================================================

fn main(argc: i32, argv: **u8) -> i32 {
    if argc < 2 {
        wr(2, "usage: observe_learn_audio <file.wav>\n");
        exit(1);
    }
    let path: *u8 = argv[1];

    let fd: i32 = open(path, 0, 0);
    if fd < 0 { wr(2, "error: cannot open file\n"); exit(1); }
    let buf: *u8 = alloc(134217728);
    let file_size: i64 = read_bytes(fd, buf, 134217728);
    close(fd);

    let num_channels: i32 = read_le_u16(buf, 22);
    let sample_rate: i32 = read_le_u32(buf, 24);
    let bits: i32 = read_le_u16(buf, 34);
    if bits != 16 { wr(2, "error: only 16-bit PCM supported\n"); exit(1); }

    var data_size_arr: [i32; 1] = 0;
    let data_offset: i32 = find_data_chunk(buf, file_size as i32, &data_size_arr[0]);
    let data_size: i32 = data_size_arr[0];
    if data_offset == 0 { wr(2, "error: no data chunk\n"); exit(1); }
    let num_frames: i32 = data_size / (2 * num_channels);

    wr(2, "FILE "); wr(2, path); wr(2, "\n");
    wr(2, "  channels="); wr_int(2, num_channels as i64);
    wr(2, " rate="); wr_int(2, sample_rate as i64);
    wr(2, " frames="); wr_int(2, num_frames as i64); wr(2, "\n");

    let chL: *i16 = alloc(num_frames);
    let chR: *i16 = alloc(num_frames);
    let chM: *i16 = alloc(num_frames);
    let sideF: *i32 = alloc(num_frames);
    var i: i32 = 0;
    while i < num_frames {
        let base: i32 = data_offset + (i * num_channels) * 2;
        let l: i32 = read_s16(buf, base);
        var r: i32 = l;
        if num_channels > 1 { r = read_s16(buf, base + 2); }
        chL[i] = l as i16;
        chR[i] = r as i16;
        chM[i] = ((l + r) >> 1) as i16;     // floor mid (invertible with side)
        sideF[i] = (l - r) + 65535;         // side FULL at offset +65535, p17
        i = i + 1;
    }
    free(buf);

    analyze("L", chL, num_frames);
    analyze("R", chR, num_frames);
    analyze("mid", chM, num_frames);
    analyze_side(sideF, num_frames);

    // THE STEREO FOLD — the headline: per-window pair decision (LR/MS/LS/RS),
    // each coded channel paying its own fixed-vs-LPC fold, 2-bit pair tag.
    let lF: *i32 = alloc(num_frames);
    let rF: *i32 = alloc(num_frames);
    let mF: *i32 = alloc(num_frames);
    i = 0;
    while i < num_frames {
        lF[i] = chL[i] as i32 + 32768;
        rF[i] = chR[i] as i32 + 32768;
        mF[i] = chM[i] as i32 + 32768;
        i = i + 1;
    }
    let sout: *i64 = alloc(4);
    let st: i64 = codec_stereo_windowed_bits(lF, rF, mF, sideF, num_frames,
        OLA_P, OLA_P17, 1024, 4, 8, 8, 17, sout);
    wr(2, "== STEREO (per-window pair fold, w1024) ==\n");
    report_bits("  total ", st, num_frames as i64);
    wr(2, "    pair split: LR="); wr_int(2, sout[0]);
    wr(2, " MS="); wr_int(2, sout[1]);
    wr(2, " LS="); wr_int(2, sout[2]);
    wr(2, " RS="); wr_int(2, sout[3]); wr(2, "\n");
    free(sout); free(mF); free(rF); free(lF);

    free(sideF); free(chM); free(chR); free(chL);
    print(num_frames as i64);
    return 0;
}
