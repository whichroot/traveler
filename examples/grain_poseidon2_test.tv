// Author: Matt Flores
// grain_poseidon2_test.tv — B-Grain end-to-end: Poseidon2 constants generated
// at RUNTIME (Grain-LFSR) drive the dyn permutation to the exact Plonky3 vector.
// @internal-design: crypto
//
// Expected output: 1  (permutation output == Plonky3 Goldilocks width-8 vector)
//
// 2-file link: grain_lfsr.o + this.

extern "C" fn grain_generate(f: Field, n: i32, t: i32, rf: i32, rp: i32,
    out: *i64, count: i32);

// ---- Generic Poseidon2 core (identical to dyn_poseidon2_test.tv) ----

fn sbox7<F: Field>(x: F) -> F {
    let x2: F = x * x;
    let x4: F = x2 * x2;
    let x7: F = x4 * x2 * x;
    return x7;
}

fn mds_mat4<F: Field>(s: *F) {
    let s0: F = s[0]; let s1: F = s[1]; let s2: F = s[2]; let s3: F = s[3];
    let t01: F  = s0 + s1;
    let t23: F  = s2 + s3;
    let t0123: F = t01 + t23;
    let t01123: F = t0123 + s1;
    let t01233: F = t0123 + s3;
    s[0] = t01123 + t01;
    s[1] = t01123 + s2 + s2;
    s[2] = t01233 + t23;
    s[3] = t01233 + s0 + s0;
}

fn mds_external_8<F: Field>(state: *F) {
    mds_mat4(state);
    let hi: *F = &state[4];
    mds_mat4(hi);
    let sum0: F = state[0] + state[4];
    let sum1: F = state[1] + state[5];
    let sum2: F = state[2] + state[6];
    let sum3: F = state[3] + state[7];
    state[0] = state[0] + sum0;
    state[1] = state[1] + sum1;
    state[2] = state[2] + sum2;
    state[3] = state[3] + sum3;
    state[4] = state[4] + sum0;
    state[5] = state[5] + sum1;
    state[6] = state[6] + sum2;
    state[7] = state[7] + sum3;
}

fn mds_internal_8<F: Field>(state: *F, diag: *F) {
    var sum: F = state[0];
    for i in 1..8 {
        sum = sum + state[i];
    }
    for i in 0..8 {
        state[i] = state[i] * diag[i] + sum;
    }
}

fn poseidon2_permute_8<F: Field>(
    state: *F, rc_init: *F, rc_term: *F, rc_int: *F, diag: *F
) {
    mds_external_8(state);
    for r in 0..4 {
        let base: i32 = r * 8;
        for i in 0..8 { state[i] = state[i] + rc_init[base + i]; }
        for i in 0..8 { state[i] = sbox7(state[i]); }
        mds_external_8(state);
    }
    for r in 0..22 {
        state[0] = state[0] + rc_int[r];
        state[0] = sbox7(state[0]);
        mds_internal_8(state, diag);
    }
    for r in 0..4 {
        let base: i32 = r * 8;
        for i in 0..8 { state[i] = state[i] + rc_term[base + i]; }
        for i in 0..8 { state[i] = sbox7(state[i]); }
        mds_external_8(state);
    }
}

fn poseidon2_diag<F: Field>(diag: *F) {
    let zero: F = 0; let one: F = 1; let two: F = 2;
    let three: F = 3; let four: F = 4;
    let half: F = one / two;
    diag[0] = zero - two;
    diag[1] = one;
    diag[2] = two;
    diag[3] = half;
    diag[4] = three;
    diag[5] = zero - half;
    diag[6] = zero - three;
    diag[7] = zero - four;
}

instantiate sbox7<dyn>;
instantiate mds_mat4<dyn>;
instantiate mds_external_8<dyn>;
instantiate mds_internal_8<dyn>;
instantiate poseidon2_permute_8<dyn>;
instantiate poseidon2_diag<dyn>;

fn main() -> i32 {
    let f: Field = field(18446744069414584321);

    // Generate the raw constant stream at runtime: [ext_init(32), internal(22),
    // ext_final(32)] = 86 for Goldilocks width-8 (RF=8, RP=22, n=64).
    let raw: *i64 = alloc(86);
    grain_generate(f, 64, 8, 8, 22, raw, 86);

    // Slice into the permutation's expected layout.
    let rc_init: *i64 = alloc(32);   // external_initial
    let rc_int: *i64 = alloc(22);    // internal
    let rc_term: *i64 = alloc(32);   // external_final
    for i in 0..32 { rc_init[i] = raw[i]; }
    for i in 0..22 { rc_int[i] = raw[32 + i]; }
    for i in 0..32 { rc_term[i] = raw[54 + i]; }

    // Derive the diagonal in field terms (already verified elsewhere).
    let diag: *i64 = alloc(8);
    poseidon2_diag_dyn(f, diag);

    // Run the permutation on [0..7].
    let state: *i64 = alloc(8);
    for i in 0..8 { state[i] = i as i64; }
    poseidon2_permute_8_dyn(f, state, rc_init, rc_term, rc_int, diag);

    // Match the Plonky3 Goldilocks width-8 test vector.
    let expected: *i64 = alloc(8);
    expected[0] = 0x020cf04a1b214d14;
    expected[1] = 0x84e14aaaeacaed25;
    expected[2] = 0x1ae0f640e81c7457;
    expected[3] = 0xa4d204cbaeb0d8a5;
    expected[4] = 0x0cf637b627b3a7ff;
    expected[5] = 0x788d304d948b486b;
    expected[6] = 0x7327133ea1949af4;
    expected[7] = 0xf415abb924da395b;

    var pass: i32 = 1;
    for i in 0..8 {
        if state[i] != expected[i] { pass = 0; }
    }
    print(pass);

    free(raw); free(rc_init); free(rc_int); free(rc_term);
    free(diag); free(state); free(expected);
    return 0;
}
