// SPDX-License-Identifier: Apache-2.0
// Author: Matt Flores
// plonk_dyn_test.tv — proves x^3 + x + 5 = 35 over a prime bound at RUNTIME
// via field(p): the dyn PLONK engine (src/lib/crypto/plonk_dyn.tv), same 8-gate
// circuit as baked plonk_test, trace root of unity from the carrier root chain.
// @internal-design: crypto
//
// Circuit (8 gates, log_n = 3):
//   Gate 0: a*b = c   (3*3 = 9)      Q_M=1, Q_O=-1
//   Gate 1: a*b = c   (9*3 = 27)     Q_M=1, Q_O=-1
//   Gate 2: a+b = c   (27+3 = 30)    Q_L=1, Q_R=1, Q_O=-1
//   Gate 3: a+5 = c   (30+5 = 35)    Q_L=1, Q_O=-1, Q_C=5
//   Gates 4-7: padding
//
// Tests:
//   1. valid proof -> 1
//   2. tampered evaluation -> 2 (equation check fails)
//
// Two-file link: plonk_dyn.o + plonk_dyn_test.o (tvc_self-only).
// Expected output: 1 2

extern "C" fn fill_rc(rc_init: *i64, rc_term: *i64, rc_int: *i64);
extern "C" fn poseidon2_diag_dyn(f: Field, diag: *i64);
extern "C" fn fmul_dyn(f: Field, a: i64, b: i64) -> i64;
extern "C" fn fadd_dyn(f: Field, a: i64, b: i64) -> i64;
extern "C" fn fsub_dyn(f: Field, a: i64, b: i64) -> i64;
extern "C" fn plonk_omega_dyn(f: Field, log_n: i32) -> i64;
extern "C" fn plonk_prove_dyn(
    f: Field, n_gates: i32, log_n: i32,
    q_L: *i64, q_R: *i64, q_O: *i64, q_M: *i64, q_C: *i64,
    wa: *i64, wb: *i64, wc: *i64,
    sigma_a: *i64, sigma_b: *i64, sigma_c: *i64,
    eval_out: *i64,
    fri_roots: *i64, fri_challenges: *i64, fri_final_poly: *i64,
    fri_query_values: *i64, fri_query_paths: *i64,
    fri_query_indices: *i32, fri_n_rounds: *i32,
    num_queries: i32,
    rc_init: *i64, rc_term: *i64, rc_int: *i64, diag: *i64) -> i32;
extern "C" fn plonk_verify_dyn(
    f: Field, n_gates: i32, log_n: i32,
    q_L: *i64, q_R: *i64, q_O: *i64, q_M: *i64, q_C: *i64,
    sigma_a: *i64, sigma_b: *i64, sigma_c: *i64,
    eval_out: *i64,
    fri_n_rounds: i32,
    fri_roots: *i64, fri_challenges: *i64, fri_final_poly: *i64,
    fri_query_values: *i64, fri_query_paths: *i64,
    fri_query_indices: *i32, num_queries: i32,
    rc_init: *i64, rc_term: *i64, rc_int: *i64, diag: *i64) -> i32;

fn run(p: i64) {
    let f: Field = field(p);

    let rc_init: *i64 = alloc(32);
    let rc_term: *i64 = alloc(32);
    let rc_int: *i64 = alloc(22);
    let diag: *i64 = alloc(8);
    fill_rc(rc_init, rc_term, rc_int);
    poseidon2_diag_dyn(f, diag);

    let n: i32 = 8;
    let log_n: i32 = 3;
    let neg1: i64 = fsub_dyn(f, 0, 1);
    let k1: i64 = 13;
    let k2: i64 = 17;

    let q_L: *i64 = alloc(n);
    let q_R: *i64 = alloc(n);
    let q_O: *i64 = alloc(n);
    let q_M: *i64 = alloc(n);
    let q_C: *i64 = alloc(n);
    for i in 0..n { q_L[i]=0; q_R[i]=0; q_O[i]=0; q_M[i]=0; q_C[i]=0; }
    q_O[0] = neg1; q_M[0] = 1;
    q_O[1] = neg1; q_M[1] = 1;
    q_L[2] = 1; q_R[2] = 1; q_O[2] = neg1;
    q_L[3] = 1; q_O[3] = neg1; q_C[3] = 5;

    let wa: *i64 = alloc(n);
    let wb: *i64 = alloc(n);
    let wc: *i64 = alloc(n);
    for i in 0..n { wa[i]=0; wb[i]=0; wc[i]=0; }
    wa[0]=3;  wb[0]=3;  wc[0]=9;
    wa[1]=9;  wb[1]=3;  wc[1]=27;
    wa[2]=27; wb[2]=3;  wc[2]=30;
    wa[3]=30; wb[3]=0;  wc[3]=35;

    let omega: i64 = plonk_omega_dyn(f, log_n);
    let op: *i64 = alloc(n);
    op[0] = 1;
    for i in 1..n { op[i] = fmul_dyn(f, op[i - 1], omega); }

    let sigma_a: *i64 = alloc(n);
    let sigma_b: *i64 = alloc(n);
    let sigma_c: *i64 = alloc(n);
    for i in 0..n {
        sigma_a[i] = op[i];
        sigma_b[i] = fmul_dyn(f, k1, op[i]);
        sigma_c[i] = fmul_dyn(f, k2, op[i]);
    }
    sigma_a[0] = fmul_dyn(f, k1, op[0]);
    sigma_b[0] = fmul_dyn(f, k1, op[1]);
    sigma_b[1] = fmul_dyn(f, k1, op[2]);
    sigma_b[2] = op[0];
    sigma_c[0] = op[1];
    sigma_a[1] = fmul_dyn(f, k2, op[0]);
    sigma_c[1] = op[2];
    sigma_a[2] = fmul_dyn(f, k2, op[1]);
    sigma_c[2] = op[3];
    sigma_a[3] = fmul_dyn(f, k2, op[2]);

    let num_queries: i32 = 3;
    let eval_out: *i64 = alloc(16);
    let fri_roots: *i64 = alloc(128);
    let fri_challenges: *i64 = alloc(32);
    let fri_final_poly: *i64 = alloc(4);
    let fri_query_values: *i64 = alloc(512);
    let fri_query_paths: *i64 = alloc(4096);
    let fri_query_indices: *i32 = alloc(16);
    let fri_n_rounds: *i32 = alloc(1);

    plonk_prove_dyn(f, n, log_n, q_L, q_R, q_O, q_M, q_C,
        wa, wb, wc, sigma_a, sigma_b, sigma_c,
        eval_out, fri_roots, fri_challenges, fri_final_poly,
        fri_query_values, fri_query_paths, fri_query_indices,
        fri_n_rounds, num_queries, rc_init, rc_term, rc_int, diag);

    let v1: i32 = plonk_verify_dyn(f, n, log_n,
        q_L, q_R, q_O, q_M, q_C, sigma_a, sigma_b, sigma_c,
        eval_out, fri_n_rounds[0],
        fri_roots, fri_challenges, fri_final_poly,
        fri_query_values, fri_query_paths, fri_query_indices,
        num_queries, rc_init, rc_term, rc_int, diag);
    print(v1);  // expect 1

    eval_out[2] = fadd_dyn(f, eval_out[2], 1);
    let v2: i32 = plonk_verify_dyn(f, n, log_n,
        q_L, q_R, q_O, q_M, q_C, sigma_a, sigma_b, sigma_c,
        eval_out, fri_n_rounds[0],
        fri_roots, fri_challenges, fri_final_poly,
        fri_query_values, fri_query_paths, fri_query_indices,
        num_queries, rc_init, rc_term, rc_int, diag);
    print(v2);  // expect 2

    free(q_L); free(q_R); free(q_O); free(q_M); free(q_C);
    free(wa); free(wb); free(wc); free(op);
    free(sigma_a); free(sigma_b); free(sigma_c);
    free(eval_out); free(fri_roots); free(fri_challenges); free(fri_final_poly);
    free(fri_query_values); free(fri_query_paths); free(fri_query_indices);
    free(fri_n_rounds);
    free(rc_init); free(rc_term); free(rc_int); free(diag);
}

fn main() -> i32 {
    // Goldilocks (k=32) and BabyBear (k=27) — same circuit, two runtime primes.
    run(18446744069414584321);
    run(2013265921);
    return 0;
}
