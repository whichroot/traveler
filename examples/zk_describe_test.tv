// SPDX-License-Identifier: Apache-2.0
// Author: Matt Flores
// zk_describe_test.tv — the #[zk] DESCRIBE companion: an external party
// re-derives the circuit (selectors + sigma) and verifies the proof against it.
// @internal-design: zk
//
// Tests (over Goldilocks, then BabyBear):
//   1. native cubic(3) = 35                                              -> 35
//   2. prover companion returns 1 (proof generated)                      -> 1
//   3. describe companion + external plonk_verify_dyn accepts the proof  -> 1
//   4. tamper a described selector -> external verify rejects (code 2/3) -> 0
//
// Per prime the driver prints:  35 1 1 0
// Expected output:  35 1 1 0   35 1 1 0
//
// Link: plonk_dyn.o + zk_cubic_dyn.o + zk_describe_test.o

extern "C" fn fill_rc(rc_init: *i64, rc_term: *i64, rc_int: *i64);
extern "C" fn poseidon2_diag_dyn(f: Field, diag: *i64);

extern "C" fn cubic_dyn(f: Field, x: i64) -> i64;
extern "C" fn cubic_zk_prove_dyn(
    f: Field, x: i64,
    eval_out: *i64,
    fri_roots: *i64, fri_challenges: *i64, fri_final_poly: *i64,
    fri_query_values: *i64, fri_query_paths: *i64,
    fri_query_indices: *i32, fri_n_rounds: *i32,
    num_queries: i32,
    rc_init: *i64, rc_term: *i64, rc_int: *i64, diag: *i64) -> i32;
// the new describe companion
extern "C" fn cubic_zk_describe_dyn(
    f: Field,
    q_L: *i64, q_R: *i64, q_O: *i64, q_M: *i64, q_C: *i64,
    sigma_a: *i64, sigma_b: *i64, sigma_c: *i64, n_out: *i32);

extern "C" fn plonk_verify_dyn(
    f: Field, n_gates: i32, log_n: i32,
    q_L: *i64, q_R: *i64, q_O: *i64, q_M: *i64, q_C: *i64,
    sigma_a: *i64, sigma_b: *i64, sigma_c: *i64,
    eval_out: *i64,
    fri_n_rounds: i32,
    fri_roots: *i64, fri_challenges: *i64, fri_final_poly: *i64,
    fri_query_values: *i64, fri_query_paths: *i64,
    fri_query_indices: *i32, num_queries: i32,
    rc_init: *i64, rc_term: *i64, rc_int: *i64, diag: *i64) -> i32;

fn run(p: i64) {
    let f: Field = field(p);
    let rc_init: *i64 = alloc(32);
    let rc_term: *i64 = alloc(32);
    let rc_int: *i64 = alloc(22);
    let diag: *i64 = alloc(8);
    fill_rc(rc_init, rc_term, rc_int);
    poseidon2_diag_dyn(f, diag);

    // 1. native
    print(cubic_dyn(f, 3));   // 35

    // 2. prover companion fills the proof buffers
    let num_queries: i32 = 3;
    let eval_out: *i64 = alloc(16);
    let fri_roots: *i64 = alloc(128);
    let fri_challenges: *i64 = alloc(32);
    let fri_final_poly: *i64 = alloc(4);
    let fri_query_values: *i64 = alloc(512);
    let fri_query_paths: *i64 = alloc(4096);
    let fri_query_indices: *i32 = alloc(16);
    let fri_n_rounds: *i32 = alloc(1);

    let pok: i32 = cubic_zk_prove_dyn(f, 3, eval_out,
        fri_roots, fri_challenges, fri_final_poly,
        fri_query_values, fri_query_paths, fri_query_indices,
        fri_n_rounds, num_queries, rc_init, rc_term, rc_int, diag);
    print(pok);   // 1

    // 3. describe companion -> selectors + sigma + [padded_n, log_n]
    let n_out: *i32 = alloc(2);
    // size buffers generously (cubic circuit is small; 64 is ample)
    let cap: i32 = 64;
    let q_L: *i64 = alloc(cap); let q_R: *i64 = alloc(cap);
    let q_O: *i64 = alloc(cap); let q_M: *i64 = alloc(cap);
    let q_C: *i64 = alloc(cap);
    let sa: *i64 = alloc(cap); let sb: *i64 = alloc(cap);
    let sc: *i64 = alloc(cap);
    cubic_zk_describe_dyn(f, q_L, q_R, q_O, q_M, q_C, sa, sb, sc, n_out);
    let padded_n: i32 = n_out[0];
    let log_n: i32 = n_out[1];

    // external verify against the DESCRIBED circuit
    let v: i32 = plonk_verify_dyn(f, padded_n, log_n,
        q_L, q_R, q_O, q_M, q_C, sa, sb, sc,
        eval_out, fri_n_rounds[0],
        fri_roots, fri_challenges, fri_final_poly,
        fri_query_values, fri_query_paths, fri_query_indices,
        num_queries, rc_init, rc_term, rc_int, diag);
    if v == 1 { print(1); } else { print(0); }

    // 4. tamper a described selector -> external verify must reject
    q_M[0] = fadd_describe(q_M[0]);
    let vt: i32 = plonk_verify_dyn(f, padded_n, log_n,
        q_L, q_R, q_O, q_M, q_C, sa, sb, sc,
        eval_out, fri_n_rounds[0],
        fri_roots, fri_challenges, fri_final_poly,
        fri_query_values, fri_query_paths, fri_query_indices,
        num_queries, rc_init, rc_term, rc_int, diag);
    if vt == 1 { print(1); } else { print(0); }   // expect 0 (rejected)

    free(eval_out); free(fri_roots); free(fri_challenges); free(fri_final_poly);
    free(fri_query_values); free(fri_query_paths); free(fri_query_indices); free(fri_n_rounds);
    free(n_out); free(q_L); free(q_R); free(q_O); free(q_M); free(q_C);
    free(sa); free(sb); free(sc);
    free(rc_init); free(rc_term); free(rc_int); free(diag);
}

// add 1 (plain integer) to perturb a selector — breaks the gate equation.
fn fadd_describe(x: i64) -> i64 {
    return x + 1;
}

fn main() -> i32 {
    run(18446744069414584321);
    run(2013265921);
    return 0;
}
