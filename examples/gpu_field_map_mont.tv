// AGX-0 arbitrary-prime exhibit: the same proven elementwise map as
// gpu_field_map.tv over BabyBear, lowered through the measured Montgomery path.
// @internal-note: plan-gpu-agx-target

field F = Field<2013265921>;

fn main() -> i32 {
    let n: i32 = 4096;
    let a: *F = alloc(n);
    let out: *F = alloc(n);
    var i: i32 = 0;
    while i < n {
        a[i] = (i * 2 + 1) as F;
        i = i + 1;
    }

    for j in 0..4096 {
        out[j] = a[j] * a[j] + 3;
    }

    print(out[0]);
    print(out[7]);
    print(out[4095]);
    return 0;
}
