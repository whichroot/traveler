// Author: Matt Flores
// dynfield_eval.tv — E2f gate: the dyn-field coverage matrix under --eval; one
// generic surface <dyn> over p=251/65521/Goldilocks, eval == compiled byte-exact.
// @internal-design: examples (dynfield_eval).

fn inv_of<F: Field>(x: F) -> F {
    return x ** -1;
}

fn axpy<F: Field>(a: F, x: F, y: F) -> F {
    // Nested dyn call: inv_of receives the carrier implicitly.
    let inv: F = inv_of(a);
    return inv * x + y;
}

fn from_i64<F: Field>(raw: i64) -> F {
    return raw as F;
}

fn balanced<F: Field>(x: F) -> i64 {
    return signed(x);
}

fn fill_squares<F: Field>(buf: *F, n: i32) {
    var i: i32 = 0;
    while i < n {
        let iv: F = i as F;
        buf[i] = iv * iv + 3;      // literal reduces in-context at runtime
        i = i + 1;
    }
}

fn sum_all<F: Field>(buf: *F, n: i32) -> F {
    var acc: F = 0;
    var i: i32 = 0;
    while i < n {
        acc = acc + buf[i];
        i = i + 1;
    }
    return acc;
}

fn probe<F: Field>(x: F) -> F {
    // let strict modulation: an i64 variable reduces into F at runtime.
    let raw: i64 = 1000003;
    let m: F = raw;
    // Comparisons: unsigned icmp on residues, carrier-free.
    var bump: F = 0;
    if x < m { bump = 7; }
    if x != m { bump = bump + 2; }
    // Pow: square-and-multiply over the runtime prime (i64 exponent).
    let pw: F = x ** 5;
    return pw + bump + m;
}

instantiate axpy<dyn>;
instantiate from_i64<dyn>;
instantiate balanced<dyn>;
instantiate fill_squares<dyn>;
instantiate sum_all<dyn>;
instantiate probe<dyn>;

fn main() {
    // ---- p = 251 (narrow fast path) ----
    let f: Field = field(251);
    print(axpy_dyn(f, 7, 100, 9));       // inv(7)*100 + 9 mod 251
    print(from_i64_dyn(f, 100000));      // 100000 mod 251
    print(balanced_dyn(f, 250));         // 250 > 125 -> -1
    print(balanced_dyn(f, 100));         // 100 <= 125 -> 100
    let buf: *i64 = alloc(8);
    fill_squares_dyn(f, buf, 8);
    print(sum_all_dyn(f, buf, 8));       // sum(i^2+3) mod 251
    print(probe_dyn(f, 10));

    // ---- p = 65521 (16-bit) ----
    let h: Field = field(65521);
    print(axpy_dyn(h, 7, 100, 9));
    print(from_i64_dyn(h, 100000));
    print(probe_dyn(h, 10));

    // ---- Goldilocks p = 2^64 - 2^32 + 1 (wide Barrett path) ----
    let g: Field = field(18446744069414584321);
    print(axpy_dyn(g, 7, 100, 9));
    print(from_i64_dyn(g, 1000000007));
    print(balanced_dyn(g, 18446744069414584320));  // p-1 -> -1
    print(probe_dyn(g, 10));

    // ---- dyn values held + compared in MAIN (carrier-free cmp) ----
    let d1 = axpy_dyn(f, 7, 100, 9);
    let d2 = axpy_dyn(f, 7, 100, 9);
    let d3 = axpy_dyn(f, 7, 100, 10);
    if d1 == d2 { print(1); }
    if d1 != d3 { print(2); }
    if d1 < d3 { print(3); }
    print(d1);                            // dyn print from main (%llu)

    free(buf);
}
