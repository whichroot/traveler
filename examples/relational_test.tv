// SPDX-License-Identifier: Apache-2.0
// Author: Matt Flores
// relational_test.tv — Level 2 hermetic gate: all-pairs arc-relation moments
// tr(M^k) on synthetic shapes; corner-cut vs radial-cut, oracle-confirmed.
// @internal-design: features (relational.tv + Level 2)
//
// Three relations, each a SYMMETRIC {0,1} graph on the arcs (moments stay
// non-negative + field-safe):
//   M_len  : edge iff arcs i,j have DIFFERENT lengths.
//   M_turn : edge iff arcs i,j's START junctions turn the SAME way (the corner
//            direction sequence — what a "3" and a "5" differ on). No trig.
//   M_adj  : edge iff arc endpoints are within an INTRINSIC scale (mean
//            nearest-endpoint distance). No magic constant.
// Feature read: tr(M^2), tr(M^3) over a dyn field (mat_trace_pow_dyn).
//
// Arc definitions (both built; the data decides):
//   corner-cut : arcs = contour runs delimited by the UNION of degree-1 cut
//                indices of x(t) and y(t) (regime_prove_dyn certificate).
//   radial-cut : arcs = runs of the angle-ordered radial sequence.
//
// Tests (each 1 = pass):
//   1. corner-cut: U and T have IDENTICAL relational signature (Level-1-blind) -> 1
//   2. radial-cut TURN moments SEPARATE U from T (the attention relation bites) -> 1
//   3. radial-cut ADJ moments SEPARATE U from T                                 -> 1
//   4. corner-cut U signature matches the oracle EXACTLY (len/turn/adj moments) -> 1
//   5. a rotated copy of U (x<->y transpose) gives the SAME radial-cut TURN
//      moments as U (reorientation invariance carries to Level 2)               -> 1
//   6. all radial-cut moments field-invariant: Goldilocks == BabyBear          -> 1
//
// Expected output: 1 1 1 1 1 1
//
// Two-file link: relational.o + relational_test.o (tvc_self-only).

extern "C" fn write(fd: i32, buf: *u8, n: usize) -> i64;
extern "C" fn strlen(s: *u8) -> usize;
extern "C" fn regime_prove_dyn(
    f: Field, data: *i64, n: i32, deg: i32, cert: *i64, work: *i64) -> i32;
extern "C" fn mat_trace_pow_dyn(
    f: Field, M: *i64, m: i32, k: i32, P: *i64, Q: *i64) -> i64;

fn wr(fd: i32, s: *u8) { let len: usize = strlen(s); write(fd, s, len); }
fn wr_int(fd: i32, n: i64) {
    if n < 0 { write(fd, "-", 1); wr_int(fd, 0 - n); return; }
    if n >= 10 { wr_int(fd, n / 10); }
    var d: [u8; 1] = 0;
    d[0] = ((n % 10) + 48) as u8;
    write(fd, &d[0], 1);
}

fn iabs(x: i32) -> i32 { if x < 0 { return 0 - x; } return x; }

// ---------- synthetic glyph ink (matches oracle ink_U / ink_T) ----------
fn box_in(x: i32, y: i32, x0: i32, x1: i32, y0: i32, y1: i32) -> i32 {
    if x >= x0 { if x <= x1 { if y >= y0 { if y <= y1 { return 1; } } } }
    return 0;
}
fn ink_U(x: i32, y: i32, r: i32) -> i32 {
    let m: i32 = r / 6;
    let w: i32 = r / 6;
    let hi: i32 = r - 1 - m;
    if box_in(x, y, m, m + w, m, hi) == 1 { return 1; }
    if box_in(x, y, hi - w, hi, m, hi) == 1 { return 1; }
    if box_in(x, y, m, hi, hi - w, hi) == 1 { return 1; }
    return 0;
}
fn ink_T(x: i32, y: i32, r: i32) -> i32 {
    let m: i32 = r / 6;
    let w: i32 = r / 6;
    let hi: i32 = r - 1 - m;
    let cx: i32 = r / 2;
    if box_in(x, y, m, hi, m, m + w) == 1 { return 1; }
    if box_in(x, y, cx - w / 2, cx + w / 2, m, hi) == 1 { return 1; }
    return 0;
}
// gid: 0=U, 1=T, 2=U transposed (x<->y).
fn ink(gid: i32, x: i32, y: i32, r: i32) -> i32 {
    if x < 0 { return 0; }
    if y < 0 { return 0; }
    if x > (r - 1) { return 0; }
    if y > (r - 1) { return 0; }
    if gid == 0 { return ink_U(x, y, r); }
    if gid == 1 { return ink_T(x, y, r); }
    return ink_U(y, x, r);
}

// ---------- Moore contour trace (matches multiview / oracle) ----------
fn trace_contour(gid: i32, r: i32, cx: *i64, cy: *i64, max_len: i32) -> i32 {
    var dx: [i32; 8] = 0;
    var dy: [i32; 8] = 0;
    dx[0]=1;  dy[0]=0;
    dx[1]=1;  dy[1]=1;
    dx[2]=0;  dy[2]=1;
    dx[3]=0-1; dy[3]=1;
    dx[4]=0-1; dy[4]=0;
    dx[5]=0-1; dy[5]=0-1;
    dx[6]=0;  dy[6]=0-1;
    dx[7]=1;  dy[7]=0-1;
    var sx: i32 = 0-1;
    var sy: i32 = 0-1;
    var yy: i32 = 0;
    while yy < r {
        var xx: i32 = 0;
        while xx < r {
            if ink(gid, xx, yy, r) == 1 { sx = xx; sy = yy; xx = r; yy = r; }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    if sx < 0 { return 0; }
    cx[0] = sx as i64; cy[0] = sy as i64;
    var clen: i32 = 1;
    var curx: i32 = sx;
    var cury: i32 = sy;
    var b: i32 = 4;
    var steps: i32 = 0;
    while steps < max_len {
        var found: i32 = 0 - 1;
        var k: i32 = 0;
        while k < 8 {
            let dd: i32 = (b + 1 + k) % 8;
            let nx: i32 = curx + dx[dd];
            let ny: i32 = cury + dy[dd];
            if ink(gid, nx, ny, r) == 1 { found = dd; k = 8; }
            k = k + 1;
        }
        if found < 0 { return clen; }
        let nxp: i32 = curx + dx[found];
        let nyp: i32 = cury + dy[found];
        if nxp == sx { if nyp == sy { return clen; } }
        if clen < max_len {
            cx[clen] = nxp as i64; cy[clen] = nyp as i64; clen = clen + 1;
        } else { return clen; }
        curx = nxp; cury = nyp;
        b = (found + 4) % 8;
        steps = steps + 1;
    }
    return clen;
}

// ---------- integer angular ordering (octant + cross-product, no trig) ----------
fn octant(dx: i64, dy: i64) -> i32 {
    if dx > 0 { if dy >= 0 { if dx > dy { return 0; } return 1; } }
    if dx <= 0 { if dy > 0 { if dy >= (0 - dx) { return 2; } return 3; } }
    if dx < 0 { if dy <= 0 { if (0 - dx) > (0 - dy) { return 4; } return 5; } }
    if (0 - dy) > dx { return 6; }
    return 7;
}
fn angle_less(ax: i64, ay: i64, bx: i64, by: i64) -> i32 {
    let oa: i32 = octant(ax, ay);
    let ob: i32 = octant(bx, by);
    if oa != ob { if oa < ob { return 1; } return 0; }
    let cross: i64 = ax * by - ay * bx;
    if cross > 0 { return 1; }
    return 0;
}
// Reorder (cx,cy) by CCW angle about centroid into (ox,oy). n points.
fn radial_order(cx: *i64, cy: *i64, n: i32, ox: *i64, oy: *i64) {
    var sx: i64 = 0;
    var sy: i64 = 0;
    var i: i32 = 0;
    while i < n { sx = sx + cx[i]; sy = sy + cy[i]; i = i + 1; }
    let mx: i64 = sx / (n as i64);
    let my: i64 = sy / (n as i64);
    // centered copies in ox/oy; sort indices by angle (selection sort).
    i = 0;
    while i < n { ox[i] = cx[i]; oy[i] = cy[i]; i = i + 1; }
    i = 0;
    while i < n {
        var best: i32 = i;
        var j: i32 = i + 1;
        while j < n {
            let bx: i64 = ox[best] - mx; let by: i64 = oy[best] - my;
            let jx: i64 = ox[j] - mx;    let jy: i64 = oy[j] - my;
            if angle_less(jx, jy, bx, by) == 1 { best = j; }
            j = j + 1;
        }
        let tx: i64 = ox[i]; ox[i] = ox[best]; ox[best] = tx;
        let ty: i64 = oy[i]; oy[i] = oy[best]; oy[best] = ty;
        i = i + 1;
    }
}

// ---------- arc cut points (union of deg-1 cuts of x and y) ----------
// Writes sorted unique start indices into starts[], returns count (m arcs).
// Uses regime_prove_dyn over field f to get the deg-1 segmentation of a view.
fn view_cuts(f: Field, view: *i64, n: i32, cert: *i64, work: *i64, starts: *i32) -> i32 {
    let nseg: i32 = regime_prove_dyn(f, view, n, 1, cert, work);
    var k: i32 = 0;
    while k < nseg { starts[k] = cert[k * 3] as i32; k = k + 1; }
    return nseg;
}
// Merge two sorted start arrays (ax/an, bx/bn) into out[], sorted unique. ret count.
fn merge_cuts(ax: *i32, an: i32, bx: *i32, bn: i32, out: *i32) -> i32 {
    var i: i32 = 0;
    var j: i32 = 0;
    var o: i32 = 0;
    while i < an {
        if j < bn {
            if bx[j] < ax[i] {
                if o == 0 { out[o] = bx[j]; o = o + 1; }
                else { if out[o - 1] != bx[j] { out[o] = bx[j]; o = o + 1; } }
                j = j + 1;
            } else {
                if o == 0 { out[o] = ax[i]; o = o + 1; }
                else { if out[o - 1] != ax[i] { out[o] = ax[i]; o = o + 1; } }
                if ax[i] == bx[j] { j = j + 1; }
                i = i + 1;
            }
        } else {
            if o == 0 { out[o] = ax[i]; o = o + 1; }
            else { if out[o - 1] != ax[i] { out[o] = ax[i]; o = o + 1; } }
            i = i + 1;
        }
    }
    while j < bn {
        if o == 0 { out[o] = bx[j]; o = o + 1; }
        else { if out[o - 1] != bx[j] { out[o] = bx[j]; o = o + 1; } }
        j = j + 1;
    }
    return o;
}

// Build arcs over a point sequence (X,Y length n) given m sorted cut starts.
// Arc k spans [starts[k], starts[k+1]) (last wraps to n). Computes per-arc:
//   len[k]   = point count
//   sx/sy/ex/ey[k] = start and end endpoints
//   turn[k]  = corner class at the start junction (sign of cross of prev-arc's
//              last edge into this arc's first edge): +1 left, -1 right, 0 straight.
fn build_arcs(
    X: *i64, Y: *i64, n: i32, starts: *i32, m: i32,
    alen: *i32, sx: *i64, sy: *i64, ex: *i64, ey: *i64, turn: *i32
) {
    var k: i32 = 0;
    while k < m {
        let s: i32 = starts[k];
        var e: i32 = n;
        if k + 1 < m { e = starts[k + 1]; }
        alen[k] = e - s;
        sx[k] = X[s]; sy[k] = Y[s];
        ex[k] = X[e - 1]; ey[k] = Y[e - 1];
        k = k + 1;
    }
    // corner class at each arc's start junction (closed contour: wraps).
    k = 0;
    while k < m {
        let pk: i32 = (k + m - 1) % m;
        let ps: i32 = starts[pk];
        var pe: i32 = n;
        if pk + 1 < m { pe = starts[pk + 1]; }
        let s: i32 = starts[k];
        var e: i32 = n;
        if k + 1 < m { e = starts[k + 1]; }
        var tc: i32 = 0;
        if (pe - ps) >= 2 { if (e - s) >= 2 {
                let aax: i64 = X[pe - 1] - X[pe - 2];
                let aay: i64 = Y[pe - 1] - Y[pe - 2];
                let bbx: i64 = X[s + 1] - X[s];
                let bby: i64 = Y[s + 1] - Y[s];
                let cross: i64 = aax * bby - aay * bbx;
                if cross > 0 { tc = 1; }
                if cross < 0 { tc = 0 - 1; }
            } }
        turn[k] = tc;
        k = k + 1;
    }
}

// ---------- relation matrices (symmetric {0,1}, flat row-major into M) ----------
fn build_M_len(alen: *i32, m: i32, M: *i64) {
    var i: i32 = 0;
    while i < m {
        var j: i32 = 0;
        while j < m {
            var v: i64 = 0;
            if i != j { if alen[i] != alen[j] { v = 1; } }
            M[i * m + j] = v;
            j = j + 1;
        }
        i = i + 1;
    }
}
fn build_M_turn(turn: *i32, m: i32, M: *i64) {
    var i: i32 = 0;
    while i < m {
        var j: i32 = 0;
        while j < m {
            var v: i64 = 0;
            if i != j { if turn[i] != 0 { if turn[i] == turn[j] { v = 1; } } }
            M[i * m + j] = v;
            j = j + 1;
        }
        i = i + 1;
    }
}
// min squared distance between arc i's endpoints {start,end} and arc j's.
fn ep_d2(sx: *i64, sy: *i64, ex: *i64, ey: *i64, i: i32, j: i32) -> i64 {
    var best: i64 = 0 - 1;
    var a: i32 = 0;
    while a < 2 {
        var b: i32 = 0;
        while b < 2 {
            var pax: i64 = sx[i]; var pay: i64 = sy[i];
            if a == 1 { pax = ex[i]; pay = ey[i]; }
            var pbx: i64 = sx[j]; var pby: i64 = sy[j];
            if b == 1 { pbx = ex[j]; pby = ey[j]; }
            let dx: i64 = pax - pbx; let dy: i64 = pay - pby;
            let d2: i64 = dx * dx + dy * dy;
            if best < 0 { best = d2; } else { if d2 < best { best = d2; } }
            b = b + 1;
        }
        a = a + 1;
    }
    return best;
}
fn build_M_adj(sx: *i64, sy: *i64, ex: *i64, ey: *i64, m: i32, M: *i64) {
    // intrinsic threshold = mean nearest-endpoint d2 over arcs.
    var sum: i64 = 0;
    var cnt: i32 = 0;
    var i: i32 = 0;
    while i < m {
        var best: i64 = 0 - 1;
        var j: i32 = 0;
        while j < m {
            if i != j {
                let d2: i64 = ep_d2(sx, sy, ex, ey, i, j);
                if best < 0 { best = d2; } else { if d2 < best { best = d2; } }
            }
            j = j + 1;
        }
        if best >= 0 { sum = sum + best; cnt = cnt + 1; }
        i = i + 1;
    }
    var thr: i64 = 0;
    if cnt > 0 { thr = sum / (cnt as i64); }
    i = 0;
    while i < m {
        var j: i32 = 0;
        while j < m {
            var v: i64 = 0;
            if i != j { if ep_d2(sx, sy, ex, ey, i, j) <= thr { v = 1; } }
            M[i * m + j] = v;
            j = j + 1;
        }
        i = i + 1;
    }
}

// ---------- one shape, one cut method -> 6 moments (len2,len3,turn2,turn3,adj2,adj3) ----------
// cut: 0 = corner (union deg-1 cuts of x,y); 1 = radial (angle-ordered).
// Returns narcs; writes 6 moments into out[0..5].
fn measure(
    gid: i32, r: i32, cut: i32, f: Field,
    cx: *i64, cy: *i64, ox: *i64, oy: *i64, vbuf: *i64,
    cert: *i64, work: *i64,
    sa: *i32, sb: *i32, su: *i32,
    alen: *i32, asx: *i64, asy: *i64, aex: *i64, aey: *i64, aturn: *i32,
    M: *i64, P: *i64, Q: *i64, out: *i64
) -> i32 {
    let n: i32 = trace_contour(gid, r, cx, cy, 4096);
    if n < 6 { return 0; }
    // choose the point sequence (X,Y) for this cut method.
    var X: *i64 = cx;
    var Y: *i64 = cy;
    if cut == 1 {
        radial_order(cx, cy, n, ox, oy);
        X = ox; Y = oy;
    }
    // cut points: union of deg-1 cuts of X and Y.
    var i: i32 = 0;
    while i < n { vbuf[i] = X[i]; i = i + 1; }
    let an: i32 = view_cuts(f, vbuf, n, cert, work, sa);
    i = 0;
    while i < n { vbuf[i] = Y[i]; i = i + 1; }
    let bn: i32 = view_cuts(f, vbuf, n, cert, work, sb);
    let m: i32 = merge_cuts(sa, an, sb, bn, su);
    if m < 1 { return 0; }
    build_arcs(X, Y, n, su, m, alen, asx, asy, aex, aey, aturn);

    build_M_len(alen, m, M);
    out[0] = mat_trace_pow_dyn(f, M, m, 2, P, Q);
    out[1] = mat_trace_pow_dyn(f, M, m, 3, P, Q);
    build_M_turn(aturn, m, M);
    out[2] = mat_trace_pow_dyn(f, M, m, 2, P, Q);
    out[3] = mat_trace_pow_dyn(f, M, m, 3, P, Q);
    build_M_adj(asx, asy, aex, aey, m, M);
    out[4] = mat_trace_pow_dyn(f, M, m, 2, P, Q);
    out[5] = mat_trace_pow_dyn(f, M, m, 3, P, Q);
    return m;
}

fn moments_eq(a: *i64, b: *i64) -> i32 {
    var k: i32 = 0;
    while k < 6 { if a[k] != b[k] { return 0; } k = k + 1; }
    return 1;
}
fn print_mom(label: *u8, narcs: i32, a: *i64) {
    wr(2, label); wr(2, " narcs="); wr_int(2, narcs as i64);
    wr(2, " len["); wr_int(2, a[0]); wr(2, ","); wr_int(2, a[1]);
    wr(2, "] turn["); wr_int(2, a[2]); wr(2, ","); wr_int(2, a[3]);
    wr(2, "] adj["); wr_int(2, a[4]); wr(2, ","); wr_int(2, a[5]); wr(2, "]\n");
}

fn main() -> i32 {
    let gold: Field = field(18446744069414584321);
    let baby: Field = field(2013265921);
    let r: i32 = 48;
    let cap: i32 = 4096;

    let cx: *i64 = alloc(cap);
    let cy: *i64 = alloc(cap);
    let ox: *i64 = alloc(cap);
    let oy: *i64 = alloc(cap);
    let vbuf: *i64 = alloc(cap);
    let cert: *i64 = alloc(cap * 3);
    let work: *i64 = alloc(cap);
    let sa: *i32 = alloc(cap);
    let sb: *i32 = alloc(cap);
    let su: *i32 = alloc(cap);
    let mcap: i32 = 256;
    let alen: *i32 = alloc(mcap);
    let asx: *i64 = alloc(mcap);
    let asy: *i64 = alloc(mcap);
    let aex: *i64 = alloc(mcap);
    let aey: *i64 = alloc(mcap);
    let aturn: *i32 = alloc(mcap);
    let M: *i64 = alloc(mcap * mcap);
    let P: *i64 = alloc(mcap * mcap);
    let Q: *i64 = alloc(mcap * mcap);

    let u_corner: *i64 = alloc(6);
    let t_corner: *i64 = alloc(6);
    let u_radial: *i64 = alloc(6);
    let t_radial: *i64 = alloc(6);
    let ur_radial: *i64 = alloc(6);
    let ur_corner: *i64 = alloc(6);
    let u_radial_b: *i64 = alloc(6);

    // corner-cut (cut=0) over Goldilocks
    let ucn: i32 = measure(0, r, 0, gold, cx, cy, ox, oy, vbuf, cert, work, sa, sb, su, alen, asx, asy, aex, aey, aturn, M, P, Q, u_corner);
    let tcn: i32 = measure(1, r, 0, gold, cx, cy, ox, oy, vbuf, cert, work, sa, sb, su, alen, asx, asy, aex, aey, aturn, M, P, Q, t_corner);
    // radial-cut (cut=1) over Goldilocks
    let urn: i32 = measure(0, r, 1, gold, cx, cy, ox, oy, vbuf, cert, work, sa, sb, su, alen, asx, asy, aex, aey, aturn, M, P, Q, u_radial);
    let trn: i32 = measure(1, r, 1, gold, cx, cy, ox, oy, vbuf, cert, work, sa, sb, su, alen, asx, asy, aex, aey, aturn, M, P, Q, t_radial);
    // rotated U (gid=2, x<->y transpose) radial-cut AND corner-cut over Goldilocks
    measure(2, r, 1, gold, cx, cy, ox, oy, vbuf, cert, work, sa, sb, su, alen, asx, asy, aex, aey, aturn, M, P, Q, ur_radial);
    let urcn: i32 = measure(2, r, 0, gold, cx, cy, ox, oy, vbuf, cert, work, sa, sb, su, alen, asx, asy, aex, aey, aturn, M, P, Q, ur_corner);
    // U radial-cut over BabyBear (field-invariance witness)
    measure(0, r, 1, baby, cx, cy, ox, oy, vbuf, cert, work, sa, sb, su, alen, asx, asy, aex, aey, aturn, M, P, Q, u_radial_b);

    wr(2, "corner-cut moments:\n");
    print_mom("  U", ucn, u_corner);
    print_mom("  T", tcn, t_corner);
    wr(2, "radial-cut moments:\n");
    print_mom("  U ", urn, u_radial);
    print_mom("  T ", trn, t_radial);
    print_mom("  Ur", urn, ur_radial);
    print_mom("  Uc(rot,corner)", urcn, ur_corner);

    // ---- Test 1: corner-cut U == T (Level-1-blind) ----
    var t1: i32 = 0;
    if moments_eq(u_corner, t_corner) == 1 { t1 = 1; }

    // ---- Test 2: radial-cut TURN moments separate U from T ----
    var t2: i32 = 0;
    if u_radial[2] != t_radial[2] { t2 = 1; }
    if u_radial[3] != t_radial[3] { t2 = 1; }

    // ---- Test 3: radial-cut ADJ moments separate U from T ----
    var t3: i32 = 0;
    if u_radial[4] != t_radial[4] { t3 = 1; }
    if u_radial[5] != t_radial[5] { t3 = 1; }

    // ---- Test 4: corner-cut U matches oracle exactly ----
    // oracle U corner: narcs=10, len[84,576], turn[30,120], adj[16,0]
    var t4: i32 = 0;
    if ucn == 10 {
        if u_corner[0] == 84 { if u_corner[1] == 576 {
                if u_corner[2] == 30 { if u_corner[3] == 120 {
                        if u_corner[4] == 16 { if u_corner[5] == 0 { t4 = 1; } } } } } }
    }

    // ---- Test 5: reorientation invariance lives in the CORNER-cut view
    // (the measured invariance-vs-discrimination trade-off: @internal-design: features). ----
    var t5: i32 = 0;
    if moments_eq(ur_corner, u_corner) == 1 { t5 = 1; }

    // ---- Test 6: radial-cut U moments field-invariant (Gold == Baby) ----
    var t6: i32 = 0;
    if moments_eq(u_radial, u_radial_b) == 1 { t6 = 1; }

    print(t1);
    print(t2);
    print(t3);
    print(t4);
    print(t5);
    print(t6);

    return 0;
}
