// Author: Matt Flores
// turning_test.tv — Level 3 hermetic gate: signed turning number + profile on
// chiral/achiral controls vs their mirrors, oracle-confirmed.
// @internal-design: features (turning.tv + Level 3)
//
// Instrument H (holonomy): per-vertex integer turn (sign of cross product, no
// trig); winding = field-reduced sum via signed_reduce; signed PROFILE = half-
// asymmetry + 4 quartile signed sums; nseg(d) of the cumulative turning function.
// Instrument P (persistence): nseg(d) spectrum (reuses regime_prove_dyn).
//
// Control classes (shape vs horizontal mirror; corner-cut is mirror-blind):
//   CHIRAL  C: corner-blind, asym sign-flips (-4 vs +4).
//   ACHIRAL U: corner-blind, asym identical (-2 vs -2).
//
// Tests (each 1 = pass):
//   1. C is CHIRAL: signed holonomy profile DIFFERS between C and mirror-C   -> 1
//   2. C asym SIGN-FLIPS under mirror (asym(C) == -asym(mirror-C))           -> 1
//   3. U is ACHIRAL: signed holonomy profile IDENTICAL between U and mirror-U -> 1
//   4. C holonomy matches the oracle EXACTLY (wind/asym/quartiles/nsegTh)    -> 1
//   5. field-carried winding (signed_reduce) field-invariant Gold == Baby    -> 1
//   6. C persistence spectrum matches the oracle (nseg d0..4 = 109,8,8,8,8)  -> 1
//
// Expected output: 1 1 1 1 1 1
//
// Three-file link: regime_fri.o + turning.o + turning_test.o (tvc_self-only).

extern "C" fn write(fd: i32, buf: *u8, n: usize) -> i64;
extern "C" fn strlen(s: *u8) -> usize;
extern "C" fn regime_prove_dyn(
    f: Field, data: *i64, n: i32, deg: i32, cert: *i64, work: *i64) -> i32;
extern "C" fn signed_reduce(data: *i64, n: i32, f: Field) -> i64;
extern "C" fn turning_number(turns: *i64, n: i32, f: Field) -> i64;

fn wr(fd: i32, s: *u8) { let len: usize = strlen(s); write(fd, s, len); }
fn wr_int(fd: i32, n: i64) {
    if n < 0 { write(fd, "-", 1); wr_int(fd, 0 - n); return; }
    if n >= 10 { wr_int(fd, n / 10); }
    var d: [u8; 1] = 0;
    d[0] = ((n % 10) + 48) as u8;
    write(fd, &d[0], 1);
}

fn box_in(x: i32, y: i32, x0: i32, x1: i32, y0: i32, y1: i32) -> i32 {
    if x >= x0 { if x <= x1 { if y >= y0 { if y <= y1 { return 1; } } } }
    return 0;
}
// C glyph (chiral): left bar + top bar + bottom bar (opens right).
fn ink_C(x: i32, y: i32, r: i32) -> i32 {
    let m: i32 = r / 6;
    let w: i32 = r / 6;
    let hi: i32 = r - 1 - m;
    if box_in(x, y, m, m + w, m, hi) == 1 { return 1; }
    if box_in(x, y, m, hi, m, m + w) == 1 { return 1; }
    if box_in(x, y, m, hi, hi - w, hi) == 1 { return 1; }
    return 0;
}
// U glyph (achiral): left bar + right bar + bottom bar (mirror-symmetric).
fn ink_U(x: i32, y: i32, r: i32) -> i32 {
    let m: i32 = r / 6;
    let w: i32 = r / 6;
    let hi: i32 = r - 1 - m;
    if box_in(x, y, m, m + w, m, hi) == 1 { return 1; }
    if box_in(x, y, hi - w, hi, m, hi) == 1 { return 1; }
    if box_in(x, y, m, hi, hi - w, hi) == 1 { return 1; }
    return 0;
}
// gid: 0=C, 1=mirror-C, 2=U, 3=mirror-U. Mirror = x -> r-1-x.
fn ink(gid: i32, x: i32, y: i32, r: i32) -> i32 {
    if x < 0 { return 0; }
    if y < 0 { return 0; }
    if x > (r - 1) { return 0; }
    if y > (r - 1) { return 0; }
    if gid == 0 { return ink_C(x, y, r); }
    if gid == 1 { return ink_C(r - 1 - x, y, r); }
    if gid == 2 { return ink_U(x, y, r); }
    return ink_U(r - 1 - x, y, r);
}

fn trace_contour(gid: i32, r: i32, cx: *i64, cy: *i64, max_len: i32) -> i32 {
    var dx: [i32; 8] = 0;
    var dy: [i32; 8] = 0;
    dx[0]=1;  dy[0]=0;
    dx[1]=1;  dy[1]=1;
    dx[2]=0;  dy[2]=1;
    dx[3]=0-1; dy[3]=1;
    dx[4]=0-1; dy[4]=0;
    dx[5]=0-1; dy[5]=0-1;
    dx[6]=0;  dy[6]=0-1;
    dx[7]=1;  dy[7]=0-1;
    var sx: i32 = 0-1;
    var sy: i32 = 0-1;
    var yy: i32 = 0;
    while yy < r {
        var xx: i32 = 0;
        while xx < r {
            if ink(gid, xx, yy, r) == 1 { sx = xx; sy = yy; xx = r; yy = r; }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    if sx < 0 { return 0; }
    cx[0] = sx as i64; cy[0] = sy as i64;
    var clen: i32 = 1;
    var curx: i32 = sx;
    var cury: i32 = sy;
    var b: i32 = 4;
    var steps: i32 = 0;
    while steps < max_len {
        var found: i32 = 0 - 1;
        var k: i32 = 0;
        while k < 8 {
            let dd: i32 = (b + 1 + k) % 8;
            let nx: i32 = curx + dx[dd];
            let ny: i32 = cury + dy[dd];
            if ink(gid, nx, ny, r) == 1 { found = dd; k = 8; }
            k = k + 1;
        }
        if found < 0 { return clen; }
        let nxp: i32 = curx + dx[found];
        let nyp: i32 = cury + dy[found];
        if nxp == sx { if nyp == sy { return clen; } }
        if clen < max_len {
            cx[clen] = nxp as i64; cy[clen] = nyp as i64; clen = clen + 1;
        } else { return clen; }
        curx = nxp; cury = nyp;
        b = (found + 4) % 8;
        steps = steps + 1;
    }
    return clen;
}

// per-vertex signed turn: sign of cross product of incoming x outgoing edges.
fn sign_i64(v: i64) -> i64 {
    if v > 0 { return 1; }
    if v < 0 { return 0 - 1; }
    return 0;
}
fn turn_seq(cx: *i64, cy: *i64, n: i32, t: *i64) {
    var i: i32 = 0;
    while i < n {
        let pi: i32 = (i + n - 1) % n;
        let ni: i32 = (i + 1) % n;
        let ax: i64 = cx[i] - cx[pi];
        let ay: i64 = cy[i] - cy[pi];
        let bx: i64 = cx[ni] - cx[i];
        let by: i64 = cy[ni] - cy[i];
        let cross: i64 = ax * by - ay * bx;
        t[i] = sign_i64(cross);
        i = i + 1;
    }
}
// signed sum of t[a..b)
fn ssum(t: *i64, a: i32, b: i32) -> i64 {
    var s: i64 = 0;
    var i: i32 = a;
    while i < b { s = s + t[i]; i = i + 1; }
    return s;
}

// Compute the turning signature of glyph gid into out:
//   out[0]=winding (field-reduced), out[1]=asym, out[2..5]=quartile signed sums,
//   out[6]=nsegTh d1, out[7]=nsegTh d2, out[8..12]=persistence nseg d0..4.
// Returns contour length.
fn measure(
    gid: i32, r: i32, f: Field,
    cx: *i64, cy: *i64, t: *i64, th: *i64, vbuf: *i64, cert: *i64, work: *i64,
    out: *i64
) -> i32 {
    let n: i32 = trace_contour(gid, r, cx, cy, 4096);
    if n < 8 { return 0; }
    turn_seq(cx, cy, n, t);
    // field-reduced turning number
    out[0] = turning_number(t, n, f);
    // signed profile: half-asymmetry + quartiles
    let h: i32 = n / 2;
    let fhalf: i64 = ssum(t, 0, h);
    let shalf: i64 = ssum(t, h, n);
    out[1] = fhalf - shalf;
    let q: i32 = n / 4;
    out[2] = ssum(t, 0, q);
    out[3] = ssum(t, q, 2 * q);
    out[4] = ssum(t, 2 * q, 3 * q);
    out[5] = ssum(t, 3 * q, n);
    // cumulative turning function -> nseg(d) of th
    var acc: i64 = 0;
    var i: i32 = 0;
    while i < n { acc = acc + t[i]; th[i] = acc; i = i + 1; }
    out[6] = regime_prove_dyn(f, th, n, 1, cert, work) as i64;
    out[7] = regime_prove_dyn(f, th, n, 2, cert, work) as i64;
    // persistence spectrum nseg(d) of x(t), d=0..4
    i = 0;
    while i < n { vbuf[i] = cx[i]; i = i + 1; }
    out[8]  = regime_prove_dyn(f, vbuf, n, 0, cert, work) as i64;
    out[9]  = regime_prove_dyn(f, vbuf, n, 1, cert, work) as i64;
    out[10] = regime_prove_dyn(f, vbuf, n, 2, cert, work) as i64;
    out[11] = regime_prove_dyn(f, vbuf, n, 3, cert, work) as i64;
    out[12] = regime_prove_dyn(f, vbuf, n, 4, cert, work) as i64;
    return n;
}

fn prof_eq(a: *i64, b: *i64) -> i32 {
    // compare asym + 4 quartiles (indices 1..5)
    var k: i32 = 1;
    while k < 6 { if a[k] != b[k] { return 0; } k = k + 1; }
    return 1;
}
fn print_sig(label: *u8, ln: i32, a: *i64) {
    wr(2, label); wr(2, " len="); wr_int(2, ln as i64);
    wr(2, " wind="); wr_int(2, a[0]);
    wr(2, " asym="); wr_int(2, a[1]);
    wr(2, " quart=("); wr_int(2, a[2]); wr(2, ","); wr_int(2, a[3]); wr(2, ",");
    wr_int(2, a[4]); wr(2, ","); wr_int(2, a[5]); wr(2, ")");
    wr(2, " nsegTh=("); wr_int(2, a[6]); wr(2, ","); wr_int(2, a[7]); wr(2, ")");
    wr(2, " persist["); wr_int(2, a[8]); wr(2, ","); wr_int(2, a[9]); wr(2, ",");
    wr_int(2, a[10]); wr(2, ","); wr_int(2, a[11]); wr(2, ","); wr_int(2, a[12]);
    wr(2, "]\n");
}

fn main() -> i32 {
    let gold: Field = field(18446744069414584321);
    let baby: Field = field(2013265921);
    let r: i32 = 48;
    let cap: i32 = 4096;

    let cx: *i64 = alloc(cap);
    let cy: *i64 = alloc(cap);
    let t: *i64 = alloc(cap);
    let th: *i64 = alloc(cap);
    let vbuf: *i64 = alloc(cap);
    let cert: *i64 = alloc(cap * 3);
    let work: *i64 = alloc(cap);

    let c_sig: *i64 = alloc(13);
    let cm_sig: *i64 = alloc(13);
    let u_sig: *i64 = alloc(13);
    let um_sig: *i64 = alloc(13);
    let c_sig_b: *i64 = alloc(13);

    let cln: i32 = measure(0, r, gold, cx, cy, t, th, vbuf, cert, work, c_sig);
    let cmln: i32 = measure(1, r, gold, cx, cy, t, th, vbuf, cert, work, cm_sig);
    let uln: i32 = measure(2, r, gold, cx, cy, t, th, vbuf, cert, work, u_sig);
    let umln: i32 = measure(3, r, gold, cx, cy, t, th, vbuf, cert, work, um_sig);
    // C over BabyBear (field-invariance witness for the field-carried winding)
    measure(0, r, baby, cx, cy, t, th, vbuf, cert, work, c_sig_b);

    wr(2, "turning signatures:\n");
    print_sig("  C      ", cln, c_sig);
    print_sig("  mirrorC", cmln, cm_sig);
    print_sig("  U      ", uln, u_sig);
    print_sig("  mirrorU", umln, um_sig);

    // ---- Test 1: C is CHIRAL (holonomy profile differs from mirror) ----
    var t1: i32 = 0;
    if prof_eq(c_sig, cm_sig) == 0 { t1 = 1; }

    // ---- Test 2: C asym sign-flips under mirror ----
    var t2: i32 = 0;
    if c_sig[1] == (0 - cm_sig[1]) { t2 = 1; }

    // ---- Test 3: U is ACHIRAL (holonomy profile identical to mirror) ----
    var t3: i32 = 0;
    if prof_eq(u_sig, um_sig) == 1 { t3 = 1; }

    // ---- Test 4: C holonomy matches oracle (wind=2, asym=-4, quart=3,-4,2,1, nsegTh=10,10) ----
    var t4: i32 = 0;
    if c_sig[0] == 2 { if c_sig[1] == (0 - 4) {
            if c_sig[2] == 3 { if c_sig[3] == (0 - 4) { if c_sig[4] == 2 { if c_sig[5] == 1 {
                            if c_sig[6] == 10 { if c_sig[7] == 10 { t4 = 1; } } } } } }
        } }

    // ---- Test 5: field-carried winding field-invariant (Gold == Baby) ----
    var t5: i32 = 0;
    if c_sig[0] == c_sig_b[0] { t5 = 1; }

    // ---- Test 6: C persistence spectrum matches oracle (109,8,8,8,8) ----
    var t6: i32 = 0;
    if c_sig[8] == 109 { if c_sig[9] == 8 { if c_sig[10] == 8 {
                if c_sig[11] == 8 { if c_sig[12] == 8 { t6 = 1; } } } } }

    print(t1);
    print(t2);
    print(t3);
    print(t4);
    print(t5);
    print(t6);

    return 0;
}
