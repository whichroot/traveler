// Author: Matt Flores
// multiview_test.tv — Level 1 hermetic gate: multi-angle nseg fingerprints on
// synthetic shapes with known answers, field-invariant across 3 primes.
// @internal-design: features (the ladder, Level 1)
//
// Five views of the SAME traced contour (all integer, no trig, field-safe):
//   x(t), y(t)        : Cartesian projections (validated in glyph_convergence).
//   (x+y)(t),(x-y)(t) : 45-degree rotated projections — the cheapest new angles.
//   r(theta)          : squared radial distance from the centroid, contour points
//                       ORDERED BY ANGLE via integer octant + cross-product (no
//                       trig). A reorientation gives a cyclically-shifted
//                       r(theta) with the SAME nseg fingerprint.
//
// Tests (each 1 = pass):
//   1. r(theta) is REORIENTATION-INVARIANT: "7" and its transposed copy give the
//      same r(theta) nseg fingerprint                                       -> 1
//   2. a Cartesian view (x) is NOT reorientation-invariant ("7" x != rot x)  -> 1
//   3. square is 4-fold on its NATURAL axes: x(d1)==4 and y(d1)==4           -> 1
//   4. diamond (square rotated 45) SCRAMBLES in Cartesian: x(d1) != 4        -> 1
//   5. diamond RECOVERS 4-fold in a 45-deg view: (x+y)(d1)==4 OR (x-y)(d1)==4 -> 1
//   6. all fingerprints field-invariant across 3 primes                      -> 1
//
// Expected output: 1 1 1 1 1 1
//
// Two-file link: regime_fri.o + multiview_test.o (tvc_self-only).

extern "C" fn write(fd: i32, buf: *u8, n: usize) -> i64;
extern "C" fn strlen(s: *u8) -> usize;
extern "C" fn regime_prove_dyn(
    f: Field, data: *i64, n: i32, deg: i32, cert: *i64, work: *i64) -> i32;

fn wr(fd: i32, s: *u8) { let len: usize = strlen(s); write(fd, s, len); }
fn wr_int(fd: i32, n: i64) {
    if n < 0 { write(fd, "-", 1); wr_int(fd, 0 - n); return; }
    if n >= 10 { wr_int(fd, n / 10); }
    var d: [u8; 1] = 0;
    d[0] = ((n % 10) + 48) as u8;
    write(fd, &d[0], 1);
}

fn iabs(x: i32) -> i32 { if x < 0 { return 0 - x; } return x; }
fn imax(a: i32, b: i32) -> i32 { if a > b { return a; } return b; }

// ---------- synthetic glyph ink ----------
fn ink_square(x: i32, y: i32, r: i32) -> i32 {
    let m: i32 = r / 4;
    if x >= m { if x <= (r - 1 - m) { if y >= m { if y <= (r - 1 - m) { return 1; } } } }
    return 0;
}
fn ink_diamond(x: i32, y: i32, r: i32) -> i32 {
    let cx: i32 = r / 2;
    let cy: i32 = r / 2;
    let rad: i32 = r / 2 - r / 6;
    if (iabs(x - cx) + iabs(y - cy)) <= rad { return 1; }
    return 0;
}
fn ink_seven(x: i32, y: i32, r: i32) -> i32 {
    let hw: i32 = imax(1, r / 12);
    let m: i32 = r / 6;
    if y >= m { if y <= (m + 2 * hw) { if x >= m { if x <= (r - 1 - m) { return 1; } } } }
    let x1: i32 = r - 1 - m;
    let y1: i32 = m;
    let x2: i32 = m;
    let y2: i32 = r - 1 - m;
    let dx: i32 = x2 - x1;
    let dy: i32 = y2 - y1;
    let px: i32 = x - x1;
    let py: i32 = y - y1;
    let cross: i32 = dy * px - dx * py;
    let denom: i32 = dx * dx + dy * dy;
    let dot: i32 = dx * px + dy * py;
    if dot >= 0 { if dot <= denom { if cross * cross <= hw * hw * denom { return 1; } } }
    return 0;
}

// dispatch: gid 0=square, 1=diamond, 2=seven, 3=seven transposed (x<->y).
fn ink(gid: i32, x: i32, y: i32, r: i32) -> i32 {
    if x < 0 { return 0; }
    if y < 0 { return 0; }
    if x > (r - 1) { return 0; }
    if y > (r - 1) { return 0; }
    if gid == 0 { return ink_square(x, y, r); }
    if gid == 1 { return ink_diamond(x, y, r); }
    if gid == 2 { return ink_seven(x, y, r); }
    return ink_seven(y, x, r);
}

// ---------- Moore contour trace ----------
fn trace_contour(gid: i32, r: i32, cx: *i64, cy: *i64, max_len: i32) -> i32 {
    var dx: [i32; 8] = 0;
    var dy: [i32; 8] = 0;
    dx[0]=1;  dy[0]=0;
    dx[1]=1;  dy[1]=1;
    dx[2]=0;  dy[2]=1;
    dx[3]=0-1; dy[3]=1;
    dx[4]=0-1; dy[4]=0;
    dx[5]=0-1; dy[5]=0-1;
    dx[6]=0;  dy[6]=0-1;
    dx[7]=1;  dy[7]=0-1;
    var sx: i32 = 0-1;
    var sy: i32 = 0-1;
    var yy: i32 = 0;
    while yy < r {
        var xx: i32 = 0;
        while xx < r {
            if ink(gid, xx, yy, r) == 1 { sx = xx; sy = yy; xx = r; yy = r; }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    if sx < 0 { return 0; }
    cx[0] = sx as i64; cy[0] = sy as i64;
    var clen: i32 = 1;
    var curx: i32 = sx;
    var cury: i32 = sy;
    var b: i32 = 4;
    var steps: i32 = 0;
    while steps < max_len {
        var found: i32 = 0 - 1;
        var k: i32 = 0;
        while k < 8 {
            let dd: i32 = (b + 1 + k) % 8;
            let nx: i32 = curx + dx[dd];
            let ny: i32 = cury + dy[dd];
            if ink(gid, nx, ny, r) == 1 { found = dd; k = 8; }
            k = k + 1;
        }
        if found < 0 { return clen; }
        let nxp: i32 = curx + dx[found];
        let nyp: i32 = cury + dy[found];
        if nxp == sx { if nyp == sy { return clen; } }
        if clen < max_len {
            cx[clen] = nxp as i64;
            cy[clen] = nyp as i64;
            clen = clen + 1;
        } else { return clen; }
        curx = nxp; cury = nyp;
        b = (found + 4) % 8;
        steps = steps + 1;
    }
    return clen;
}

// ---------- integer angular ordering (octant + cross-product, no trig) ----------
// octant 0..7 CCW starting at +x axis.
fn octant(dx: i64, dy: i64) -> i32 {
    if dx > 0 { if dy >= 0 {
            if dx > dy { return 0; } else { return 1; }
        } }
    if dx <= 0 { if dy > 0 {
            if dy >= (0 - dx) { return 2; } else { return 3; }
        } }
    if dx < 0 { if dy <= 0 {
            if (0 - dx) > (0 - dy) { return 4; } else { return 5; }
        } }
    // dx>=0, dy<0
    if (0 - dy) > dx { return 6; }
    return 7;
}

// angle_less(a, b): true if point a precedes b in CCW order around centroid.
fn angle_less(ax: i64, ay: i64, bx: i64, by: i64) -> i32 {
    let oa: i32 = octant(ax, ay);
    let ob: i32 = octant(bx, by);
    if oa != ob { if oa < ob { return 1; } return 0; }
    // same octant: a before b iff cross(a,b) > 0
    let cross: i64 = ax * by - ay * bx;
    if cross > 0 { return 1; }
    return 0;
}

// Build r(theta): squared distance from centroid, contour points ordered by
// angle (selection sort on the centered points). Writes into out, length n.
fn radial_view(cx: *i64, cy: *i64, n: i32, px: *i64, py: *i64, out: *i64) {
    // centroid (integer mean)
    var sx: i64 = 0;
    var sy: i64 = 0;
    var i: i32 = 0;
    while i < n { sx = sx + cx[i]; sy = sy + cy[i]; i = i + 1; }
    let mx: i64 = sx / (n as i64);
    let my: i64 = sy / (n as i64);
    i = 0;
    while i < n { px[i] = cx[i] - mx; py[i] = cy[i] - my; i = i + 1; }
    // selection sort by angle (CCW)
    i = 0;
    while i < n {
        var best: i32 = i;
        var j: i32 = i + 1;
        while j < n {
            if angle_less(px[j], py[j], px[best], py[best]) == 1 { best = j; }
            j = j + 1;
        }
        let tx: i64 = px[i]; px[i] = px[best]; px[best] = tx;
        let ty: i64 = py[i]; py[i] = py[best]; py[best] = ty;
        i = i + 1;
    }
    i = 0;
    while i < n { out[i] = px[i] * px[i] + py[i] * py[i]; i = i + 1; }
}

// nseg at degree d over a field.
fn nseg(f: Field, data: *i64, n: i32, d: i32, cert: *i64, work: *i64) -> i32 {
    return regime_prove_dyn(f, data, n, d, cert, work);
}

// Build all five views for glyph gid; write each view's nseg(d1) into fp5[0..4]
// (x,y,x+y,x-y,r) over f. Returns contour length; also checks field-invariance.
fn measure_glyph(
    gid: i32, r: i32, f: Field, gold: Field, baby: Field, small: Field,
    cx: *i64, cy: *i64, vbuf: *i64, px: *i64, py: *i64,
    cert: *i64, work: *i64, fp5: *i32, field_ok: *i32
) -> i32 {
    let n: i32 = trace_contour(gid, r, cx, cy, 4096);

    // view 0: x
    var i: i32 = 0;
    while i < n { vbuf[i] = cx[i]; i = i + 1; }
    fp5[0] = nseg(f, vbuf, n, 1, cert, work);
    if nseg(gold, vbuf, n, 1, cert, work) != nseg(baby, vbuf, n, 1, cert, work) { field_ok[0] = 0; }
    if nseg(gold, vbuf, n, 1, cert, work) != nseg(small, vbuf, n, 1, cert, work) { field_ok[0] = 0; }

    // view 1: y
    i = 0;
    while i < n { vbuf[i] = cy[i]; i = i + 1; }
    fp5[1] = nseg(f, vbuf, n, 1, cert, work);

    // view 2: x+y
    i = 0;
    while i < n { vbuf[i] = cx[i] + cy[i]; i = i + 1; }
    fp5[2] = nseg(f, vbuf, n, 1, cert, work);

    // view 3: x-y
    i = 0;
    while i < n { vbuf[i] = cx[i] - cy[i]; i = i + 1; }
    fp5[3] = nseg(f, vbuf, n, 1, cert, work);

    // view 4: r(theta)
    radial_view(cx, cy, n, px, py, vbuf);
    fp5[4] = nseg(f, vbuf, n, 1, cert, work);
    if nseg(gold, vbuf, n, 1, cert, work) != nseg(baby, vbuf, n, 1, cert, work) { field_ok[0] = 0; }
    if nseg(gold, vbuf, n, 1, cert, work) != nseg(small, vbuf, n, 1, cert, work) { field_ok[0] = 0; }

    return n;
}

fn print_fp(fp: *i32, label: *u8) {
    wr(2, label);
    var k: i32 = 0;
    while k < 5 { wr_int(2, fp[k] as i64); wr(2, " "); k = k + 1; }
    wr(2, "\n");
}

fn main() -> i32 {
    let gold: Field = field(18446744069414584321);
    let baby: Field = field(2013265921);
    let small: Field = field(65537);
    let r: i32 = 48;

    let cap: i32 = 4096;
    let cx: *i64 = alloc(cap);
    let cy: *i64 = alloc(cap);
    let vbuf: *i64 = alloc(cap);
    let px: *i64 = alloc(cap);
    let py: *i64 = alloc(cap);
    let cert: *i64 = alloc(cap * 3);
    let work: *i64 = alloc(cap);

    let fp_sq: *i32 = alloc(5);
    let fp_di: *i32 = alloc(5);
    let fp_7: *i32 = alloc(5);
    let fp_7r: *i32 = alloc(5);
    let field_ok: *i32 = alloc(1);
    field_ok[0] = 1;

    measure_glyph(0, r, gold, gold, baby, small, cx, cy, vbuf, px, py, cert, work, fp_sq, field_ok);
    measure_glyph(1, r, gold, gold, baby, small, cx, cy, vbuf, px, py, cert, work, fp_di, field_ok);
    measure_glyph(2, r, gold, gold, baby, small, cx, cy, vbuf, px, py, cert, work, fp_7, field_ok);
    measure_glyph(3, r, gold, gold, baby, small, cx, cy, vbuf, px, py, cert, work, fp_7r, field_ok);

    // For r(theta) reorientation invariance we need the FULL fingerprint, but
    // nseg(d1) is the robust witness: print to stderr for transparency.
    wr(2, "view fingerprints nseg(d1) [x y x+y x-y r]:\n");
    print_fp(fp_sq, "  square  ");
    print_fp(fp_di, "  diamond ");
    print_fp(fp_7,  "  seven   ");
    print_fp(fp_7r, "  sevenR  ");

    // ---- Test 1: r(theta) reorientation-invariant (seven vs sevenR, view 4) ----
    var t1: i32 = 0;
    if fp_7[4] == fp_7r[4] { t1 = 1; }

    // ---- Test 2: Cartesian x NOT reorientation-invariant (view 0 differs) ----
    var t2: i32 = 0;
    if fp_7[0] != fp_7r[0] { t2 = 1; }

    // ---- Test 3: square is 4-fold on natural axes (x==4 and y==4) ----
    var t3: i32 = 0;
    if fp_sq[0] == 4 { if fp_sq[1] == 4 { t3 = 1; } }

    // ---- Test 4: diamond scrambles in Cartesian (x != 4) ----
    var t4: i32 = 0;
    if fp_di[0] != 4 { t4 = 1; }

    // ---- Test 5: diamond recovers 4-fold in a 45-deg view (x+y==4 OR x-y==4) ----
    // (a single-pixel trace difference can shift the other diagonal by 1; the
    // durable law is that SOME rotated angle exposes the hidden 4-fold structure.)
    var t5: i32 = 0;
    if fp_di[2] == 4 { t5 = 1; }
    if fp_di[3] == 4 { t5 = 1; }

    print(t1);
    print(t2);
    print(t3);
    print(t4);
    print(t5);
    print(field_ok[0]);   // 1

    return 0;
}
