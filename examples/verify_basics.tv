// Author: Matt Flores
// verify_basics.tv — Verification of foundational patterns for self-hosting.
//
// Tests: else-if chains, logical &&/||, nested function calls,
// multiple return paths, u8 operations, recursive functions.
//
// Expected output: 2 1 3 1 0 1 5 3 120

// --- else if chains ---
fn classify(x: i32) -> i32 {
    if x < 0 {
        return 0;
    } else if x < 10 {
        return 1;
    } else if x < 100 {
        return 2;
    } else {
        return 3;
    }
}

// --- logical operators ---
fn in_range(x: i32, lo: i32, hi: i32) -> i32 {
    if x >= lo && x < hi {
        return 1;
    }
    return 0;
}

fn either(a: i32, b: i32) -> i32 {
    if a == 1 || b == 1 {
        return 1;
    }
    return 0;
}

// --- nested function calls ---
fn add(a: i32, b: i32) -> i32 {
    return a + b;
}

fn double(x: i32) -> i32 {
    return x + x;
}

// --- recursion ---
fn factorial(n: i32) -> i32 {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

fn main() {
    // else if chains: classify 50 → 2 (10..100 range)
    print(classify(50));    // 2

    // else if: classify 5 → 1 (0..10 range)
    print(classify(5));     // 1

    // else if: classify 500 → 3 (>= 100)
    print(classify(500));   // 3

    // logical &&: 5 in [0, 10) → 1
    print(in_range(5, 0, 10));   // 1

    // logical &&: 15 not in [0, 10) → 0
    print(in_range(15, 0, 10));  // 0

    // logical ||: either(0, 1) → 1
    print(either(0, 1));         // 1

    // nested calls: add(double(1), double(1) + 1) = add(2, 3) = 5
    print(add(double(1), add(double(1), 1)));  // 5

    // multiple return paths: classify(-1) → 0, then classify(5) → 1
    // verifies function re-entry after early return
    let a: i32 = classify(-1);
    let b: i32 = classify(5);
    print(a + b + classify(50));  // 0 + 1 + 2 = 3

    // recursion
    print(factorial(5));    // 120
}
