// syntax_type.tv — `type N = <FieldTy>;` unifies the field/binfield/extfield
// decl keywords (kind derived from the RHS); a non-field RHS is refused.
// @internal-design: examples (syntax twins).
//
// Expected output:
//   151
//   153
//   10
//   0

type F = Field<251>;                  // == field F = Field<251>;
type B = BinField<8, 0x11B>;          // == binfield B = ...;
type E = ExtField<Field<251>, 2>;     // == extfield E = ...;

fn main() -> i32 {
    let a: F = 100;
    let b: F = 51;
    print(a + b);          // 151  (100 + 51 mod 251)

    let x: B = 0x53;
    let y: B = 0xCA;
    print(x + y);          // 153  (GF(2^8) add == XOR: 0x53 ^ 0xCA = 0x99)

    let e: E = 10;         // (10, 0)
    print(e);              // 10 0  (two limbs, one per line)

    return 0;
}
