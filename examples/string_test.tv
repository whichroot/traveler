// Author: Matt Flores
// string_test.tv — Str gate (B1a Slice 2; tvc_self ONLY, defs inlined): build/
// concat/read, str_eq, and the embedded-NUL via-negativa (length-based wins).
// @internal-design: collections.
//
// Expected output:
//   3      (len of "hi!" after concat)
//   104    ('h' = str_byte 0)
//   1      (str_eq of two "ab" strings)
//   0      (str_eq of {a,NUL,x} vs {a,NUL,y}: differ after NUL)

struct Str {
    data: *u8,
    len: i32,
    cap: i32,
}

fn str_new() -> Str {
    let buf: *u8 = alloc(8);
    return Str { data: buf, len: 0, cap: 8 };
}

fn str_push(s: *Str, c: u8) {
    if s.len == s.cap {
        s.cap = s.cap * 2;
        s.data = realloc(s.data, s.cap);
    }
    s.data[s.len] = c;
    s.len = s.len + 1;
}

fn str_concat(a: *Str, b: *Str) {
    var i: i32 = 0;
    while i < b.len {
        str_push(a, b.data[i]);
        i = i + 1;
    }
}

fn str_len(s: *Str) -> i32 {
    return s.len;
}

fn str_byte(s: *Str, i: i32) -> u8 {
    return s.data[i];
}

fn str_eq(a: *Str, b: *Str) -> i32 {
    if a.len != b.len {
        return 0;
    }
    var i: i32 = 0;
    while i < a.len {
        if a.data[i] != b.data[i] {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

fn str_free(s: *Str) {
    free(s.data);
}

fn main() -> i32 {
    // --- build "hi", concat "!" ---
    var s: Str = str_new();
    str_push(&s, 104); // 'h'
    str_push(&s, 105); // 'i'
    var bang: Str = str_new();
    str_push(&bang, 33); // '!'
    str_concat(&s, &bang);
    print(str_len(&s));       // 3
    print(str_byte(&s, 0) as i32); // 104

    // --- equal strings ---
    var a1: Str = str_new();
    str_push(&a1, 97); str_push(&a1, 98); // "ab"
    var a2: Str = str_new();
    str_push(&a2, 97); str_push(&a2, 98); // "ab"
    print(str_eq(&a1, &a2));  // 1

    // --- embedded-NUL probe: {a, 0, x} vs {a, 0, y} ---
    var n1: Str = str_new();
    str_push(&n1, 97); str_push(&n1, 0); str_push(&n1, 120); // a \0 x
    var n2: Str = str_new();
    str_push(&n2, 97); str_push(&n2, 0); str_push(&n2, 121); // a \0 y
    print(str_eq(&n1, &n2));  // 0 (length-based catches the post-NUL diff)

    str_free(&s); str_free(&bang);
    str_free(&a1); str_free(&a2);
    str_free(&n1); str_free(&n2);
    return 0;
}
