// dyn_register_test.tv — Register<dyn, d>: the fat register carrying its own
// Field carrier, advanced via @field_dyn_add; baked-vs-dyn parity gated.
// @internal-design: core
//
// Five tests:
//   1. Explicit carrier: register(field(251), 10, 4, 2) advanced 6x
//      -> 10 14 20 28 38 50 (matches register_basics.tv baked output)
//   2. Method syntax: reg.advance() on a dyn register
//      -> 10 14 20 28 38 50
//   3. One source, two paths: generic fn instantiated <Field<251>> and <dyn>,
//      element-wise comparison -> 1
//   4. Regime detection over dyn (Section 17 Level 2 consequence):
//      runtime prime, two linear segments -> boundary=4, then 50 53 56
//   5. Width coverage: registers over field(65521) and field(4294967291)
//      -> 54430 705032619
//
// Expected output:
//   10 14 20 28 38 50
//   10 14 20 28 38 50
//   1
//   4 50 53 56
//   54430
//   705032619

fn main() {
    // ---- Test 1: Explicit carrier constructor ----
    let f: Field = field(251);
    var reg: Register<dyn, 2> = register(f, 10, 4, 2);

    let v0: dyn = advance(reg);
    let v1: dyn = advance(reg);
    let v2: dyn = advance(reg);
    let v3: dyn = advance(reg);
    let v4: dyn = advance(reg);
    let v5: dyn = advance(reg);
    print(v0); print(v1); print(v2);
    print(v3); print(v4); print(v5);

    // ---- Test 2: Method syntax (.advance()) ----
    let f2: Field = field(251);
    var reg2: Register<dyn, 2> = register(f2, 10, 4, 2);

    let m0: dyn = reg2.advance();
    let m1: dyn = reg2.advance();
    let m2: dyn = reg2.advance();
    let m3: dyn = reg2.advance();
    let m4: dyn = reg2.advance();
    let m5: dyn = reg2.advance();
    print(m0); print(m1); print(m2);
    print(m3); print(m4); print(m5);

    // ---- Test 3: One source, two paths ----
    // Baked path: Register<Field<251>, 2>
    let baked_ok: i32 = test_baked();
    // Dyn path: Register<dyn, 2> via field(251)
    let dyn_ok: i32 = test_dyn();
    // Compare: both should produce identical sequences
    let both_ok: i32 = baked_ok + dyn_ok;
    // both_ok == 2 means both matched; print 1 if all good
    if both_ok == 2 {
        print(1);
    } else {
        print(0);
    }

    // ---- Test 4: Regime detection over dyn ----
    test_regime_dyn();

    // ---- Test 5: Width coverage ----
    test_width_coverage();
}

// Baked register: advance 6x, return 1 if sequence matches [10,14,20,28,38,50]
type F = Field<251>;
fn test_baked() -> i32 {
    var reg: Register<F, 2> = register(10, 4, 2);
    var expected: [i32; 6] = 0;
    expected[0] = 10; expected[1] = 14; expected[2] = 20;
    expected[3] = 28; expected[4] = 38; expected[5] = 50;

    var ok: i32 = 1;
    var i: i32 = 0;
    while i < 6 {
        let v: F = advance(reg);
        // Compare field value to expected int
        let vi: i32 = v as i32;
        if vi != expected[i] {
            ok = 0;
        }
        i = i + 1;
    }
    return ok;
}

// Dyn register: advance 6x, return 1 if sequence matches [10,14,20,28,38,50]
fn test_dyn() -> i32 {
    let f: Field = field(251);
    var reg: Register<dyn, 2> = register(f, 10, 4, 2);
    var expected: [i32; 6] = 0;
    expected[0] = 10; expected[1] = 14; expected[2] = 20;
    expected[3] = 28; expected[4] = 38; expected[5] = 50;

    var ok: i32 = 1;
    var i: i32 = 0;
    while i < 6 {
        let v: dyn = advance(reg);
        let vi: i32 = v as i32;
        if vi != expected[i] {
            ok = 0;
        }
        i = i + 1;
    }
    return ok;
}

// Regime detection over a dyn register (spec §17 Level 2): two linear segments,
// break at index 4; boundary emerges when prediction fails (pure icmp i64).
fn test_regime_dyn() {
    let f: Field = field(251);
    var data: [i64; 8] = 0;
    data[0] = 10; data[1] = 13; data[2] = 16; data[3] = 19;
    data[4] = 50; data[5] = 53; data[6] = 56; data[7] = 59;

    // Register predicts first regime: linear, start=10, slope=3
    var reg: Register<dyn, 1> = register(f, 10, 3);
    var boundary: i32 = 0 - 1;

    var i: i32 = 0;
    while i < 8 {
        let predicted: dyn = advance(reg);
        // Compare advance result (i64-backed dyn) against data (i64)
        // For exact linear prediction, field-reduced values match.
        let actual: i64 = data[i];
        let pred_i64: i64 = predicted as i64;
        if pred_i64 != actual {
            boundary = i;
            break;
        }
        i = i + 1;
    }

    print(boundary);  // 4

    // Re-init register for second regime
    var reg2: Register<dyn, 1> = register(f, 50, 3);
    let w0: dyn = reg2.advance();
    let w1: dyn = reg2.advance();
    let w2: dyn = reg2.advance();
    print(w0); print(w1); print(w2);  // 50 53 56
}

// Width coverage: 16-bit and 32-bit primes
fn test_width_coverage() {
    // 16-bit: Field<65521> — degree-1 register [54430, 0]; one advance
    // returns state[0] = 54430.
    let f16: Field = field(65521);
    var r16: Register<dyn, 1> = register(f16, 54430, 0);
    let w16: dyn = r16.advance();
    print(w16);  // 54430

    // 32-bit: Field<4294967291>
    let f32: Field = field(4294967291);
    var r32: Register<dyn, 1> = register(f32, 705032619, 0);
    let w32: dyn = r32.advance();
    print(w32);  // 705032619
}
