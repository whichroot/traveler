// Author: Matt Flores
// vec_export_test.tv — #[export]/instantiate ABI verify (B1a Slice 1): does a
// generic-struct stdlib survive an object boundary? Probe A struct-redeclare
// (by-value aggregate return), Probe B opaque-handle. tvc_self ONLY.
// @internal-design: collections.
//
// Expected output:
//   100   (Probe A: vec_get_i32(&v, 0) after pushing 100)
//   200   (Probe A: vec_get_i32(&v, 1) after pushing 200)
//   100   (Probe B: same via heap-allocated handle)
//   200   (Probe B)

struct Vec<T> {
    data: *T,
    len: i32,
    cap: i32,
}

// Extern declarations: mangled monomorphized names from vec.tv's instantiate.
extern "C" fn vec_new_i32() -> Vec<i32>;
extern "C" fn vec_push_i32(v: *Vec<i32>, x: i32);
extern "C" fn vec_get_i32(v: *Vec<i32>, i: i32) -> i32;
extern "C" fn vec_free_i32(v: *Vec<i32>);

fn main() -> i32 {
    // --- Probe A: by-value struct return + redeclared layout ---
    var v: Vec<i32> = vec_new_i32();
    vec_push_i32(&v, 100);
    vec_push_i32(&v, 200);
    print(vec_get_i32(&v, 0));  // 100
    print(vec_get_i32(&v, 1));  // 200
    vec_free_i32(&v);

    // --- Probe B: opaque heap handle, pointer-only boundary ---
    let h: *Vec<i32> = alloc(1);
    let init: Vec<i32> = vec_new_i32();
    h[0] = init;
    vec_push_i32(h, 100);
    vec_push_i32(h, 200);
    print(vec_get_i32(h, 0));   // 100
    print(vec_get_i32(h, 1));   // 200
    vec_free_i32(h);
    free(h);

    return 0;
}
