// Author: Matt Flores
// piecewise_continuation_test.tv — streaming continuation + piecewise tests.
// @internal-design: codec (continuation encoding)
//
// Test 1 (streaming): a long linear ramp forces multiple segments; all follow
//   the same order-1 polynomial, so CONT blocks (BT_CONT=0x03) must appear
//   after the first. Verify: CONT detected, decode lossless.
// Test 2 (piecewise): constant + linear + quadratic sections; the segmenter
//   adapts order per segment. Verify: multiple segments, decode lossless.
//
// Expected output:
//   cont_found 1
//   cont_lossless 1
//   piecewise_found 1
//   piecewise_lossless 1
//
// Linking: piecewise_codec.o + this.o

type F = Field<251>;

extern "C" fn write(fd: i32, buf: *u8, n: i64) -> i64;

struct Segment {
    start: i32,
    length: i32,
    order: i32,
    n_headers: i32,
    h0: i32, h1: i32, h2: i32, h3: i32, h4: i32, h5: i32, h6: i32,
    res_offset: i32,
    res_count: i32,
    encoded_bits: i64,
    is_cont: i32,
    is_predictive: i32,
}

extern "C" fn pc_segment_greedy(
    samples: *i32, n: i32,
    segments: *Segment, max_segments: i32,
    residuals_buf: *i32, max_residuals: i32,
    p: i32) -> i32;

extern "C" fn pc_encode(
    segments: *Segment, n_segs: i32,
    residuals_buf: *i32, total_samples: i32,
    out: *u8, capacity: i32,
    p: i32) -> i32;

extern "C" fn pc_decode(
    data: *u8, data_len: i32,
    out: *i32, max_samples: i32,
    p: i32) -> i32;

// Output helper — all results via print() for consistent buffering

fn main() -> i32 {
    let p: i32 = 251;
    let segments: *Segment = alloc(128);
    let residuals: *i32 = alloc(16384);
    let encoded: *u8 = alloc(16384);
    let decoded: *i32 = alloc(1024);

    // ============================================================
    // TEST 1: Streaming continuation (streaming)
    // Long linear ramp: f(x) = 10 + 3x, 128 points
    // Forces multiple segments → CONT blocks after the first
    // ============================================================
    let n1: i32 = 128;
    let ramp: *i32 = alloc(n1);
    for i in 0..n1 {
        ramp[i] = (10 + 3 * i) % p;
    }

    let n_segs1: i32 = pc_segment_greedy(ramp, n1, segments, 128, residuals, 16384, p);

    // Check: any segment has is_cont = 1?
    var cont_found: i32 = 0;
    var s: i32 = 0;
    while s < n_segs1 {
        if segments[s].is_cont == 1 {
            cont_found = 1;
        }
        s = s + 1;
    }

    // Encode
    let enc_len1: i32 = pc_encode(segments, n_segs1, residuals, n1, encoded, 16384, p);

    // Also check for BT_CONT byte (0x03) in encoded stream
    var b: i32 = 0;
    while b < enc_len1 {
        if encoded[b] == 3 { cont_found = 1; }
        b = b + 1;
    }

    // Decode and verify lossless
    let dec_n1: i32 = pc_decode(encoded, enc_len1, decoded, 1024, p);
    var cont_lossless: i32 = 1;
    if dec_n1 != n1 { cont_lossless = 0; }
    var i: i32 = 0;
    while i < n1 {
        if decoded[i] != ramp[i] { cont_lossless = 0; }
        i = i + 1;
    }

    // Output: cont_found cont_lossless (as field elements for print())
    print(cont_found as F);
    print(cont_lossless as F);

    // ============================================================
    // TEST 2: Piecewise polynomial segmentation
    // Mixed signal: constant + linear + quadratic sections.
    // The segmenter adapts polynomial order per segment.
    // Verify: multiple segments with different orders, decode lossless.
    // ============================================================
    let n2: i32 = 48;
    let mixed: *i32 = alloc(n2);
    // Section 1: constant (16 samples) — value 50
    for i in 0..16  { mixed[i] = 50; }
    // Section 2: linear ramp (16 samples) — 50 + 5*i
    for i in 16..32 { mixed[i] = 50 + 5 * (i - 16); }
    // Section 3: quadratic (16 samples) — 125 + 2*i + i^2/2
    for i in 32..48 {
        let t: i32 = i - 32;
        mixed[i] = (125 + 2 * t + t * t) % p;
    }

    let n_segs2: i32 = pc_segment_greedy(mixed, n2, segments, 128, residuals, 16384, p);

    // Check: multiple segments produced (piecewise segmentation)?
    var pw_found: i32 = 0;
    if n_segs2 > 1 { pw_found = 1; }

    // Encode
    let enc_len2: i32 = pc_encode(segments, n_segs2, residuals, n2, encoded, 16384, p);

    // Decode and verify lossless
    let dec_n2: i32 = pc_decode(encoded, enc_len2, decoded, 1024, p);
    var pw_lossless: i32 = 1;
    if dec_n2 != n2 { pw_lossless = 0; }
    i = 0;
    while i < n2 {
        if decoded[i] != mixed[i] { pw_lossless = 0; }
        i = i + 1;
    }

    // Output: piecewise_found piecewise_lossless
    print(pw_found as F);
    print(pw_lossless as F);

    return 0;
}
