// Author: Matt Flores
// export_test.tv — Verify #[export] produces callable symbols in a shared library.
//
// Build:
//   tvc export_test.tv -o /tmp/export_test.ll
//   llc -filetype=obj /tmp/export_test.ll -o /tmp/export_test.o
//   clang -shared -o /tmp/libexport_test.dylib /tmp/export_test.o
//
// From Python:
//   lib = ctypes.CDLL("/tmp/libexport_test.dylib")
//   assert lib.add_two(3, 4) == 7

type F = Field<65521>;

#[export]
fn add_two(a: i32, b: i32) -> i32 {
    return a + b;
}

#[export]
fn field_add_test(a: i32, b: i32) -> i32 {
    let fa: F = a as F;
    let fb: F = b as F;
    let fc: F = fa + fb;
    return fc as i32;
}

#[export]
fn forward_diff_order1(samples: *i32, n: i32, out: *i32) -> i32 {
    var i: i32 = 0;
    while i < n - 1 {
        out[i] = samples[i + 1] - samples[i];
        i = i + 1;
    }
    return n - 1;
}
