// var creates mutable bindings with AST_LET flags bit0=1.
//
// Expected output:
//   15
//   6
//   42

var g_counter: i32 = 40;    // mutable global

fn main() -> i32 {
    var x: i32 = 5;         // mutable local
    x = x + 10;             // mutation proves the binding is mutable

    var sum: i32 = 0;
    var i: i32 = 0;
    while i < 4 {
        sum = sum + i;      // 0+1+2+3 = 6
        i = i + 1;
    }

    g_counter = g_counter + 2;

    print(x);              // 15
    print(sum);            // 6
    print(g_counter);      // 42
    return 0;
}
