// syntax_var.tv — `var` is a surface alias of `let mut`: same AST_LET (flags
// bit0=1), byte-identical IR to the `let mut` twin (tests/codegen_diff).
// @internal-design: examples (syntax twins).
//
// Expected output:
//   15
//   6
//   42

var g_counter: i32 = 40;    // top-level `var` == mutable global (let mut)

fn main() -> i32 {
    var x: i32 = 5;         // local `var` == let mut
    x = x + 10;             // mutate — proves the binding is mutable

    var sum: i32 = 0;
    var i: i32 = 0;
    while i < 4 {
        sum = sum + i;      // 0+1+2+3 = 6
        i = i + 1;
    }

    g_counter = g_counter + 2;

    print(x);              // 15
    print(sum);            // 6
    print(g_counter);      // 42
    return 0;
}
