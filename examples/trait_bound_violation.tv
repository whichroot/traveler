// trait_bound_violation.tv — NEGATIVE test for trait-bound enforcement (B2b
// Slice 3): MUST FAIL to compile — NoShape passed to fn<T: Shape>, clean
// file:line diagnostic, non-zero exit. tvc_self ONLY; the gate asserts failure.

struct Rect { w: i32, h: i32 }
struct NoShape { z: i32 }

trait Shape {
    fn area(self) -> i32;
}

impl Shape for Rect {
    fn area(self) -> i32 { return self.w * self.h; }
}

fn describe<T: Shape>(x: T) -> i32 {
    return x.area();
}

fn main() -> i32 {
    let n: NoShape = NoShape { z: 1 };
    print(describe(n));   // NoShape does NOT impl Shape -> compile error
    return 0;
}
