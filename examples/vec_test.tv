// Author: Matt Flores
// vec_test.tv — Vec<T> round-trip gate (B1a Slice 1; tvc_self ONLY, defs
// inlined): realloc growth, pop/len/get, struct elements, method==free parity.
// @internal-design: collections.
//
// Expected output:
//   5      (len after 5 pushes)
//   40     (vec_get idx 4)
//   40     (vec_pop)
//   4      (len after pop)
//   10     (v.get(1) via method)
//   1      (method==free parity flag)
//   30     (struct elem: pt.x)
//   40     (struct elem: pt.y)

struct Vec<T> {
    data: *T,
    len: i32,
    cap: i32,
}

fn vec_new<T>() -> Vec<T> {
    let buf: *T = alloc(4);
    return Vec { data: buf, len: 0, cap: 4 };
}

fn vec_push<T>(v: *Vec<T>, x: T) {
    if v.len == v.cap {
        v.cap = v.cap * 2;
        v.data = realloc(v.data, v.cap);
    }
    v.data[v.len] = x;
    v.len = v.len + 1;
}

fn vec_pop<T>(v: *Vec<T>) -> T {
    v.len = v.len - 1;
    return v.data[v.len];
}

fn vec_len<T>(v: *Vec<T>) -> i32 {
    return v.len;
}

fn vec_get<T>(v: *Vec<T>, i: i32) -> T {
    return v.data[i];
}

fn vec_free<T>(v: *Vec<T>) {
    free(v.data);
}

fn get<T>(v: *Vec<T>, i: i32) -> T {
    return vec_get(v, i);
}

struct Pt {
    x: i32,
    y: i32,
}

fn main() -> i32 {
    // --- Vec<i32>: growth + core ops ---
    var v: Vec<i32> = vec_new();
    vec_push(&v, 0);
    vec_push(&v, 10);
    vec_push(&v, 20);
    vec_push(&v, 30);
    vec_push(&v, 40);   // 5th push: len was 4 == cap, forces realloc 4->8
    print(vec_len(&v)); // 5
    print(vec_get(&v, 4)); // 40
    print(vec_pop(&v));    // 40
    print(vec_len(&v));    // 4

    // --- method form + parity ---
    let m1: i32 = v.get(1);     // method -> get(&v, 1) -> vec_get
    print(m1);                  // 10
    let f1: i32 = vec_get(&v, 1);
    var parity: i32 = 0;
    if m1 == f1 { parity = 1; }
    print(parity);              // 1

    vec_free(&v);

    // --- Vec<Pt>: struct element (ctx_elem_size under generic T) ---
    var vp: Vec<Pt> = vec_new();
    vec_push(&vp, Pt { x: 30, y: 40 });
    let p0: Pt = vec_get(&vp, 0);
    print(p0.x);  // 30
    print(p0.y);  // 40
    vec_free(&vp);

    return 0;
}
