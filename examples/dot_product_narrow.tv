// dot_product_narrow.tv - exact integer dots with explicit input/accumulator
// widths. This is an example, not a frozen library API.
// @internal-note: plan-dot-product-support

fn dot_i8_i64(x: *i8, w: *i8, n: i32) -> i64 {
    var acc: i64 = 0;
    var i: i32 = 0;
    while i < n {
        acc = acc + (x[i] as i64) * (w[i] as i64);
        i = i + 1;
    }
    return acc;
}

fn dot_u8_u64(x: *u8, w: *u8, n: i32) -> u64 {
    var acc: u64 = 0 as u64;
    var i: i32 = 0;
    while i < n {
        acc = acc + (x[i] as u64) * (w[i] as u64);
        i = i + 1;
    }
    return acc;
}

fn dot_i32_i64(x: *i32, w: *i32, n: i32) -> i64 {
    var acc: i64 = 0;
    var i: i32 = 0;
    while i < n {
        acc = acc + (x[i] as i64) * (w[i] as i64);
        i = i + 1;
    }
    return acc;
}

fn main() -> i32 {
    var sx: [i8; 3] = 0;
    var sw: [i8; 3] = 0;
    sx[0] = (0 - 128) as i8; sx[1] = 127 as i8; sx[2] = (0 - 3) as i8;
    sw[0] = (0 - 128) as i8; sw[1] = 127 as i8; sw[2] = 7 as i8;
    print(dot_i8_i64(&sx[0], &sw[0], 3));
    print(dot_i8_i64(&sx[0], &sw[0], 0));
    print(dot_i8_i64(&sx[0], &sw[0], 0 - 1));

    var ux: [u8; 3] = 0;
    var uw: [u8; 3] = 0;
    ux[0] = 255 as u8; ux[1] = 17 as u8; ux[2] = 3 as u8;
    uw[0] = 251 as u8; uw[1] = 19 as u8; uw[2] = 7 as u8;
    print(dot_u8_u64(&ux[0], &uw[0], 3));

    var ix: [i32; 2] = 0;
    var iw: [i32; 2] = 0;
    ix[0] = 0 - 2147483647 - 1; ix[1] = 0 - 2147483647 - 1;
    iw[0] = 0 - 2147483647 - 1; iw[1] = 0 - 2147483647 - 1;
    // The mathematical sum is 2^63; i64 returns its defined wrapped residue.
    print(dot_i32_i64(&ix[0], &iw[0], 2));
    return 0;
}
