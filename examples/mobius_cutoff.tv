// Author: Matt Flores
// mobius_cutoff.tv — machine-check of Remark 3.4 (mobius_linear_complexity.tex):
// c = 10^-15 for every N >= 3 — 60 dyadic windows + N=3, then the seven directed
// endpoint inequalities at N = 2^62. Exact integer arithmetic, no floats.
// @internal-design: mobius-inclusion
//
// Output: 60 ; then 60 per-window headrooms ; min-headroom ; its k (=61) ;
// all-windows-pass (1) ; N=3 headroom ; N=3 pass (1) ; finite verdict (1) ; then
// 62 (asymptotic-tier marker) ; per endpoint a pass flag (all 1), with a ppm slack
// printed after E1,E2,E3,E6c (margin where meaningful) ; asymptotic verdict (1) ;
// finally the combined verdict (1): c = 1e-15 on [3,2^62) AND the N>=2^62 hypotheses.

import "../src/lib/util/lnbounds.tv";
import "../src/lib/util/wideint.tv";

// floor(log2(v)) for v >= 1.
fn ilog2(v: i64) -> i64 {
    var n: i64 = 0;
    var x: i64 = v;
    while x > 1 { x = x / 2; n = n + 1; }
    return n;
}

// bit length of a wide (0 for zero).
fn w_bitlen(w: *i64, nl: i32) -> i64 {
    var i: i32 = nl - 1;
    while i >= 0 {
        if w[i] != 0 { return 31 * (i as i64) + ilog2(w[i]) + 1; }
        i = i - 1;
    }
    return 0;
}

// ---------------------------------------------------------------------------
// Asymptotic tier N >= 2^62 (A3b): the seven Remark-3.4 endpoints at N = 2^62
// (T = 64 exactly); "sound" = the directed rounding makes each check HARDER.
// ---------------------------------------------------------------------------
fn asym_tier() -> i32 {
    let SI: i64 = 1073741824;            // 2^30 (lnbounds internal scale)
    let l2L: i64 = ln2_lo();             // lower bound on ln2, scale SI
    let l2H: i64 = ln2_hi();             // upper bound on ln2, scale SI

    print(62);                           // marker: asymptotic tier, endpoint N = 2^62

    // E1 [i64]  149*l2L > 100*SI    (1/ln2 < 1.49, i.e. the coefficient 1.49-1/ln2
    //   is positive; l2L LOWER => LHS underestimated => a pass is sound.)
    let e1L: i64 = 149 * l2L;
    let e1R: i64 = 100 * SI;
    var e1: i32 = 0;
    if e1L > e1R { e1 = 1; }
    print(e1);
    print(((e1L - e1R) * 1000000 / e1R) as i32);        // ppm slack (~3.3%)

    // E2 [i64]  6400*SI <= 9238*l2L   (9238 = 149*62; T=64 <= 1.49*62*ln2. l2L
    //   LOWER => RHS underestimated => harder test => sound. BINDING, ~0.05%.)
    let e2L: i64 = 6400 * SI;
    let e2R: i64 = 9238 * l2L;
    var e2: i32 = 0;
    if e2L <= e2R { e2 = 1; }
    print(e2);
    print(((e2R - e2L) * 1000000 / e2L) as i32);        // ppm slack (binding, ~480)

    // E3 [i64]  100*ln_hi(ceil(1.49*SI)) <= 11*ln_lo(62*l2L)   (ln1.49 <= 0.11*m;
    //   ln_hi UPPER on LHS, ln_lo LOWER on RHS-arg => sound. With E2: lnT <= 1.11m.)
    let arg149: i64 = (149 * SI + 99) / 100;            // ceil(1.49*SI)
    let e3L: i64 = 100 * ln_hi(arg149);
    let e3R: i64 = 11 * ln_lo(62 * l2L);
    var e3: i32 = 0;
    if e3L <= e3R { e3 = 1; }
    print(e3);
    print(((e3R - e3L) * 1000000 / e3L) as i32);        // ppm slack (~3.6%)

    // E4 [i64]  128*ln_lo(64*SI) > 17*SI   (2T*lnT > 17 at 2^62, so max(17, 2T lnT)
    //   resolves to 2T lnT; ln_lo LOWER => LHS underestimated => sound.)
    let e4L: i64 = 128 * ln_lo(64 * SI);
    let e4R: i64 = 17 * SI;
    var e4: i32 = 0;
    if e4L > e4R { e4 = 1; }
    print(e4);                                          // margin astronomically slack

    // E6b [i128]  62*l2L * ln_lo(62*l2L) >= 161*SI^2   (l*m >= 161, "+1" folded into
    //   the coefficient; both factors LOWER bounds => sound. Product ~2^67: NATIVE i128.)
    let ellLo: i64 = 62 * l2L;
    let mLo: i64 = ln_lo(ellLo);
    let e6bL: i128 = (ellLo as i128) * (mLo as i128);
    let e6bR: i128 = (161 as i128) << 60;               // 161 * SI^2 = 161 * 2^60
    var e6b: i32 = 1;
    if e6bL < e6bR { e6b = 0; }                         // i.e. e6bL >= e6bR
    print(e6b);

    // E6c [i64]  5335558^2 <= 11*1610000^2   (pure rational: 2*(2*1.49*1.11 +
    //   1/161)^2 <= 22, i.e. 3.31401^2 <= 11; both sides ~2.85e13 < 2^63, no logs.)
    let aa: i64 = 5335558 * 5335558;
    let bb: i64 = 11 * (1610000 * 1610000);
    var e6c: i32 = 0;
    if aa <= bb { e6c = 1; }
    print(e6c);
    print(((bb - aa) * 1000000 / aa) as i32);           // ppm slack (~0.16%)

    // E5 [i256]  23*(62*l2H * ln_hi(62*l2H))^2 <= 2^62*SI^4 = 2^182   (f(2^62) >= 23;
    //   l2H/ln_hi UPPER on the denominator => LHS overestimated => sound. NATIVE i256.)
    let ellHi: i64 = 62 * l2H;
    let mHi: i64 = ln_hi(ellHi);
    let inner: i256 = (ellHi as i256) * (mHi as i256);  // >= l*m*SI^2  (~2^67)
    let e5L: i256 = (23 as i256) * inner * inner;        // 23*(l m)^2 at scale SI^4
    let e5R: i256 = (1 as i256) << 182;                  // 2^62 * SI^4
    var e5: i32 = 1;
    if e5R < e5L { e5 = 0; }                             // i.e. e5L <= e5R
    print(e5);

    var v: i32 = 0;
    if e1 == 1 && e2 == 1 && e3 == 1 && e4 == 1 && e6b == 1 && e6c == 1 && e5 == 1 { v = 1; }
    print(v);                                            // asymptotic-tier verdict
    return v;
}

fn main() -> i32 {
    let SI: i64 = 1073741824;        // 2^30, lnbounds internal scale
    let DOWN: i64 = 16384;           // 2^14: SI -> compare scale S = 2^16
    let nl: i32 = 8;
    let xw: *i64 = alloc(nl);
    let x2: *i64 = alloc(nl);
    let c15: *i64 = alloc(nl);
    let rhs: *i64 = alloc(nl);
    let lhs: *i64 = alloc(nl);
    let three: *i64 = alloc(nl);
    let lhs3: *i64 = alloc(nl);
    w_set_i64(c15, nl, 1000000000000000);   // 10^15

    print(60);                       // number of dyadic windows (k = 2..61)

    let l2: i64 = ln2_lo();          // lower bound on ln2, scale SI
    var all_pass: i32 = 1;
    var min_hr: i64 = 1000000;
    var argmin: i32 = 0;
    var k: i32 = 2;
    while k <= 61 {
        let LN: i64 = (k as i64) * l2;        // lower bound on ln N   (N >= 2^k), SI
        let LNLN: i64 = ln_lo(LN);            // lower bound on ln ln N,           SI
        let X: i64 = (LN / DOWN) * (LNLN / DOWN);   // scale S^2 = 2^32, fits i64
        w_set_i64(xw, nl, X);
        w_mul(xw, xw, x2, nl);                // X^2
        w_mul(x2, c15, rhs, nl);              // 10^15 * X^2   (RHS)
        w_set_pow2(lhs, nl, (k as i64) + 65); // 2^(k+1) * S^4 = 2^(k+65)   (LHS)
        let cmp: i32 = w_cmp(lhs, rhs, nl);   // LHS <= RHS  <=>  window passes
        if cmp > 0 { all_pass = 0; }
        let hr: i64 = w_bitlen(rhs, nl) - ((k as i64) + 66);
        print(hr as i32);                     // per-window headroom (bits)
        if hr < min_hr { min_hr = hr; argmin = k; }
        k = k + 1;
    }
    print(min_hr as i32);            // tightest window headroom (bits)
    print(argmin);                   // k of tightest window (expect 61)
    print(all_pass);                 // 1 : every window k=2..61 passes

    // N = 3 : the small-N spike, checked pointwise (numerator = 3 exactly).
    let ln3: i64 = ln_lo(3 * SI);
    let lnln3: i64 = ln_lo(ln3);
    let X3: i64 = (ln3 / DOWN) * (lnln3 / DOWN);
    w_set_i64(xw, nl, X3);
    w_mul(xw, xw, x2, nl);
    w_mul(x2, c15, rhs, nl);         // 10^15 * X3^2
    w_set_pow2(lhs, nl, 64);         // S^4 = 2^64
    w_set_i64(three, nl, 3);
    w_mul(lhs, three, lhs3, nl);     // 3 * S^4  (numerator N=3, scaled)
    let cmp3: i32 = w_cmp(lhs3, rhs, nl);
    var pass3: i32 = 0;
    if cmp3 <= 0 { pass3 = 1; }
    print((w_bitlen(rhs, nl) - w_bitlen(lhs3, nl)) as i32);   // N=3 headroom (bits)
    print(pass3);                    // 1

    var verdict: i32 = 0;
    if all_pass == 1 { if pass3 == 1 { verdict = 1; } }
    print(verdict);                  // 1 : c = 1e-15 on all of [3, 2^62) (finite tier)

    // Asymptotic tier N >= 2^62 (A3b): the 1.49 / 1.11 / 23 endpoints, native wide.
    let asym: i32 = asym_tier();
    var full: i32 = 0;
    if verdict == 1 && asym == 1 { full = 1; }
    print(full);                     // 1 : both tiers -> c = 1e-15 for every N >= 3

    free(xw); free(x2); free(c15); free(rhs); free(lhs); free(three); free(lhs3);
    return 0;
}
