// Author: Matt Flores
// enum_match_nested.tv — nested match + aggregate enum payloads
// (@internal-note: known-issues #31). tvc_self ONLY (gated in tests/dynfield/run.sh; not seed surface).
// @internal-design: examples (enum_match_nested, #31).
//
// Expected output:
//   21    nested integer match inside the FIRST (non-last) arm
//   8     outer binding still live after the nested match
//   500   enum-in-enum payload, nested enum match, depth-3 integer match
//   510   outer binding as a scrutinee AFTER the nested match
//   9     multi-field payload: scalar before a struct (offset alignment)
//   1     struct field len round-trips through construction + destructure
//   65    struct field data round-trips
enum FsError {
    NotFound,
    ReadFailed,
}

enum Result<T, E> {
    Ok(T),
    Err(E),
}

// 16-byte struct payload: wider than the old 8-byte payload guess.
struct Buf {
    data: *u8,
    len: i32,
    cap: i32,
}

enum Pair {
    Two(i32, Buf),
    None,
}

fn read_ok() -> Result<Buf, FsError> {
    let d: *u8 = alloc(8);
    d[0] = 104;
    return Result::Ok(Buf { data: d, len: 2, cap: 8 });
}

fn read_err() -> Result<Buf, FsError> {
    return Result::Err(FsError::ReadFailed);
}

fn main() -> i32 {
    // (1) nested match in the FIRST arm — the outer arm window must survive,
    // and the binding must stay live after the nested match.
    let r1: Result<Buf, FsError> = read_ok();
    match r1 {
        Result::Ok(b) => {
            match b.len {
                2 => { print(21); }
                _ => { print(0 - 1); }
            }
            print(b.cap);
        }
        Result::Err(e) => { print(0 - 2); }
    }

    // (2) enum-typed payload: bound, copied, nested-matched (depth 3), and
    // used as a scrutinee again after the nest.
    let r2: Result<Buf, FsError> = read_err();
    match r2 {
        Result::Ok(b) => { print(0 - 3); }
        Result::Err(e) => {
            let tag: FsError = e;
            match tag {
                FsError::NotFound => { print(404); }
                FsError::ReadFailed => {
                    match 1 {
                        1 => { print(500); }
                        _ => { print(0 - 4); }
                    }
                }
            }
            match e {
                FsError::NotFound => { print(414); }
                FsError::ReadFailed => { print(510); }
            }
        }
    }

    // (3) multi-field variant: i32 then a 16-byte struct — construction and
    // destructuring must agree on the aligned payload offsets.
    let d2: *u8 = alloc(4);
    d2[0] = 65;
    let p: Pair = Pair::Two(9, Buf { data: d2, len: 1, cap: 4 });
    match p {
        Pair::Two(n, b2) => { print(n); print(b2.len); print(b2.data[0] as i32); }
        Pair::None => { print(0 - 5); }
    }
    return 0;
}
