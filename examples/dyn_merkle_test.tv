// dyn_merkle_test.tv — generic Merkle (build/open/verify) calling the generic
// Poseidon2 compression, all instantiated <dyn> over a runtime prime.
// @internal-design: crypto
//
// Test 1: all 8 authentication paths verify   -> 1
// Test 2: old leaf fails against tampered tree -> 0
// Test 3: tampered leaf verifies in new tree   -> 1
//
// Expected output: 1 0 1

// ---- Generic Poseidon2 core (from poseidon2.tv) ----

fn sbox7<F: Field>(x: F) -> F {
    let x2: F = x * x;
    let x4: F = x2 * x2;
    let x7: F = x4 * x2 * x;
    return x7;
}

fn mds_mat4<F: Field>(s: *F) {
    let s0: F = s[0]; let s1: F = s[1]; let s2: F = s[2]; let s3: F = s[3];
    let t01: F  = s0 + s1;
    let t23: F  = s2 + s3;
    let t0123: F = t01 + t23;
    let t01123: F = t0123 + s1;
    let t01233: F = t0123 + s3;
    s[0] = t01123 + t01;
    s[1] = t01123 + s2 + s2;
    s[2] = t01233 + t23;
    s[3] = t01233 + s0 + s0;
}

fn mds_external_8<F: Field>(state: *F) {
    mds_mat4(state);
    let hi: *F = &state[4];
    mds_mat4(hi);
    let sum0: F = state[0] + state[4];
    let sum1: F = state[1] + state[5];
    let sum2: F = state[2] + state[6];
    let sum3: F = state[3] + state[7];
    state[0] = state[0] + sum0;
    state[1] = state[1] + sum1;
    state[2] = state[2] + sum2;
    state[3] = state[3] + sum3;
    state[4] = state[4] + sum0;
    state[5] = state[5] + sum1;
    state[6] = state[6] + sum2;
    state[7] = state[7] + sum3;
}

fn mds_internal_8<F: Field>(state: *F, diag: *F) {
    var sum: F = state[0];
    for i in 1..8 {
        sum = sum + state[i];
    }
    for i in 0..8 {
        state[i] = state[i] * diag[i] + sum;
    }
}

fn poseidon2_permute_8<F: Field>(
    state: *F, rc_init: *F, rc_term: *F, rc_int: *F, diag: *F
) {
    mds_external_8(state);
    for r in 0..4 {
        let base: i32 = r * 8;
        for i in 0..8 { state[i] = state[i] + rc_init[base + i]; }
        for i in 0..8 { state[i] = sbox7(state[i]); }
        mds_external_8(state);
    }
    for r in 0..22 {
        state[0] = state[0] + rc_int[r];
        state[0] = sbox7(state[0]);
        mds_internal_8(state, diag);
    }
    for r in 0..4 {
        let base: i32 = r * 8;
        for i in 0..8 { state[i] = state[i] + rc_term[base + i]; }
        for i in 0..8 { state[i] = sbox7(state[i]); }
        mds_external_8(state);
    }
}

fn poseidon2_compress<F: Field>(
    left: *F, right: *F, out: *F,
    rc_init: *F, rc_term: *F, rc_int: *F, diag: *F
) {
    let state: *F = alloc(8);
    for i in 0..4 { state[i] = left[i]; }
    for i in 0..4 { state[4 + i] = right[i]; }
    poseidon2_permute_8(state, rc_init, rc_term, rc_int, diag);
    for i in 0..4 { out[i] = state[i]; }
    free(state);
}

fn poseidon2_diag<F: Field>(diag: *F) {
    let zero: F = 0;
    let one: F = 1;
    let two: F = 2;
    let three: F = 3;
    let four: F = 4;
    let half: F = one / two;
    diag[0] = zero - two;
    diag[1] = one;
    diag[2] = two;
    diag[3] = half;
    diag[4] = three;
    diag[5] = zero - half;
    diag[6] = zero - three;
    diag[7] = zero - four;
}

// ---- Generic Merkle (from merkle.tv, calling poseidon2_compress<F>) ----

fn merkle_build<F: Field>(
    leaves: *F, n_leaves: i32, tree: *F,
    rc_init: *F, rc_term: *F, rc_int: *F, diag: *F
) {
    for i in 0..n_leaves {
        let src: i32 = i * 4;
        let dst: i32 = (n_leaves + i) * 4;
        for j in 0..4 { tree[dst + j] = leaves[src + j]; }
    }
    var k: i32 = n_leaves - 1;
    while k >= 1 {
        let left: *F = &tree[(2 * k) * 4];
        let right: *F = &tree[(2 * k + 1) * 4];
        let out: *F = &tree[k * 4];
        poseidon2_compress(left, right, out, rc_init, rc_term, rc_int, diag);
        k = k - 1;
    }
}

fn merkle_open<F: Field>(tree: *F, n_leaves: i32, idx: i32, path: *F) -> i32 {
    var pos: i32 = n_leaves + idx;
    var depth: i32 = 0;
    while pos > 1 {
        let sibling: i32 = pos ^ 1;
        let src: i32 = sibling * 4;
        let dst: i32 = depth * 4;
        for j in 0..4 { path[dst + j] = tree[src + j]; }
        pos = pos / 2;
        depth = depth + 1;
    }
    return depth;
}

fn merkle_verify<F: Field>(
    root: *F, leaf: *F, idx: i32, n_leaves: i32,
    path: *F, path_len: i32,
    rc_init: *F, rc_term: *F, rc_int: *F, diag: *F
) -> i32 {
    let current: *F = alloc(4);
    let tmp: *F = alloc(4);
    for j in 0..4 { current[j] = leaf[j]; }
    var pos: i32 = n_leaves + idx;
    for d in 0..path_len {
        let sib: *F = &path[d * 4];
        if (pos & 1) == 0 {
            poseidon2_compress(current, sib, tmp, rc_init, rc_term, rc_int, diag);
        } else {
            poseidon2_compress(sib, current, tmp, rc_init, rc_term, rc_int, diag);
        }
        for j in 0..4 { current[j] = tmp[j]; }
        pos = pos / 2;
    }
    var ok: i32 = 1;
    for j in 0..4 {
        if current[j] != root[j] { ok = 0; }
    }
    free(current);
    free(tmp);
    return ok;
}

instantiate sbox7<dyn>;
instantiate mds_mat4<dyn>;
instantiate mds_external_8<dyn>;
instantiate mds_internal_8<dyn>;
instantiate poseidon2_permute_8<dyn>;
instantiate poseidon2_compress<dyn>;
instantiate poseidon2_diag<dyn>;
instantiate merkle_build<dyn>;
instantiate merkle_open<dyn>;
instantiate merkle_verify<dyn>;

// ---- Goldilocks round constants (Plonky3) ----

