fn main() -> i32 {
    let f: Field = field(18446744069414584321);

    let rc_init: *i64 = alloc(32);
    let rc_term: *i64 = alloc(32);
    let rc_int: *i64 = alloc(22);
    let diag: *i64 = alloc(8);
    fill_rc(rc_init, rc_term, rc_int);
    poseidon2_diag_dyn(f, diag);

    let n: i32 = 8;
    let leaves: *i64 = alloc(n * 4);
    for i in 0..n {
        leaves[i * 4] = (i + 1) as i64;
        leaves[i * 4 + 1] = 0;
        leaves[i * 4 + 2] = 0;
        leaves[i * 4 + 3] = 0;
    }

    let tree: *i64 = alloc(2 * n * 4);
    merkle_build_dyn(f, leaves, n, tree, rc_init, rc_term, rc_int, diag);
    let root: *i64 = &tree[4];

    // Test 1: verify all 8 paths
    let path: *i64 = alloc(4 * 4);
    var all_pass: i32 = 1;
    for i in 0..n {
        let leaf: *i64 = &leaves[i * 4];
        let depth: i32 = merkle_open_dyn(f, tree, n, i, path);
        let ok: i32 = merkle_verify_dyn(f, root, leaf, i, n, path, depth,
            rc_init, rc_term, rc_int, diag);
        if ok != 1 { all_pass = 0; }
    }
    print(all_pass);

    // Test 2: tamper leaf 3, old leaf fails against new tree
    let old_leaf: *i64 = alloc(4);
    for j in 0..4 { old_leaf[j] = leaves[3 * 4 + j]; }
    leaves[3 * 4] = 99;
    merkle_build_dyn(f, leaves, n, tree, rc_init, rc_term, rc_int, diag);
    let new_root: *i64 = &tree[4];
    let depth2: i32 = merkle_open_dyn(f, tree, n, 3, path);
    let bad: i32 = merkle_verify_dyn(f, new_root, old_leaf, 3, n, path, depth2,
        rc_init, rc_term, rc_int, diag);
    print(bad);

    // Test 3: tampered leaf verifies in new tree
    let tampered: *i64 = &leaves[3 * 4];
    let good: i32 = merkle_verify_dyn(f, new_root, tampered, 3, n, path, depth2,
        rc_init, rc_term, rc_int, diag);
    print(good);

    free(leaves); free(tree); free(path); free(old_leaf);
    free(rc_init); free(rc_term); free(rc_int); free(diag);
    return 0;
}
