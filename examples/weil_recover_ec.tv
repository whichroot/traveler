// weil_recover_ec.tv — recover the Weil zeta of an elliptic curve FROM point counts
// via BM + Hankel (nt/curve.tv FORWARD + nt/linrec.tv INVERSE); genus = order/2.
// @internal-design: nt; plan: @internal-note: plan-observability (E0/E1)
// Parts: A synthetic BM/Hankel validation; B real elliptic zetas (over lifting
// prime L vs the F_p collapse); C Frobenius companion operator; D genus ladder.
// @internal-oracle: weil_recover_ec (bit-for-bit).

import "../src/lib/nt/curve.tv";     // FORWARD: mod_pos/legendre/count_fp/count_fp2/count_fp3
import "../src/lib/nt/linrec.tv";    // INVERSE: mod_l/inv_l/center/bm_l/hankel_rank

let LIFT: i64 = 65537;   // lifting prime: prime, > dynamic range of these curves

// ---- Part A (E0): validate BM + Hankel on synthetic sequences. Prints per
// sequence: order, hankel_rank, centered C[1..order]; order == rank IS the check.
fn probe(s: *i64, n: i32) {
    let C: *i64 = alloc(n + 1);
    let ord: i32 = bm_l(s, n, LIFT, C);
    let hr: i32 = hankel_rank(s, n, LIFT);
    print(ord);
    print(hr);
    var i: i32 = 1;
    while i <= ord {
        print(center(C[i], LIFT) as i32);
        i = i + 1;
    }
    free(C);
}

// ---- Part B (E1): recover the elliptic zeta from s_0 = 2, s_n = p^n + 1 - N_n
// (independent counts). Over L: order 2, full zeta; over p: order 1, collapse.
fn recover_curve(p: i32, a: i32, b: i32) {
    let n1: i32 = count_fp(p, a, b);
    let n2: i32 = count_fp2(p, a, b);
    let n3: i32 = count_fp3(p, a, b);
    let s: *i64 = alloc(4);
    s[0] = 2;
    s[1] = (p + 1 - n1) as i64;
    s[2] = (p * p + 1 - n2) as i64;
    s[3] = (p * p * p + 1 - n3) as i64;

    // recover over the lifting prime L
    let C: *i64 = alloc(5);
    let ord: i32 = bm_l(s, 4, LIFT, C);
    let ap: i64 = 0 - center(C[1], LIFT);   // C = [1, -a_p, p]
    let prec: i64 = center(C[2], LIFT);
    var rh: i32 = 0;
    if ap * ap <= 4 * (p as i64) { rh = 1; }
    let ap_direct: i32 = p + 1 - n1;
    var agree: i32 = 0;
    if (ap as i32) == ap_direct { agree = 1; }

    // Hankel floor: 2x2 Hankel det nonzero over L  =>  genuinely genus >= 1
    let hr: i32 = hankel_rank(s, 4, LIFT);

    // recover over F_p: the collapse — the constant term is p = 0 in F_p, so the
    // norm/genus datum is UNRECOVERABLE in the curve's own field; L is required.
    let Cp: *i64 = alloc(5);
    let ord_p: i32 = bm_l(s, 4, p as i64, Cp);
    let cp2: i64 = center(Cp[2], p as i64);   // recovered constant term over F_p

    print(ord);              // 2  (order over L = 2g = genus 1 -> 2)
    print(ap as i32);        // recovered a_p
    print(prec as i32);      // recovered p (the constant term of the zeta)
    print(rh);               // RH: a_p^2 <= 4p
    print(ap_direct);        // a_p from the direct F_p count
    print(agree);            // recovered == direct
    print(hr);               // Hankel rank over L (2)
    print(ord_p);            // order over F_p (as BM reports it)
    print(cp2 as i32);       // recovered constant term over F_p = 0 (p vanished)

    free(s);
    free(C);
    free(Cp);
}

// ---- Part C (spectral): companion M = [[a_p,-p],[1,0]] is the Frobenius operator
// (Hilbert-Polya): Tr(M^n) = s_n counts points, det M = p, RH = spectrum on sqrt p.
fn matmul2(A: *i64, B: *i64, L: i64, out: *i64) {
    out[0] = mod_l(A[0] * B[0] + A[1] * B[2], L);
    out[1] = mod_l(A[0] * B[1] + A[1] * B[3], L);
    out[2] = mod_l(A[2] * B[0] + A[3] * B[2], L);
    out[3] = mod_l(A[2] * B[1] + A[3] * B[3], L);
}

fn frobenius_spectral(p: i32, a: i32, b: i32) {
    let n1: i32 = count_fp(p, a, b);
    let n2: i32 = count_fp2(p, a, b);
    let n3: i32 = count_fp3(p, a, b);
    let ap: i64 = (p + 1 - n1) as i64;
    let pl: i64 = p as i64;
    let s1: i64 = ap;
    let s2: i64 = (p * p + 1 - n2) as i64;
    let s3: i64 = (p * p * p + 1 - n3) as i64;

    // companion operator M = [[a_p, -p], [1, 0]] over the lifting prime
    let M: *i64 = alloc(4);
    M[0] = mod_l(ap, LIFT);
    M[1] = mod_l(0 - pl, LIFT);
    M[2] = 1;
    M[3] = 0;
    let M2: *i64 = alloc(4);
    let M3: *i64 = alloc(4);
    matmul2(M, M, LIFT, M2);
    matmul2(M2, M, LIFT, M3);

    // spectral traces Tr(M^n) vs the point-count observable s_n
    let t1: i64 = center(mod_l(M[0] + M[3], LIFT), LIFT);
    let t2: i64 = center(mod_l(M2[0] + M2[3], LIFT), LIFT);
    let t3: i64 = center(mod_l(M3[0] + M3[3], LIFT), LIFT);
    let det: i64 = center(mod_l(M[0] * M[3] - M[1] * M[2], LIFT), LIFT);

    var f1: i32 = 0;
    if t1 == s1 { f1 = 1; }
    var f2: i32 = 0;
    if t2 == s2 { f2 = 1; }
    var f3: i32 = 0;
    if t3 == s3 { f3 = 1; }
    var fd: i32 = 0;
    if det == pl { fd = 1; }
    var rh: i32 = 0;
    if ap * ap <= 4 * pl { rh = 1; }

    print(ap as i32);    // trace of Frobenius (= s_1)
    print(det as i32);   // det = p = q (the RH product alpha*beta)
    print(f1);           // Tr(M^1) == s_1  (operator trace counts points)
    print(f2);           // Tr(M^2) == s_2
    print(f3);           // Tr(M^3) == s_3
    print(fd);           // det(M) == p
    print(rh);           // RH: spectrum on |z| = sqrt p  <=>  a_p^2 <= 4p

    free(M);
    free(M2);
    free(M3);
}

// ---- Part D (genus ladder): genus = (recovered order)/2 for g = 0, 1, 2; the g=2
// curve is y^2 = x^5+x+1 / F_13 (zeta L = 1 + T + 4T^2 + 13T^3 + 169T^4). ----

// generate s_0..s_{nterms-1} for a degree-4 zeta with connection poly [1,c1,c2,c3,c4]
// (s_0 = 2g = 4; s_1..s_3 via Newton's identities; s_n = -(c1 s_{n-1}+...+c4 s_{n-4})).
fn gen_trace_deg4(c1: i64, c2: i64, c3: i64, c4: i64, s: *i64, nterms: i32) {
    let e1: i64 = 0 - c1;   // elementary symmetric: L = prod(1 - a_i T)
    let e2: i64 = c2;
    let e3: i64 = 0 - c3;
    s[0] = 4;
    s[1] = e1;
    s[2] = e1 * s[1] - 2 * e2;
    s[3] = e1 * s[2] - e2 * s[1] + 3 * e3;
    var n: i32 = 4;
    while n < nterms {
        s[n] = 0 - (c1 * s[n - 1] + c2 * s[n - 2] + c3 * s[n - 3] + c4 * s[n - 4]);
        n = n + 1;
    }
}

fn genus_ladder() {
    // g = 0: the projective line, s_n = 0
    let s0: *i64 = alloc(6);
    var i: i32 = 0;
    while i < 6 {
        s0[i] = 0;
        i = i + 1;
    }
    let C0: *i64 = alloc(7);
    let ord0: i32 = bm_l(s0, 6, LIFT, C0);

    // g = 1: real elliptic (p=5), s_0..s_3 from independent counts
    let n1: i32 = count_fp(5, 1, 1);
    let n2: i32 = count_fp2(5, 1, 1);
    let n3: i32 = count_fp3(5, 1, 1);
    let s1: *i64 = alloc(4);
    s1[0] = 2;
    s1[1] = (5 + 1 - n1) as i64;
    s1[2] = (5 * 5 + 1 - n2) as i64;
    s1[3] = (5 * 5 * 5 + 1 - n3) as i64;
    let C1: *i64 = alloc(5);
    let ord1: i32 = bm_l(s1, 4, LIFT, C1);

    // g = 2: real genus-2 zeta (p=13): L = 1 + T + 4T^2 + 13T^3 + 169T^4
    let s2: *i64 = alloc(8);
    gen_trace_deg4(1, 4, 13, 169, s2, 8);
    let C2: *i64 = alloc(9);
    let ord2: i32 = bm_l(s2, 8, LIFT, C2);
    let c1r: i64 = center(C2[1], LIFT);
    let c2r: i64 = center(C2[2], LIFT);

    // genus-2 RH region (p=13): real Weil poly y^2 + c1 y + (c2 - 2p), roots in
    // [-2sqrt p, 2sqrt p]  <=>  disc>=0, 2p+c2>=0, (2p+c2)^2>=4p c1^2, c1^2<=16p.
    let pg: i64 = 13;
    let disc: i64 = c1r * c1r - 4 * (c2r - 2 * pg);
    let ss: i64 = 2 * pg + c2r;
    var rh2: i32 = 0;
    if disc >= 0 {
        if ss >= 0 {
            if ss * ss >= 4 * pg * c1r * c1r {
                if c1r * c1r <= 16 * pg { rh2 = 1; }
            }
        }
    }

    print(ord0);            // 0
    print(ord0 / 2);        // genus 0
    print(ord1);            // 2
    print(ord1 / 2);        // genus 1
    print(ord2);            // 4
    print(ord2 / 2);        // genus 2
    print(c1r as i32);      // recovered zeta coeff c1 (== weil_zeta_g2)
    print(c2r as i32);      // recovered zeta coeff c2
    print(rh2);             // genus-2 RH region holds

    free(s0);
    free(C0);
    free(s1);
    free(C1);
    free(s2);
    free(C2);
}

fn main() -> i32 {
    // Part A — synthetic operator validation
    // Fibonacci: s_n = s_{n-1} + s_{n-2},  C = [1,-1,-1], order 2
    let fib: *i64 = alloc(8);
    fib[0] = 1; fib[1] = 1; fib[2] = 2; fib[3] = 3;
    fib[4] = 5; fib[5] = 8; fib[6] = 13; fib[7] = 21;
    probe(fib, 8);
    free(fib);

    // eigenvalues {1,2,3}: s_n = sum k^n,  C = [1,-6,11,-6], order 3
    let tri: *i64 = alloc(6);
    tri[0] = 3; tri[1] = 6; tri[2] = 14; tri[3] = 36; tri[4] = 98; tri[5] = 276;
    probe(tri, 6);
    free(tri);

    // Part B — recover real elliptic zetas from point-count behavior
    recover_curve(5, 1, 1);
    recover_curve(13, 2, 1);

    // Part C — the Frobenius operator: Tr(M^n) counts the points (Hilbert-Polya)
    frobenius_spectral(5, 1, 1);
    frobenius_spectral(13, 2, 1);

    // Part D — the genus ladder: genus = (recovered order)/2, for g = 0, 1, 2
    genus_ladder();

    return 0;
}
