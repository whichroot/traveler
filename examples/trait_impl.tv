// Author: Matt Flores
// trait_impl.tv — user-declared traits + impl blocks (B2b Slice 2): methods
// registered as Trait__Type__method, called explicitly — static, no vtable.
// tvc_self ONLY. Prose: @internal-design: examples (trait_impl).
//
// Expected output:
//   200    Rect{w:10,h:20}.area  via Shape__Rect__area
//   78     Circle{r:5}.area      via Shape__Circle__area (pi≈3.14 -> 3*25+...)
//   30     Rect perimeter        via Shape__Rect__perimeter (2*(10+20)/2)
//   1      Eq__Rect__eq(self, 200): area matches -> 1

struct Rect { w: i32, h: i32 }
struct Circle { r: i32 }

// A trait with two methods — the decision contract.
trait Shape {
    fn area(self) -> i32;
    fn perimeter(self) -> i32;
}

// A second trait — proves a type can implement more than one, and that the
// same method name in different traits never collides.
trait Eq {
    fn eq(self, other: i32) -> i32;
}

impl Shape for Rect {
    fn area(self) -> i32 {
        return self.w * self.h;
    }
    fn perimeter(self) -> i32 {
        return (self.w + self.h);
    }
}

impl Shape for Circle {
    fn area(self) -> i32 {
        // integer pi*r^2 with pi ~ 3.14 -> (314 * r * r) / 100
        return (314 * self.r * self.r) / 100;
    }
    fn perimeter(self) -> i32 {
        return (628 * self.r) / 100;
    }
}

impl Eq for Rect {
    fn eq(self, other: i32) -> i32 {
        if self.w * self.h == other {
            return 1;
        }
        return 0;
    }
}

fn main() -> i32 {
    let r: Rect = Rect { w: 10, h: 20 };
    let c: Circle = Circle { r: 5 };

    print(Shape__Rect__area(&r));        // 200
    print(Shape__Circle__area(&c));      // 78  (314*25/100)
    print(Shape__Rect__perimeter(&r));   // 30  (10+20)
    print(Eq__Rect__eq(&r, 200));        // 1   (area 200 matches)
    return 0;
}
