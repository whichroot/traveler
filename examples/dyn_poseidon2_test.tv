    diag[0] = 0xfffffffeffffffff;
    diag[1] = 0x0000000000000001;
    diag[2] = 0x0000000000000002;
    diag[3] = 0x7fffffff80000001;
    diag[4] = 0x0000000000000003;
    diag[5] = 0x7fffffff80000000;
    diag[6] = 0xfffffffefffffffe;
    diag[7] = 0xfffffffefffffffd;
}

fn main() -> i32 {
    let f: Field = field(18446744069414584321);

    // Test 1: dyn S-box x^7: sbox7(2) == 128
    let s: i64 = sbox7_dyn(f, 2);
    if s == 128 { print(1); } else { print(0); }

    let rc_init: *i64 = alloc(32);
    let rc_term: *i64 = alloc(32);
    let rc_int: *i64 = alloc(22);
    let diag: *i64 = alloc(8);
    fill_goldilocks(rc_init, rc_term, rc_int, diag);

    // Test 2: field-term diag derivation reproduces the published diag.
    let dderiv: *i64 = alloc(8);
    poseidon2_diag_dyn(f, dderiv);
    var diag_ok: i32 = 1;
    for i in 0..8 {
        if dderiv[i] != diag[i] { diag_ok = 0; }
    }
    print(diag_ok);

    // Test 3: dyn full permutation vs Plonky3 vector, using the DERIVED diag.
    let state: *i64 = alloc(8);
    for i in 0..8 { state[i] = i as i64; }

    poseidon2_permute_8_dyn(f, state, rc_init, rc_term, rc_int, dderiv);

    let expected: *i64 = alloc(8);
    expected[0] = 0x020cf04a1b214d14;
    expected[1] = 0x84e14aaaeacaed25;
    expected[2] = 0x1ae0f640e81c7457;
    expected[3] = 0xa4d204cbaeb0d8a5;
    expected[4] = 0x0cf637b627b3a7ff;
    expected[5] = 0x788d304d948b486b;
    expected[6] = 0x7327133ea1949af4;
    expected[7] = 0xf415abb924da395b;

    var pass: i32 = 1;
    for i in 0..8 {
        if state[i] != expected[i] { pass = 0; }
    }
    print(pass);

    free(state); free(rc_init); free(rc_term); free(rc_int); free(diag); free(dderiv); free(expected);
    return 0;
}
