// dyn_poseidon2_test.tv — the SAME generic Poseidon2 permutation compiled <dyn>,
// run over field(Goldilocks) and matched exactly to the Plonky3 test vector.
// @internal-design: crypto
//
// Test 1: dyn S-box x^7: sbox7(2) == 128
// Test 2: field-term diag derivation matches published Goldilocks diag
// Test 3: dyn full permutation [0..7] (with DERIVED diag) -> Plonky3 vector
//
// Expected output: 1 1 1

// ---- Generic Poseidon2 core (identical to poseidon2.tv) ----

fn sbox7<F: Field>(x: F) -> F {
    let x2: F = x * x;
    let x4: F = x2 * x2;
    let x7: F = x4 * x2 * x;
    return x7;
}

fn mds_mat4<F: Field>(s: *F) {
    let s0: F = s[0]; let s1: F = s[1]; let s2: F = s[2]; let s3: F = s[3];
    let t01: F  = s0 + s1;
    let t23: F  = s2 + s3;
    let t0123: F = t01 + t23;
    let t01123: F = t0123 + s1;
    let t01233: F = t0123 + s3;
    s[0] = t01123 + t01;
    s[1] = t01123 + s2 + s2;
    s[2] = t01233 + t23;
    s[3] = t01233 + s0 + s0;
}

fn mds_external_8<F: Field>(state: *F) {
    mds_mat4(state);
    let hi: *F = &state[4];
    mds_mat4(hi);
    let sum0: F = state[0] + state[4];
    let sum1: F = state[1] + state[5];
    let sum2: F = state[2] + state[6];
    let sum3: F = state[3] + state[7];
    state[0] = state[0] + sum0;
    state[1] = state[1] + sum1;
    state[2] = state[2] + sum2;
    state[3] = state[3] + sum3;
    state[4] = state[4] + sum0;
    state[5] = state[5] + sum1;
    state[6] = state[6] + sum2;
    state[7] = state[7] + sum3;
}

fn mds_internal_8<F: Field>(state: *F, diag: *F) {
    var sum: F = state[0];
    for i in 1..8 {
        sum = sum + state[i];
    }
    for i in 0..8 {
        state[i] = state[i] * diag[i] + sum;
    }
}

fn poseidon2_permute_8<F: Field>(
    state: *F, rc_init: *F, rc_term: *F, rc_int: *F, diag: *F
) {
    mds_external_8(state);
    for r in 0..4 {
        let base: i32 = r * 8;
        for i in 0..8 {
            state[i] = state[i] + rc_init[base + i];
        }
        for i in 0..8 {
            state[i] = sbox7(state[i]);
        }
        mds_external_8(state);
    }
    for r in 0..22 {
        state[0] = state[0] + rc_int[r];
        state[0] = sbox7(state[0]);
        mds_internal_8(state, diag);
    }
    for r in 0..4 {
        let base: i32 = r * 8;
        for i in 0..8 {
            state[i] = state[i] + rc_term[base + i];
        }
        for i in 0..8 {
            state[i] = sbox7(state[i]);
        }
        mds_external_8(state);
    }
}

// Internal MDS diagonal derived IN FIELD TERMS over the runtime prime —
// the spec's diag = [-2, 1, 2, 1/2, 3, -1/2, -3, -4] are field elements.
fn poseidon2_diag<F: Field>(diag: *F) {
    let zero: F = 0;
    let one: F = 1;
    let two: F = 2;
    let three: F = 3;
    let four: F = 4;
    let half: F = one / two;     // inv(2)
    diag[0] = zero - two;        // -2
    diag[1] = one;               // 1
    diag[2] = two;               // 2
    diag[3] = half;              // 1/2
    diag[4] = three;             // 3
    diag[5] = zero - half;       // -1/2
    diag[6] = zero - three;      // -3
    diag[7] = zero - four;       // -4
}

instantiate sbox7<dyn>;
instantiate mds_mat4<dyn>;
instantiate mds_external_8<dyn>;
instantiate mds_internal_8<dyn>;
instantiate poseidon2_permute_8<dyn>;
instantiate poseidon2_diag<dyn>;

// ---- Goldilocks round constants (Plonky3 Grain LFSR output) ----
// Filled as i64; dyn arithmetic reduces against the runtime prime.

fn fill_goldilocks(rc_init: *i64, rc_term: *i64, rc_int: *i64, diag: *i64) {
    rc_init[0]  = 0xdd5743e7f2a5a5d9; rc_init[1]  = 0xcb3a864e58ada44b;
    rc_init[2]  = 0xffa2449ed32f8cdc; rc_init[3]  = 0x42025f65d6bd13ee;
    rc_init[4]  = 0x7889175e25506323; rc_init[5]  = 0x34b98bb03d24b737;
    rc_init[6]  = 0xbdcc535ecc4faa2a; rc_init[7]  = 0x5b20ad869fc0d033;
    rc_init[8]  = 0xf1dda5b9259dfcb4; rc_init[9]  = 0x27515210be112d59;
    rc_init[10] = 0x4227d1718c766c3f; rc_init[11] = 0x26d333161a5bd794;
    rc_init[12] = 0x49b938957bf4b026; rc_init[13] = 0x4a56b5938b213669;
    rc_init[14] = 0x1120426b48c8353d; rc_init[15] = 0x6b323c3f10a56cad;
    rc_init[16] = 0xce57d6245ddca6b2; rc_init[17] = 0xb1fc8d402bba1eb1;
    rc_init[18] = 0xb5c5096ca959bd04; rc_init[19] = 0x6db55cd306d31f7f;
    rc_init[20] = 0xc49d293a81cb9641; rc_init[21] = 0x1ce55a4fe979719f;
    rc_init[22] = 0xa92e60a9d178a4d1; rc_init[23] = 0x002cc64973bcfd8c;
    rc_init[24] = 0xcea721cce82fb11b; rc_init[25] = 0xe5b55eb8098ece81;
    rc_init[26] = 0x4e30525c6f1ddd66; rc_init[27] = 0x43c6702827070987;
    rc_init[28] = 0xaca68430a7b5762a; rc_init[29] = 0x3674238634df9c93;
    rc_init[30] = 0x88cee1c825e33433; rc_init[31] = 0xde99ae8d74b57176;

    rc_term[0]  = 0x014ef1197d341346; rc_term[1]  = 0x9725e20825d07394;
    rc_term[2]  = 0xfdb25aef2c5bae3b; rc_term[3]  = 0xbe5402dc598c971e;
    rc_term[4]  = 0x93a5711f04cdca3d; rc_term[5]  = 0xc45a9a5b2f8fb97b;
    rc_term[6]  = 0xfe8946a924933545; rc_term[7]  = 0x2af997a27369091c;
    rc_term[8]  = 0xaa62c88e0b294011; rc_term[9]  = 0x058eb9d810ce9f74;
    rc_term[10] = 0xb3cb23eced349ae4; rc_term[11] = 0xa3648177a77b4a84;
    rc_term[12] = 0x43153d905992d95d; rc_term[13] = 0xf4e2a97cda44aa4b;
    rc_term[14] = 0x5baa2702b908682f; rc_term[15] = 0x082923bdf4f750d1;
    rc_term[16] = 0x98ae09a325893803; rc_term[17] = 0xf8a6475077968838;
    rc_term[18] = 0xceb0735bf00b2c5f; rc_term[19] = 0x0a1a5d953888e072;
    rc_term[20] = 0x2fcb190489f94475; rc_term[21] = 0xb5be06270dec69fc;
    rc_term[22] = 0x739cb934b09acf8b; rc_term[23] = 0x537750b75ec7f25b;
    rc_term[24] = 0xe9dd318bae1f3961; rc_term[25] = 0xf7462137299efe1a;
    rc_term[26] = 0xb1f6b8eee9adb940; rc_term[27] = 0xbdebcc8a809dfe6b;
    rc_term[28] = 0x40fc1f791b178113; rc_term[29] = 0x3ac1c3362d014864;
    rc_term[30] = 0x9a016184bdb8aeba; rc_term[31] = 0x95f2394459fbc25e;

    rc_int[0]  = 0x488897d85ff51f56; rc_int[1]  = 0x1140737ccb162218;
    rc_int[2]  = 0xa7eeb9215866ed35; rc_int[3]  = 0x9bd2976fee49fcc9;
    rc_int[4]  = 0xc0c8f0de580a3fcc; rc_int[5]  = 0x4fb2dae6ee8fc793;
