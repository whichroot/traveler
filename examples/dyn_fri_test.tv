fn main() -> i32 {
    // Runtime-selected prime: Goldilocks (NTT-friendly, k=32).
    let f: Field = field(18446744069414584321);

    let rc_init: *i64 = alloc(32);
    let rc_term: *i64 = alloc(32);
    let rc_int: *i64 = alloc(22);
    let diag: *i64 = alloc(8);
    fill_rc(rc_init, rc_term, rc_int);
    poseidon2_diag_dyn(f, diag);

    // f(x) = 1 + 2x + 3x^2 + 4x^3
    let degree: i32 = 3;
    let coeffs: *i64 = alloc(4);
    coeffs[0] = 1; coeffs[1] = 2; coeffs[2] = 3; coeffs[3] = 4;

    let log_blowup: i32 = 1;
    let shift: i64 = 7;            // coset generator
    let num_queries: i32 = 3;
    let max_rounds: i32 = 4;
    let max_depth: i32 = 4;

    let roots: *i64 = alloc(max_rounds * 4);
    let challenges: *i64 = alloc(max_rounds);
    let final_poly: *i64 = alloc(1);
    let query_values: *i64 = alloc(num_queries * max_rounds * 2);
    let query_paths: *i64 = alloc(num_queries * max_rounds * max_depth * 4);
    let query_indices: *i32 = alloc(num_queries);

    // Test 1: prove + verify -> 1
    let n_rounds: i32 = fri_prove_dyn(
        f, coeffs, degree, log_blowup, shift, num_queries,
        roots, challenges, final_poly,
        query_values, query_paths, query_indices,
        rc_init, rc_term, rc_int, diag);

    let ok: i32 = fri_verify_dyn(
        f, degree, log_blowup, shift, num_queries, n_rounds,
        roots, challenges, final_poly,
        query_values, query_paths, query_indices,
        rc_init, rc_term, rc_int, diag);
    print(ok);

    // Test 2: tamper final poly -> verify fails -> 0
    final_poly[0] = final_poly[0] + 1;
    let bad: i32 = fri_verify_dyn(
        f, degree, log_blowup, shift, num_queries, n_rounds,
        roots, challenges, final_poly,
        query_values, query_paths, query_indices,
        rc_init, rc_term, rc_int, diag);
    print(bad);

    free(coeffs); free(roots); free(challenges); free(final_poly);
    free(query_values); free(query_paths); free(query_indices);
    free(rc_init); free(rc_term); free(rc_int); free(diag);
    return 0;
}
